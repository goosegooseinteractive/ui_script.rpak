void function UI_InitCharacterSelectMenu( var menu )
{
	fileForever.menu = menu

	AddMenuEventHandler( menu, eUIEvent.MENU_NAVIGATE_BACK, UI_OnCharacterSelectMenu_NavBack )

	AddMenuFooterOption( menu, RIGHT, BUTTON_X, true, "", "", UI_OnLoadoutButton_RightClick, UI_ShouldShowToggleLegendDetailsFooter ) 
	AddMenuFooterOption( menu, RIGHT, MOUSE_RIGHT, true, "", "", UI_OnLoadoutButton_RightClick, UI_ShouldShowToggleLegendDetailsFooter ) 

	AddMenuFooterOption( menu, RIGHT, BUTTON_Y, true, "", "", UI_OnToggleMuteButtonClick, UI_ShouldShowToggleMuteFooter ) 
	AddMenuFooterOption( menu, RIGHT, KEY_F, true, "", "", UI_OnToggleMuteButtonClick, UI_ShouldShowToggleMuteFooter ) 

	AddMenuFooterOption( menu, RIGHT, BUTTON_X, true, "", "", UI_OnToggleJumpmasterButtonClick, UI_ShouldShowToggleJumpmasterFooter ) 
	AddMenuFooterOption( menu, RIGHT, KEY_E, true, "", "", UI_OnToggleJumpmasterButtonClick, UI_ShouldShowToggleJumpmasterFooter ) 

	AddMenuFooterOption( menu, RIGHT, BUTTON_START, true, "", "", void function( var button ) {
		OpenSystemMenu()
	} ) 

	AddMenuEventHandler( menu, eUIEvent.MENU_CLOSE, void function() {
		RunClientScript( "OnCharacterSelectMenuClosed_RemoveCallbacks" )
	} )

	ToolTips_AddMenu( menu )


		AddMenuFooterOption( menu, RIGHT, KEY_ENTER, true, "", "", UI_OnLoadoutButton_Enter )


	AddUICallback_OnResolutionChanged( UI_OnResolutionChanged )
}








bool function UI_ShouldShowToggleLegendDetailsFooter()
{
	return IsFullyConnected()
}

bool function UI_ShouldShowToggleMuteFooter()
{
	return IsFullyConnected() ? SquadMuteLegendSelectEnabled() : false
}

bool function UI_ShouldShowToggleJumpmasterFooter()
{
	return IsFullyConnected() ? IsJumpmasterVolunteeringEnabled() : false
}

void function UI_OnLoadoutButton_Enter( var button )
{
	var chatbox = Hud_GetChild( fileForever.menu, "LobbyChatBox" )

	if ( !HudChat_HasAnyMessageModeStoppedRecently() )
		Hud_StartMessageMode( chatbox )

	Hud_SetVisible( chatbox, true )
}

void function UI_OnLoadoutButton_RightClick( var button )
{
	if ( CanRunClientScript() )
		RunClientScript( "OnLoadoutButton_RightClick" )
}


void function UI_OnToggleMuteButtonClick( var button )
{
	if ( CanRunClientScript() )
		RunClientScript( "UIToClient_ToggleMute" )
}


void function UI_OnToggleJumpmasterButtonClick( var button )
{
	if ( !IsFullyConnected() )
		return

	if ( !IsJumpmasterVolunteeringEnabled() )
		return

	if ( !CanRunClientScript() )
		return

	RunClientScript( "UIToClient_OnToggleJumpmasterButtonClick" )
}

void function UI_OnResolutionChanged()
{
	if ( CanRunClientScript() && GetActiveMenu() && (GetActiveMenuName() == "CharacterSelectMenu") )
		RunClientScript( "CharacterSelect_UpdateMenuButtons" )
}


void function ClientToUI_UpdateHighlightedCharacter( string charGuid, string charSkinGuid )
{
	SettingsAssetGUID characterGuid = ConvertItemFlavorGUIDStringToGUID( charGuid )
	ItemFlavor character = GetItemFlavorByGUID( characterGuid )

	SettingsAssetGUID characterSkinGuid = ConvertItemFlavorGUIDStringToGUID( charSkinGuid )
	ItemFlavor characterSkin = GetItemFlavorByGUID( characterSkinGuid )

	RTKCharacterSkillsModel_SetCharacter( character )
	RTKLegendUpgradeTree_SetCharacter( character )
	RTKLegendUpgradeTree_IsInteractable( false )
	RTKLegendUpgradeTree_SetTitleVisibility( false )
	RTKLegendUpgradeTree_SetDescriptionVisibility( false )
	RTKCharacterSkinInfoModel_SetPickingPlayerSkinInfo( characterSkin )
}























































































































