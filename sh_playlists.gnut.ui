global typedef PlaylistName string
global typedef PlaylistVarName string


global struct TimestampRange
{
	int startUnixTime 
	int endUnixTime 
}
global struct PlaylistScheduleData
{
	array<TimestampRange> blocks
	TimestampRange ornull currentBlock
	TimestampRange ornull nextBlock
}









struct
{
	table<string, int> playlistIndexMap
	int lastCheckedTime = 0
	bool isOptInEnabled = false
	array<string> cachedVisiblePlaylistNames

} file










int ornull function GetCurrentPlaylistVarTimestamp( string varName, int defaultVal )
{
	return DateTimeStringToUnixTimestamp( GetCurrentPlaylistVarString( varName, string(defaultVal) ) )
}




int function GetMaxTeamSizeForPlaylist( PlaylistName playlistName )
{
	int maxTeamSize = GetPlaylistVarInt( playlistName, "max_team_size", 0 )
	if ( maxTeamSize > 0 )
		return maxTeamSize

	int maxPlayers = GetPlaylistVarInt( playlistName, "max_players", 0 )
	int maxTeams   = GetPlaylistVarInt( playlistName, "max_teams", 0 )
	if ( maxTeams == 0 )
		return maxPlayers
	return maxPlayers / maxTeams
}



int function GetMaxQueueSizeForPlaylist( PlaylistName playlistName )
{
	if ( GameModeVariant_IsActiveForPlaylist( playlistName, eGameModeVariants.SURVIVAL_RANKED ) && Ranked_PartyAboveSoloQueueRankThreshold( playlistName ) )
		return 1

	return GetMaxTeamSizeForPlaylist( playlistName )
}




array<string> function GetPlaylistMaps( PlaylistName playlistName )
{
	array<string> mapsArray

	int numModes = GetPlaylistGamemodesCount( playlistName )
	for ( int modeIndex = 0; modeIndex < numModes; modeIndex++ )
	{
		int numMaps = GetPlaylistGamemodeByIndexMapsCount( playlistName, modeIndex )
		for ( int mapIndex = 0; mapIndex < numMaps; mapIndex++ )
		{
			string mapName = GetPlaylistGamemodeByIndexMapByIndex( playlistName, modeIndex, mapIndex )
			if ( mapsArray.contains( mapName ) )
				continue

			mapsArray.append( mapName )
		}
	}

	return mapsArray
}



vector function GameMode_GetPillarColor( int pillarIndex )
{
	switch ( pillarIndex )
	{
		case 0: 
			return < 0.4, 0.1765, 0.5686 >
		case 1: 
			return < 0.9098, 0.015686, 0.011764 > 
		case 2: 
			return < 0.251, 0.8784, 0.8157 >
		case 3: 
			return < 0.3906, 0.4414, 0.4375 >
		default:
			return < 0.3906, 0.4414, 0.4375 >
	}
	unreachable
}

float function GameMode_GetPillarColorLightness( int pillarIndex )
{
	switch ( pillarIndex )
	{
		case 2: 
			return -0.60
		default:
			return -0.40
	}
	unreachable
}

asset function GameMode_GetTileImage( array< string > imageKeys, int tileHeight = 0 )
{
	asset assetOut = $""
	for ( int i = 0; i < imageKeys.len(); i++ )
	{
		string imageKey = imageKeys[i]
		if ( imageKey != "" )
		{
			string imageKeyTileHeight = imageKey + "_" + string( tileHeight )
			if ( imageKeyTileHeight in GAMEMODE_TILE_IMAGE_MAP )
			{
				assetOut = GAMEMODE_TILE_IMAGE_MAP[imageKeyTileHeight]
			} else if ( imageKey in GAMEMODE_TILE_IMAGE_MAP )
			{
				assetOut = GAMEMODE_TILE_IMAGE_MAP[imageKey]
			}

			else if ( HasEventTakeOverActive() && IsPlaylistLockedForEvent( imageKey ) )
			{
				assetOut = GetImageFromImageMap( "play_apex_panel_locked", false )
			}
			else
			{
				assetOut = GetImageFromImageMap( imageKey, false )
			}
			if ( assetOut != $"" && assetOut != $"white")
			{
				break
			}
		}
	}

	return assetOut
}

asset function GameMode_GetPlayImageInner( array< string > imageKeys )
{
	asset assetOut = $""
	for ( int i = 0; i < imageKeys.len(); i++ )
	{
		string imageKey = imageKeys[i]
		if ( imageKey != "" )
		{
			if ( imageKey in GAMEMODE_PLAY_INNER_IMAGE_MAP )
			{
				assetOut = GAMEMODE_PLAY_INNER_IMAGE_MAP[imageKey]
			}
			if ( assetOut != $"" && assetOut != $"white")
			{
				break
			}
		}
	}

	return assetOut
}

asset function GameMode_GetPlayImageOuter( array< string > imageKeys )
{
	asset assetOut = $""
	for ( int i = 0; i < imageKeys.len(); i++ )
	{
		string imageKey = imageKeys[i]
		if ( imageKey != "" )
		{
			if ( imageKey in GAMEMODE_PLAY_OUTER_IMAGE_MAP )
			{
				assetOut = GAMEMODE_PLAY_OUTER_IMAGE_MAP[imageKey]
			}
			if ( assetOut != $"" && assetOut != $"white")
			{
				break
			}
		}
	}

	return assetOut
}



bool function CanPlaylistFitPartySize( PlaylistName playlistName, int partySize, bool sendOpenInvite )
{
	int maxPlayersPerTeam = GetMaxTeamSizeForPlaylist( playlistName )
	if ( partySize > maxPlayersPerTeam )
		return false

	if ( sendOpenInvite && maxPlayersPerTeam == 1 )
		return false

	bool partiesAllowed = GetPlaylistVarBool( playlistName, "parties_allowed", true )
	if ( !partiesAllowed )
	{
		if ( partySize > 1 )
			return false

		if ( sendOpenInvite )
			return false
	}

	return true
}

asset function GetImageFromImageMap( string keyName, bool warnOnFailure = true )
{
	asset imageAsset = $"white"
	if ( keyName != "" )
	{
		if ( keyName in GAMEMODE_IMAGE_MAP )
			imageAsset = GAMEMODE_IMAGE_MAP[keyName]
		else
		{
#if UI_AUTOMATION
				if ( UIAutomation_IsAutomateQueueForPlaylists() )
					return imageAsset 
#endif

			if ( warnOnFailure )
			{
				Warning( "GetImageFromImageMap: Invalid playlist value for 'image': %s", keyName )
			}
		}
	}
	return imageAsset
}

asset function GetThumbnailImageFromImageMap( string keyName, bool warnOnFailure = true )
{
	asset imageAsset = $"white"
	if ( keyName != "" )
	{
		if ( keyName in GAMEMODE_THUMBNAIL_IMAGE_MAP )
			imageAsset = GAMEMODE_THUMBNAIL_IMAGE_MAP[keyName]
		else
		{
#if UI_AUTOMATION
				if ( UIAutomation_IsAutomateQueueForPlaylists() )
					return imageAsset 
#endif

			if ( warnOnFailure )
				Warning( "GetThumbnailImageFromImageMap: Invalid playlist value for 'image': %s", keyName )
		}
	}
	return imageAsset
}

asset function GetGamemodeLogoFromImageMap( string keyName, bool warnOnFailure = true )
{
	asset imageAsset = $"white"
	if ( keyName != "" )
	{
		bool foundLogo = false
		var parentBlock = GetSettingsBlockForAsset( GAMEMODE_LOGO_SHAREDMAP )
		var arrField    = GetSettingsBlockArray( parentBlock, "gamemodeLogos" )

		foreach ( var entryBlock in IterateSettingsArray( arrField ) )
		{
			string modeName = GetSettingsBlockString( entryBlock, "mode" )

			if( modeName.tolower() == keyName.tolower() )
			{
				imageAsset = GetSettingsBlockAsset( entryBlock, "logo" )
				foundLogo = true
				break
			}
		}

		if ( !foundLogo )
		{
#if UI_AUTOMATION
				if ( UIAutomation_IsAutomateQueueForPlaylists() )
					return imageAsset 
#endif

			if ( warnOnFailure )
				Warning( "GetGamemodeLogoFromImageMap: Invalid playlist value for 'image': %s", keyName )
		}
	}
	return imageAsset
}


