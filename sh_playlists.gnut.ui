#if DEV

const DEV_SecondsPerRotation = 3600
#endif


int function GetPlaylistRotationNextTime( string rotationName = "" )
{
	int nextTime = GetNamedPlaylistRotationNextTime( rotationName )

#if DEV
		if ( nextTime == 0 )
			nextTime = (GetUnixTimestamp() / DEV_SecondsPerRotation ) * DEV_SecondsPerRotation + DEV_SecondsPerRotation 
#endif

	return nextTime
}


string function GetPlaylistRotationNextTimeFormatedString( int seconds = -1, string rotationName = "" )
{
	DisplayTime dt

	if( seconds > -1 )
		dt = SecondsToDHMS( seconds - 1 )
	else
		dt = SecondsToDHMS( GetPlaylistRotationNextTime( rotationName ) - GetUnixTimestamp() - 1 )

	string nextTimeStr

	bool isDays = dt.days > 0
	bool isHours = dt.hours > 0
	bool isMinutes = dt.minutes > 0

	string formatString

	if( isDays && !isHours ){
		
		formatString = Localize( "#TIME_REMAINING_DAYS", string( dt.days ))
	}else if ( isDays && isHours ){
		
		formatString = Localize( "#TIME_REMAINING_DAYS_HOURS", string( dt.days ), string( dt.hours ) )
	}else if( !isDays && isHours && isMinutes ){
		
		formatString = Localize( "#TIME_REMAINING_HOURS_MINUTES", string( dt.hours ), string( dt.minutes ) )
	}else if( !isDays && !isHours && isMinutes ){
		
		formatString = Localize( "#TIME_REMAINING_MINUTES_SECONDS", string( dt.minutes ), string( dt.seconds ) )
	}else if( !isDays && !isHours && !isMinutes){
		
		formatString = Localize( "#TIME_REMAINING_SECONDS", string( dt.seconds ) )
	}

	return formatString
}



void function UpdateMatchmakeFromMatchPlaylist_Thread()
{
	Signal( uiGlobal.signalDummy, "UpdateMatchmakeFromMatchPlaylist" )
	EndSignal( uiGlobal.signalDummy, "UpdateMatchmakeFromMatchPlaylist" )
	EndSignal( uiGlobal.signalDummy, "LevelShutdown" )

	string lastMatchmakingPlaylist = ""
	int emptyPlaylistFrameCount = 0

	while ( true )
	{
		string currentMatchmakingPlaylist = GetMatchRequeuePlaylist()
		if ( currentMatchmakingPlaylist != lastMatchmakingPlaylist )
		{
			lastMatchmakingPlaylist = currentMatchmakingPlaylist

			if ( currentMatchmakingPlaylist == "" )
			{
				emptyPlaylistFrameCount = 0
			}
			else
			{
				emptyPlaylistFrameCount = -1

				CancelMatchmaking()
				WaitFrame()
				StartMatchmaking( currentMatchmakingPlaylist )
			}
		}

		
		if ( emptyPlaylistFrameCount != -1 )
		{
			emptyPlaylistFrameCount++

			if ( emptyPlaylistFrameCount > 10 )
				MatchRequeueCancel()
		}

		wait 1.0
	}
}
void function MatchRequeueCancel()
{
	if ( AreWeMatchmaking() && !LeaveMatch_WasInitiated() )
		CancelMatchmaking()

	Signal( uiGlobal.signalDummy, "UpdateMatchmakeFromMatchPlaylist" )
}


string function GetDefaultPlaylist()
{
	if ( HasEventTakeOverActive() )
		return GetEventTakeoverPlaylist()

	if ( FTUEFlow_IsInFTUEFlow( GetLocalClientPlayer() ) )
	{
		string recommendation = FTUEFlow_GetLobbyPlaylistRecommendation()
		if ( recommendation != "" )
			return recommendation
	}

	if ( RPPMatchMaking_IsInMatchMakingFlow( GetLocalClientPlayer() ) )
	{
		string recommendation = RPPMatchMaking_GetLobbyPlaylistRecommendation()
		if ( recommendation != "" )
			return recommendation
	}

	if ( NewPlayerMatchMaking_IsInMatchMakingFlow( GetLocalClientPlayer() ) )
	{
		string recommendation = NewPlayerMatchMaking_GetLobbyPlaylistRecommendation()
		if ( recommendation != "" )
			return recommendation
	}


	if ( GetPartySize() == 1 )
	{
		if ( !IsLocalPlayerExemptFromTraining() && !HasLocalPlayerCompletedTraining() )
			return PLAYLIST_TRAINING

		if ( !IsLocalPlayerExemptFromNewPlayerOrientation() && !HasLocalPlayerCompletedNewPlayerOrientation() )
			return PLAYLIST_NEW_PLAYER_ORIENTATION
	}
	else if ( DoNonlocalPlayerPartyMembersNeedToCompleteNewPlayerOrientation() )
	{
		return PLAYLIST_NEW_PLAYER_ORIENTATION
	}





	string defaultPlaylist = GetCurrentPlaylistVarString( "playlist_default_slot_override", "regular_1" )
	string defaultSchedulePlaylist = GetCurrentPlaylistForSchedule( defaultPlaylist)
	if ( defaultSchedulePlaylist != "" )
		return defaultSchedulePlaylist

	array<string> list = GetVisiblePlaylistNames()
	foreach ( playlist in list )
	{

		if ( playlist == PLAYLIST_TRAINING || playlist == PLAYLIST_NEW_PLAYER_ORIENTATION )



			continue

		if ( GameModeVariant_IsActiveForPlaylist( playlist, eGameModeVariants.SURVIVAL_RANKED ) )
		{
			if ( !IsFullyConnected() || !IsPersistenceAvailable() )
				continue
			if ( !Ranked_MeetRankedRequirement( GetLocalClientPlayer() ) )
				continue
		}

		return playlist
	}

	return ""
}



string function GetPlaylistMapVarStringOrPlaylistVarString( string playlistName, int mapIdx, string varname, string defaultValue = "" )
{
	return GetPlaylistMapVarString( playlistName, mapIdx, varname, "" ) != "" ? GetPlaylistMapVarString( playlistName, mapIdx, varname, defaultValue ) : GetPlaylistVarString( playlistName, varname, defaultValue )
}



bool function PartyHasPlaylistAccountLevelRequired( string playlistName )
{
	

	if ( !IsFullyConnected() )
		return false

	int accountLevelRequired = GetPlaylistVarInt( playlistName, "account_level_required", 0 ) - 1 
	if ( accountLevelRequired < 0 )
		return true

	Party party = GetParty()
	if ( party.members.len() == 0 )
	{
		if ( IsPersistenceAvailable() )
			return GetPlayerAccountLevel( GetLocalClientPlayer() ) >= accountLevelRequired
		else
			return false
	}

	bool onePartyMembersMeetRankedLevelRequirement = false

	foreach ( member in party.members )
	{
		CommunityUserInfo ornull userInfoOrNull = GetUserInfo( member.hardware, member.uid )

		if ( userInfoOrNull != null )
		{
			CommunityUserInfo userInfo = expect CommunityUserInfo(userInfoOrNull)

			if ( userInfo.charData[ePlayerStryderCharDataArraySlots.ACCOUNT_LEVEL] >= accountLevelRequired )
			{
				onePartyMembersMeetRankedLevelRequirement = true
				break
			}
		}
	}

	return onePartyMembersMeetRankedLevelRequirement
}


