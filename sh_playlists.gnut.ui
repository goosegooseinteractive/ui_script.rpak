	asset val = GetDataTableAsset( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )

	string playlistVarName = (ref + override + columnName)
	string assetRaw = GetCurrentPlaylistVarString( playlistVarName, "" )
	if ( assetRaw.len() == 0 )
