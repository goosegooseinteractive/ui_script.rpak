bool function Playlist_PlaylistHasSchedule( string playlistName )
{
	string ornull schedule = GetScheduleFromPlaylist( playlistName )
	if ( schedule != null )
	{
		return true
	}

	return false
}

TimestampRange ornull function Playlist_GetPlaylistScheduledTimeRange( string playlistName )
{
	string ornull schedule = GetScheduleFromPlaylist( playlistName )
	if ( schedule != null && GetCurrentPlaylistForSchedule( expect string( schedule )  ) == playlistName )
	{
		TimestampRange range
		range.startUnixTime = GetCurrentScheduleEntryStartTime( expect string( schedule ) )
		range.endUnixTime = GetCurrentScheduleEntryEndTime( expect string( schedule ) )
		return range
	}

	return null
}




int ornull function Playlist_GetRankedSeasonEndDate( bool isFirstSplit )
{
	string endDateKey = isFirstSplit ? "ranked_season_end_date_split1" : "ranked_season_end_date_split2"
	string varVal = GetCurrentPlaylistVarString( endDateKey, "" )
	if ( varVal.len() > 0 )
	{
		return DateTimeStringToUnixTimestamp( varVal )
	}

	return null
}

int ornull function Playlist_GetRankedPlaylistLockDate( bool isFirstSplit )
{
	string endDateKey = isFirstSplit ? "ranked_playlist_lock_date_split1" : "ranked_playlist_lock_date_split2"
	string varVal = GetCurrentPlaylistVarString( endDateKey, "" )
	if ( varVal.len() > 0 )
	{
		return DateTimeStringToUnixTimestamp( varVal )
	}

	return null
}

bool function Playlist_ShouldLockRankedPlaylistForSplit()
{
	int ornull lockPlaylistDate = Ranked_GetCurrentRankedPeriodLockTime()
	if ( lockPlaylistDate != null )
	{
		bool passLockPlylistDate = GetUnixTimestamp() > expect int( lockPlaylistDate )
		bool pastEndDate = Ranked_IsPastRankedSeasonEndDate()
		ItemFlavor rankedPeriod = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( Ranked_GetCurrentPeriodGUIDString() ) )
		bool isFirstSplit = Ranked_IsRankedV2FirstSplit( rankedPeriod )
		return passLockPlylistDate && !pastEndDate && isFirstSplit
	}
	return false
}

bool function Playlist_ShouldLockRankedPlaylistForPatch( string plName )
{
	int ornull lockPlaylistDate = Ranked_GetCurrentRankedPeriodLockTime()
	if ( lockPlaylistDate != null ) 
	{
		bool passLockPlylistDate = GetUnixTimestamp() > expect int( lockPlaylistDate )
		bool pastEndDate = Ranked_IsPastRankedSeasonEndDate()
		ItemFlavor rankedPeriod = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( Ranked_GetCurrentPeriodGUIDString() ) )
		bool isFirstSplit = Ranked_IsRankedV2FirstSplit( rankedPeriod )
		return passLockPlylistDate && !pastEndDate && !isFirstSplit
	}

	int ornull seasonEndDate = Ranked_GetCurrentRankedPeriodEndTime()
	if ( seasonEndDate == null )
		return false

	if ( Playlist_PlaylistHasSchedule( plName ) )
	{
		TimestampRange ornull currentBlockOrNull = Playlist_GetPlaylistScheduledTimeRange( plName )
		if ( currentBlockOrNull == null )
			return true

		TimestampRange currentBlock = expect TimestampRange( currentBlockOrNull )

		bool outsideCurrentBlock = currentBlock.startUnixTime > GetUnixTimestamp() || currentBlock.endUnixTime < GetUnixTimestamp()
		bool pastEndDate = Ranked_IsPastRankedSeasonEndDate()

		
		if ( outsideCurrentBlock && !pastEndDate )
			return true
	}

	return false
}




