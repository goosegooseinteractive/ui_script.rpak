


global function GRXRetroPack_Init
global function GRXRetroPack_DebugPrint
global function GRXRetroPack_IsRetroContainerEnabled

global function GRXRetroPack_GetAllBackfillItemsInCategory
global function GRXRetroPack_GetBackfillCategoryForItem

global function GRXRetroPack_GetPersonalizedLootPoolItems
global function GRXRetroPack_FilterRetroContainerContents


const bool PROCESS_REFS_ON_INIT = true
const bool RETRO_CONTAINER_ITEMS = true

typedef CategorizedBackfillItems array< array< ItemFlavor > >

struct FileStruct_GRXRetroPack
{
	
	table< string, bool > allBackfillItemRefs

	array< array< ItemFlavor > > backfillItemsByCategory
}
FileStruct_GRXRetroPack& file


void function GRXRetroPack_Init()
{
	FileStruct_GRXRetroPack newFile
	file = newFile

	AddCallbackOrMaybeCallNow_OnAllItemFlavorsRegistered( GRXRP_OnAllItemFlavorsRegistered )
}

void function GRXRetroPack_DebugPrint()
{
#if DEV
	printf( "%i refs\n", file.allBackfillItemRefs.len() )

	foreach ( int arrayIndex, array< ItemFlavor > flavArray in file.backfillItemsByCategory )
	{
		printf( "  Category %i has %i flavs\n", arrayIndex, flavArray.len() )
	}
#endif
}

bool function GRXRetroPack_IsRetroContainerEnabled()
{
	return RETRO_CONTAINER_ITEMS
}

array< ItemFlavor > function GRXRetroPack_GetAllBackfillItemsInCategory( int bfCategory )
{
	GRXRP_AssertBackfillCategory( bfCategory )

	return file.backfillItemsByCategory[bfCategory]
}


int function GRXRetroPack_GetBackfillCategoryForItem( ItemFlavor flav )
{
	int rv
	
	
	const NUM_BACKFILL_ITEM_CATEGORIES = 3

	int type = ItemFlavor_GetType( flav )
	int quality = ItemFlavor_GetQuality( flav )


	if ( type == eItemType.character_skin )
	{
		rv = eBackfillPoolCategory.EPIC_CHARACTER_SKIN
	}
	else if ( type == eItemType.weapon_skin )
	{
		rv = eBackfillPoolCategory.EPIC_WEAPON_SKIN
	}
	else
	{
		rv = eBackfillPoolCategory.EPIC_NON_SKIN
	}

	int offsetToUse
	{
		
		Assert( quality >= eRarityTier.EPIC && quality <= eRarityTier.MYTHIC, format( "Unhandled backfill Quality %i for %s", quality, ItemFlavor_GetAssetName( flav ) ) )
		int tierOffset = quality - eRarityTier.EPIC 
		offsetToUse = NUM_BACKFILL_ITEM_CATEGORIES * tierOffset
	}

	rv += offsetToUse
	return rv
}

array< UILootPoolItemData > function GRXRetroPack_GetPersonalizedLootPoolItems( ItemFlavor packFlav )
{
	Assert( GRXPack_GetIsLootPoolBrowsable( packFlav ) ) 
	Assert( GRX_IsInventoryReady() )

	array< UILootPoolItemData > rv

	int packType = ItemFlavor_GetAccountPackType( packFlav )
	array< ItemFlavor > packContents = GRXPack_GetPackContents( packFlav )

	if ( !GRXPack_IsBackfillPack( packFlav ) )
	{
		
		foreach ( ItemFlavor packItem in packContents )
		{
			UILootPoolItemData newElem
			newElem.flav		= packItem
			newElem.quantity	= 1
			newElem.isFallback	= false
			newElem.isOwned		= GRX_IsItemOwnedByPlayer( packItem )

			rv.append( newElem )
		}

		return rv
	}

	

	array< ItemFlavor > ornull containerItems = GRX_GetItemFlavsFromRetroContainer( packFlav )
	Assert( containerItems != null )
	expect array< ItemFlavor >( containerItems )

	array< ItemFlavor > filteredContainerItems = GRXRetroPack_FilterRetroContainerContents( containerItems, packContents )
	array< ItemFlavor > nonEventContainerItems = clone filteredContainerItems

	array< ItemFlavor > backfillExclusionList = GRXRP_GetBackfillExclusionList( packFlav, packType )
#if DEV
	printf( "%s - %s backfill exclusion list has %d item(s)", FUNC_NAME(), ItemFlavor_GetAssetName( packFlav ), backfillExclusionList.len() )
#endif

	foreach ( ItemFlavor packItem in packContents )
	{
		bool itemIsToBeBackfilled = false

		if ( GRX_IsItemOwnedByPlayer( packItem ) )
		{
			if ( filteredContainerItems.contains( packItem ) == false )
			{
				
				itemIsToBeBackfilled = true
			}
		}

		if ( backfillExclusionList.contains( packItem ) )
		{
#if DEV
				printt( "  EXCLUDING from backfill: ", ItemFlavor_GetAssetName( packItem ) )
#endif

			itemIsToBeBackfilled = false
		}

		nonEventContainerItems.fastremovebyvalue( packItem )

		UILootPoolItemData newElem
		newElem.flav		= packItem
		newElem.quantity	= 1
		newElem.isFallback	= itemIsToBeBackfilled
		newElem.isOwned		= false

		rv.append( newElem )
	}

	
	{
		CategorizedBackfillItems backfillRewards
		backfillRewards.resize( eBackfillPoolCategory._COUNT )

		nonEventContainerItems.sort( int function( ItemFlavor a, ItemFlavor b ) {
			SettingsAssetGUID aGUID = ItemFlavor_GetGUID( a )
			SettingsAssetGUID bGUID = ItemFlavor_GetGUID( b )

			return ClampInt( aGUID - bGUID, -1, 1 )
		} )

		foreach ( ItemFlavor nonEventItem in nonEventContainerItems )
		{
			int bfCategory = GRXRetroPack_GetBackfillCategoryForItem( nonEventItem )
			backfillRewards[bfCategory].append( nonEventItem )
		}

		
		foreach ( UILootPoolItemData poolItem in rv )
		{
			ItemFlavor poolFlav = poolItem.flav

			if ( poolItem.isFallback )
			{
				int bfCategory = GRXRetroPack_GetBackfillCategoryForItem( poolFlav )

				if ( backfillRewards[bfCategory].len() > 0 )
				{
					
					poolItem.isOwned = true

					
					ItemFlavor bfReward = backfillRewards[bfCategory].pop()
					poolItem.flav = bfReward
				}
			}
			else
			{
				
				poolItem.isOwned = GRX_IsItemOwnedByPlayer( poolFlav )
			}
		}
	}

	return rv
}

array< ItemFlavor > function GRXRetroPack_FilterRetroContainerContents( array< ItemFlavor > inputFlavs, array< ItemFlavor > secondaryAllowlist )
{
	

	array< ItemFlavor > rv

	foreach ( ItemFlavor flav in inputFlavs )
	{
		string grxRef = ItemFlavor_GetGRXAlias( flav )

		bool inPrimaryList		= grxRef in file.allBackfillItemRefs
		bool inSecondaryList	= secondaryAllowlist.contains( flav )

		if ( inPrimaryList || inSecondaryList )
		{
			rv.append( flav )
		}
	}

	return rv
}

array< ItemFlavor > function GRXRP_GetBackfillExclusionList( ItemFlavor packFlav, int packType )
{
	
	

	array< ItemFlavor > rv
	if ( packType != eAccountPackType.RETRO_ESCALATING_BACKFILL_PACK )
		return rv

	PoolRarityConfig poolConfig = GRXPack_GetRarityConfig( packFlav )
	rv = poolConfig.specificFlavs.clonekeys()

	return rv
}

void function GRXRP_AssertBackfillCategory( int bfCategory )
{
	Assert( file.backfillItemsByCategory.isvalidindex( bfCategory ), format( "Category %i is invalid", bfCategory ) )
}

void function GRXRP_OnAllItemFlavorsRegistered()
{
	file.backfillItemsByCategory.clear()
	file.backfillItemsByCategory.resize( eBackfillPoolCategory._COUNT )

	if ( PROCESS_REFS_ON_INIT )
	{
		GRXRP_ProcessRefList( eBackfillPoolCategory.MYTHIC_CHARACTER_SKIN, Mythic_CharSkins )
		GRXRP_ProcessRefList( eBackfillPoolCategory.MYTHIC_WEAPON_SKIN, Mythic_WeapSkins )
		GRXRP_ProcessRefList( eBackfillPoolCategory.MYTHIC_NON_SKIN, Mythic_NonSkins )
		GRXRP_ProcessRefList( eBackfillPoolCategory.LEGENDARY_CHARACTER_SKIN,	Legendary_CharSkins	)
		GRXRP_ProcessRefList( eBackfillPoolCategory.LEGENDARY_WEAPON_SKIN,		Legendary_WeapSkins	)
		GRXRP_ProcessRefList( eBackfillPoolCategory.LEGENDARY_NON_SKIN,			Legendary_NonSkins	)
		GRXRP_ProcessRefList( eBackfillPoolCategory.EPIC_CHARACTER_SKIN,		Epic_CharSkins		)
		GRXRP_ProcessRefList( eBackfillPoolCategory.EPIC_WEAPON_SKIN,			Epic_WeapSkins		)
		GRXRP_ProcessRefList( eBackfillPoolCategory.EPIC_NON_SKIN,				Epic_NonSkins		)
	}
}

void function GRXRP_ProcessRefList( int bfCategory, array< string > refs )
{
	GRXRP_AssertBackfillCategory( bfCategory )

	foreach ( string ref in refs )
	{
		int grxIndex = GetGRXIndexByGRXRef( ref )
		if ( IsValidItemFlavorGRXIndex( grxIndex ) )
		{
			ItemFlavor flav = GetItemFlavorByGRXIndex( grxIndex )
			file.backfillItemsByCategory[bfCategory].append( flav )

			file.allBackfillItemRefs[ref] <- true
		}
		else
		{
			Warning( format( "%s - Invalid GRX Ref %s\n", FUNC_NAME(), ref ) )
		}
	}
}


































