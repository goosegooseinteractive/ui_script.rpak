global const string EVO_XP_NETINT = "evo_xp"




	const float WAIT_BEFORE_NEXT_ORB_SPAWN = 0.05
	global const string EVO_CACHE_TINY_INFO_TARGET_NAME = "evo_consolidate_parent"
