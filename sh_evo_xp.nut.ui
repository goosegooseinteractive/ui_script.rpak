const table<string, asset> EVOXP_DATATABLE = {
	
	[ "DEFAULT" ] = $"datatable/evo_xp.rpak",


	[ "UNHINGED" ] = $"datatable/evo_xp_unhinged.rpak",

}

const bool EVO_XP_DEBUG = false

void function EvoXP_Init()
{
	EvoXP_InitTuningValues()

	if( !EvoXp_IsEnabled() )
		return

	EvoXP_NetvarsInit()




























































}

void function EvoXP_InitTuningValues()
{




	
	Tuning defaultTunings

	tuning.isEnabled = GetCurrentPlaylistVarBool( "evo_xp_enabled", true )



















































		tuning.overflowEvoXPToTeammatesWhenMaxLevel = GetCurrentPlaylistVarBool( "passive_upgrade_core_share_evo_at_max_level", defaultTunings.overflowEvoXPToTeammatesWhenMaxLevel )











}

void function EvoXP_NetvarsInit()
{
	RegisterNetworkedVariable( EVO_XP_NETINT, SNDC_PLAYER_GLOBAL, SNVT_BIG_INT , 0.0 )
}

void function EvoXp_LobbyInit()
{
	EvoXP_NetvarsInit()
	EvoXP_InitTuningValues()
}

bool function EvoXp_IsEnabled()
{
	return LegendUpgrades_IsEnabled()
}







































