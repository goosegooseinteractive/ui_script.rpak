void function ShChallenges_LevelInit_PreStats()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	AddCallback_OnItemFlavorRegistered( eItemType.challenge, Callback_OnChallengeRegistered )































		RegisterSignal( "UINotification_AssignedChallengesDidChange" )








	ReturningPlayerChallenges_Init()

	file.initialized = true
}

void function Callback_OnChallengeRegistered( ItemFlavor challenge )
{









































}

void function ShChallenges_LevelInit_PostStats()
{
#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return
#endif

	fileLevel.hasPlaylistChallengeOverrides = GetCurrentPlaylistVarBool( "has_playlist_challenge_overrides", false )

	ShChallenges_RefreshCachedSeasonInfo()


		RefreshEventCache()


	foreach ( ItemFlavor challenge in GetAllChallenges() )
	{

		Assert( !Challenge_IsPlayerPassChallenge( challenge ) || ItemFlavor_GetParentFlavor( challenge ) != null )


		array<bool> fetchAltRefs = [ false ]
		if ( Challenge_IsEitherOr( challenge ) )
			fetchAltRefs.append( true )

		foreach ( bool isAlt in fetchAltRefs )
		{
			int tierCount = Challenge_GetTierCount( challenge )

			for ( int i = 0 ; i < tierCount ; i++ )
			{
				array<string> statRefs = Challenge_GetStatRefs( null, challenge, i, isAlt )
				foreach ( string statRef in statRefs )
				{
					if ( !IsValidStatEntryRef( statRef ) )
					{
						Assert( false, format( "Challenge '%s' tier %d refers to non-existent stat: '%s'", ItemFlavor_GetAssetName( challenge ), i, statRef ) )
						continue
					}

					StatEntry stat = GetStatEntryByRef( statRef )









































					if ( stat.statWriteMode == eStatWriteMode.WRITE_END_OF_MATCH )
					{
						Assert( false, format( "Challenge '%s' refers to stat that does NOT have the PERSISTENCE_WRITE_IMMEDIATELY flag: '%s'", ItemFlavor_GetAssetName( challenge ), statRef ) )
						continue
					}

					if ( Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.EVENT_HIDDEN )
					{
						continue
					}

					int challengeGameMode = Challenge_GetGameMode( challenge, isAlt )




					if ( stat.gameModeBitField != challengeGameMode )

					{
						string formatStr	= "(%s with mode %s)"

						string modeStr
						if ( challengeGameMode == CHALLENGE_GAME_MODE_ANY )
						{
							modeStr = CHALLENGE_GAME_MODE_STRING_ANY
						}
						else if ( challengeGameMode == CHALLENGE_GAME_MODE_ANY_PLUS_CASUAL_TRIOS )
						{
							modeStr = CHALLENGE_GAME_MODE_STRING_ANY_PLUS_CASUAL_TRIOS
						}
						else if ( challengeGameMode == CHALLENGE_GAME_MODE_BATTLE_ROYALE )
						{
							modeStr = CHALLENGE_GAME_MODE_STRING_BATTLE_ROYALE
						}
						else if ( challengeGameMode == CHALLENGE_GAME_MODE_BATTLE_ROYALE_PLUS_CASUAL_TRIOS )
						{
							modeStr = CHALLENGE_GAME_MODE_STRING_BATTLE_ROYALE_PLUS_CASUAL_TRIOS
						}
						else if ( challengeGameMode == CHALLENGE_GAME_MODE_EXCEPT_BR )
						{
							modeStr = CHALLENGE_GAME_MODE_STRING_EXCEPT_BR
						}
						else
						{
							modeStr = GetEnumString( "eChallengeGameMode", challengeGameMode )
						}

						string challModeStr	= format( formatStr, ItemFlavor_GetAssetName( challenge ), modeStr )

						string trackedModes
						if ( stat.gameModeBitField == CHALLENGE_GAME_MODE_ANY )
						{
							trackedModes = CHALLENGE_GAME_MODE_STRING_ANY
						}
						else if ( stat.gameModeBitField == CHALLENGE_GAME_MODE_ANY_PLUS_CASUAL_TRIOS )
						{
							trackedModes = CHALLENGE_GAME_MODE_STRING_ANY_PLUS_CASUAL_TRIOS
						}
						else if ( stat.gameModeBitField == CHALLENGE_GAME_MODE_BATTLE_ROYALE )
						{
							trackedModes = CHALLENGE_GAME_MODE_STRING_BATTLE_ROYALE
						}
						else if ( stat.gameModeBitField == CHALLENGE_GAME_MODE_BATTLE_ROYALE_PLUS_CASUAL_TRIOS )
						{
							trackedModes = CHALLENGE_GAME_MODE_STRING_BATTLE_ROYALE_PLUS_CASUAL_TRIOS
						}
						else if ( stat.gameModeBitField == CHALLENGE_GAME_MODE_EXCEPT_BR )
						{
							trackedModes = CHALLENGE_GAME_MODE_STRING_EXCEPT_BR
						}
						else
						{
							array<int> intModes = Stats_GetGameModesFromBitfield( stat.gameModeBitField )
							array<string> stringModes
							foreach ( int intMode in intModes )
							{
								stringModes.append( GetEnumString( "eChallengeGameMode", intMode ) )
							}

							trackedModes = stringModes.join( ", " )
						}

						string statModeStr	= format( formatStr, statRef, trackedModes )

						Assert( false, format( "Mismatch mode configuration between Challenge %s and Stat %s", challModeStr, statModeStr ) )

						continue
					}

					if ( !(stat in fileLevel.statEntryChallengesMap) )
						fileLevel.statEntryChallengesMap[ stat ] <- []

					StatRefMapChallengePair	pair
					pair.challenge = challenge
					pair.statIsAlt = isAlt
					fileLevel.statEntryChallengesMap[ stat ].append( pair )
				}

				if ( Challenge_GetGoalVal( challenge, i, isAlt ) <= 0 )
				{

						if ( !Challenge_IsRankedChallengeActive() && Challenge_IsMetaChallenge( challenge ) && Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.RANKED_REWARD )
						{
							continue 
						}











					continue
				}
			}
		}
	}


	if ( !IsLobby() )
	{
		thread InitChallengesThread()
	}

}




















void function InitChallengesThread()
{
	while ( !IsFullyConnected() )
		WaitFrame()

	ClientToUI_AssignedChallengesDidChange()
	ClientToUI_ChallengeDataDidChange( false ) 
	SetChallengeCategory()
}


void function RegisterChallengeSource( ItemFlavor challengeFlav, ItemFlavor sourceFlav, int sortOrdinal )
{
	if ( challengeFlav in fileLevel.challengeSourceMap )
	{
		Warning( "Challenge %s source is ambiguous: %s, %s", string(ItemFlavor_GetAsset( challengeFlav )), string(ItemFlavor_GetAsset( fileLevel.challengeSourceMap[challengeFlav] )), string(ItemFlavor_GetAsset( sourceFlav )) )
		return
	}
	fileLevel.challengeSourceMap[challengeFlav] <- sourceFlav
	Challenge_SetSortOrdinal( challengeFlav, sortOrdinal )
}

void function Challenge_SetSortOrdinal( ItemFlavor challengeFlav, int sortOrdinal )
{
	

#if CHALLENGE_DEBUG
		if ( challengeFlav in fileLevel.challengeSortOrdinalMap )
			printf( "Challenge %i is already registered in challengeSortOrdinalMap! (%i) Overriding to %i", challengeFlav.guid, fileLevel.challengeSortOrdinalMap[challengeFlav], sortOrdinal )
#endif

	fileLevel.challengeSortOrdinalMap[challengeFlav] <- sortOrdinal
}

int function Challenge_GetSortOrdinal( ItemFlavor challengeFlav )
{
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )

	if ( challengeFlav in fileLevel.challengeSortOrdinalMap )
	{
		return fileLevel.challengeSortOrdinalMap[challengeFlav]
	}

#if CHALLENGE_DEBUG
		printf( "Challenge %i was not in challengeSortOrdinalMap! Did you forget to RegisterChallengeSource?", challengeFlav.guid )
#endif
	return 0
}




























































































































void function ClientToUI_AssignedChallengesDidChange()
{
	InitPlayerChallengesStateFromPersistence( GetLocalClientPlayer(), fileLevel.localPlayerChallengesState )
	Signal( uiGlobal.signalDummy, "UINotification_AssignedChallengesDidChange" )
}


















void function ClientToUI_ChallengeDataDidChange( bool didEventChallengesRefresh )
{
	if ( IsLobby() && IsLocalClientEHIValid() )
	{
		InitPlayerChallengesStateFromPersistence( GetLocalClientPlayer(), fileLevel.localPlayerChallengesState )
		UpdateFavoriteChallengesCache( GetLocalClientPlayer() )

			ChallengeTile_RefreshTiles()


		var button = AllChallengesMenu_GetLastGroupButton()
		AllChallengesMenu_UpdateCategories( null )
		if ( button != null )
			AllChallengesMenu_SetLastGroupButton( button )
		AllChallengesMenu_ActivateLastGroupButton()

		if ( didEventChallengesRefresh )
			fileLevel.haveEventChallengesRefreshedOnUI = true
	}
}











void function ClientToUI_FavoriteChallengeDidToggle( SettingsAssetGUID challengeGUID, bool willFavorite )
{
	UpdateFavoriteChallengesCache( GetLocalClientPlayer() )

	if ( IsValidItemFlavorGUID( challengeGUID ) )
	{
		ItemFlavor challenge = GetItemFlavorByGUID( challengeGUID )
		if ( Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.MYTHIC )
			Mythics_UpdateLootCeremonyTrackingButton()
		ChallengeTile_UpdateFavoriteChallenge( challengeGUID, willFavorite )
	}

}



bool function EventChallengesDidRefreshOnUI()
{
	return fileLevel.haveEventChallengesRefreshedOnUI
}




void function HideLobbyChallengeMenu()
{
#if CHALLENGE_DEBUG
		ChallengeDbg( GetLocalClientPlayer(), "" )
#endif

	if ( !IsFullyConnected() )
		return

	
	var progressionPanel 		   = GetLobbyProgressionPanel()
	var challengesBoxHeader        = Hud_GetChild( progressionPanel, "ChallengesBox" )
	var battlePassNextRewardButton = Hud_GetChild( progressionPanel, "ChallengesNextBPReward" )
	var challengesBoxHeaderRui     = Hud_GetRui( challengesBoxHeader ) 
	var allChallengesButton        = Hud_GetChild( progressionPanel, "AllChallengesButton" )

	var challengeCatergoryLeft      = Hud_GetChild( progressionPanel, "ChallengeCatergoryLeftButton" )
	var challengeCatergorySelection = Hud_GetChild( progressionPanel, "ChallengeCatergorySelection" )
	var challengeCatergoryRight     = Hud_GetChild( progressionPanel, "ChallengeCatergoryRightButton" )
	var viewEventButton       		= Hud_GetChild( progressionPanel, "ViewEventButton" )
	var storyPrizeTrackButton       = Hud_GetChild( progressionPanel, "StoryPrizeTrackButton" )
	var challengesTags = Hud_GetChild( progressionPanel, "ChallengesTags" )


	array<var> btnList = GetLobbyChallengeButtons()
	array<var> btnStoryList = GetLobbyStoryChallengeButtons()

	entity player = GetLocalClientPlayer()

	foreach ( button in btnList )
		Hud_Hide( button )

	foreach ( button in btnStoryList )
		Hud_Hide( button )

	Hud_Hide( challengesBoxHeader )
	Hud_Hide( battlePassNextRewardButton )
	Hud_Hide( allChallengesButton )
	Hud_Hide( challengeCatergoryLeft )
	Hud_Hide( challengeCatergorySelection )
	Hud_Hide( challengeCatergoryRight )
	Hud_Hide( viewEventButton )
	Hud_Hide( storyPrizeTrackButton )
	Hud_Hide( challengesTags )
}

var function GetLobbyProgressionPanel()
{
	var parentPanel = GetPanel( "PlayPanel" )
	parentPanel = GetProgressionTray()
	return Hud_GetChild( parentPanel, "ProgressionPanel" )
}

void function UpdateLobbyChallengeMenu( bool shouldUpdateEventsCache )
{
#if CHALLENGE_DEBUG
		ChallengeDbg( GetLocalClientPlayer(), "" )
#endif

	if ( !IsFullyConnected() )
		return

	if ( shouldUpdateEventsCache ) 
		RefreshEventCache()

	
	var playPanel                   = GetPanel( "PlayPanel" )
	var progressionPanel 			= GetLobbyProgressionPanel()
	var challengesBoxHeader         = Hud_GetChild( progressionPanel, "ChallengesBox" )
	var battlePassNextRewardButton  = Hud_GetChild( progressionPanel, "ChallengesNextBPReward" )
	var challengesBoxHeaderRui      = Hud_GetRui( challengesBoxHeader ) 
	var allChallengesButton         = Hud_GetChild( progressionPanel, "AllChallengesButton" )
	var challengeCatergoryLeft      = Hud_GetChild( progressionPanel, "ChallengeCatergoryLeftButton" )
	var challengeCatergorySelection = Hud_GetChild( progressionPanel, "ChallengeCatergorySelection" )
	var challengeCatergoryRight     = Hud_GetChild( progressionPanel, "ChallengeCatergoryRightButton" )
	var viewEventButton       		= Hud_GetChild( progressionPanel, "ViewEventButton" )
	var storyPrizeTrackButton       = Hud_GetChild( progressionPanel, "StoryPrizeTrackButton" )
	var miniPromoButton				= Hud_GetChild( playPanel, "MiniPromo" )
	var challengesTags       		= Hud_GetChild( progressionPanel, "ChallengesTags" )
	var challengesBlur              = Hud_GetChild( progressionPanel, "ChallengesBlur" )

	array<var> btnList = GetLobbyChallengeButtons()
	array<var> btnStoryList = GetLobbyStoryChallengeButtons()

	entity player = GetLocalClientPlayer()

	int challengeCategory                		= GetChallengeDisplayCategory()
	ItemFlavor ornull currentEvent       		= null
	ItemFlavor ornull currentBuffetEvent 		= null
	ItemFlavor ornull currentEventShop   		= null
	
	ItemFlavor ornull currentRewardCampaign		= null
	ItemFlavor ornull currentTempUnlockEvent    = TempUnlock_GetLatestActiveEvent( GetUnixTimestamp() )

	if ( fileLevel.currentEvents.len() > 0 )
		currentBuffetEvent = fileLevel.currentEvents[ 0 ]

	if ( fileLevel.currentEventShops.len() > 0 )
		currentEventShop = fileLevel.currentEventShops[ 0 ]

	if ( fileLevel.currentRewardCampaigns.len() > 0 )
		currentRewardCampaign = fileLevel.currentRewardCampaigns[ 0 ]

	if ( IsStoryCategory( challengeCategory ) )
	{
		if ( fileLevel.currentStories.len() > 0 )
			currentEvent = fileLevel.currentStories[ 0 ]
	}
	else
	{
		if ( IsEventShopChallengeCategory( challengeCategory ) && ( EventShop_CurrentActiveEventShopHasDailyChallenges() || EventShop_CurrentActiveEventShopHasEventChallenges() ) )
		{
			currentEvent = currentEventShop
		}
		else if ( IsEventCategory( challengeCategory ) )
		{
			currentEvent = currentBuffetEvent
		}
		else if( IsRewardCampaignChallengeCategory( challengeCategory ) )
		{
			currentEvent = currentRewardCampaign
		}
		else if( IsTempUnlockChallengeCategory( challengeCategory ) )
		{
			currentEvent = currentTempUnlockEvent
		}
	}

	array<ItemFlavor> challenges = GetChallengesByCategory( player, challengeCategory, currentEvent )
	
	if ( IsRewardCampaignChallengeCategory( challengeCategory ) )
	{
		challenges = RewardCampaign_GetCurrentTempUnlockChallenges( player )
	}

	if ( IsTempUnlockChallengeCategory( challengeCategory ) )
	{
		challenges = TempUnlock_GetCurrentCharacterUnlockChallenges( player )
	}

	UpdateChallengeCategorySelection( Hud_GetRui( challengeCatergorySelection ) )
	UpdateChallengeCategoryTint( currentEvent, challengeCatergoryLeft, challengeCatergorySelection, challengeCatergoryRight, allChallengesButton )

	if ( IsEventCategory( challengeCategory ) && currentEvent != null )
	{
		expect ItemFlavor( currentEvent )
		FilterOutMainChallengeIfValid( currentEvent, challenges )
	}

	HideLobbyChallengeMenu()

	UpdateChallengeTags( challengesTags )

	Hud_SetVisible( challengesTags, !IsStoryCategory( challengeCategory ) )
	Hud_Show( challengesBoxHeader )
	Hud_Show( allChallengesButton )
	Hud_Show( challengeCatergoryLeft )
	Hud_Show( challengeCatergorySelection )
	Hud_Show( challengeCatergoryRight )
	Hud_Show( challengesBlur )

	bool isViewButtonVisible = Hud_IsVisible(viewEventButton)
	bool isStoryTrackButtonVisible =  Hud_IsVisible(storyPrizeTrackButton)

	bool isButtonVisible = isViewButtonVisible || isStoryTrackButtonVisible
	var buttonBelow = isButtonVisible ? viewEventButton : miniPromoButton
	Hud_SetNavDown( challengeCatergoryLeft, buttonBelow )
	Hud_SetNavDown( challengeCatergoryRight, buttonBelow )
	Hud_SetNavDown( allChallengesButton, buttonBelow )

	if( isViewButtonVisible )
		Hud_SetNavUp( miniPromoButton, viewEventButton )
	else if( isStoryTrackButtonVisible )
		Hud_SetNavUp( miniPromoButton, storyPrizeTrackButton )
	else
		Hud_SetNavUp( miniPromoButton, challengeCatergoryRight )
}

bool function ShouldChallengeCountTowardsNewness( ItemFlavor challenge )
{
	if ( !Newness_IsItemFlavorNew( challenge ) )
		return false

	if ( Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING )
		return false

	if ( Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.EVENT_HIDDEN )
		return false

	if ( Challenge_GetTimeSpanKindFromBakery( challenge ) == eChallengeTimeSpanKind.EVENT_SPECIAL_2 )
		return false

	return true
}












































































































void function FilterOutMainChallengeIfValid( ItemFlavor currentEvent, array<ItemFlavor> challenges )
{
	BuffetEventModesAndChallengesData eventData = BuffetEvent_GetModesAndChallengesData( currentEvent )
	if ( eventData.mainChallengeFlav != null )
	{
		ItemFlavor main = expect ItemFlavor( eventData.mainChallengeFlav )
		int idx         = challenges.find( main )
		if ( idx >= 0 )
		{
			challenges.remove( idx )
		}
	}
}


array<ItemFlavor> function GetChallengesByCategory( entity player, int challengeCategory, ItemFlavor ornull currentEvent )
{
	bool hasActiveEvent = false
	if ( currentEvent != null )
	{
		expect ItemFlavor( currentEvent )
		hasActiveEvent = true
	}

	array<ItemFlavor> challenges
	if ( IsEventCategory( challengeCategory ) )
	{
		int timespan = IsEventShopChallengeCategory( challengeCategory ) ? eChallengeTimeSpanKind.EVENTSHOP_DAILY_CHALLENGE : eChallengeTimeSpanKind.EVENT
		challenges = GetAssignedChallengesByTimeSpan( player, timespan, -1, currentEvent )
	}
	else if ( IsStoryCategory( challengeCategory ) )
	{
		expect ItemFlavor( currentEvent )

		challenges = StoryEvent_GetCurrentChapterChallenges( player,  currentEvent )
	}
	else
	{
		switch( challengeCategory )
		{
			case eChallengeCategory.BEGINNER:
			{
				array<ItemFlavor> allBeginnerChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.BEGINNER )
				foreach ( ItemFlavor beginnerChallenge in allBeginnerChallenges )
				{
					if ( challenges.len() >= NUM_DAILY_CHALLENGES )
						break 

						if ( !Challenge_IsComplete( player, beginnerChallenge ) && !Challenge_IsMetaChallenge( beginnerChallenge ) )
						{
							challenges.append( beginnerChallenge )
						}
				}
				break
			}

			case eChallengeCategory.RETURNING_PLAYER:
			{
				array<ItemFlavor> allReturningPlayerChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.RETURNING_PLAYER )
				foreach ( ItemFlavor returningPlayerChallenge in allReturningPlayerChallenges )
				{
					if ( challenges.len() >= NUM_DAILY_CHALLENGES )
						break 

					if ( !Challenge_IsComplete( player, returningPlayerChallenge ) && !Challenge_IsMetaChallenge( returningPlayerChallenge ) )
					{
						challenges.append( returningPlayerChallenge )
					}
				}
				break
			}


			case eChallengeCategory.ROAD_TO_RANKED:
			{
				array<ItemFlavor> allChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.ROAD_TO_RANKED )
				foreach ( ItemFlavor challenge in allChallenges )
				{
					if ( challenges.len() >= NUM_DAILY_CHALLENGES )
						break 

					if ( !Challenge_IsComplete( player, challenge ) && !Challenge_IsMetaChallenge( challenge ) )
					{
						challenges.append( challenge )
					}
				}
				break
			}



			case eChallengeCategory.RANKED:
			{
				array<ItemFlavor> allChallenges = []
				if ( GetConVarBool( RANKED_REWARD_HAS_MIN_MATCH_REQUIREMENT ) )
					allChallenges.extend( GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.RANKED_REWARD ) )
				if ( GetConVarBool( RANKED_EVENT_CONVAR ) )
					allChallenges.extend( GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.RANKED_EVENT_CHAMPION ) )
				foreach ( ItemFlavor challenge in allChallenges )
				{
					if ( challenges.len() >= NUM_DAILY_CHALLENGES )
						break 

					if ( !Challenge_IsComplete( player, challenge ) && !Challenge_IsMetaChallenge( challenge ) )
					{
						challenges.append( challenge )
					}
				}
				break
			}


			case eChallengeCategory.DAILY:
				challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.DAILY )
				break

			case eChallengeCategory.TOP_WEEKLY:
				challenges = GetWeeklyChallengesSortedByProgress( player )
				break

			case eChallengeCategory.FAVORITES:
				challenges = GetFavoriteChallenges( player )
				break

			case eChallengeCategory.EVENTSHOP_DAILY_CHALLENGE:
				challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENTSHOP_DAILY_CHALLENGE )
				break

			case eChallengeCategory.EVENTSHOP_EVENT_CHALLENGE:
				challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENTSHOP_EVENT_CHALLENGE )
				break

			case eChallengeCategory.REWARD_CAMPAIGN:
				challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.REWARD_CAMPAIGN )
				break

			case eChallengeCategory.TEMP_UNLOCK:
				array<ItemFlavor> tempUnlockEvents = TempUnlock_GetActiveEvents( GetUnixTimestamp() )
				foreach( ItemFlavor tempUnlockEvent in tempUnlockEvents )
				{
					
					challenges.extend( TempUnlock_GetCharacterUnlockChallenges( tempUnlockEvent ) )
				}
				break

			case eChallengeCategory.CHALLENGE_TILE:

				ChallengeTile ornull featuredTile = ChallengeTile_GetActiveFeaturedTile()
				if ( featuredTile != null )
				{
					expect ChallengeTile( featuredTile )
					challenges = ChallengeTile_GetLobbyWidgetChallenges( featuredTile, NUM_DAILY_CHALLENGES )
				}

				break

			unreachable
		}
	}

	if ( IsLobby() && challengeCategory != eChallengeCategory.TOP_WEEKLY ) 
		Challenge_SortChallengeFlavsByProgress( challenges )

	return challenges
}



array<ItemFlavor> function GetWeeklyChallengesSortedByProgress( entity player )
{
	const NUM_CHALLENGES_TO_RETURN = NUM_DAILY_CHALLENGES

	array<ChallengeSortStruct> challengeSortArray

	PlayerChallengesState pcs = GetPlayerChallengesState( player )

	array<ItemFlavor> results
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		if ( cs.timeSpanKind == eChallengeTimeSpanKind.SEASON_WEEKLY )
		{

			Assert( cs.passIdx == -1 )


			if ( !IsChallengePlaylistEnabled( challengeFlav ) )
				continue

			if ( Challenge_IsComplete( player, challengeFlav ) )
				continue

			if ( Stats_CurrentModeSupportsCustomStats() && !Challenge_IsEitherOr( challengeFlav ) && ( Challenge_GetGameMode( challengeFlav ) == CHALLENGE_GAME_MODE_BATTLE_ROYALE || Challenge_GetGameMode( challengeFlav ) == CHALLENGE_GAME_MODE_BATTLE_ROYALE_PLUS_CASUAL_TRIOS )  )
				continue

			if ( !Stats_CurrentModeSupportsCustomStats() && !Challenge_IsEitherOr( challengeFlav ) && !Challenge_CanBeCompletedInBR( challengeFlav ) )
				continue

			int currentTier = player.GetPersistentVarAsInt( format( CHALLENGE_PVAR_KEY_FSTRING_CURRENT_TIER, cs.persistenceIdx ) )
			int goalVal     = Challenge_GetGoalVal( challengeFlav, currentTier )

			int current            = 0
			array<string> statRefs = Challenge_GetStatRefs( player, challengeFlav, currentTier )
			foreach ( string statRef in statRefs )
			{
				Assert( IsValidStatEntryRef( statRef ) )
				StatEntry entry = GetStatEntryByRef( statRef )
				Assert( entry.type == eStatType.INT )
				current += GetStat_Int( player, entry, eStatGetWhen.CURRENT )
			}

			int marker = player.GetPersistentVarAsInt( format( CHALLENGE_PVAR_KEY_FSTRING_STAT_MARKER, cs.persistenceIdx ) )

			float progressFrac = float(current - marker) / float(goalVal)

			if ( Challenge_IsEitherOr( challengeFlav ) && Stats_CurrentModeSupportsCustomStats() )
			{
				bool getAlt = true
				int markerAlt  = player.GetPersistentVarAsInt( format( CHALLENGE_PVAR_KEY_FSTRING_STAT_MARKER_ALT, cs.persistenceIdx ) )
				int goalValAlt = Challenge_GetGoalVal( challengeFlav, currentTier, getAlt )
				int currentAlt = 0

				array<string> altRefs = Challenge_GetStatRefs( player, challengeFlav, currentTier, getAlt )
				foreach ( string statRef in altRefs )
				{
					Assert( IsValidStatEntryRef( statRef ) )
					StatEntry entry = GetStatEntryByRef( statRef )
					Assert( entry.type == eStatType.INT )
					currentAlt += GetStat_Int( player, entry, eStatGetWhen.CURRENT )
				}

				progressFrac = float(currentAlt - markerAlt) / float(goalValAlt)
			}

			int activeTier           = Challenge_GetCurrentTier( player, challengeFlav )

			ChallengeSortStruct sortStruct
			sortStruct.progressFrac  = progressFrac
			sortStruct.week          = Challenge_FindAssignedWeekOrder( player, challengeFlav )
			sortStruct.difficulty    = Challenge_GetDifficulty( challengeFlav )
			sortStruct.name          = Challenge_GetDescription( challengeFlav, activeTier )
			sortStruct.challengeFlav = challengeFlav

			challengeSortArray.append( sortStruct )
		}
	}
	challengeSortArray.sort( Challenge_SortByProgress )
#if DEV
		foreach ( ChallengeSortStruct sortStruct in challengeSortArray )
		{
			printt( DEV_ItemFlavor_GetCleanedAssetPath( sortStruct.challengeFlav ) + "\t" + sortStruct.progressFrac + "\t" + sortStruct.week )
		}
#endif

	array<ItemFlavor> topWeeklyChallenges = []
	int maxSize                           = minint( NUM_CHALLENGES_TO_RETURN, challengeSortArray.len() )

	string prevDescription
	for ( int index = 0; index < challengeSortArray.len(); index++ )
	{
		ItemFlavor challenge = challengeSortArray[ index ].challengeFlav
		int challengeTier    = Challenge_GetCurrentTier( player, challenge )
		string challengeDesc = Challenge_GetDescription( challenge, challengeTier )
		if ( challengeDesc == prevDescription )
		{
			
			continue
		}

		prevDescription = challengeDesc
		topWeeklyChallenges.append( challengeSortArray[ index ].challengeFlav )

		if ( topWeeklyChallenges.len() >= maxSize )
			break
	}

	return topWeeklyChallenges
}



int function Challenge_FindAssignedWeekOrder( entity player, ItemFlavor challengeFlav )
{
	int weekIndex = Challenge_GetWeekNumber( challengeFlav )

	for ( int i = 0 ; i < NUM_CHALLENGE_WEEKS_MAX ; i++ )
	{



			int groupIndex = GetPersistentVarAsInt( "weeklyGroupOrder[" + i + "]" )

		if ( groupIndex == weekIndex )
			return i
	}

	return -1    
}



int function Challenge_SortByProgress( ChallengeSortStruct a, ChallengeSortStruct b )
{
	
	if ( a.progressFrac < b.progressFrac )
		return 1
	else if ( a.progressFrac > b.progressFrac )
		return -1

	
	if ( a.week > b.week )
		return 1
	else if ( a.week < b.week )
		return -1

	
	if ( a.difficulty > b.difficulty )
		return 1
	else if ( a.difficulty < b.difficulty )
		return -1

	
	if ( a.name > b.name )
		return 1
	else if ( a.name < b.name )
		return -1

	return 0
}



struct SortChallengeFlavsByProgressData
{
	bool challengeComplete
	float progressFrac
	int sortOrdinal
	int difficulty
	string description
}

void function Challenge_SortChallengeFlavsByProgress( array<ItemFlavor> challenges )
{
	if ( GetConVarBool( "script_enable_sort_challenge_flavs_by_progress_with_cache" ) )
	{
		if ( GetConVarBool( "script_enable_sort_challenge_flavs_by_progress_verify" ) )
		{
			array<ItemFlavor> legacyChallengesResult = clone challenges
			Challenge_SortChallengeFlavsByProgressLegacy( legacyChallengesResult )
			Challenge_SortChallengeFlavsByProgressWithCache( challenges )
			Assert( legacyChallengesResult.len() == challenges.len() )
			for ( int i = 0; i < challenges.len(); ++i )
				Assert( challenges[i].guid == legacyChallengesResult[i].guid )
		}
		else
			Challenge_SortChallengeFlavsByProgressWithCache( challenges )
	}
	else
		Challenge_SortChallengeFlavsByProgressLegacy( challenges )
}

void function Challenge_SortChallengeFlavsByProgressWithCache( array<ItemFlavor> challenges )
{
	PerfStart( PerfIndexClient.SortChalFlavsByProgCache )

	entity player = GetLocalClientPlayer()

	table< SettingsAssetGUID, SortChallengeFlavsByProgressData> sortDataCache

	foreach ( ItemFlavor challengeFlav in challenges )
	{
		SortChallengeFlavsByProgressData data
		data.challengeComplete = Challenge_IsComplete( player, challengeFlav )
		data.progressFrac = 0
		if ( !data.challengeComplete )
		{
			int currentTier     = Challenge_GetCurrentTier( player, challengeFlav )
			int currentProgress = Challenge_GetProgressValue( player, challengeFlav, currentTier )
			int goalProgress    = Challenge_GetGoalVal( challengeFlav, currentTier )
			if ( goalProgress != 0 )
				data.progressFrac = float(currentProgress) / goalProgress
		}

		data.sortOrdinal = Challenge_GetSortOrdinal( challengeFlav )
		data.difficulty = Challenge_GetDifficulty( challengeFlav )

		int currentDisplayableTier = Challenge_GetCurrentDisplayableTier( player, challengeFlav )
		data.description = Challenge_GetDescription( challengeFlav, currentDisplayableTier )

		sortDataCache[challengeFlav.guid] <- data
	}

	challenges.sort( int function ( ItemFlavor challengeFlavA, ItemFlavor challengeFlavB ) : ( sortDataCache ) {

		SortChallengeFlavsByProgressData sortDataA = sortDataCache[challengeFlavA.guid]
		SortChallengeFlavsByProgressData sortDataB = sortDataCache[challengeFlavB.guid]
		bool challengeAComplete = sortDataA.challengeComplete
		bool challengeBComplete = sortDataB.challengeComplete
		if ( challengeAComplete && !challengeBComplete )
			return 1
		else if ( !challengeAComplete && challengeBComplete )
			return -1
		else if ( !challengeAComplete && !challengeBComplete )
		{
			float progressFracA  = sortDataA.progressFrac
			float progressFracB  = sortDataB.progressFrac
			if ( progressFracA > progressFracB )
				return -1
			else if ( progressFracA < progressFracB )
				return 1
		}

		int sortOrdinalA = sortDataA.sortOrdinal
		int sortOrdinalB = sortDataB.sortOrdinal
		if ( sortOrdinalA < sortOrdinalB )
			return -1
		else if ( sortOrdinalA > sortOrdinalB )
			return 1

		int difficultyA = sortDataA.difficulty
		int difficultyB = sortDataB.difficulty
		if ( difficultyA > difficultyB )
			return 1
		else if ( difficultyA < difficultyB )
			return -1

		string descriptionA = sortDataA.description
		string descriptionB = sortDataB.description
		if ( descriptionA > descriptionB )
			return 1
		else if ( descriptionA < descriptionB )
			return -1

		return 0
	} )

	PerfEnd( PerfIndexClient.SortChalFlavsByProgCache )
}

void function Challenge_SortChallengeFlavsByProgressLegacy( array<ItemFlavor> challenges )
{
	PerfStart( PerfIndexClient.SortChalFlavsByProgLegacy )
	challenges.sort( Challenge_SortChallengeFlavsByProgressLegacyCmp )
	PerfEnd( PerfIndexClient.SortChalFlavsByProgLegacy )
}

int function Challenge_SortChallengeFlavsByProgressLegacyCmp( ItemFlavor challengeFlavA, ItemFlavor challengeFlavB )
{
	entity player = GetLocalClientPlayer()

	bool challengeAComplete = Challenge_IsComplete( player, challengeFlavA )
	bool challengeBComplete = Challenge_IsComplete( player, challengeFlavB )

	if ( challengeAComplete && !challengeBComplete )
		return 1
	else if ( !challengeAComplete && challengeBComplete )
		return -1
	else if ( !challengeAComplete && !challengeBComplete )
	{
		
		int currentTierA     = Challenge_GetCurrentTier( player, challengeFlavA )
		int currentProgressA = Challenge_GetProgressValue( player, challengeFlavA, currentTierA )
		int goalProgressA    = Challenge_GetGoalVal( challengeFlavA, currentTierA )

		int currentTierB     = Challenge_GetCurrentTier( player, challengeFlavB )
		int currentProgressB = Challenge_GetProgressValue( player, challengeFlavB, currentTierB )
		int goalProgressB    = Challenge_GetGoalVal( challengeFlavB, currentTierB )

		float progressFracA  = float(currentProgressA) / float(goalProgressA)
		float progressFracB  = float(currentProgressB) / float(goalProgressB)
		if ( progressFracA > progressFracB )
			return -1
		else if ( progressFracA < progressFracB )
			return 1
	}

	return Challenge_SortSameProgressChallenges( challengeFlavA, challengeFlavB )
}



int function Challenge_SortSameProgressChallenges( ItemFlavor challengeFlavA, ItemFlavor challengeFlavB )
{
	Assert( ItemFlavor_GetType( challengeFlavA ) == eItemType.challenge )
	Assert( ItemFlavor_GetType( challengeFlavB ) == eItemType.challenge )

	
	int sortOrdinalA = Challenge_GetSortOrdinal( challengeFlavA )
	int sortOrdinalB = Challenge_GetSortOrdinal( challengeFlavB )
	if ( sortOrdinalA < sortOrdinalB )
		return -1
	else if ( sortOrdinalA > sortOrdinalB )
		return 1

	
	int difficultyA = Challenge_GetDifficulty( challengeFlavA )
	int difficultyB = Challenge_GetDifficulty( challengeFlavB )
	if ( difficultyA > difficultyB )
		return 1
	else if ( difficultyA < difficultyB )
		return -1


		
		int tierA = Challenge_GetCurrentDisplayableTier( GetLocalClientPlayer(), challengeFlavA )
		int tierB = Challenge_GetCurrentDisplayableTier( GetLocalClientPlayer(), challengeFlavB )
		string nameA = Challenge_GetDescription( challengeFlavA, tierA )
		string nameB = Challenge_GetDescription( challengeFlavB, tierB )

		if ( nameA > nameB )
			return 1
		else if ( nameA < nameB )
			return -1


	return 0
}








































































































void function ServerToUI_RefreshCompletedChallengeUI( SettingsAssetGUID challengeGUID )
{
	Assert( IsValidItemFlavorGUID( challengeGUID ), "Invalid Challenge GUID received. Script RPC lib should have dropped this call." ) 

	ItemFlavor challengeFlav = GetItemFlavorByGUID( challengeGUID )
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )
	if ( ItemFlavor_GetType( challengeFlav ) != eItemType.challenge )
	{
		printt( format( "Received a non-challenge ItemFlav %d", challengeGUID ) )
		return
	}

	if ( !Challenge_ShouldTrackProgressInLobby( challengeFlav ) )
	{
		printt( format( "Attempted to wait for challenge ( GUID %d ) to complete when it wasn't configured to track progress in lobby. ", challengeGUID ) )
		return
	}
	thread WaitForChallengeCompletion_Thread( challengeFlav )
}

void function WaitForChallengeCompletion_Thread( ItemFlavor challengeFlav )
{
	
	const int MAX_CHALLENGE_WAIT_TIMEOUT = 60
	int framesWaited = 0
	while ( !Challenge_IsComplete( GetLocalClientPlayer(), challengeFlav ) && framesWaited < MAX_CHALLENGE_WAIT_TIMEOUT )
	{
		framesWaited++
		WaitFrame()
	}


	if ( framesWaited < MAX_CHALLENGE_WAIT_TIMEOUT )
	{
		ChallengeTile_RefreshTiles()
	}

}
































































































void function UpdateFavoriteChallengesCache( entity player )
{
	Assert( IsValid( player ) )

	if ( player != GetLocalClientPlayer() )
		return

	fileLevel.favoriteChallengeCache.clear()
	for ( int index = 0; index < NUM_FAVORITE_CHALLENGES; index++ )
	{
		SettingsAssetGUID challengeGUID = player.GetPersistentVarAsInt( format( "favoriteChallengeGUID[%d]", index ) )
		if ( !IsValidItemFlavorGUID( challengeGUID ) )
			continue

		ItemFlavor challengeFlav = GetItemFlavorByGUID( challengeGUID )

		if ( !IsChallengeValidAsFavorite( player, challengeFlav ) )
			continue

		fileLevel.favoriteChallengeCache.append( challengeFlav )
	}
}



bool function HasFavoriteChallenges()
{
	return fileLevel.favoriteChallengeCache.len() > 0
}



bool function IsFavoriteChallenge( ItemFlavor challengeFlav )
{
	foreach ( ItemFlavor challenge in fileLevel.favoriteChallengeCache )
	{
		if ( challenge == challengeFlav )
			return true
	}
	return false
}



array<ItemFlavor> function GetFavoriteChallenges( entity player )
{
	return clone fileLevel.favoriteChallengeCache
}


bool function IsChallengeValidAsFavorite( entity player, ItemFlavor challengeFlav )
{
	if ( !Challenge_IsAssigned( player, challengeFlav ) )
		return false
	if ( Challenge_IsComplete( player, challengeFlav ) )
		return false
	if ( !IsChallengePlaylistEnabled( challengeFlav ) )
		return false
	if ( !Challenge_GetTrackingAllowed( challengeFlav ) )
		return false
	if ( Challenge_IsMetaChallenge( challengeFlav ) )
		return false

	return true
}


bool function Challenge_CanToggleFavoriteState( entity player, ItemFlavor challengeFlav )
{
	
	if ( IsFavoriteChallenge( challengeFlav ) )
		return true

	return IsChallengeValidAsFavorite( player, challengeFlav )
}






































































