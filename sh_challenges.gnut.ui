array<int> function GetChallengeCategoryIDArray( bool hideInMinimap = false )
{
	array<int> categoryIDtoStringArray = []

	array<ItemFlavor> allBeginnerChallenges = GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.BEGINNER )
	if ( allBeginnerChallenges.len() > 0 && PlayerPass_IsActive( GetLocalClientPlayer(), ePassType.NEWPLAYER ) )
		categoryIDtoStringArray.append( eChallengeCategory.BEGINNER )

	array<ItemFlavor> allReturningPlayerChallenges = GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.RETURNING_PLAYER )
	if ( allReturningPlayerChallenges.len() > 0 && ReturningPlayerChallenges_GetPlayerCompletedChallengeCount( GetLocalClientPlayer() ) < allReturningPlayerChallenges.len() && PlayerPass_IsActive( GetLocalClientPlayer(), ePassType.RETURNING_PLAYER ) )
		categoryIDtoStringArray.append( eChallengeCategory.RETURNING_PLAYER )


	array<ItemFlavor> allRTRChallenges = GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.ROAD_TO_RANKED )
	if ( GetConVarBool( RANKED_ENABLE_ROAD_TO_RANKED ) && allRTRChallenges.len() > 0 )
		categoryIDtoStringArray.append( eChallengeCategory.ROAD_TO_RANKED )



	if( !hideInMinimap )
	{
		array<ItemFlavor> allRankedChallenges = []
		if ( GetConVarBool( RANKED_REWARD_HAS_MIN_MATCH_REQUIREMENT ) )
			allRankedChallenges.extend( GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.RANKED_REWARD ) )
		if ( GetConVarBool( RANKED_EVENT_CONVAR ) )
			allRankedChallenges.extend( GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.RANKED_EVENT_CHAMPION ) )
		if ( allRankedChallenges.len() > 0 )
			categoryIDtoStringArray.append( eChallengeCategory.RANKED )
	}


	
	int eventIdx = eChallengeCategory.EVENT_00
	foreach ( event in fileLevel.currentEvents )
	{
		Assert( IsEventCategory( eventIdx ) )
		categoryIDtoStringArray.append( eventIdx++ )
	}

	if ( EventShop_CurrentActiveEventShopHasDailyChallenges() )
	{
		categoryIDtoStringArray.append( eChallengeCategory.EVENTSHOP_DAILY_CHALLENGE )
	}

	if ( EventShop_CurrentActiveEventShopHasEventChallenges() )
	{
		ItemFlavor ornull activeEventShop = EventShop_GetCurrentActiveEventShop()
		if ( EventShop_GetShowEventChallengesInLobby( expect ItemFlavor(activeEventShop) ) )
		{
			categoryIDtoStringArray.append( eChallengeCategory.EVENTSHOP_EVENT_CHALLENGE )
		}
	}

	ItemFlavor ornull activeRewardCampaign = RewardCampaign_GetActiveRewardCampaign()
	if ( activeRewardCampaign != null )
	{
		expect ItemFlavor( activeRewardCampaign )

		array<ItemFlavor> collectionFlavs = RewardCampaign_GetChallengeCollections( activeRewardCampaign )
		foreach( collectionFlav in collectionFlavs )
		{
			ChallengeCollection activeCollection = ChallengeCollection_GetByGUID( collectionFlav.guid )
			if ( ChallengeCollection_HasChallenges( activeCollection ) )
			{
				categoryIDtoStringArray.append( eChallengeCategory.REWARD_CAMPAIGN )
			}
		}












	}



	ChallengeTile ornull featuredTile = ChallengeTile_GetActiveFeaturedTile()
	if ( featuredTile != null )
	{
		if ( ChallengeTile_GetLobbyWidgetChallenges( expect ChallengeTile( featuredTile ), NUM_DAILY_CHALLENGES ).len() > 0 )
		{
			categoryIDtoStringArray.append( eChallengeCategory.CHALLENGE_TILE )
		}
	}



	array<ItemFlavor> tempUnlockChallenges = TempUnlock_GetCurrentCharacterUnlockChallenges( GetLocalClientPlayer() )
	if ( tempUnlockChallenges.len() > 0 )
	{
		categoryIDtoStringArray.append( eChallengeCategory.TEMP_UNLOCK )
	}

	
	if( !hideInMinimap )
	{
		int storyIdx = eChallengeCategory.STORY_00
		foreach ( story in fileLevel.currentStories )
		{
			if( StoryEvent_GetShowInChallengeBoxBool( story ) )
			{
				Assert( IsStoryCategory( storyIdx ) )
				categoryIDtoStringArray.append( storyIdx++ )
			}
		}
	}

	bool hasFavorites = HasFavoriteChallenges()
	if ( hasFavorites )
		categoryIDtoStringArray.append( eChallengeCategory.FAVORITES )

	categoryIDtoStringArray.extend( [ eChallengeCategory.DAILY, eChallengeCategory.TOP_WEEKLY ] )

	return categoryIDtoStringArray
}

void function UpdateChallengeCategorySelection( var rui, bool longName = false, bool hideInMinimap = false )
{
	
	if ( !IsFullyConnected() )
		return

	array<int> categoryIDtoStringArray = GetChallengeCategoryIDArray( hideInMinimap )
	int selectionSlots                 = categoryIDtoStringArray.len()
	

	int newSelectionIndex = ClampInt( fileLevel._challengeCategorySelectionIndex, 0, selectionSlots )
	fileLevel._challengeCategorySelectionIndex = newSelectionIndex

	string category = GetCategoryStringFromType( categoryIDtoStringArray[ newSelectionIndex ], longName )
	RuiSetInt( rui, "selectionSlots", selectionSlots )    
	RuiSetInt( rui, "selectionID", newSelectionIndex ) 
	RuiSetString( rui, "selectionText", category ) 






		int currCat = GetChallengeDisplayCategory( hideInMinimap )
		if ( IsEventCategory( currCat ) )
		{
			int timestamp                  = GetUnixTimestamp()
			ItemFlavor ornull currentEvent = GetActiveBuffetEventForCategory( timestamp, currCat )

			
			if ( currentEvent == null )
			{
				RuiSetGameTime( rui, "expireTime", RUI_BADGAMETIME )
				RuiSetBool( rui, "eventActive", false )
				return
			}

			Assert( currentEvent != null )
			expect ItemFlavor( currentEvent )
			Assert( ItemFlavor_GetType( currentEvent ) == eItemType.calevent_buffet )

			int endTime           = CalEvent_GetFinishUnixTime( currentEvent )
			int remainingDuration = endTime - GetUnixTimestamp()

			RuiSetGameTime( rui, "expireTime", remainingDuration > 0 ? ClientTime() + remainingDuration : RUI_BADGAMETIME )
			RuiSetBool( rui, "eventActive", true )
		}
		else if ( IsStoryCategory( currCat ) )
		{
			int timestamp                  = GetUnixTimestamp()
			ItemFlavor ornull currentEvent = GetActiveStoryEventForCategory( timestamp, currCat )

			
			if ( currentEvent == null )
			{
				RuiSetGameTime( rui, "expireTime", RUI_BADGAMETIME )
				RuiSetBool( rui, "eventActive", false )
				return
			}

			Assert( currentEvent != null )
			expect ItemFlavor( currentEvent )
			Assert( ItemFlavor_GetType( currentEvent ) == eItemType.calevent_story_challenges )

			int endTime           = CalEvent_GetFinishUnixTime( currentEvent )
			int remainingDuration = endTime - GetUnixTimestamp()

			RuiSetGameTime( rui, "expireTime", remainingDuration > 0 ? ClientTime() + remainingDuration : RUI_BADGAMETIME )
			RuiSetBool( rui, "eventActive", true )
		}

		else if ( IsChallengeTileCategory( currCat ) )
		{
			int timestamp = GetUnixTimestamp()
			ChallengeTile ornull featuredTile = ChallengeTile_GetActiveFeaturedTile()

			if ( featuredTile == null )
			{
				RuiSetGameTime( rui, "expireTime", RUI_BADGAMETIME )
				RuiSetBool( rui, "eventActive", false )
				return
			}
			expect ChallengeTile( featuredTile )

			int remainingDuration = featuredTile.endDate - GetUnixTimestamp()

			RuiSetGameTime( rui, "expireTime", remainingDuration > 0 ? ClientTime() + remainingDuration : RUI_BADGAMETIME )
			RuiSetBool( rui, "eventActive", true )
		}

		else
		{
			RuiSetString( rui, "beginnerChallengeCount", "" )
			RuiSetString( rui, "returningPlayerChallengeCount", "" )
			RuiSetGameTime( rui, "expireTime", RUI_BADGAMETIME )
			RuiSetBool( rui, "eventActive", false )

			switch( currCat )
			{

				case eChallengeCategory.BEGINNER:
					entity player = GetLocalClientPlayer()
					string beginnerChallengeCount = PlayerPass_LocalizeCompletedOfTotalString( player, ePassType.NEWPLAYER )
					RuiSetString( rui, "beginnerChallengeCount", beginnerChallengeCount )
					break

				case eChallengeCategory.RETURNING_PLAYER:
					entity player = GetLocalClientPlayer()
					string returningPlayerChallengeCount = PlayerPass_LocalizeCompletedOfTotalString( player, ePassType.RETURNING_PLAYER )
					RuiSetString( rui, "returningPlayerChallengeCount", returningPlayerChallengeCount )
					break
				case eChallengeCategory.DAILY:
					int remainingDuration = GetPersistentVarAsInt( "dailyExpirationTime" ) - GetDailyResetAlignedTime()
					RuiSetGameTime( rui, "expireTime", remainingDuration > 0 ? ClientTime() + remainingDuration : RUI_BADGAMETIME )
					RuiSetBool( rui, "eventActive", false )
					break

				case eChallengeCategory.EVENTSHOP_DAILY_CHALLENGE:
					int remainingDuration = GetPersistentVarAsInt( "dailyExpirationTime" ) - GetDailyResetAlignedTime()
					RuiSetGameTime( rui, "expireTime", remainingDuration > 0 ? ClientTime() + remainingDuration : RUI_BADGAMETIME )
					RuiSetBool( rui, "eventActive", true )
					break

				case eChallengeCategory.TEMP_UNLOCK:
				case eChallengeCategory.EVENTSHOP_EVENT_CHALLENGE:
				case eChallengeCategory.REWARD_CAMPAIGN:
					RuiSetBool( rui, "eventActive", true )
					break
			}
		}

}



void function SetChallengeCategory()
{
	
	bool functionref( int ) ChallengeCategoryIDCheck = IsEventCategory

	if ( file.hasCompletedEventDailies || file.hasCompletedEventEntirely )
	{
		ChallengeCategoryIDCheck = IsPreferredCalendarCategory
	}

	array<int> categoryIDArray = GetChallengeCategoryIDArray()
	foreach ( int index, int categoryID in categoryIDArray )
	{
		if ( ChallengeCategoryIDCheck( categoryID ) )
		{
			fileLevel._challengeCategorySelectionIndex = index
			break
		}
	}

	
	if ( CanRunClientScript() )
		RunClientScript( "UpdateClientCategorySelectionIndexFromUI", fileLevel._challengeCategorySelectionIndex )
}










void function UpdateChallengeCategoryTint( ItemFlavor ornull event, var challengeCatergoryLeft, var challengeCatergorySelection, var challengeCatergoryRight, var allChallengesButton )
{
	SeasonStyleData seasonStyle = GetSeasonStyle()

	array<var> ruiArray
	ruiArray.append( Hud_GetRui( challengeCatergoryLeft ) )
	ruiArray.append( Hud_GetRui( challengeCatergorySelection ) )
	ruiArray.append( Hud_GetRui( challengeCatergoryRight ) )
	ruiArray.append( Hud_GetRui( allChallengesButton ) )

	vector tint = <1, 1, 1>
	if ( IsEventCategory( GetChallengeDisplayCategory() ) )
	{
		Assert( event != null )
		expect ItemFlavor( event )
		tint = BuffetEvent_GetCategoryButtonTint( event )
	}

	RuiSetColorAlpha( Hud_GetRui( allChallengesButton ), "seasonColor", SrgbToLinear( seasonStyle.seasonNewColor ), 1.0 )

	foreach ( var rui in ruiArray )
	{
		RuiSetFloat3( rui, "backgroundTint", tint )
	}
}



int function GetCategorySelectionSize( bool hideInMinimap = false )
{
	array<int> categoryArray = GetChallengeCategoryIDArray( hideInMinimap )
	return categoryArray.len()
}



void function IncrementCategorySelection(  bool hideInMinimap = false, var button = null )
{
	if ( !IsFullyConnected() )
		return

	int newSelection = (fileLevel._challengeCategorySelectionIndex + 1) % GetCategorySelectionSize( hideInMinimap )
	fileLevel._challengeCategorySelectionIndex = newSelection
}



void function DecrementCategorySelection( bool hideInMinimap = false, var button = null )
{
	if ( !IsFullyConnected() )
		return

	int newSelection = (GetCategorySelectionSize( hideInMinimap ) + fileLevel._challengeCategorySelectionIndex - 1) % GetCategorySelectionSize( hideInMinimap )
	fileLevel._challengeCategorySelectionIndex = newSelection
}



int function GetChallengeDisplayCategory( bool hideInMinimap = false )
{
	
	array<int> categoryIDtoStringArray = GetChallengeCategoryIDArray( hideInMinimap )
	int maxCategories = categoryIDtoStringArray.len()

	if ( fileLevel._challengeCategorySelectionIndex >= maxCategories )
	{
		Warning( "Cached _challengeCategorySelectionIndex(%i) does not index ChallengeCategory array (%i)\n", fileLevel._challengeCategorySelectionIndex, maxCategories )
		fileLevel._challengeCategorySelectionIndex = 0
	}

	return categoryIDtoStringArray[ fileLevel._challengeCategorySelectionIndex ]
}



string function GetCategoryStringFromType( int categoryID, bool longName = false )
{
	string appendStr = longName ? "_CHALLENGES" : ""

	if ( IsEventCategory( categoryID ) )
	{
		return "#CATEGORY_EVENT" + appendStr
	}
	else if ( IsStoryCategory( categoryID ) )
	{
		return "#CATEGORY_STORY" + appendStr
	}
	else
	{
		switch( categoryID )
		{
			case eChallengeCategory.BEGINNER:
				return "#CATEGORY_BEGINNER" + appendStr
				break
			case eChallengeCategory.RETURNING_PLAYER:
				return "#CATEGORY_RETURNING_PLAYER" + appendStr
				break

			case eChallengeCategory.ROAD_TO_RANKED:
				return "#ROAD_TO_RANKED" + appendStr
				break


			case eChallengeCategory.RANKED:
				return "#CATEGORY_RANKED" + appendStr
				break

			case eChallengeCategory.DAILY:
				return "#CATEGORY_DAILY" + appendStr
				break

			case eChallengeCategory.TOP_WEEKLY:
				return "#CATEGORY_TOP_WEEKLY" + appendStr
				break

			case eChallengeCategory.FAVORITES:
				return "#CATEGORY_FAVORITES" + appendStr
				break

			case eChallengeCategory.EVENTSHOP_DAILY_CHALLENGE:
				return "#CATEGORY_REWARD_SHOP_DAILY" + appendStr
				break

			case eChallengeCategory.EVENTSHOP_EVENT_CHALLENGE:
				return "#CATEGORY_REWARD_SHOP_EVENT" + appendStr
				break

			case eChallengeCategory.REWARD_CAMPAIGN:
				return "#UNLOCK_LEGENDS" + appendStr

			case eChallengeCategory.TEMP_UNLOCK:
				return "#UNLOCK_LEGEND"

			case eChallengeCategory.CHALLENGE_TILE:
				return "#CATEGORY_EVENT" + appendStr

		}
	}

	unreachable
}



void function SetSeasonColors( var rui )
{
	ShChallenges_RefreshCachedSeasonInfo()

	ItemFlavor ornull season = fileLevel.currentSeason.calEventOrNull

	if ( season != null )
	{
		expect ItemFlavor( season )

		RuiSetFloat3( rui, "seasonColor", Season_GetTabBGSelectedCol( season ) )
	}
}



array<var> function GetLobbyChallengeButtons()
{
	var progressionPanel = GetLobbyProgressionPanel()

	array<var> buttons
	for ( int rowIdx = 0; rowIdx < NUM_DAILY_CHALLENGES; rowIdx++ )
		buttons.append( Hud_GetChild( progressionPanel, "ChallengeButton" + rowIdx ) )

	return buttons
}

array<var> function GetLobbyStoryChallengeButtons()
{
	var progressionPanel = GetLobbyProgressionPanel()

	array<var> buttons
	for ( int rowIdx = 0; rowIdx < 1; rowIdx++ )
		buttons.append( Hud_GetChild( progressionPanel, "StoryChallengeButton" + rowIdx ) )

	return buttons
}











array<ChallengeGroupData> function GetPlayerChallengeGroupData( entity player )
{
	Assert( player == GetLocalClientPlayer() )
	array<ChallengeGroupData> groupData
	array<ItemFlavor> challenges = []


	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.BEGINNER )
	if( challenges.len() > 0 )
		groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_BEGINNER" ), challenges, eChallengeTimeSpanKind.BEGINNER ) )


	if( ReturningPlayerChallenges_IsActive() )
	{
		challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.RETURNING_PLAYER )
		if( challenges.len() > 0 && ReturningPlayerChallenges_GetPlayerCompletedChallengeCount( GetLocalClientPlayer() ) < challenges.len() )
			groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_RETURNING_PLAYER" ), challenges, eChallengeTimeSpanKind.RETURNING_PLAYER ) )
	}

	
	foreach ( event in fileLevel.currentEvents )
	{
		challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT, -1, event )
		ChallengeGroupData g = CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_EVENT" ), challenges, eChallengeTimeSpanKind.EVENT )
		g.event = event
		groupData.append( g )
	}

	
	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_HIDDEN ) 
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_EVENT_REWARD" ), challenges, eChallengeTimeSpanKind.EVENT_HIDDEN ) ) 

	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_SPECIAL_2 ) 
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_EVENT_SPECIAL" ), challenges, eChallengeTimeSpanKind.EVENT_SPECIAL_2 ) )

	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_SPECIAL )
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_EVENT_SPECIAL" ), challenges, eChallengeTimeSpanKind.EVENT_SPECIAL ) )

	
	ItemFlavor ornull currentEventShop = EventShop_GetCurrentActiveEventShop()
	if ( currentEventShop != null )
	{
		expect ItemFlavor( currentEventShop )
		array< ItemFlavor > currentDailyEventShopChallenges = EventShop_GetCurrentActiveEventShopDailyChallenges()
		array< ItemFlavor > currentAssignedDailyEventShopChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENTSHOP_DAILY_CHALLENGE, -1, currentEventShop )

		Assert( currentDailyEventShopChallenges.len() == currentAssignedDailyEventShopChallenges.len(), "Event shop API & assigned Daily challenges API did not return arrays of equal length.")

		array< ItemFlavor > currentEventEventShopChallenges = EventShop_GetCurrentActiveEventShopEventChallenges()
		array< ItemFlavor > currentAssignedEventEventShopChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENTSHOP_EVENT_CHALLENGE, -1, currentEventShop )

		Assert( currentEventEventShopChallenges.len() == currentAssignedEventEventShopChallenges.len(), "Event shop API & assigned Event challenges API did not return arrays of equal length.")

		EventShopData data = EventShop_GetEventShopData( currentEventShop )
		groupData.append( CreateChallengeGroup( player, Localize( data.eventShopButtonText ), currentAssignedDailyEventShopChallenges, eChallengeTimeSpanKind.EVENTSHOP_DAILY_CHALLENGE ) )
		groupData.append( CreateChallengeGroup( player, Localize( data.eventShopButtonText ), currentAssignedEventEventShopChallenges, eChallengeTimeSpanKind.EVENTSHOP_EVENT_CHALLENGE ) )
	}

	
	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.REWARD_CAMPAIGN )
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_EVENT_REWARD_CAMPAIGN" ), challenges, eChallengeTimeSpanKind.REWARD_CAMPAIGN ) )

	challenges = GetAssignedChallengesByTimeSpan( GetLocalClientPlayer(), eChallengeTimeSpanKind.DAILY )
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_DAILY" ), challenges, eChallengeTimeSpanKind.DAILY ) )

	
	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING )
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_SEASON_WEEKLY_RECURRING" ), challenges, eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING ) )

	
	for ( int i = 0 ; i < NUM_CHALLENGE_WEEKS_MAX ; i++ )
	{
		int groupIndex = GetPersistentVarAsInt( "weeklyGroupOrder[" + i + "]" )
		if ( groupIndex == 0 )
			break 
		challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.SEASON_WEEKLY, groupIndex )
		if ( challenges.len() > 0 )
			groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_WEEKLY", i + 1 ), challenges, eChallengeTimeSpanKind.SEASON_WEEKLY ) )
	}

	
	challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.MYTHIC )
	groupData.append( CreateChallengeGroup( player, Localize( "#CHALLENGE_GROUP_MYTHIC" ), challenges, eChallengeTimeSpanKind.MYTHIC ) )

	
	challenges = GetFavoriteChallenges( player )
	groupData.append( CreateChallengeGroup( player, Localize( "#CATEGORY_FAVORITES" ), challenges, eChallengeTimeSpanKind.FAVORITE ) )

	return groupData
}




void function Challenge_IterateAssignedWeeklyChallenges( entity player, void functionref ( int, int, array<ItemFlavor> ) weekCallback )
{
	for ( int i = 0 ; i < NUM_CHALLENGE_WEEKS_MAX ; i++ )
	{
		int groupIndex = GetPersistentVarAsInt( "weeklyGroupOrder[" + i + "]" )
		if ( groupIndex == 0 )
			break 
		array<ItemFlavor> challenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.SEASON_WEEKLY, groupIndex )
		weekCallback( i, groupIndex, challenges )
	}
}



array<ItemFlavor> function GetPinnedChallenges()
{
	PlayerChallengesState pcs = GetPlayerChallengesState( GetLocalClientPlayer() )

	array<ItemFlavor> pinnedChallenges
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		if ( Challenge_IsPinned( challengeFlav ) )
			pinnedChallenges.append( challengeFlav )
	}

	return pinnedChallenges
}



array<ItemFlavor> function GetLocalPinnedChallenges()
{
	PlayerChallengesState pcs = GetPlayerChallengesState( GetLocalClientPlayer() )

	array<ItemFlavor> pinnedChallenges
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		if ( Challenge_IsPinnedLocal( challengeFlav ) )
			pinnedChallenges.append( challengeFlav )
	}

	return pinnedChallenges
}



array<ItemFlavor> function GetLocalPinnedChallengesForKind( int kind )
{
	array<ItemFlavor> pinnedChallenges

	foreach ( ItemFlavor challengeFlav in GetLocalPinnedChallenges() )
	{
		if ( Challenge_GetTimeSpanKindFromBakery( challengeFlav ) == kind )
		{
			pinnedChallenges.append( challengeFlav )
		}
	}

	return pinnedChallenges
}



















































































































































































































































































































































































































































































































































































































































PlayerChallengesState function GetPlayerChallengesState( entity player = null )
{
	player = AssertLocalOrServerValidPlayer( player )



		return fileLevel.localPlayerChallengesState

}

void function InitPlayerChallengesStateFromPersistence( entity player, PlayerChallengesState pcs )
{
	if ( !IsValid( player ) )
		return

#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return
#endif

	foreach ( ChallengeState ornull cs in pcs.persistentArrayMirror )
	{
		if ( cs == null )
			continue
		expect ChallengeState(cs)
		cs.persistenceIdx = -1
		ItemFlavor badItemFlav
		cs.flav = badItemFlav
		cs.timeSpanKind = eChallengeTimeSpanKind.INVALID
	}
	pcs.persistentArrayMirror.clear()
	pcs.persistentArrayMirror.resize( NUM_CHALLENGES_MAX, null )
	pcs.challengeStateMap.clear()





	for ( int persistentArrayIdx = 0 ; persistentArrayIdx < NUM_CHALLENGES_MAX ; persistentArrayIdx++ )
	{
		int guid                        = player.GetPersistentVarAsInt( format( CHALLENGE_PVAR_KEY_FSTRING_GUID, persistentArrayIdx ) )
		ItemFlavor ornull challengeFlav = GetItemFlavorOrNullByGUID( guid, eItemType.challenge )
		if ( challengeFlav == null )
		{
			if ( guid > 0 )
			{







			}
			continue
		}
		expect ItemFlavor( challengeFlav )

		if ( !Challenge_IsPlayerChallengeMigrationValid( player, challengeFlav ) )
		{






			continue
		}

		ChallengeState cs
		cs.persistenceIdx = persistentArrayIdx
		cs.flav = challengeFlav
		cs.timeSpanKind = Challenge_GetTimeSpanKindFromBakery( challengeFlav )
		pcs.challengeStateMap[cs.flav] <- cs
		pcs.persistentArrayMirror[persistentArrayIdx] = cs
	}


	for ( int passArrayIdx = 0 ; passArrayIdx < NUM_ACTIVE_PLAYER_PASSES ; passArrayIdx++ )
	{
		int passGuid = player.GetPersistentVarAsInt( format( PASSES_PVAR_KEY_FSTRING_GUID, passArrayIdx ) )
		if( passGuid == 0 )
			continue

		Assert( IsValidItemFlavorGUID( passGuid ) )
		ItemFlavor passFlav = GetItemFlavorByGUID( passGuid )

		for ( int persistentArrayIdx = 0 ; persistentArrayIdx < NUM_CHALLENGES_PER_PASS ; persistentArrayIdx++ )
		{
			string persistenceKeyPrefix     = format( PASSES_CHALLENGES_PVAR_KEY_FSTRING, passArrayIdx, persistentArrayIdx )
			int guid                        = player.GetPersistentVarAsInt( persistenceKeyPrefix + CHALLENGE_PVAR_KEY_GUID )
			ItemFlavor ornull challengeFlav = GetItemFlavorOrNullByGUID( guid, eItemType.challenge )
			if ( challengeFlav == null )
			{
				if ( guid > 0 )
				{







				}
				continue
			}
			expect ItemFlavor( challengeFlav )

			ChallengeState cs
			cs.persistenceIdx = persistentArrayIdx
			cs.passIdx = passArrayIdx
			cs.flav = challengeFlav
			cs.pass = passFlav
			cs.timeSpanKind = eChallengeTimeSpanKind.PLAYER_PASS

			pcs.challengeStateMap[cs.flav] <- cs
		}
	}






























}

bool function Challenge_IsChallengesStateInititated( entity player )
{





	PlayerChallengesState pcs = GetPlayerChallengesState( player )
	return pcs.challengeStateMap.len() > 0
}


































































































































































































































































































































































































































































































