bool function Challenge_IsPlayerChallengeMigrationValid( entity player, ItemFlavor challengeFlav )
{
	if ( !Challenge_IsMigrationChallenge( challengeFlav ) )
		return true

	int playerVersion = player.GetPersistentVarAsInt( "challengeMigrationVersion" )
	int minVersion = Challenge_GetMinMigrationVersion( challengeFlav )
	int endVersion = Challenge_GetEndMigrationVersion( challengeFlav )

	if ( playerVersion >= minVersion && ( endVersion == 0 || playerVersion < endVersion ) )
		return true

	return false
}