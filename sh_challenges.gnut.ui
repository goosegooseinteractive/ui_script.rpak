bool function Challenge_IsUsingBitfieldStatrefs( entity player, ItemFlavor challengeFlav, int tier, bool getAlt )
{
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )
	Assert( tier >= 0 && tier < Challenge_GetTierCount( challengeFlav ) )

	if ( !Challenge_IsAssigned( player, challengeFlav ) || Challenge_IsComplete( player, challengeFlav ) )
	{
		return false
	}

	array<string> statRefs = Challenge_GetStatRefs( player, challengeFlav, tier, getAlt )
	foreach ( string statRef in statRefs )
	{
		StatEntry entry = GetStatEntryByRef( statRef )
		if ( entry.behavior == eStatBehavior.BITFIELD )
		{
			return true
		}
	}

	return false
}

