bool function Challenge_CanBeCompletedInBR( ItemFlavor flavor )
{
	if ( Challenge_IsEitherOr( flavor ) )
		return true

	if ( Challenge_GetGameMode( flavor) == CHALLENGE_GAME_MODE_BATTLE_ROYALE || Challenge_GetGameMode( flavor) == CHALLENGE_GAME_MODE_BATTLE_ROYALE_PLUS_CASUAL_TRIOS )
		return true

	if ( Challenge_GetGameMode( flavor) == CHALLENGE_GAME_MODE_ANY || Challenge_GetGameMode( flavor) == CHALLENGE_GAME_MODE_ANY_PLUS_CASUAL_TRIOS )
		return true

	if ( Challenge_GetGameMode( flavor) == CHALLENGE_GAME_MODE_NON_MODE )
		return true

	return false

}




