ItemFlavor function Challenge_GetProgressUnlockDependency( ItemFlavor challengeFlav )
{
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )
	Assert( Challenge_IsProgressUnlocked( challengeFlav ), "Tried to get progress unlock dependency from a challenge that isn't progress-unlocked!" )
	ItemFlavor challengeSetFlav = GetItemFlavorByAsset( GetGlobalSettingsAsset( ItemFlavor_GetAsset( challengeFlav ), "linkedSetForProgressUnlock" ) )

	return challengeSetFlav
}

int function Challenge_GetMinimumNumberOfChallengesCompletedForUnlock( entity player, ItemFlavor challengeFlav )
{
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )
	if ( !Challenge_IsProgressUnlocked( challengeFlav ) )
		return 0

	int completionPercentageRequirement = GetGlobalSettingsInt( ItemFlavor_GetAsset( challengeFlav ), "progressUnlockRequirement" )
	ChallengeSet challengeSet = ChallengeSet_GetByGUID( Challenge_GetProgressUnlockDependency( challengeFlav ).guid )

	float validChallengesCount = 0.0
	foreach ( ItemFlavor challenge in challengeSet.challenges )
	{
		if ( Challenge_IsPlayerChallengeMigrationValid( player, challenge ) )
		{
			validChallengesCount++
		}
	}
	return int( ceil( float( completionPercentageRequirement ) / 100.0 * validChallengesCount ) )
}

bool function Challenge_MeetsUnlockCompletionRequirements( entity player, ItemFlavor challengeFlav )
{
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )
	ChallengeSet challengeSet = ChallengeSet_GetByGUID( Challenge_GetProgressUnlockDependency( challengeFlav ).guid )

	return ChallengeSet_GetProgress( player, challengeSet ) >= Challenge_GetMinimumNumberOfChallengesCompletedForUnlock( player, challengeFlav )
}

