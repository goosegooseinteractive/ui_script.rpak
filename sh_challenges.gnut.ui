bool function Challenge_IsPinned( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.challenge )

	ItemFlavor ornull activePass = fileLevel.currentSeason.battlePassOrNull
	if ( activePass == null )
		return false

	return ( flavor == GetBattlePassRecurringGrindlordChallenge( expect ItemFlavor( activePass ) ) )
}



