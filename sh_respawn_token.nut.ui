}

int function GetPlaylistVar_RespawnDisabledDeathstage()
{
	
	return GetCurrentPlaylistVarInt( "respawn_token_respawn_disable_deathstage_close", RESPAWN_TOKEN_DISABLE_AT_RING_STAGE )
}

