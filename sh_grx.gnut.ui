	return fileLevel.activeStoreTabSections
}



void function SendRecommendedShopSectionOrderingPinEvent()
{
	if ( fileLevel.sentRecommendedShopSectionOrderingPinEvent )
		return

	fileLevel.sentRecommendedShopSectionOrderingPinEvent = true

	array< int > activeSectionIds = []
	foreach ( GRXStoreSection section in fileLevel.activeStoreTabSections )
	{
		activeSectionIds.append( section.id )
	}

	array< string > activeSectionLocIds = []
	foreach ( GRXStoreSection section in fileLevel.activeStoreTabSections )
	{
		activeSectionLocIds.append( section.localization )
	}

	array<int> recommendedShopSectionOrderingForPin = clone fileLevel.recommendedShopSectionOrdering
	PIN_RecommendedShopSectionOrdering( activeSectionIds, recommendedShopSectionOrderingForPin, activeSectionLocIds )
}



void function SortShopSectionsByRecommendedOrder()
{
	
	
	if ( fileLevel.recommendedShopSectionOrdering.len() == 0 || fileLevel.activeStoreTabSections.len() == 0 )
		return

	
	
	
	
	
	
	
	
	

	fileLevel.activeStoreTabSections.sort( SortShopSectionsByRecommendedOrderComparator )

	SendRecommendedShopSectionOrderingPinEvent()
}



int function SortShopSectionsByRecommendedOrderComparator( GRXStoreSection a, GRXStoreSection b )
{
	int indexA = fileLevel.recommendedShopSectionOrdering.find( a.id )
	int indexB = fileLevel.recommendedShopSectionOrdering.find( b.id )

	
	if ( indexA == -1 )
	{
		GRX_Warning( "Section %s with id %d not in recommended order list, sending to end",  a.localization, a.id )
		indexA = INT_MAX
	}
	if ( indexB == -1 )
	{
		GRX_Warning( "Section %s with id %d not in recommended order list, sending to end", b.localization, b.id )
		indexB = INT_MAX
	}

	if ( indexA < indexB )
		return -1
	if ( indexA > indexB )
		return 1
	return 0
}

void function DetermineActiveStoreSectionsForTabs()
{
	if ( !GRX_IsDynamicStoreEnabled() )
		return

	
	if ( fileLevel.offerAliasToOfferMap.len() == 0 )
		return

	
	if ( fileLevel.storeTabs.len() == 0 )
		return

	
	int currentTime = GetUnixTimestamp()

	fileLevel.activeStoreTabSections.clear()

	for ( int i = 0; i < fileLevel.storeTabs.len(); ++i )
	{
		GRXStoreTab tab = fileLevel.storeTabs[i]

		
		if ( tab.alias != SHOP_TAB_ALIAS )
			continue

		
		for ( int j = 0; j < tab.sections.len(); ++j )
		{
			GRXStoreSection section = tab.sections[j]

			bool isSectionActive = ( section.isEvergreen || ( section.startDate < currentTime && section.endDate > currentTime ) )

			if ( GRX_IsStoreSectionForShopPersonalizationOffers( section ) )
			{
				if ( !fileLevel.hasShopPersonalizationOffersUpdated )
				{
					GRX_Trace( "Skipping ShopPersonalizationOffers section:%d (!fileLevel.hasShopPersonalizationOffersUpdated)", section.id )
					isSectionActive = false
				}
				else if ( section.items.len() == 0 )
				{
					GRX_Trace( "Skipping ShopPersonalizationOffers section:%d (section.items.len() == 0)", section.id )
					isSectionActive = false
				}

				if ( isSectionActive )
				{
					section.endDate = fileLevel.shopPersonalizationSectionEndTime
				}
			}

			if ( isSectionActive )
			{
				fileLevel.activeStoreTabSections.append( section  )
			}
		}
	}

	
	SortShopSectionsByRecommendedOrder()
}



bool function GRX_IsPlayerEligibleForACBonus()
{
	if ( !GetConVarBool( "mtx_first_time_ac_bonus_enabled" ) )
	{
		return false
	}
	bool areTargetedAdsEnabled = GRX_AreTargetedAdsEnabled()
	int hasPurchasedAC = GRX_GetAccountIntAttribute( HAS_PURCHASED_AC_ACCOUNT_ATTRIBUTE_NAME )
#if DEV
		printt("TargetedAdsEnabled UM segment match: ", areTargetedAdsEnabled, " and hasPurchasedAC attribute value: ", hasPurchasedAC )
#endif
	return areTargetedAdsEnabled && hasPurchasedAC == 0
}




