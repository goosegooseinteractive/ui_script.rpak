void function GRX_CheckAndPurchaseMilestoneRewardOffer_Thread()
{
	EndSignal( uiGlobal.signalDummy, "LevelShutdown" )
	while ( IsLobby() && ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() ) )
	{
		WaitFrame()
	}

	if ( GRX_UI_IsInValidStateToAttemptGRXOperations() )
	{
		GRX_CheckAndPurchaseMilestoneRewardOffer()
	}
}



void function GRX_CheckAndPurchaseMilestoneRewardOffer()
{
	SettingsAssetGUID SIXTH_ANNIVERSARY_MILESTONE_EVENT_GUID = 1342536088
	SettingsAssetGUID R301_GUID = 796782040

	ItemFlavor ornull activeMilestoneEvent = GetActiveMilestoneEvent( GetUnixTimestamp() )

	if ( activeMilestoneEvent == null )
	{
		GRX_Info( "No active milestone event" )
		return
	}

	expect ItemFlavor( activeMilestoneEvent )

	if ( ItemFlavor_GetGUID( activeMilestoneEvent ) != SIXTH_ANNIVERSARY_MILESTONE_EVENT_GUID )
	{
		GRX_Info( "Active milestone event is not 6th anniversary" )
		return
	}

	ItemFlavor ornull r301ItemFlav = GetItemFlavorOrNullByGUID( R301_GUID )
	Assert( r301ItemFlav != null, "Couldn't find r301 itemFlav" )

	if ( r301ItemFlav == null )
	{
		return
	}

	expect ItemFlavor( r301ItemFlav )

	if ( GRX_HasItem( ItemFlavor_GetGRXIndex( r301ItemFlav ) ) )
	{
		Assert( fileLevel.mythicChaseRewardOffer != null )
		if ( fileLevel.mythicChaseRewardOffer == null )
		{
			return
		}

		GRXScriptOffer rewardOffer = expect GRXScriptOffer( fileLevel.mythicChaseRewardOffer )

		if ( rewardOffer.purchaseCount > 0 )
		{
			GRX_Info( "Reward offer already purchased" )
			return
		}

		bool playerOwnsAllRewardItemsAlready = true
		foreach( GRXStoreOfferItem rewardItem in rewardOffer.items )
		{
			if ( !GRX_HasItem( rewardItem.itemIdx ) )
			{
				playerOwnsAllRewardItemsAlready = false
				break
			}
		}

		if ( playerOwnsAllRewardItemsAlready )
		{
			GRX_Info( "Player already owns all items in offer" )
			return
		}

		int quantity = 1
		int queryGoal = GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER

		ScriptGRXOperationInfo operation
		operation.expectedQueryGoal = queryGoal
		operation.doOperationFunc = ( void function( int opId ) : ( queryGoal, rewardOffer, quantity ) {
			GRX_PurchaseFreeOffer( opId, queryGoal, rewardOffer, quantity )
		})
		operation.onDoneCallback = ( void function( int status ) : ( rewardOffer, quantity )
		{
#if DEV
			bool wasSuccessful = ( status == eScriptGRXOperationStatus.DONE_SUCCESS )
			if ( wasSuccessful )
			{
				GRX_Info( "Successfully purchased reward offer" )
			}
			else
			{
				GRX_Info( "Failed to purchase reward offer" )
			}
#endif
		})

		QueueGRXOperation( GetLocalClientPlayer(), operation )
	}
	else
	{
		GRX_Info( "Player does not own r-301" )
	}
}



void function ProcessLegendLockerItemsInPackOffers_Thread()
{
	EndSignal( uiGlobal.signalDummy, "LevelShutdown" )
	while ( IsLobby() &&  ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() ) )
	{
		WaitFrame()
	}

	if ( GRX_UI_IsInValidStateToAttemptGRXOperations() )
	{
		ProcessLegendLockerItemsInPackOffers()
	}
}



void function ProcessLegendLockerItemsInPackOffers()
{
	if ( GRX_IsOfferRestricted() )
		return

	var itemsToPackOffersTable = GetDataTable( $"datatable/legend_locker/itemsToPackOffers.rpak" )
	int itemsToPackOffersTableRowCount = GetDataTableRowCount( itemsToPackOffersTable )

	int itemSettingsAssetGuidColumn = GetDataTableColumnByName( itemsToPackOffersTable, "itemSettingsAssetGuid" )
	int packOfferAliasColumn = GetDataTableColumnByName( itemsToPackOffersTable, "packOfferAlias" )
	int locationColumn = GetDataTableColumnByName( itemsToPackOffersTable, "location" )

	if ( itemSettingsAssetGuidColumn < 0 || packOfferAliasColumn < 0 || locationColumn < 0 )
	{
		GRX_Warning("There are problems with the Legend Locker items to pack offers datatable!!!")
		return
	}

	for( int i = 0; i < itemsToPackOffersTableRowCount; i++ )
	{
		SettingsAssetGUID guid = GetDataTableInt( itemsToPackOffersTable, i, itemSettingsAssetGuidColumn )

		
		ItemFlavor ornull legendLockerItemFlav = GetItemFlavorOrNullByGUID( guid )

		if ( legendLockerItemFlav == null )
		{
			GRX_Trace( "Couldn't find a valid legend locker itemFlav with guid = " + guid )
			continue
		}

		expect ItemFlavor( legendLockerItemFlav )

		
		string offerAlias = GetDataTableString( itemsToPackOffersTable, i, packOfferAliasColumn )
		GRXScriptOffer ornull scriptOffer = GRX_GetScriptOfferFromOfferAlias( offerAlias )

		if ( scriptOffer == null )
		{
			GRX_Trace( "Couldn't find associated script offer for offerAlias = " + offerAlias )
			continue
		}

		expect GRXScriptOffer( scriptOffer )

		
		string storeLocation =  GetDataTableString( itemsToPackOffersTable, i, locationColumn )

		if ( storeLocation == "" )
		{
			GRX_Trace( "Found an empty location associated with pack offer = " + offerAlias )
			continue
		}

		
		ItemFlavorPurchasabilityInfo purchasabilityInfo = GRX_GetItemPurchasabilityInfo( legendLockerItemFlav )

		if ( !( storeLocation in purchasabilityInfo.locationToDedicatedStoreOffersMap ) )
		{
			purchasabilityInfo.locationToDedicatedStoreOffersMap[storeLocation] <- []
		}

		array<GRXScriptOffer> locationOffers = purchasabilityInfo.locationToDedicatedStoreOffersMap[storeLocation]
		if ( !locationOffers.contains( scriptOffer ) )
		{
			locationOffers.append( scriptOffer )
		}
	}
}



void function UICodeCallback_GRXShopSectionOrderingUpdated( array<int> sectionOrdering )
{
	fileLevel.recommendedShopSectionOrdering = sectionOrdering
	SortShopSectionsByRecommendedOrder()
}


#if UI_AUTOMATION
void function GRX_UIAutomation_PurchaseRandomOffer()
{
	if ( !GRX_UI_IsInValidStateToAttemptGRXOperations() || !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
	{
		return
	}

	
	if ( !fileLevel.purchaseInfoInitDone )
	{
		foreach ( ItemFlavor _, ItemFlavorPurchasabilityInfo info in fileLevel.itemFlavorPurchasabilityInfoMap )
		{
			if ( !info.isPurchasableAtAll )
			{
				continue
			}

			GRXScriptOffer offer
			bool isCrafting = false

			if ( info.craftingOfferOrNull != null )
			{
				offer = GRX_ScriptOfferFromCraftingOffer( expect GRXScriptCraftingOffer( info.craftingOfferOrNull ) )
			}
			else
			{
				if ( info.locationToDedicatedStoreOffersMap.len() == 0 )
				{
					continue
				}

				foreach ( string loc, array< GRXScriptOffer > offerArray in info.locationToDedicatedStoreOffersMap )
				{
					if ( offerArray.len() > 0 )
					{
						offer = offerArray[ 0 ]
						break
					}
				}
			}

			if ( !IsOfferAutomaticallyPurchasable( offer ) )
			{
				continue
			}

			fileLevel.validOffers.append( offer )
		}

		printf( "UIAutomation: initial offer scan completed, total available offers: %d", fileLevel.validOffers.len() )
		fileLevel.purchaseInfoInitDone = true
	}

	if ( fileLevel.validOffers.len() == 0 )
	{
		printt( "UIAutomation: no offers left to purchase, quitting client" )
		ClientCommand( "quit" )
	}

	int randomIndex = RandomInt( fileLevel.validOffers.len() )
	GRXScriptOffer offer = fileLevel.validOffers[ randomIndex ]

	if ( offer.purchaseLimit - offer.purchaseCount <= 0 )
	{
		printf( "UIAutomation: offer limit reached for this offer (%s), skipping", offer.offerAlias )
		RemoveOfferFromAvailableOffers( randomIndex )
		return
	}

	if ( !GRX_CanAfford( offer.prices[0], 1 ) )
	{
		printt( "UIAutomation: currency balance fallen below threshold, quitting client" )
		ClientCommand( "quit" )
	}

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = offer.isCraftingOffer ? GRX_HTTPQUERYGOAL_CRAFT_ITEM : GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER
	operation.doOperationFunc = (void function( int opId ) : ( offer ) {
		GRX_PurchaseOffer( opId, offer.isCraftingOffer ? GRX_HTTPQUERYGOAL_CRAFT_ITEM : GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER, offer, offer.prices[0], 1, null )
	})
	operation.onDoneCallback = (void function( int status ) : ( offer, randomIndex )
	{
		if ( status == eScriptGRXOperationStatus.DONE_SUCCESS )
		{
			printf( "UIAutomation: purchased offer ( %s ) as part offer automation testing.", FUNC_NAME(), offer.offerAlias )
			RemoveOfferFromAvailableOffers( randomIndex )
		}
	})


	QueueGRXOperation( GetLocalClientPlayer(), operation )
}

void function RemoveOfferFromAvailableOffers( int index )
{
	fileLevel.validOffers.fastremove( index )
}

bool function IsOfferAutomaticallyPurchasable( GRXScriptOffer offer )
{
	if ( !offer.isAvailable || !GRX_CanAfford( offer.prices[0], 1 ) && ( offer.purchaseLimit - offer.purchaseCount > 0 ) || offer.isOnlyGiftable || offer.ineligibilityCode != eIneligibilityCode.ELIGIBLE )
	{
		return false
	}

	return true
}
#endif
