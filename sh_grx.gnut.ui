void function GRX_PreviewPack( ItemFlavor pack )
{
	if ( !GetConVarBool( "mtx_get_pack_preview_enabled" ) )
	{
		return
	}

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GET_PACK_PREVIEW

	operation.doOperationFunc = ( void function( int opID ) : ( pack ) {
		printt( "GRX_PreviewPack", opID, ItemFlavor_GetGRXIndex( pack ) )
		GRX_GetPackPreview( opID, ItemFlavor_GetGRXIndex( pack ) )
	})
	operation.onDoneCallback = ( void function( int status ) : ( operation, pack ) {
		if ( status == eScriptGRXOperationStatus.DONE_SUCCESS )
		{
			foreach ( void functionref( int, array< UILootPoolItemData >, ItemFlavor ) callback in fileLevel.packPreviewOnDoneCallbacks )
			{
				callback( eLootPoolBrowserQueryStatus.OK, fileLevel.packPreviewResults, pack )
			}
			Signal( uiGlobal.signalDummy, "OnPackPreviewCompleted")
		}
		else
		{
			foreach ( void functionref( int, array< UILootPoolItemData >, ItemFlavor ) callback in fileLevel.packPreviewOnDoneCallbacks )
			{
				callback( eLootPoolBrowserQueryStatus.ERROR, fileLevel.packPreviewResults, pack )
			}
		}
	})
	QueueGRXOperation( GetLocalClientPlayer(), operation )
}

void function UICodeCallback_GRXPackPreviewCompleted( array< GRXLootPoolItem > results )
{
	Assert( results.len() <= MAX_RESULTS_FROM_LPB_QUERY, format( "Too many results from loot pool browser query: %d.", results.len() ) )

	fileLevel.packPreviewResults = []

	foreach ( GRXLootPoolItem item in results )
	{
		UILootPoolItemData uiData
		uiData.flav = GetItemFlavorByGRXIndex( item.itemIndex )
		uiData.quantity = item.quantity
		uiData.isFallback = item.isFallback

		
		uiData.isOwned = GRX_IsItemOwnedByPlayer( uiData.flav, GetLocalClientPlayer() )

		fileLevel.packPreviewResults.append( uiData )
	}
}

void function UICodeCallback_GRXOnDemandContainerReceived( string containerAlias, GRXContainerInfo container )
{
	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )

	if ( !( containerAlias in scriptState.onDemandContainers ) )
	{
		
		
		GRX_Warning( "Container \'%s\' is not present in onDemandContainers, throwing away response from server", containerAlias )
		return
	}

	scriptState.onDemandContainers[containerAlias] = container

	if ( !( containerAlias in fileLevel.onDemandContainerAvailableCallbacks ) )
	{
		return
	}

	array<void functionref( GRXContainerInfo )> callbacks = fileLevel.onDemandContainerAvailableCallbacks[containerAlias]
	foreach ( void functionref( GRXContainerInfo ) callback in callbacks )
	{
		callback( container )
	}
}



GRXLootPoolProgress function GRX_GetLootPoolProgress( entity player, ItemFlavor pack )
{
	Assert( ItemFlavor_GetType( pack ) == eItemType.account_pack )

	array< ItemFlavor > contents = GRXPack_GetPackContents( pack )
	GRXLootPoolProgress progress
	progress.owned = 0
	progress.total = contents.len()

	
	bool isBackfillType = ItemFlavor_GetAccountPackType( pack ) == eAccountPackType.RETRO_BACKFILL_PACK
	if ( isBackfillType )
	{
		string progressRewardSeq = GRXPack_GetPackOpenProgressRewardSequenceString( pack )

		




			
			if ( progressRewardSeq == "rewardseq_retro_s11e01_progress" )
			{
				progress.owned = player.GetPersistentVarAsInt( progressRewardSeq )
			}


		return progress
	}

	
	foreach ( ItemFlavor item in contents )
	{
		if ( GRX_IsItemOwnedByPlayer( item, player ) )
		{
			progress.owned += 1
		}
	}

	return progress
}



bool function GRX_IsValidGRXOwnershipMode( int grxMode )
{
	return grxMode == eItemFlavorGRXMode.OWNERSHIP_TARGET || grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE	|| grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET
}


