	Assert( ItemFlavor_GetType( flav ) == eItemType.account_currency_bundle )

	
	int playlistValue = GetCurrentPlaylistVarInt( "grx_" + ItemFlavor_GetGRXAlias( flav ) + "_count", -1 )
	int bakeryValue = GetGlobalSettingsInt( ItemFlavor_GetAsset( flav ), "currencyCount" )

	if ( playlistValue != -1 )
