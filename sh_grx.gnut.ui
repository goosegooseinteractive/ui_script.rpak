bool function HasBattlePassRewards()
{
	entity player = GetLocalClientPlayer()
	EHI playerEHI = ToEHI( player )

	ItemFlavor ornull activeBattlePass = GetActiveBattlePassV2()

	if ( activeBattlePass == null || !GRX_IsInventoryReady() )
		return false

	expect ItemFlavor( activeBattlePass )

	BattlePassLevelData levelData = GetBattlePassLevelData( player, activeBattlePass )

	if ( levelData.currentXP == levelData.lastSeenXP && levelData.hasPremiumPass == levelData.hadPremiumPass && levelData.hasUltimatePlusPass == levelData.hadUltimatePlusPass )
		return false

	if ( levelData.currentXP == 0 && levelData.lastSeenXP == 0 && !levelData.hadPremiumPass )
		levelData.lastLevel = 0 

	bool functionref( ItemFlavor, int, int, int ) HasRewardsForTier = bool function ( ItemFlavor battlePass, int currentLevel, int lastLevel, int tier ) {

		for ( int levelIdx = lastLevel; levelIdx <= currentLevel; levelIdx++ )
		{
			array<BattlePassReward> rewards = GetBattlePassV2Rewards( battlePass, levelIdx, tier, GetLocalClientPlayer() )
			if ( rewards.len() > 0 )
				return true
		}
		return false
	}

	if ( HasRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.FREE ) )
		return true

	if ( levelData.hasPremiumPass != levelData.hadPremiumPass )
		levelData.lastLevel = 0 

	if ( levelData.hasPremiumPass )
	{
		if ( HasRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.PREMIUM ) )
			return true
	}

	if ( levelData.hasUltimatePlusPass != levelData.hadUltimatePlusPass )
		levelData.lastLevel = 0 

	if ( levelData.hasUltimatePlusPass )
	{
		if ( HasRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.ULTIMATE_PLUS ) )
			return true
	}
	return false
}

bool function HasPassRewards()
{
	entity player = GetLocalClientPlayer()

	array<ItemFlavor ornull> activePasses
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.NEWPLAYER ) )
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.RETURNING_PLAYER ) )
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.ACCOUNT ) )

		array< ItemFlavor > legendPasses = PlayerPass_GetAssignedPassesOfType( player, ePassType.LEGEND )
		foreach ( ItemFlavor legendPass in legendPasses )
		{
			ItemFlavor ornull legendPassOrNull = legendPass 
			activePasses.push( legendPassOrNull )
		}


	foreach ( ItemFlavor ornull activePass in activePasses )
	{
		if ( activePass == null )
			continue

		expect ItemFlavor( activePass )

		int currentXP          = PlayerPass_GetProgress( player, activePass )
		int lastSeenXP         = PlayerPass_GetLastSeenProgress( player, activePass, ePassLastSeenType.LOBBY )

		if ( currentXP == lastSeenXP )
			continue

		int lastLevel    = PlayerPass_GetPassLevelForXP( player, activePass, lastSeenXP )
		int currentLevel    = PlayerPass_GetPassLevelForXP( player, activePass, currentXP )

		if ( currentXP == 0 && lastSeenXP == 0 )
			lastLevel = 0

		if ( lastLevel >= currentLevel )
			continue


		for ( int levelIdx = lastLevel + 1; levelIdx <= currentLevel; levelIdx++ )
		{
			array<BattlePassReward> rewards = GetBattlePassV2Rewards( activePass, levelIdx, eBattlePassV2RewardTier.FREE, GetLocalClientPlayer() )
			if ( rewards.len() > 0 )
				return true
		}
	}

	return false
}

