bool function GRX_IsDynamicStoreEnabled()
{
	return GetConVarBool( "mtx_dynamic_store_info_enabled" )
}



bool function GRX_IsStoreSectionForShopPersonalizationOffers( GRXStoreSection section )
{
	return ( section.triggerId != 0 || section.recoId != "" )
}



GRXStoreSection ornull function GRX_TryGetShopPersonalizationSection()
{
	foreach ( GRXStoreTab tab in fileLevel.storeTabs )
	{
		foreach ( GRXStoreSection section in tab.sections )
		{
			if ( GRX_IsStoreSectionForShopPersonalizationOffers( section ) )
			{
				
				
				
				int currentTime = GetUnixTimestamp()
				bool isSectionActive = ( section.isEvergreen || ( section.startDate < currentTime && section.endDate > currentTime ) )
				if ( isSectionActive )
				{
					return section
				}
			}
		}
	}

	return null
}



void function UICodeCallback_GRXShopPersonalizationOffersUpdated( array<GRXStoreOffer> offers, int sectionEndTime )
{
#if DEV
	if ( fileLevel.storeTabs.len() == 0 )
	{
		GRX_Warning( "CodeCallback_GRXShopPersonalizationOffersUpdated not expected if no storeTabs exist (ShopPersonalizationOffers requested as a side-effect of tagged store sections)" )
	}
#endif

	GRX_Info( "%d ShopPersonalizationOffers Updated with an end time of %i", offers.len(), sectionEndTime )
	fileLevel.hasShopPersonalizationOffersUpdated = true
	fileLevel.shopPersonalizationOffers = offers
	fileLevel.shopPersonalizationSectionEndTime = sectionEndTime

	AddAllShopPersonalizationOffersAsScriptOffers() 

	GRXStoreSection ornull shopPersonalizationSectionOrNull = GRX_TryGetShopPersonalizationSection()
	if ( shopPersonalizationSectionOrNull == null )
	{
		GRX_Warning( "No dynamic store section for shopPersonalization found." )
		return
	}

	GRXStoreSection shopPersonalizationSection = expect GRXStoreSection( shopPersonalizationSectionOrNull )
	if ( shopPersonalizationSection.items.len() > 0 )
	{
		GRX_Warning( "Dynamic store section already has items. sectionId=%d", shopPersonalizationSection.id )
		return
	}

	foreach ( GRXStoreOffer offer in fileLevel.shopPersonalizationOffers )
	{
		GRXStoreItem newItem
		newItem.offerAlias = offer.offerAlias
		newItem.type = eStoreGridItemType.OFFER_1_2 
		shopPersonalizationSection.items.append( newItem )
	}

	DetermineActiveStoreSectionsForTabs()
}



void function AddAllShopPersonalizationOffersAsScriptOffers()
{
	foreach ( GRXStoreOffer offer in fileLevel.shopPersonalizationOffers )
	{
		GRXScriptOffer scriptOffer

		
		
		scriptOffer.attributes["location"] <- "shopP"

		GRX_InitScriptOfferFromStoreOffer( offer, scriptOffer, false )
	}
}



