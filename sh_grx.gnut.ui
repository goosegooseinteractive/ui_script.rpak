	}
	fileLevel.hasEarnedRewardCallbacks.append( cb )
}


SettingsAssetGUID ornull function GetRewardSummaryQueuedRewardOrNull( int persistentArrayIdx )
{
	SettingsAssetGUID rewardItemFlavGUID = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ) ) )
	if ( rewardItemFlavGUID == 0 )
		return null

	int rewardFlowToUse = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].rewardFlowToUse", persistentArrayIdx ) ) )
	if ( rewardFlowToUse != eRewardFlow.REWARD_ATTRIBUTION_SUMMARY )
		return null

	if ( !IsValidItemFlavorGUID( rewardItemFlavGUID, eValidation.DONT_ASSERT ) )
	{
		if ( GetCurrentPlaylistVarBool( "grx_purge_unknown_guid_rewards", true ) )
		{
			GRX_Warning( "Purging unknown ItemFlavor GUID " + rewardItemFlavGUID + " found in grxQueuedRewards." )
			GRX_MarkRewardAcknowledged( rewardItemFlavGUID, persistentArrayIdx )
		}
		else
		{
			Assert( false, "Unknown ItemFlavor GUID " + rewardItemFlavGUID + " found in grxQueuedRewards." )
		}
		return null
	}

	ItemFlavor rewardItemFlav = GetItemFlavorByGUID( rewardItemFlavGUID )

	
	if ( GRX_IsRankedReward( rewardItemFlav ) )
		return null

	
	if ( ItemFlavor_GetType( rewardItemFlav ) == eItemType.reward_set_tracker )
	{
		GRX_MarkRewardAcknowledged( rewardItemFlavGUID, persistentArrayIdx )
		return null
	}

	bool rewardAcknowledged = expect bool( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].rewardAcknowledged", persistentArrayIdx )  )  ) 
	return rewardAcknowledged ? null : rewardItemFlavGUID
}

array<RewardItemFlavor> function GetBadgeRewards()
{
	array<RewardItemFlavor> rewards

	array< BadgeDisplayData > badgesDisplayData = GladiatorCardBadge_GetPostGameStatUnlockBadgesDisplayData()
	foreach ( BadgeDisplayData displayData in badgesDisplayData )
	{
		if ( ItemFlavor_GetType( displayData.badge ) != eItemType.gladiator_card_badge )
			continue

		if ( GRX_IsRankedReward( displayData.badge ) )
			continue

		bool duplicateBadge = false
		for ( int i = 0; i < rewards.len(); ++i )
		{
			if ( rewards[i].reward.guid == displayData.badge.guid )
			{
				duplicateBadge = true
				break;
			}
		}

		
		if ( duplicateBadge )
			continue

		RewardItemFlavor rewardItemFlavor
		rewardItemFlavor.reward = displayData.badge
		rewardItemFlavor.sourceFlav = null
		rewardItemFlavor.quantity = 1
		rewards.append( rewardItemFlavor )
	}

	GRX_MarkBadgeRewardsAcknowledged()

	return rewards
}

array<RewardItemFlavor> function GetQueuedRewards()
{
	array<RewardItemFlavor> rewards

	for ( int persistentArrayIdx = 0; persistentArrayIdx < QUEUED_REWARDS_MAX_COUNT; persistentArrayIdx++ )
	{
		Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
		SettingsAssetGUID ornull rewardItemFlavGUID = GetRewardSummaryQueuedRewardOrNull( persistentArrayIdx )
		if ( rewardItemFlavGUID == null )
			continue

		expect SettingsAssetGUID( rewardItemFlavGUID )
		ItemFlavor rewardItemFlav = GetItemFlavorByGUID( rewardItemFlavGUID )
		SettingsAssetGUID sourceFlavGUID = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].sourceGUID", persistentArrayIdx ) ) )
		ItemFlavor ornull sourceFlav = null
		if ( sourceFlavGUID == ASSET_SETTINGS_UNIQUE_ID_INVALID )
		{
			
			if ( GetGlobalSettingsAsset( ItemFlavor_GetAsset( rewardItemFlav ), "parentItemFlavor" ) != "" )
			{
				asset parentAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( rewardItemFlav ), "parentItemFlavor" )
				
				if ( IsValidItemFlavorSettingsAsset( parentAsset ) )
				{
					ItemFlavor parentChallengeFlav = GetItemFlavorByAsset( parentAsset )
					
					if ( ItemFlavor_GetType( parentChallengeFlav ) == eItemType.challenge )
						sourceFlav = Challenge_GetSourceOrNull( parentChallengeFlav )
				}
			}
		}
		else if ( IsValidItemFlavorGUID( sourceFlavGUID ) )
		{
			sourceFlav = GetItemFlavorByGUID( sourceFlavGUID )

			if ( ItemFlavor_GetType( expect ItemFlavor( sourceFlav ) ) == eItemType.challenge )
				sourceFlav = Challenge_GetSourceOrNull( expect ItemFlavor( sourceFlav ) )
		}

		int quantity = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].rewardQuantities[0]", persistentArrayIdx ) ) ) 

		RewardItemFlavor rewardItemFlavor
		rewardItemFlavor.reward = rewardItemFlav
		rewardItemFlavor.sourceFlav = sourceFlav
		rewardItemFlavor.quantity = quantity
		rewards.append( rewardItemFlavor )

		GRX_MarkRewardAcknowledged( rewardItemFlavGUID, persistentArrayIdx )
	}

	return rewards
}

BattlePassLevelData function GetBattlePassLevelData( entity player, ItemFlavor activeBattlePass )
{
	BattlePassLevelData levelData

	EHI playerEHI = ToEHI( player )

	levelData.currentXP          = GetPlayerBattlePassXPProgress( playerEHI, activeBattlePass )
	levelData.lastSeenXP         = GetPlayerBattlePassLastSeenXP( playerEHI, activeBattlePass )
	levelData.hasPremiumPass     = DoesPlayerOwnBattlePassTier( player, activeBattlePass, eBattlePassV2OwnershipTier.PREMIUM )
	levelData.hadPremiumPass     = GetPlayerBattlePassLastSeenPremium( playerEHI, activeBattlePass )
	levelData.lastLevel    		 = GetBattlePassLevelForXP( activeBattlePass, levelData.lastSeenXP ) + 1
	levelData.currentLevel 		 = GetBattlePassLevelForXP( activeBattlePass, levelData.currentXP )
	levelData.hasUltimatePlusPass = DoesPlayerOwnBattlePassTier( player, activeBattlePass, eBattlePassV2OwnershipTier.ULTIMATE_PLUS )
	levelData.hadUltimatePlusPass = GetPlayerBattlePassLastSeenUltimatePlus( playerEHI, activeBattlePass )

	return levelData
}

array<RewardItemFlavor> function GetBattlePassRewards()
{
	array<RewardItemFlavor> rewardItems

	entity player = GetLocalClientPlayer()
	EHI playerEHI = ToEHI( player )

	ItemFlavor ornull activeBattlePass = GetActiveBattlePassV2()

	if ( activeBattlePass == null || !GRX_IsInventoryReady() )
		return rewardItems

	expect ItemFlavor( activeBattlePass )

	BattlePassLevelData levelData = GetBattlePassLevelData( player, activeBattlePass )

	if ( levelData.currentXP == levelData.lastSeenXP && levelData.hasPremiumPass == levelData.hadPremiumPass && levelData.hasUltimatePlusPass == levelData.hadUltimatePlusPass )
		return rewardItems

	if ( levelData.currentXP == 0 && levelData.lastSeenXP == 0 && !levelData.hadPremiumPass )
		levelData.lastLevel = 0 

	array<BattlePassReward> functionref( ItemFlavor, int, int, int ) GetRewardsForTier = array<BattlePassReward> function ( ItemFlavor battlePass, int currentLevel, int lastLevel, int tier ) {
		array<BattlePassReward> rewards
		for ( int levelIdx = lastLevel; levelIdx <= currentLevel; levelIdx++ )
		{
			rewards.extend( GetBattlePassV2Rewards( battlePass, levelIdx, tier, GetLocalClientPlayer() ) )
		}
		return rewards
	}

	array<BattlePassReward> allRewards
	allRewards.extend( GetRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.FREE ) )

	if ( levelData.hasPremiumPass != levelData.hadPremiumPass )
		levelData.lastLevel = 0 

	if ( levelData.hasPremiumPass )
		allRewards.extend( GetRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.PREMIUM ) )

	if ( levelData.hasUltimatePlusPass != levelData.hadUltimatePlusPass )
		levelData.lastLevel = 0 

	if ( levelData.hasUltimatePlusPass )
		allRewards.extend( GetRewardsForTier( activeBattlePass, levelData.currentLevel, levelData.lastLevel, eBattlePassV2RewardTier.ULTIMATE_PLUS ) )

	for ( int rewardIdx = 0; rewardIdx < allRewards.len(); ++rewardIdx )
	{
		RewardItemFlavor rewardItemFlavor
		rewardItemFlavor.reward = allRewards[rewardIdx].flav
		rewardItemFlavor.sourceFlav = activeBattlePass
		rewardItemFlavor.quantity = allRewards[rewardIdx].quantity
		rewardItems.append( rewardItemFlavor )
	}

	int passGuid = ItemFlavor_GetGUID( activeBattlePass )
	UpdatePassLastInfo( player, ePassLastSeenType.LOBBY, passGuid )
	Remote_ServerCallFunction( "ClientCallback_UpdatePassLastInfo", ePassLastSeenType.LOBBY, passGuid )

	return rewardItems
}

array<RewardItemFlavor> function GetPassRewards()
{
	array<RewardItemFlavor> rewardItems

	entity player = GetLocalClientPlayer()

	array<ItemFlavor ornull> activePasses
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.NEWPLAYER ) )
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.RETURNING_PLAYER ) )
	activePasses.push( PlayerPass_GetAssignedPass( player, ePassType.ACCOUNT ) )

	array< ItemFlavor > legendPasses = PlayerPass_GetAssignedPassesOfType( player, ePassType.LEGEND )
	foreach ( ItemFlavor legendPass in legendPasses )
	{
		ItemFlavor ornull legendPassOrNull = legendPass 
		activePasses.push( legendPassOrNull )
	}


	foreach ( ItemFlavor ornull activePass in activePasses )
	{
		if ( activePass == null )
			continue

		expect ItemFlavor( activePass )

		int currentXP          = PlayerPass_GetProgress( player, activePass )
		int lastSeenXP         = PlayerPass_GetLastSeenProgress( player, activePass, ePassLastSeenType.LOBBY )

		if ( currentXP == lastSeenXP )
			continue

		int lastLevel    = PlayerPass_GetPassLevelForXP( player, activePass, lastSeenXP )
		int currentLevel    = PlayerPass_GetPassLevelForXP( player, activePass, currentXP )

		if ( currentXP == 0 && lastSeenXP == 0 )
			lastLevel = 0

		if ( lastLevel >= currentLevel )
			continue

		array<BattlePassReward> allAwards
		for ( int levelIdx = lastLevel + 1; levelIdx <= currentLevel; levelIdx++ )
			allAwards.extend( GetBattlePassV2Rewards( activePass, levelIdx, eBattlePassV2RewardTier.FREE, GetLocalClientPlayer() ) )

		for ( int awardIdx = 0; awardIdx < allAwards.len(); ++awardIdx )
		{
			RewardItemFlavor rewardItem
			rewardItem.reward = allAwards[awardIdx].flav
			rewardItem.sourceFlav = activePass
			rewardItem.quantity = allAwards[awardIdx].quantity
			rewardItems.append( rewardItem )
		}

		UpdatePassLastInfo( player, ePassLastSeenType.LOBBY, ItemFlavor_GetGUID( activePass ) )
	}

	Remote_ServerCallFunction( "ClientCallback_UpdateAllPassLastInfo", ePassLastSeenType.LOBBY )

	return rewardItems
}

array<RewardItemFlavor> function GRX_GetEarnedRewards()
{
	array<RewardItemFlavor> rewardItems

	foreach ( array<RewardItemFlavor> functionref() rewardCB in fileLevel.getEarnedRewardCallbacks )
		rewardItems.extend( rewardCB() )

#if DEV
	GRX_Info( "Found %d Earned Rewards", rewardItems.len() )
	foreach ( RewardItemFlavor item in rewardItems )
	{
		GRX_Info( "%s x %d", ItemFlavor_GetAssetName( item.reward ), item.quantity )
	}
#endif

	return rewardItems
}

