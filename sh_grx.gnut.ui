int function GRXPack_GetRetroPackDisclaimerType( ItemFlavor pack )
{
	Assert( IsItemFlavorStructValid( pack.guid, eValidation.ASSERT ) )
	Assert( GRXPack_IsAnyRetroPack( pack ) )

	asset itemAsset = ItemFlavor_GetAsset( pack )
	string settingsString = GetGlobalSettingsString( itemAsset, "packDisclosureType" )
	int accountPackType

	switch ( settingsString )
	{
		case "MILESTONE_EVENT":
			accountPackType = eRetroPackDisclosureType.MILESTONE_EVENT
			break
		case "COLLECTION_EVENT":
			accountPackType = eRetroPackDisclosureType.COLLECTION_EVENT
			break
		default:
			Assert( false )
			break
	}

	return accountPackType
}



