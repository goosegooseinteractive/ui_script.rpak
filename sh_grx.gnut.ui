array<ItemFlavor> ornull function GRX_GetItemFlavsFromRetroContainer( ItemFlavor pack )
{
	if ( !GRX_IsInventoryReady() )
	{
		GRX_Info( "UI inventory is not ready yet; cannot access containers" )
		return null
	}

	array<ItemFlavor> result
	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )

	string containerAlias = GRXPack_GetContainerAlias( pack )

	if ( containerAlias.len() == 0 || !( containerAlias in scriptState.onDemandContainers ) )
	{
		return result
	}

	GRXContainerInfo container = scriptState.onDemandContainers[containerAlias]
	result = GRX_GetItemFlavsFromContainer( container )

	return result
}



array<ItemFlavor> function GRX_GetItemFlavsFromContainer( GRXContainerInfo container )
{
	array<ItemFlavor> result

	foreach ( int itemIndex in container.itemIndices )
	{
		ItemFlavor itemFlav = GetItemFlavorByGRXIndex( itemIndex )
		result.append( itemFlav )
	}

	return result
}



void function GRX_RequestOnDemandContainer( string containerAlias )
{
	if ( containerAlias.len() == 0 )
	{
		return
	}

	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )
	if ( containerAlias in scriptState.onDemandContainers )
	{
		
		return
	}

	GRXContainerInfo container
	scriptState.onDemandContainers[containerAlias] <- container

	GRX_RequestOnDemandContainer_Internal( containerAlias )
}



void function GRX_ClearOnDemandContainer( string containerAlias )
{
	if ( containerAlias.len() == 0 )
	{
		return
	}

	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )
	if ( containerAlias in scriptState.onDemandContainers )
	{
		delete scriptState.onDemandContainers[ containerAlias ]
	}
}



void function AddCallbackOrCallNow_OnDemandContainerAvailable( string containerAlias, void functionref( GRXContainerInfo ) cb, bool HACK_dontErrorOnDuplicate = false )
{
	if ( containerAlias.len() == 0 )
	{
		return
	}

	if ( !( containerAlias in fileLevel.onDemandContainerAvailableCallbacks ) )
	{
		fileLevel.onDemandContainerAvailableCallbacks[containerAlias] <- []
	}

	array<void functionref( GRXContainerInfo )> callbacks = fileLevel.onDemandContainerAvailableCallbacks[containerAlias]

	if ( callbacks.contains( cb ) )
	{
		Assert( HACK_dontErrorOnDuplicate, "Tried to add a callback that was already added" )
	}

	callbacks.append( cb )

	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )
	if ( containerAlias in scriptState.onDemandContainers )
	{
		GRXContainerInfo container = scriptState.onDemandContainers[containerAlias]
		if ( container.containerId.len() > 0 )
		{
			
			cb( container )
		}
	}
}



void function RemoveCallback_OnDemandContainerAvailable( string containerAlias, void functionref( GRXContainerInfo ) cb )
{
	Assert( containerAlias in fileLevel.onDemandContainerAvailableCallbacks, "Tried to remove a callback for a containerAlias that was not added" )
	array<void functionref( GRXContainerInfo )> callbacks = fileLevel.onDemandContainerAvailableCallbacks[containerAlias]

	Assert( callbacks.contains( cb ), "Tried to remove a callback that was not added" )
	callbacks.fastremovebyvalue( cb )
}



