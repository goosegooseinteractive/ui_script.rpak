const asset DEFAULTS_ENDORSEMENTS_ICON_OVERRIDE														= $""
const string DEFAULTS_ENDORSEMENT_NOTIF_SOUND_1P_OVERRIDE											= ""
const string DEFAULTS_ENDORSEMENT_SPONSOR_DISPLAY_NAME_OVERRIDE										= ""
const string DEFAULTS_ENDORSEMENT_SPONSOR_DISPLAY_DESCRIPTION_OVERRIDE								= ""
const string DEFAULTS_ENDORSEMENT_SPONSOR_COLOR_OVERRIDE											= ""
const asset DEFAULTS_ENDORSEMENT_SPONSOR_ICON_OVERRIDE												= $""
const string DEFAULTS_ENDORSEMENT_SPONSOR_HOVER_SOUND_1P_OVERRIDE									= ""
const string DEFAULTS_ENDORSEMENT_SPONSOR_SELECT_SOUND_1P_OVERRIDE									= ""
const string DEFAULTS_ENDORSEMENT_SPONSOR_SELECT_LAST_SOUND_1P_OVERRIDE								= ""
const bool DEFAULTS_ENDORSEMENTS_FADE_POI_ICON_AT_DIFFERENT_HEIGHTS									= true
