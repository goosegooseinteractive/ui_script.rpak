const bool DEFAULTS_ENDORSEMENTS_GRANTED_GIVE_EVO													= true
const int DEFAULTS_ENDORSEMENTS_MAX_ENDORSEMENT_COUNT												= 3
const string DEFAULTS_ENDORSEMENT_PASSIVE_BASE														= "PAS_ENDORSEMENT_"


const int CLOCKUP_ENDORSEMENTS_ENDORSEMENT_COUNT														= 1



const string PVAR_ENDORSEMENTS_ACTIVE																= "endorsements_enable"
const string PVAR_ENDORSEMENTS_TRACKS																= "endorsements_tracks"
const string PVAR_ENDORSEMENTS_TRACKS_FIXED_ORDER_ENABLED											= "endorsements_tracks_fixed_order_enabled"
const string PVAR_ENDORSEMENTS_FADE_POI_ICON_AT_DIFFERENT_HEIGHTS									= "endorsements_fade_poi_name_endorsement_station_icon_at_diff_height"
const string PVAR_ENDORSEMENTS_FADE_POI_ICON_ADDITIONAL_HEIGHT										= "endorsements_additional_height_for_endorsement_station_icon_fade"
const string PVAR_ENDORSEMENTS_STATIONS_ENABLED														= "endorsements_stations_enabled"
const string PVAR_ENDORSEMENTS_GRANTED_GIVE_EVO														= "endorsements_granted_give_evo"
const string PVAR_ENDORSEMENTS_MAX_ENDORSEMENT_COUNT												= "endorsements_max_endorsement_count"


const asset ENDORSEMENTS_ASSET_ENDORSEMENT_DEFINITIONS												= $"datatable/endorsements/endorsement_definitions.rpak"
const asset ENDORSEMENTS_ASSET_ENDORSEMENT_GROUP_DEFINITIONS										= $"datatable/endorsements/endorsement_group_definitions.rpak"
