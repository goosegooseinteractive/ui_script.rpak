void function PIN_Wishlist_Save( Wishlist wishlist, Wishlist previousWishlist, int editsRemaining )
{
	table< string, array< string > > current
	current[ "legends" ] <- []
	current[ "weapons" ] <- []
	foreach ( int guid in wishlist.flattened )
	{
		ItemFlavor flav = GetItemFlavorByGUID( guid )
		if ( ItemFlavor_GetType( flav ) == eItemType.character )
		{
			current[ "legends" ].append( Wishlist_GetMarketplaceStringRef( flav ) )
		}
		else if ( ItemFlavor_GetType( flav ) == eItemType.weapon_category )
		{
			current[ "weapons" ].append( Wishlist_GetMarketplaceStringRef( flav ) )
		}
	}

	table< string, array< string > > previous
	previous[ "legends" ] <- []
	previous[ "weapons" ] <- []
	foreach ( int guid in previousWishlist.flattened )
	{
		ItemFlavor flav = GetItemFlavorByGUID( guid )
		if ( ItemFlavor_GetType( flav ) == eItemType.character )
		{
			previous[ "legends" ].append( Wishlist_GetMarketplaceStringRef( flav ) )
		}
		else if ( ItemFlavor_GetType( flav ) == eItemType.weapon_category )
		{
			previous[ "weapons" ].append( Wishlist_GetMarketplaceStringRef( flav ) )
		}
	}

	table< string, int > epics
	foreach ( int guid in wishlist.flattened )
	{
		ItemFlavor flav = GetItemFlavorByGUID( guid )
		epics[ Wishlist_GetMarketplaceStringRef( flav ) ] <- Wishlist_GetTotalProgressForCategory( guid, null )
	}

	AddPINTelemetryEvent( "wishlist",
		PIN_StandardHeader(),
		{
			current = current,
			prev_wish_list = previous,
			type = "save",
			edits_remaining = editsRemaining,
			epics = epics,
			hub_name = file.currentHubForPIN,
		}
	)
}

void function PIN_Wishlist_Reset()
{
	entity player = GetLocalClientPlayer()
	int editsRemaining = GRXCurrency_GetPlayerBalance( player, GRX_CURRENCIES[ GRX_CURRENCY_WISHLIST_TOKEN ] )

	AddPINTelemetryEvent( "wishlist",
		PIN_StandardHeader(),
		{
			type = "reset",
			edits_remaining = editsRemaining,
			hub_name = file.currentHubForPIN,
		}
	)
}





















