void function PIN_EscrowPreventedGifting()
{
	entity player = GetLocalClientPlayer()
	int escrowBalance = GRXCurrency_GetPlayerBalance( player, GRX_CURRENCIES[GRX_CURRENCY_ESCROW] )
	int premiumBalance = GRXCurrency_GetPlayerBalance( player, GRX_CURRENCIES[GRX_CURRENCY_PREMIUM] )

	AddPINTelemetryEvent( "no_gift_escrow",
		PIN_StandardHeader(),
		{
			escrow = escrowBalance
			premium = premiumBalance
		}
	)
}



