void function PIN_BonusMeterPlayerProgressedMeter( entity player, int previousLevel, int packsToOpen, int meterGoal, string bonusMeterID, string reward = "" )
{
	Assert( previousLevel != packsToOpen + previousLevel )
	int tdur = GetUnixTimestamp() - player.GetPersistentVarAsInt( "installUnixTime" )

	AddPINTelemetryEvent( "player_level",
		PIN_StandardHeader(),
		{
			is_primary = false,
			level = string( packsToOpen + previousLevel ),
			prev_level = string( previousLevel ),
			reward_level = string( meterGoal ),
			sdur = PIN_GetSessionDuration(), 
			tdur = tdur, 
			type = bonusMeterID
		}
	)
}



