	[ eUniversalSetIndex.SCEPTER_BASE ] = [ eUniversalSetIndex.SCEPTER_BASE, eUniversalSetIndex.SCEPTER_RECOLOR_1, eUniversalSetIndex.SCEPTER_RECOLOR_2, eUniversalSetIndex.SCEPTER_RECOLOR_3 ],
