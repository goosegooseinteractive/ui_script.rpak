asset function MeleeSkin_GetMenuModel( ItemFlavor meleeSkin )
{
	Assert( ItemFlavor_GetType( meleeSkin ) == eItemType.melee_skin )

	asset meleeWeaponAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( meleeSkin ), "parentItemFlavor" )
	ItemFlavor meleeWeapon = GetItemFlavorByAsset( meleeWeaponAsset )
	string mainWeaponClassname = MeleeWeapon_GetMainWeaponClassname( meleeWeapon )
	return GetWeaponInfoFileKeyFieldAsset_Global( mainWeaponClassname, "viewmodel" )
}



ItemFlavor function ResolveMeleeSkinOrMeleeWeapon( ItemFlavor rawMeleeSkin )
{
	Assert( ItemFlavor_GetType( rawMeleeSkin ) == eItemType.melee_skin )

	ItemFlavor meleeSkin = rawMeleeSkin
	if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkin ) )
	{
		
		asset meleeWeaponAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( meleeSkin ), "parentItemFlavor" )
		meleeSkin = GetItemFlavorByAsset( meleeWeaponAsset )
	}
	return meleeSkin
}



asset function MeleeSkin_GetMenuAnimSeq( ItemFlavor rawMeleeSkin )
{
	ItemFlavor meleeSkinOrMeleeWeapon = ResolveMeleeSkinOrMeleeWeapon( rawMeleeSkin )
	return GetGlobalSettingsAsset( ItemFlavor_GetAsset( meleeSkinOrMeleeWeapon ), "menuAnimSeq" )
}




asset function MeleeSkin_GetMenuInspectAnimSeq( ItemFlavor rawMeleeSkin )
{
	asset animSeq

	ItemFlavor meleeSkinOrMeleeWeapon = ResolveMeleeSkinOrMeleeWeapon( rawMeleeSkin )

	
	if ( ItemFlavor_GetType( meleeSkinOrMeleeWeapon ) == eItemType.melee_skin )
	{
		animSeq = GetGlobalSettingsAsset( ItemFlavor_GetAsset( meleeSkinOrMeleeWeapon ), "menuInspectAnimSeq" )
	}

	if ( animSeq == $"" )
	{
		animSeq = MeleeSkin_GetMenuAnimSeq( rawMeleeSkin )
	}

	return animSeq
}




