float function MeleeWeapon_GetInspectVectorScale( ItemFlavor meleeWeapon )
{
	Assert( ItemFlavor_GetType( meleeWeapon ) == eItemType.melee_weapon )
	return GetGlobalSettingsFloat( ItemFlavor_GetAsset( meleeWeapon ), "inspectVectorScale" )
}



float function MeleeWeapon_GetStoreVectorScale( ItemFlavor meleeWeapon )
{
	Assert( ItemFlavor_GetType( meleeWeapon ) == eItemType.melee_weapon )
	return GetGlobalSettingsFloat( ItemFlavor_GetAsset( meleeWeapon ), "storeVectorScale" )
}



