void function DEV_PrintLootDataOverrides()
{
	var dt = GetDataTable( LOOT_DATATABLE )
	int numRows = GetDataTableRowCount( dt )
	int ref_col = GetDataTableColumnByName( dt, "ref" )
	table<string, LootData>	baseLootData
	for ( int i = 0; i < numRows; i++ )
	{
		string ref = GetDataTableString( dt, i, ref_col )
		if ( ref in file.lootDataOverrides )
		{
			LootData data = ReadLootItemFromDatatableRow( dt, i, string( LOOT_DATATABLE ) )
			baseLootData[data.ref] <- data
		}
	}

	foreach ( string ref, LootData override in file.lootDataOverrides )
	{
		if ( ref in baseLootData )
		{
			printt( "[LootOverride] MODIFY item " + ref + " from source " + override.dev_source )

			LootData base = baseLootData[ref]

			asset overrideTableAsset = GetAssetFromString( override.dev_source )
			var dtOverride = GetDataTable( overrideTableAsset )
			int baseRow = GetDataTableRowMatchingStringValue( dt, ref_col, ref )
			int overrideRow = GetDataTableRowMatchingStringValue( dtOverride, ref_col, ref )

			string baseString
			string overrideString
			if ( base.pingCommsAction != override.pingCommsAction )
			{
				printt( "+ pingCommsAction " + base.pingCommsAction + " -> " + override.pingCommsAction )
			}
			if ( base.baseWeapon != override.baseWeapon )
			{
				printt( "+ baseWeapon " + base.baseWeapon + " -> " + override.baseWeapon )
			}
			if ( string( base.fakeAmmoIcon ) != string( override.fakeAmmoIcon ) )
			{
				printt( "+ fakeAmmoIcon " + string( base.fakeAmmoIcon ) + " -> " + string ( override.fakeAmmoIcon ) )
			}
			if ( base.brandAsset != override.brandAsset )
			{
				printt( "+ brandAsset " + string( base.brandAsset )  + " -> " + string ( override.brandAsset ) )
			}
			baseString = GetLootTableString( ref, dt, baseRow, "baseMods" )
			overrideString = GetLootTableString( ref, dtOverride, overrideRow, "baseMods" )
			if ( baseString != overrideString )
			{
				printt( "+ baseMods " + baseString  + " -> " + overrideString )
			}
			if ( base.model != override.model )
			{
				printt( "+ model " + string( base.model )  + " -> " + string ( override.model ) )
			}
			if ( base.skinOverride != override.skinOverride  )
			{
				printt( "+ skinOverride " + base.skinOverride + " -> " + override.skinOverride )
			}
			if ( base.hudIcon != override.hudIcon )
			{
				printt( "+ hudIcon " + string( base.hudIcon )  + " -> " + string ( override.hudIcon ) )
			}
			if ( base.attachSound != override.attachSound )
			{
				printt( "+ attachSound " + base.attachSound + " -> " + override.attachSound )
			}
			if ( base.pickupSound_3p != override.pickupSound_3p )
			{
				printt( "+ pickupSound_3p " + base.pickupSound_3p + " -> " + override.pickupSound_3p )
			}
			if ( base.pickupSound_1p != override.pickupSound_1p)
			{
				printt( "+ pickupSound_1p " + base.pickupSound_1p + " -> " + override.pickupSound_1p )
			}
			if ( base.carrySound != override.carrySound )
			{
				printt( "+ carrySound " + base.carrySound + " -> " + override.carrySound )
			}
			if ( base.scrapValue != override.scrapValue )
			{
				printt( "+ scrapValue " + base.scrapValue + " -> " + override.scrapValue )
			}
			if ( base.droppodRotate != override.droppodRotate )
			{
				printt( "+ droppodRotate " + base.droppodRotate + " -> " + override.droppodRotate )
			}
			if ( base.isDynamic != override.isDynamic )
			{
				printt( "+ isDynamic " + base.isDynamic + " -> " + override.isDynamic )
			}
			if ( base.pretendsToBeBlank != override.pretendsToBeBlank )
			{
				printt( "+ pretendsToBeBlank " + base.pretendsToBeBlank + " -> " + override.pretendsToBeBlank )
			}
			if ( base.conditional != override.conditional )
			{
				printt( "+ conditional " + base.conditional + " -> " + override.conditional )
			}
			if ( base.printPickupToObituary != override.printPickupToObituary )
			{
				printt( "+ printPickupToObituary " + base.printPickupToObituary + " -> " + override.printPickupToObituary  )
			}
			if ( base.restrictFromSling != override.restrictFromSling )
			{
				printt( "+ restrictFromSling " + base.restrictFromSling+ " -> " + override.restrictFromSling )
			}
			if ( base.pickupString != override.pickupString )
			{
				printt( "+ pickupString " + base.pickupString + " -> " + override.pickupString )
			}
			if ( base.desc != override.desc )
			{
				printt( "+ desc " + base.desc + " -> " + override.desc )
			}
			if ( base.countPerDrop != override.countPerDrop )
			{
				printt( "+ countPerDrop " + base.countPerDrop + " -> " + override.countPerDrop )
			}
			if ( base.tier != override.tier )
			{
				printt( "+ tier " + base.tier + " -> " + override.tier )
			}
			if ( base.isDisabled != override.isDisabled )
			{
				printt( "+ isDisabled " + base.isDisabled + " -> " + override.isDisabled )
			}
			baseString = GetLootTableString(ref, dt, baseRow, "supportedAttachments" )
			overrideString = GetLootTableString( ref, dtOverride, overrideRow, "supportedAttachments" )
			if ( baseString != overrideString )
			{
				printt( "+ supportedAttachments " + baseString + " -> " + overrideString )
			}
			baseString = GetLootTableString(ref, dt, baseRow, "lootTags" )
			overrideString = GetLootTableString( ref, dtOverride, overrideRow, "lootTags" )
			if ( baseString != overrideString )
			{
				printt( "+ lootTags " + baseString + " -> " + overrideString )
			}
			if ( base.lootType != override.lootType )
			{
				printt( "+ lootType " + base.lootType + " -> " + override.lootType )
			}
			if ( base.netInt != override.netInt )
			{
				printt( "+ netInt " + base.netInt + " -> " + override.netInt )
			}
			if ( base.inventorySlotCount != override.inventorySlotCount )
			{
				printt( "+ inventorySlotCount " + base.inventorySlotCount + " -> " + override.inventorySlotCount )
			}
			if ( base.floorSpawnCategory != override.floorSpawnCategory )
			{
				printt( "+ floorSpawnCategory " + base.floorSpawnCategory + " -> " + override.floorSpawnCategory )
			}
			baseString = GetLootTableString(ref, dt, baseRow, "passive" )
			overrideString = GetLootTableString( ref, dtOverride, overrideRow, "passive" )
			if ( baseString != overrideString )
			{
				printt( "+ passive " + baseString + " -> " + overrideString )
			}
			if ( base.cosmeticSkinOverride != override.cosmeticSkinOverride )
			{
				printt( "+ cosmeticSkinOverride " + string( base.cosmeticSkinOverride )  + " -> " + string ( override.cosmeticSkinOverride ) )
			}
		}
		else
		{
			printt( "[LootOverride] ADD item " + ref + " from source " + override.dev_source )
		}
	}
}

void function DEV_PrintLootDataByRef( string ref )
{
	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	printt( "=== LootData for ref: " + ref + " ===" )
	printt( "ref:", data.ref )
	printt( "tier:", data.tier )
	printt( "index:", data.index )
	printt( "inventorySlotCount:", data.inventorySlotCount )
	printt( "pingCommsAction:", data.pingCommsAction )
	printt( "requestCommsAction:", data.requestCommsAction )
	printt( "model:", data.model )
	printt( "skinOverride:", data.skinOverride )
	printt( "hudIcon:", data.hudIcon )
	printt( "hudIconSquare:", data.hudIconSquare )
	printt( "craftingIcon:", data.craftingIcon )
	printt( "attachSound:", data.attachSound )
	printt( "pickupSound_1p:", data.pickupSound_1p )
	printt( "pickupSound_3p:", data.pickupSound_3p )
	printt( "carrySound:", data.carrySound )
	printt( "pickupString:", data.pickupString )
	printt( "desc:", data.desc )
	printt( "hopupPopupDesc:", data.hopupPopupDesc )
	printt( "countPerDrop:", data.countPerDrop )
	printt( "lootType:", data.lootType )
	printt( "netInt:", data.netInt )
	printt( "ammoType:", data.ammoType )
	printt( "secondaryAmmoType:", data.secondaryAmmoType )
	printt( "isActive:", data.isActive )
	printt( "passive:", data.passive )
	printt( "attachmentStyle:", data.attachmentStyle )
	printt( "attachmentType:", data.attachmentType )
	printt( "scrapValue:", data.scrapValue )
	printt( "droppodRotate:", data.droppodRotate )
	printt( "isDynamic:", data.isDynamic )
	printt( "conditional:", data.conditional )
	printt( "printPickupToObituary:", data.printPickupToObituary )
	printt( "pretendsToBeBlank:", data.pretendsToBeBlank )
	printt( "baseWeapon:", data.baseWeapon )
	foreach ( attachment in data.supportedAttachments )
	{
		printt( "supportedAttachments:", attachment )
	}
	foreach ( attachment in data.disabledAttachments )
	{
		printt( "disabledAttachments:", attachment )
	}
	foreach ( lootTag in data.lootTags )
	{
		printt( "lootTags:", lootTag )
	}
		foreach ( fakeMod in data.fakeMods )
	{
		printt( "fakeMods:", fakeMod )
	}
	foreach ( baseMode in data.baseMods )
	{
		printt( "baseMods:", baseMode )
	}
	printt( "fakeAmmoIcon:", data.fakeAmmoIcon )
	printt( "brandAsset:", data.brandAsset )
	printt( "collabCharacter:", data.collabCharacter )
	printt( "restrictFromSling:", data.restrictFromSling )
	printt( "hideFromDeathbox:", data.hideFromDeathbox )
	printt( "hideFromBlackMarket:", data.hideFromBlackMarket )
	printt( "isDisabled:", data.isDisabled )
	printt( "floorSpawnCategory:", data.floorSpawnCategory )
	printt( "cosmeticSkinOverride:", data.cosmeticSkinOverride )
	printt( "targetLockedStartTime:", data.targetLockedStartTime )
	printt( "===============================\n" )
}
#endif
















































