bool function Integrated_IncapShield_Enabled()
{
	bool enabled = GetCurrentPlaylistVarBool ( "Integrated_IncapShield_Enabled" , true )

	return enabled
}



bool function HasLockedCorruptedAttachments()
{
	return GetCurrentPlaylistVarBool( "has_locked_corrupted_attachments", false )
}

bool function HasExclusiveCorruptedAttachments()
{
	return GetCurrentPlaylistVarBool( "has_exclusive_corrupted_attachments", true )
}

bool function IsAttachmentCorrupted( LootData data )
{
	return data.lootTags.contains( "corrupted_attachment" )
}

bool function IsStockpileWeapon (  string weaponName )
{
	if ( IsWeaponKeyFieldDefined ( weaponName , "non_crate_stockpile_weapon" ) && GetWeaponInfoFileKeyField_Global( weaponName, "non_crate_stockpile_weapon" ) == 1 )
		return true

	return false
}






























string function GetAttachmentPointName( string attachmentPoint )
{
	switch ( attachmentPoint )
	{
		case "barrel":
			return "#SLOT_BARREL"

		case "mag":
			return "#SLOT_MAG"

		case "grip":
			return "#SLOT_GRIP"








		case "hopup":
		case "hopupMulti_a":
		case "hopupMulti_b":
			return "#SLOT_HOPUP"

		case "sight":
			return "#SLOT_SIGHT"
	}

	unreachable
}