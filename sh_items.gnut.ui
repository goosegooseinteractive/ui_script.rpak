void function ShItems_LevelInit_Begin()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	Assert( ITEM_FLAV_PREFIX.len() == ITEM_FLAV_PREFIX_LEN )
	Assert( ITEM_FLAV_SUFFIX.len() == ITEM_FLAV_SUFFIX_LEN )

#if DEV



#endif

	for ( int typeIndex = 0; typeIndex < eItemType.COUNT; typeIndex++ )
	{
		ItemTypeInfo typeInfo
		fileLevel.itemTypeInfoList.append( typeInfo )
	}

	file.unlockFuncs["founders_pack"] <- PlayerHasFoundersPack
	file.unlockFuncs["starters_pack"] <- PlayerHasStarterPack
	file.unlockFuncs["origin_access_on_pc"] <- PlayerHadOriginAccessOnPC
	file.unlockFuncs["ea_access_on_xbox"] <- PlayerHadEAAccessOnXbox

	file.exclusiveFuncs["psplus_or_xbgold"] <- PlayerHasEntitlementForPSPlusOrXBGold
	file.exclusiveFuncs["switch_platform"] <- PlayerIsOnSwitchAndOwnsItem
	file.exclusiveFuncs["ea_play"] <- PlayerHasEAPlay
}


void function ShItems_CacheEntitlementForPSPlusAndXBGold()
{
	foreach ( ItemFlavor entitlementFlav in GetAllItemFlavorsOfType( eItemType.entitlement ) )
	{
		int entitlementType = Entitlement_GetEntitlementType( entitlementFlav )

		if ( entitlementType == eEntitlementType.FIRSTPARTY )
		{
			string enumString = Entitlement_GetEntitlementEnumValAsString( entitlementFlav )
			int enumVal       = Entitlement_GetEntitlementEnumVal( entitlementFlav )

			if ( Entitlement_IsEntitlementMarketplaceExclusive( entitlementFlav ) )
			{
				continue
			}

			int firstPartyRewardType = -1

			if ( enumString.find( "PSPLUS" ) == 0 )
			{
				firstPartyRewardType = eFirstPartyRewardType.PS_PLUS
			}
			else if ( enumString.find( "XBOX_GOLD" ) == 0 )
			{
				firstPartyRewardType = eFirstPartyRewardType.XBOX_GOLD
			}

			if ( firstPartyRewardType == eFirstPartyRewardType.PS_PLUS || firstPartyRewardType == eFirstPartyRewardType.XBOX_GOLD )
			{
				foreach ( var block in IterateSettingsAssetArray( ItemFlavor_GetAsset( entitlementFlav ), "list" ) )
				{
					ItemFlavor rewardFlav = GetItemFlavorByAsset( GetSettingsBlockAsset( block, "flavor" ) )

					if ( firstPartyRewardType == eFirstPartyRewardType.PS_PLUS )
					{
#if DEV
							Assert( ItemFlavor_HasExclusiveFunc( rewardFlav ), "PSPLUS reward " + string( ItemFlavor_GetAsset( rewardFlav )) + " must select the exclusive checkbox" )
							string exclusiveFuncString = GetGlobalSettingsString( ItemFlavor_GetAsset( rewardFlav ), "exclusiveFunc" )
							Assert( exclusiveFuncString == "psplus_or_xbgold", "PSPLUS reward " + string( ItemFlavor_GetAsset( rewardFlav )) + " must set the exclusiveFunc to psplus_or_xbgold " )
#endif

						fileLevel.entitlementRewardPSPlusMap[rewardFlav] <- enumVal
					}
					else if ( firstPartyRewardType == eFirstPartyRewardType.XBOX_GOLD )
					{
#if DEV
							Assert( ItemFlavor_HasExclusiveFunc( rewardFlav ), "XBOX_GOLD reward " + string( ItemFlavor_GetAsset( rewardFlav )) + " must select the exclusive checkbox" )
							string exclusiveFuncString = GetGlobalSettingsString( ItemFlavor_GetAsset( rewardFlav ), "exclusiveFunc" )
							Assert( exclusiveFuncString == "psplus_or_xbgold", "XBOX_GOLD reward " + string( ItemFlavor_GetAsset( rewardFlav )) + " must set the exclusiveFunc to psplus_or_xbgold " )
#endif

						fileLevel.entitlementRewardXboxGoldMap[rewardFlav] <- enumVal
					}
				}
			}
		}
	}
}


void function ShItems_LevelInit_Finish()
{
#if DEV
		PerfStart( PerfIndexShared.ItemFlavorRegistration )
#endif

	foreach ( RegisterItemFlavorsCallbackType cb in fileLevel.registerRootItemFlavorsCallbacks )
		cb()

	foreach ( OnPreAllItemFlavorsRegisteredCallbackType cb in fileLevel.OnPreAllItemFlavorsRegisteredCallbacks )
		cb()

	fileLevel.isItemRegistrationFinished = true

	foreach ( OnAllItemFlavorsRegisteredCallbackType cb in fileLevel.onAllItemFlavorsRegisteredCallbacks )
		cb()

#if DEV
		PerfEnd( PerfIndexShared.ItemFlavorRegistration )
#endif

	ShItems_CacheEntitlementForPSPlusAndXBGold()

#if DEV
		fileLevel.itemFlavorListAll.shrinktofit()
#endif
	fileLevel.itemFlavorListCosmetic.shrinktofit()
	foreach ( ItemTypeInfo typeInfo in fileLevel.itemTypeInfoList )
	{
		typeInfo.itemFlavorList.shrinktofit()
	}














}

bool function IsItemFlavorRegistrationFinished()
{
	return fileLevel.isItemRegistrationFinished
}






string function GetCleanAssetPathForItemFlavor( ItemFlavor flavor )
{
	
	
	
	
	
	
	
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	string assetPath = string(ItemFlavor_GetAsset( flavor ))
	assetPath = assetPath.slice( ITEM_FLAV_PREFIX.len(), assetPath.len() - ITEM_FLAV_SUFFIX.len() )
	assetPath = replace( assetPath, "/", "_" )
	Assert( assetPath == sanitize( assetPath ), "Weird characters in item flavor human readable ref: " + assetPath + " (only alphanumeric and underscore allowed)" )
	return assetPath
}

#if DEV
array<ItemFlavor> function DEV_GetAllItemFlavors()
{
	Assert( IsItemFlavorRegistrationFinished(), "Can't ask for all itemflavors before they are all registered" )
	return fileLevel.itemFlavorListAll
}


string function DEV_ItemFlavor_GetCleanedAssetPath( ItemFlavor flavor )
{
	return GetCleanAssetPathForItemFlavor( flavor )
}

bool function DEV_IsValidItemFlavorHumanReadableRef_Slow( string ref )
{
	foreach ( ItemFlavor flav in DEV_GetAllItemFlavors() )
	{
		if ( ref == DEV_ItemFlavor_GetCleanedAssetPath( flav ) )
			return true
	}

	return false
}

ItemFlavor function DEV_GetItemFlavorByHumanReadableRef_Slow( string ref )
{
	foreach ( ItemFlavor flav in DEV_GetAllItemFlavors() )
	{
		if ( ref == DEV_ItemFlavor_GetCleanedAssetPath( flav ) )
			return flav
	}
	Assert( false, "Invalid ref " + ref )

	unreachable
}
#endif


string function ItemFlavor_GetHumanReadableRefForPIN_Slow( ItemFlavor flavor )
{
	return GetCleanAssetPathForItemFlavor( flavor )
}



string function ItemFlavor_GetCleanDownloadAssetPath_Slow( ItemFlavor flavor )
{
	return GetCleanAssetPathForItemFlavor( flavor )
}

array<asset> function GetBaseItemFlavorsFromArray( string arrayFieldName )
{
	var parentBlock = GetSettingsBlockForAsset( baseItemFlavorAsset )
	var arrField    = GetSettingsBlockArray( parentBlock, arrayFieldName )
	array<asset> validAssets

	foreach ( var entryBlock in IterateSettingsArray( arrField ) )
	{
		asset entryAsset = GetSettingsBlockAsset( entryBlock, "flavor" )
		if ( entryAsset != $"" )
			validAssets.append( entryAsset )
	}

	return validAssets
}


void function AddCallback_RegisterRootItemFlavors( RegisterItemFlavorsCallbackType cb )
{
#if DEV
	Assert( !fileLevel.DEV_hasItemRegistrationStarted, "Callbacks must be added BEFORE item registration has started." )
#endif
	Assert( !fileLevel.registerRootItemFlavorsCallbacks.contains( cb ), "Callback already registered" )
	fileLevel.registerRootItemFlavorsCallbacks.append( cb )
}


void function AddCallback_OnItemFlavorRegistered( int itemType, OnItemFlavorRegisteredCallbackType cb )
{
#if DEV
	Assert( !fileLevel.DEV_hasItemRegistrationStarted )
#endif

	if ( !(itemType in fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap) )
		fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap[itemType] <- []

	Assert( !fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap[itemType].contains( cb ), "Callback already registered" )
	fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap[itemType].append( cb )
}

void function AddCallback_OnPreAllItemFlavorsRegistered( OnPreAllItemFlavorsRegisteredCallbackType cb )
{
	Assert( !fileLevel.OnPreAllItemFlavorsRegisteredCallbacks.contains( cb ), "Callback already registered" )
	fileLevel.OnPreAllItemFlavorsRegisteredCallbacks.append( cb )

	Assert( !fileLevel.isItemRegistrationFinished, "Item Registration has already finished, it's now too late to add a callback" )
}

void function AddCallbackOrMaybeCallNow_OnAllItemFlavorsRegistered( OnAllItemFlavorsRegisteredCallbackType cb )
{
	

	Assert( !fileLevel.onAllItemFlavorsRegisteredCallbacks.contains( cb ), "Callback already registered" )
	fileLevel.onAllItemFlavorsRegisteredCallbacks.append( cb )

	if ( fileLevel.isItemRegistrationFinished )
		cb()
}

const array<int> DELETED_GUIDS_LIST = [
	1352760251
]

bool function IsValidItemFlavorGUID( SettingsAssetGUID guid, int validationBehavior = eValidation.DONT_ASSERT )
{
	bool good = (guid in fileLevel.guidItemFlavorMap)

#if DEV
		if ( DELETED_GUIDS_LIST.contains( guid ) )
		{
			return false
		}
#endif

	Assert( good || validationBehavior != eValidation.ASSERT, "Unknown item flavor guid: " + guid )
	return good
}


ItemFlavor function GetItemFlavorByGUID( SettingsAssetGUID guid )
{
	Assert( guid != ASSET_SETTINGS_UNIQUE_ID_INVALID, "GUID parameter cannot be zero aka invalid" )
	Assert( IsValidItemFlavorGUID( guid, eValidation.ASSERT ) )

	return fileLevel.guidItemFlavorMap[ guid ]
}

ItemFlavor ornull function TryGetItemFlavorByGUID( SettingsAssetGUID guid )
{
	if ( !IsValidItemFlavorGUID( guid, eValidation.DONT_ASSERT ) )
		return null

	return fileLevel.guidItemFlavorMap[ guid ]
}

SettingsAssetGUID function ConvertItemFlavorGUIDStringToGUID( string guidString )
{
	if ( guidString.len() != (GUID_SAMPLE_STRING).len() )
		return ASSET_SETTINGS_UNIQUE_ID_INVALID

	if ( guidString.slice( 0, 4 ).toupper() != GUID_PREFIX )
		return ASSET_SETTINGS_UNIQUE_ID_INVALID

	return int( guidString.slice( 4 ) )
}


ItemFlavor ornull function GetItemFlavorOrNullByGUID( SettingsAssetGUID guid, int expectedItemType = eItemType.INVALID )
{
	
	if ( !IsValidItemFlavorGUID( guid ) )
		return null

	ItemFlavor flav = fileLevel.guidItemFlavorMap[ guid ]
	if ( expectedItemType != eItemType.INVALID && flav.typeIndex != expectedItemType )
		return null

	return flav
}

int function GetItemFlavorTypeByString( string itemType )
{
	Assert( itemType in eItemType, "Unknown item type: " + itemType + " ( check eItemType matches code_root.rson and that itemtype was defined in settings_itemtypes.csv )" )

	var itemTypeFromEnum = eItemType[itemType]
	expect int( itemTypeFromEnum )

	return itemTypeFromEnum
}

bool function IsValidItemFlavorSettingsAsset( asset itemAsset, int validationBehavior = eValidation.DONT_ASSERT )
{
	if ( itemAsset == $"" )
	{
		Assert( false || validationBehavior != eValidation.ASSERT, "Blank item settings asset passed" )
		return false
	}

	int guid = GetUniqueIdForSettingsAsset( itemAsset )
	bool good = ( guid in fileLevel.guidItemFlavorMap )

	Assert( good || validationBehavior != eValidation.ASSERT, "Bad item settings asset: " + itemAsset )
	return good
}


ItemFlavor function GetItemFlavorByAsset( asset itemAsset )
{
	Assert( IsValidItemFlavorSettingsAsset( itemAsset, eValidation.ASSERT ) )

	int guid = GetUniqueIdForSettingsAsset( itemAsset )

	return fileLevel.guidItemFlavorMap[ guid ]
}


bool function IsValidItemFlavorType( int typeIndex, int validationBehavior = eValidation.DONT_ASSERT )
{
	bool good = (typeIndex > eItemType.INVALID && typeIndex < eItemType.COUNT && typeIndex != eItemType.__loot_start && typeIndex != eItemType.__loot_end)

	Assert( good || validationBehavior != eValidation.ASSERT, "Invalid item type index: " + typeIndex )
	return good
}


string function DescribeItemFlavorType( int itemType )
{
	if ( IsValidItemFlavorType( itemType, eValidation.ASSERT ) )
	{
		return GetEnumString( "eItemType", itemType )
	}

	return "InvalidItemType"
}


