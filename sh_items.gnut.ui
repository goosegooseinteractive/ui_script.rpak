int function ItemFlavor_GetAccountPackType( ItemFlavor pack )
{
	Assert( IsItemFlavorStructValid( pack.guid, eValidation.ASSERT ) )
	Assert( ItemFlavor_GetType( pack ) == eItemType.account_pack )

	asset itemAsset = ItemFlavor_GetAsset( pack )
	string settingsString = GetGlobalSettingsString( itemAsset, "packType" )
	return ItemFlavor_ConvertPackTypeStringToEnum( settingsString )
}

int function ItemFlavor_ConvertPackTypeStringToEnum( string packTypeString )
{
	switch ( packTypeString )
	{
		case "APEX_PACK":
			return eAccountPackType.APEX
		case "EVENT_PACK":
			return eAccountPackType.EVENT
		case "EVENT_THEMATIC_PACK":
			return eAccountPackType.EVENT_THEMATIC
		case "THEMATIC_PACK":
			return eAccountPackType.THEMATIC
		case "MYTHIC_PACK":
			return eAccountPackType.MYTHIC
		case "SIRNGE_PACK":
			return eAccountPackType.SIRNGE
		case "RETRO_PACK":
			return eAccountPackType.RETRO_PACK
		case "RETRO_BACKFILL_PACK":
			return eAccountPackType.RETRO_BACKFILL_PACK
		case "RETRO_ESCALATING_PACK":
			return eAccountPackType.RETRO_ESCALATING_PACK
		case "RETRO_ESCALATING_BACKFILL_PACK":
			return eAccountPackType.RETRO_ESCALATING_BACKFILL_PACK
		case "WISHLIST_PACK":
			return eAccountPackType.WISHLIST_PACK

		default:
			
			
			return eAccountPackType.APEX 
	}
	unreachable
}

bool function ItemFlavor_IsApexPack( ItemFlavor pack )
{
	if ( ItemFlavor_GetType( pack ) == eItemType.account_pack && ItemFlavor_GetAccountPackType( pack ) == eAccountPackType.APEX )
		return true

	return false
}




bool function ItemFlavor_IsWishlistSirngePack( ItemFlavor pack )
{
	Assert( IsItemFlavorStructValid( pack.guid, eValidation.ASSERT ) )
	Assert( ItemFlavor_GetType( pack ) == eItemType.account_pack && ItemFlavor_GetAccountPackType( pack ) == eAccountPackType.SIRNGE )

	if ( ItemFlavor_GetAccountPackType( pack ) != eAccountPackType.SIRNGE )
		return false

	asset itemAsset = ItemFlavor_GetAsset( pack )
	return GetGlobalSettingsBool( itemAsset, "isWishlistSirngePack" )
}

bool function ItemFlavor_IsWishlistPack( ItemFlavor pack )
{
	if ( ItemFlavor_GetType( pack ) != eItemType.account_pack )
		return false

	int accountPackType = ItemFlavor_GetAccountPackType( pack )
	if ( accountPackType == eAccountPackType.SIRNGE )
		return ItemFlavor_IsWishlistSirngePack( pack )
	else if ( accountPackType == eAccountPackType.WISHLIST_PACK )
		return true

	return false
}

bool function ItemFlavor_IsWishlistUpgradablePack( ItemFlavor pack )
{
	if ( !ItemFlavor_IsApexPack( pack ) )
	{
		return false
	}

	
	SettingsAssetGUID guid = ItemFlavor_GetGUID( pack )
	return 	guid == 1124352130 || 	
			guid == 1133168882 || 	
			guid == 491582306 		
}

bool function ItemFlavor_IsWishlistRelatedPack( ItemFlavor pack )
{
	return ItemFlavor_IsWishlistPack( pack ) || ItemFlavor_IsWishlistUpgradablePack( pack )
}

int function GetPlaylistAvailabilityByRef( array< string > refs )
{
	
	foreach ( ref in refs )
	{
		if ( HIDDEN_CHARACTER_REFS.len() > 0 && HIDDEN_CHARACTER_REFS.contains( ref ) )
			return eItemFlavorPlaylistAvailability.HIDDEN

		string playlistVar = GetCurrentPlaylistVarString( ref, "none" ).tolower()

		
		if ( refs.len() == 1 && playlistVar == "none" )
			return eItemFlavorPlaylistAvailability.NONE

		else if ( playlistVar == "enable" )
			return eItemFlavorPlaylistAvailability.ENABLED

		else if ( playlistVar == "disable_grx_ops" )
			return eItemFlavorPlaylistAvailability.GRX_DISABLED

		else if ( playlistVar == "lock" )
			return eItemFlavorPlaylistAvailability.LOCKED

		else if ( playlistVar == "hide" )
			return eItemFlavorPlaylistAvailability.HIDDEN

		else if ( playlistVar == "disable" )
			return eItemFlavorPlaylistAvailability.DISABLED

		else if ( playlistVar == "force_unlock_for_special_event" )
			return eItemFlavorPlaylistAvailability.FORCE_UNLOCK_FOR_SPECIAL_EVENT





	}

	return eItemFlavorPlaylistAvailability.NONE
}


int function ItemFlavor_GetPlaylistAvailability( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )

	if ( flavor.metaData == null )
		return eItemFlavorPlaylistAvailability.NONE

	table<string, string> ornull metaData = flavor.metaData
	expect table<string, string>(metaData)

	if ( PLAYLIST_AVAILABILITY_META_DATA_KEY in metaData )
		return int(metaData[ PLAYLIST_AVAILABILITY_META_DATA_KEY ])

	return eItemFlavorPlaylistAvailability.NONE
}


bool function ItemFlavor_IsAvailableInPlaylist( ItemFlavor flavor )
{
	int op = ItemFlavor_GetPlaylistAvailability( flavor )

	if ( op == eItemFlavorPlaylistAvailability.NONE )
		return true

	if ( op == eItemFlavorPlaylistAvailability.ENABLED )
		return true

	if ( op == eItemFlavorPlaylistAvailability.FORCE_UNLOCK_FOR_SPECIAL_EVENT )
		return true

	return false
}


bool function ItemFlavor_IsItemDisabledForGRX( ItemFlavor flavor )
{
	if ( ItemFlavor_GetPlaylistAvailability( flavor ) == eItemFlavorPlaylistAvailability.GRX_DISABLED )
		return true

	return false
}


bool function ItemFlavor_ShouldBeVisible( ItemFlavor flavor, entity player, int ornull overrideEditionOrNull = null )
{
	int availableState = ItemFlavor_GetPlaylistAvailability( flavor )
	if ( availableState == eItemFlavorPlaylistAvailability.HIDDEN )
		return false
	else if ( availableState == eItemFlavorPlaylistAvailability.DISABLED )
		return false

	int edition
	if ( overrideEditionOrNull == null )
	{
		Assert( player != null )
		edition = GRX_GetPlayerEdition( player )
	}
	else
	{
		Assert( player == null )
		edition = expect int(overrideEditionOrNull)
	}

	return ItemFlavor_IsActiveForEdition( flavor, edition )
}


bool function ItemFlavor_IsTheFavoriteSentinel( ItemFlavor flavor )
{
	return GetGlobalSettingsBool( ItemFlavor_GetAsset( flavor ), "isTheFavoriteSentinel" )
}


bool function ItemFlavor_IsActiveForEdition( ItemFlavor flavor, int edition )
{
	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.loot_main_weapon:
			if ( MainWeapon_GetIsShippingWeapon( flavor ) )
				return true
			if ( edition < GetItemFlavorPlaylistEdition( flavor ) )
				return false
			break

		case eItemType.character:
			if ( CharacterClass_GetIsShippingCharacter( flavor ) )
				return true
			if ( edition < GetItemFlavorPlaylistEdition( flavor ) )
				return false
			break
	}

	return true
}


bool function ItemFlavor_CheckType( ItemFlavor flavor, int expectedTypeIndex, int validationBehavior = eValidation.DONT_ASSERT )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	int typeIndex = ItemFlavor_GetType( flavor )
	bool good     = (typeIndex == expectedTypeIndex)

	Assert( good || validationBehavior != eValidation.ASSERT, "Item flavor type validation failed."
	+ " Expected type " + GetEnumString( "eItemType", expectedTypeIndex ) + " but got "
	+ DEV_GetEnumStringSafe( "eItemType", typeIndex ) + "."
	)
	return good
}


bool function ItemFlavor_HasQualityAndRarityIsAtLeast( ItemFlavor flavor, int rarity )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	string enumKey = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "quality" )
	if ( enumKey == "NONE" )
		return false

	Assert( enumKey in eRarityTier, "Invalid eQuality enum value: " + enumKey )

	return ( eRarityTier[enumKey] >= rarity )
}

bool function ItemFlavor_HasQuality( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	string enumKey = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "quality" )
	return enumKey != "NONE"
}


int function ItemFlavor_GetQuality( ItemFlavor flavor, int ornull fallbackValue = null )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	string enumKey = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "quality" )
	if ( enumKey == "NONE" )
	{
		if ( fallbackValue != null )
			return expect int(fallbackValue)
		else
		{
#if DEBUG_ITEM_QUALITY_LOOKUP
				printf( "Item flavor %s has no quality.", string(ItemFlavor_GetAsset( flavor )) )
#endif
			return eRarityTier.NONE
		}
	}
	Assert( enumKey in eRarityTier, "Invalid eQuality enum value: " + enumKey )

	return eRarityTier[enumKey]
}


vector function ItemFlavor_GetQualityColor( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	return GetFXRarityColorForUnlockable( ItemFlavor_GetQuality( flavor ) )
}


string function ItemFlavor_GetQualityName( ItemFlavor flavor, bool isPlural = false )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )
	return ItemQuality_GetQualityName( ItemFlavor_GetQuality( flavor ), isPlural )
}

bool function ItemFlavor_IsThematic( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )

	if ( ItemFlavor_GetType( flavor ) != eItemType.account_pack )
		return false

	var packType = ItemFlavor_GetAccountPackType( flavor )
	return packType == eAccountPackType.THEMATIC || packType == eAccountPackType.EVENT_THEMATIC
}

bool function ItemFlavor_IsCurrency( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )

	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.account_currency:
		case eItemType.account_currency_bundle:
		case eItemType.apex_coins:
			return true
	}

	return false
}

bool function ItemFlavor_IsApexPackBrowsable( ItemFlavor flavor )
{
	return ItemFlavor_GetType( flavor ) == eItemType.account_pack ? GRXPack_GetIsLootPoolBrowsable( flavor ) : false
}

string function ItemQuality_GetQualityName( int quality, bool isPlural = false)
{
	switch ( quality )
	{
		case 5:
			return isPlural ? "#LOOT_TIER6_PLURAL" : "#LOOT_TIER6"

		case 4:
			return isPlural ? "#LOOT_TIER5_PLURAL" : "#LOOT_TIER5"

		case 3:
			return isPlural ? "#LOOT_TIER4_PLURAL" : "#LOOT_TIER4"

		case 2:
			return isPlural ? "#LOOT_TIER3_PLURAL" : "#LOOT_TIER3"

		case 1:
			return isPlural ? "#LOOT_TIER2_PLURAL" : "#LOOT_TIER2"

		case 0:
			return isPlural ? "#LOOT_TIER1_PLURAL" : "#LOOT_TIER1"

		case -1:
			return ""
	}
	unreachable
}







string function DEV_DescItemFlavor( ItemFlavor ornull flav, bool short = false )
{
	if ( flav == null )
		return "~~null~~"
	expect ItemFlavor( flav )

	if ( !IsItemFlavorStructValid( flav.guid, eValidation.DONT_ASSERT ) )
		return "~~invalid~~"

	if ( short )
		return string(ItemFlavor_GetAsset( flav ))

	return format( "~~%s:%s:%s~~", DEV_GetEnumStringSafe( "eItemType", ItemFlavor_GetType( flav ) ), string(ItemFlavor_GetAsset( flav )), ItemFlavor_GetGUIDString( flav ) )
}



int function GetItemFlavorPlaylistEdition( ItemFlavor flavor )
{
	string ref      = ItemFlavor_GetGUIDString( flavor )
	int playlistVar = GetCurrentPlaylistVarInt( ref + "_edition", -1 )

	if ( playlistVar <= 0 )
		return 99999

	return playlistVar
}


array<var> function IterateSettingsAssetArray( asset settingsAsset, string arrayFieldName )
{
	var assetBlock       = GetSettingsBlockForAsset( settingsAsset )
	var arr              = GetSettingsBlockArray( assetBlock, arrayFieldName )
	int arraySize        = GetSettingsArraySize( arr )

	array<var> arrBlocks = []
	arrBlocks.resize( arraySize )

	for ( int entryIdx = 0; entryIdx < arraySize; entryIdx++ )
	{
		arrBlocks[entryIdx] = GetSettingsArrayElem( arr, entryIdx )
	}
	return arrBlocks
}


array<var> function IterateSettingsArray( var arr )
{
	int arraySize        = GetSettingsArraySize( arr )

	array<var> arrBlocks = []
	arrBlocks.resize( arraySize )

	for ( int entryIdx = 0; entryIdx < arraySize; entryIdx++ )
	{
		arrBlocks[entryIdx] = GetSettingsArrayElem( arr, entryIdx )
	}
	return arrBlocks
}


array<ItemFlavor> function RegisterReferencedItemFlavorsFromArray( ItemFlavor parentFlavor, string arrayFieldName, string refFieldName )
{
	array<ItemFlavor> loaded = []
	var parentBlock          = ItemFlavor_GetSettingsBlock( parentFlavor )
	var arrField             = GetSettingsBlockArray( parentBlock, arrayFieldName )



	foreach ( var entryBlock in IterateSettingsArray( arrField ) )
	{
		asset entryAsset = GetSettingsBlockAsset( entryBlock, refFieldName )
		if ( entryAsset == $"" )
		{
			Warning( "Warning: Asset \"" + ItemFlavor_GetAsset( parentFlavor ) + "\" has an empty entry in array \"" + arrayFieldName + "\"" )
			continue
		}
		ItemFlavor ornull childFlavorOrNull = RegisterItemFlavorFromSettingsAsset( entryAsset )
		if ( childFlavorOrNull != null )
		{
			ItemFlavor childFlavor =  expect ItemFlavor(childFlavorOrNull)
			loaded.append( childFlavor )









		}
	}
	return loaded
}

















































































































void function MakeItemFlavorSet( array<ItemFlavor> list, table<ItemFlavor, int> sortOrdinalMap, bool validateHasNonGRX )
{
	








	if ( validateHasNonGRX )
	{
		ItemFlavor defaultFlavor = list[0]
		if ( ItemFlavor_GetGRXMode( defaultFlavor ) != eItemFlavorGRXMode.NONE )
		{
			bool found = false
			foreach ( ItemFlavor flav in list )
			{
				if ( ItemFlavor_GetGRXMode( flav ) == eItemFlavorGRXMode.NONE )
				{
					defaultFlavor = flav
					found         = true
					break
				}
			}
			Assert( found )
			list.fastremovebyvalue( defaultFlavor )
			list.insert( 0, defaultFlavor )
		}
		Assert( ItemFlavor_GetGRXMode( list[0] ) == eItemFlavorGRXMode.NONE )
	}

	foreach ( int index, ItemFlavor flavor in list )
	{
		sortOrdinalMap[flavor] <- index
	}
}


ItemFlavor ornull function RegisterItemFlavorFromSettingsAsset( asset settingsAsset )
{
	Assert( settingsAsset != $"" )
#if DEV
		fileLevel.DEV_hasItemRegistrationStarted = true
#endif

#if DEBUG_ITEM_FLAVOR_REGISTRATION
		printt( "DEBUG_ITEM_FLAVOR_REGISTRATION", FUNC_NAME(), settingsAsset, "Registering..." )
#endif

	int guid = GetUniqueIdForSettingsAsset( settingsAsset )
	if ( guid in fileLevel.guidItemFlavorMap )
	{
		
		return fileLevel.guidItemFlavorMap[ guid ]
	}

	string assetPath = string( settingsAsset )
	Assert( !fileLevel.isItemRegistrationFinished, "Attempted to register item flavor after registration period ended (" + assetPath + ")" )

	
	Assert( assetPath.find( ITEM_FLAV_PREFIX ) == 0 )

	string guidString = ConvertAssetIDToGUIDString( GetUniqueIdForSettingsAsset( settingsAsset ) )

	ItemFlavor flavor

	string itemType = GetGlobalSettingsString( settingsAsset, "itemType" )
	flavor.typeIndex = GetItemFlavorTypeByString( itemType )

	string humanReadableRef = ""
	if ( itemTypesThatNeedHumanReadableRef.contains( flavor.typeIndex ) )
	{
		
		humanReadableRef = assetPath.slice( ITEM_FLAV_PREFIX.len(), assetPath.len() - ITEM_FLAV_SUFFIX.len() )
		humanReadableRef = replace( humanReadableRef, "/", "_" )
		Assert( humanReadableRef == sanitize( humanReadableRef ), "Weird characters in item flavor human readable ref: " + humanReadableRef + " (only alphanumeric and underscore allowed)" )
	}

	int availability = flavor.typeIndex == eItemType.character ? GetPlaylistAvailabilityByRef( [ humanReadableRef, guidString ] ) : GetPlaylistAvailabilityByRef( [ guidString ] )
	if ( availability == eItemFlavorPlaylistAvailability.DISABLED )
	{
		if ( flavor.typeIndex == eItemType.character )
		{
			Warning( "Overriding DISABLE for Character %s to HIDDEN. Do NOT use `disable` for Characters; use `hide` to prevent children and referencing itemflavors from having issues.", humanReadableRef )
			availability = eItemFlavorPlaylistAvailability.HIDDEN
		}
		else
		{
			printt( "Item flavor disabled by playlist vars: " + humanReadableRef + " | " + guidString )

#if DEBUG_ITEM_FLAVOR_REGISTRATION
				printt( "DEBUG_ITEM_FLAVOR_REGISTRATION", FUNC_NAME(), settingsAsset, "Disabled by playlist!" )
#endif
			return null
		}
	}
	if ( flavor.typeIndex == eItemType.character && availability != eItemFlavorPlaylistAvailability.ENABLED )
	{
		
		int shippingStatus = eItemFlavorShippingStatus[GetGlobalSettingsString( settingsAsset, "shippingStatus" )]
		if ( shippingStatus == eItemFlavorShippingStatus.WIP_HIDE )
			availability = eItemFlavorPlaylistAvailability.HIDDEN
	}

	if ( flavor.typeIndex == eItemType.challenge )
		flavor.metaData = GetChallengeMetaDataFromAsset( settingsAsset )

	if ( IsCalEvent( flavor.typeIndex ) || ITEM_TYPES_WITH_DATETIME_ATTRIBUTES.contains( flavor.typeIndex ) )
	{
		if ( flavor.typeIndex == eItemType.battlepass )
		{
			if ( GetGlobalSettingsString( settingsAsset, "passType" ) == "SEASONAL" || GetGlobalSettingsString( settingsAsset, "passType" ) == "ACCOUNT" )
			{
				flavor.metaData = GetTimestampMetaDataFromAsset( settingsAsset, flavor.typeIndex, true )
			}
		}
		else
		{
			flavor.metaData = GetTimestampMetaDataFromAsset( settingsAsset, flavor.typeIndex, true )
		}
	}

	
	if ( flavor.typeIndex == eItemType.character )
	{
		table<string, string> tmp = {}
		tmp[ "character_ref" ] <- humanReadableRef
		flavor.metaData = tmp
	}








	else if ( flavor.typeIndex == eItemType.calevent_season )
	{
		table<string, string> ornull tmp = flavor.metaData
		expect table<string, string>(tmp)
		tmp[ "season_ref" ] <- humanReadableRef
	}
	else if ( flavor.typeIndex == eItemType.calevent_rankedperiod )
	{
		table<string, string> ornull tmp = flavor.metaData
		expect table<string, string>(tmp)
		tmp[ "rankedperiod_ref" ] <- humanReadableRef
	}
	else if ( flavor.typeIndex == eItemType.calevent_arenas_ranked_period )
	{
		table<string, string> ornull tmp = flavor.metaData
		expect table<string, string>(tmp)
		tmp[ "arenas_ranked_period_ref" ] <- humanReadableRef
	}
	

	
	if ( availability != eItemFlavorPlaylistAvailability.NONE )
	{
		table<string, string> ornull tmp = flavor.metaData
		bool needsMetaDataInit
		if ( tmp == null )
		{
			tmp = {}
			needsMetaDataInit = true
		}

		expect table<string, string>(tmp)
		tmp[ PLAYLIST_AVAILABILITY_META_DATA_KEY ] <- string( availability )

		if ( needsMetaDataInit )
			flavor.metaData = tmp
	}

	flavor.guid = GetUniqueIdForSettingsAsset( settingsAsset )
	Assert( !(flavor.guid in fileLevel.guidItemFlavorMap),
		format( "Duplicate item GUID: %d (%s and %s)", flavor.guid, string(ItemFlavor_GetAsset( fileLevel.guidItemFlavorMap[flavor.guid] )), string(settingsAsset) ) )

	if ( flavor.typeIndex > eItemType._CALEVENT_LIMITED_TIME && flavor.typeIndex < eItemType._CALEVENT_RANGE_END && CalEvent_IsExpired( flavor ) )
		return null 

	fileLevel.guidItemFlavorMap[flavor.guid] <- flavor
	fileLevel.itemTypeInfoList[flavor.typeIndex].itemFlavorList.append( flavor ) 

#if DEV
		fileLevel.itemFlavorListAll.append( flavor )
#endif

	
	ShGRX_RegisterItemFlavor( flavor )


		Loadouts_SetSortPriorityForItemFlavor( flavor )


	if ( ItemFlavor_IsEquippableCosmeticType( flavor.typeIndex ) )
	{
		fileLevel.itemFlavorListCosmetic.append( flavor )
		if ( ItemFlavor_GetGRXMode( flavor ) == eItemFlavorGRXMode.REGULAR && ItemFlavor_HasQualityAndRarityIsAtLeast( flavor, eRarityTier.LEGENDARY ) )
			fileLevel.legendaryItemFlavors.append( flavor )
	}

	if ( flavor.typeIndex in fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap )
	{
		foreach ( OnItemFlavorRegisteredCallbackType cb in fileLevel.itemTypeOnItemFlavorRegisteredCallbackListMap[flavor.typeIndex] )
			cb( flavor )
	}

#if DEBUG_ITEM_FLAVOR_REGISTRATION
		printt( "DEBUG_ITEM_FLAVOR_REGISTRATION", FUNC_NAME(), settingsAsset, "Done!" )
#endif
	return flavor
}



ItemFlavorStack function MakeItemFlavorStack( ItemFlavor flav, int qty )
{
	ItemFlavorStack result
	result.flav = flav
	result.qty = qty
	return result
}




bool function IsItemFlavorBagValid( ItemFlavorBag bag, bool allowEmpty, int assertBehavior = eValidation.DONT_ASSERT )
{
	if ( bag.flavors.len() == 0 )
	{
		Assert( allowEmpty || assertBehavior != eValidation.ASSERT, format( "ItemFlavorBag is empty: %s", DEV_DescribeItemFlavorBag( bag ) ) )
		return allowEmpty
	}

	if ( bag.flavors.len() != bag.quantities.len() )
	{
		Assert( assertBehavior != eValidation.ASSERT, format( "ItemFlavorBag flavor/quantity array size mismatch: %s", DEV_DescribeItemFlavorBag( bag ) ) )
		return false
	}

	table<ItemFlavor, bool> seenFlavs = {}
	foreach ( int itemIdx, ItemFlavor itemFlav in bag.flavors )
	{
		if ( itemFlav in seenFlavs && !ItemFlavorIsStackable( itemFlav ) )
		{
			Assert( assertBehavior != eValidation.ASSERT, format( "ItemFlavorBag has duplicate flavor: %s", DEV_DescribeItemFlavorBag( bag ) ) )
			return false
		}
		seenFlavs[itemFlav] <- true

		if ( bag.quantities[itemIdx] <= 0 )
		{
			Assert( assertBehavior != eValidation.ASSERT, format( "ItemFlavorBag has bad quantity: %s", DEV_DescribeItemFlavorBag( bag ) ) )
			return false
		}
	}

	return true
}




ItemFlavorBag function MakeItemFlavorBag( table<ItemFlavor, int> contents )
{
	ItemFlavorBag result
	foreach ( ItemFlavor flav, int quantity in contents )
	{
		result.flavors.append( flav )
		result.quantities.append( quantity )
	}
	Assert( IsItemFlavorBagValid( result, true, eValidation.ASSERT ) )
	return result
}




void function ItemFlavorBag_ClearZeroQuantityFlavors( ItemFlavorBag bag )
{
	for ( int itemIdx = bag.flavors.len() - 1; itemIdx >= 0; itemIdx-- )
	{
		if ( bag.quantities[itemIdx] == 0 )
		{
			bag.flavors.remove( itemIdx )
			bag.quantities.remove( itemIdx )
		}
	}
}




ItemFlavor function ItemFlavorBag_GetSingleOutputItemFlavor_Assert( ItemFlavorBag bag )
{
	Assert( bag.flavors.len() == 1 )
	Assert( IsItemFlavorStructValid( bag.flavors[0].guid, eValidation.DONT_ASSERT ) )
	return bag.flavors[0]
}




ItemFlavor function ItemFlavorBag_GetMeleeSkinItem( ItemFlavorBag bag )
{
	Assert( bag.flavors.len() >= 1 )

	array<ItemFlavor> meleeSkinItems
	foreach ( item in bag.flavors )
	{
		if ( ItemFlavor_GetType( item ) == eItemType.melee_skin )
			meleeSkinItems.append( item )
	}

	Assert( meleeSkinItems.len() == 1, "Offer expected to contain 1 melee skin but found " + meleeSkinItems.len() + "." )
	Assert( IsItemFlavorStructValid( meleeSkinItems[0].guid, eValidation.DONT_ASSERT ) )

	return meleeSkinItems[0]
}



ItemFlavor function ItemFlavorBag_GetMythicSkinItem( ItemFlavorBag bag )
{
	Assert( bag.flavors.len() >= 1 )

	bool foundMythicSkin = false
	ItemFlavor mythicSkin
	foreach ( item in bag.flavors )
	{
		if ( Mythics_IsItemFlavorMythicSkin( item ) )
		{
			Assert( !foundMythicSkin, "Offer contains more than one mythic skin" )
			foundMythicSkin = true
			mythicSkin = item
		}
	}

	Assert( IsItemFlavorStructValid( mythicSkin.guid, eValidation.DONT_ASSERT ) )

	return mythicSkin
}



int function ItemFlavorBag_GetHighestRarity( ItemFlavorBag bag )
{
	int maxQuality = 0
	foreach ( item in bag.flavors )
	{
		int quality = ItemFlavor_GetQuality( item )
		if ( quality > maxQuality )
			maxQuality = quality
	}
	return maxQuality
}



int function RewardItemFlavorArray_GetHighestRarity( array<RewardItemFlavor> rewards )
{
	int maxQuality = 0
	foreach ( reward in rewards )
	{
		int quality = ItemFlavor_GetQuality( reward.reward )
		if ( quality > maxQuality )
			maxQuality = quality
	}
	return maxQuality
}



table<ItemFlavor, int> function ItemFlavorBag_ToQuantityMap( ItemFlavorBag bag )
{
	table<ItemFlavor, int> out = {}
	foreach ( int idx, ItemFlavor flav in bag.flavors )
		out[flav] <- bag.quantities[idx]
	return out
}



bool function ItemFlavorBag_HasSameContents( ItemFlavorBag first, ItemFlavorBag second )
{
	if ( first.flavors.len() != second.flavors.len() )
	{
		return false
	}

	for ( int i = 0; i < first.flavors.len(); ++i )
	{
		if ( first.flavors[i] != second.flavors[i] )
		{
			return false
		}

		if ( first.quantities[i] != second.quantities[i] )
		{
			return false
		}
	}

	return true
}



bool function ItemFlavorBag_HasItemType( ItemFlavorBag bag, int itemType )
{
	Assert( itemType > eItemType.INVALID && itemType < eItemType.COUNT )

	for ( int i = 0; i < bag.flavors.len(); ++i )
	{
		if ( bag.flavors[i].typeIndex == itemType )
		{
			return true
		}
	}

	return false
}



string function DEV_DescribeItemFlavorBag( ItemFlavorBag bag )
{
	string errorStr = ""
	if ( bag.associatedError != GRX_INVENTORYERROR_NONE )
	{
		errorStr = format( "(ERROR:%d) ", bag.associatedError )
	}

	array<string> contents
	int maxIdx = maxint( bag.flavors.len(), bag.quantities.len() )

	for ( int itemIdx = 0; itemIdx < maxIdx; itemIdx++ )
	{
		string itemFlavStr = "MISSING"
		string quantityStr = "MISSING"

		if ( bag.flavors.isvalidindex( itemIdx ) )
		{
			itemFlavStr = "INVALID"

			ItemFlavor itemFlav = bag.flavors[itemIdx]
			if ( IsItemFlavorStructValid( itemFlav.guid, eValidation.DONT_ASSERT ) )
			{
				itemFlavStr = ItemFlavor_GetAssetName( itemFlav )
			}
		}

		if ( bag.quantities.isvalidindex( itemIdx ) )
		{
			quantityStr = string( bag.quantities[itemIdx] )
		}

		string itemStr = format( "%s*%s", itemFlavStr, quantityStr )
		contents.append( itemStr )
	}

	string rv = format( "%s%s", errorStr, contents.join( ", " ) )
	return rv
}













bool function ItemFlavor_HasExclusiveFunc( ItemFlavor flavor )
{
	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.character_skin:
		case eItemType.weapon_skin:
		case eItemType.weapon_charm:
		case eItemType.loadscreen:
		case eItemType.gladiator_card_frame:
		case eItemType.gladiator_card_badge:
			return GetGlobalSettingsBool( ItemFlavor_GetAsset( flavor ), "exclusive" )
			break
	}

	return false
}


bool function ItemFlavor_HasUnlockFunc( ItemFlavor flavor )
{
	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.character_skin:
		case eItemType.weapon_skin:
		case eItemType.gladiator_card_frame:
			return GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "unlockFuncKey" ) != ""
			break
	}

	return false
}


string function ItemFlavor_GetUnlockFuncKey( ItemFlavor flavor )
{
	string unlockFuncString = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "unlockFuncKey" )
	return unlockFuncString
}


bool function ItemFlavor_IsMarketplaceExclusive( ItemFlavor flavor, entity player )
{
#if DEV
	if ( IsEverythingUnlocked() )
	{
		
		return false
	}
#endif

	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.character_skin:
		case eItemType.weapon_skin:
		case eItemType.weapon_charm:
		case eItemType.loadscreen:
		case eItemType.gladiator_card_frame:
		case eItemType.gladiator_card_badge:
			break

		default:
			return false
	}

	if ( GetGlobalSettingsBool( ItemFlavor_GetAsset( flavor ), "marketplaceExclusivePSOnly" ) && PlayerIsOnPlayStation( player ) )
	{
		return true
	}
	else if ( GetGlobalSettingsBool( ItemFlavor_GetAsset( flavor ), "marketplaceExclusiveXBOnly" ) && PlayerIsOnXbox( player ) )
	{
		return true
	}

	return GetGlobalSettingsBool( ItemFlavor_GetAsset( flavor ), "marketplaceExclusive" )
}

bool function ItemFlavor_PassesUnlockFunc( ItemFlavor flavor, entity player )
{
	if ( IsEverythingUnlocked() )
		return true

	string unlockFuncString = ItemFlavor_GetUnlockFuncKey( flavor )
	Assert( unlockFuncString in file.unlockFuncs, "unlockFuncKey from bakery isn't mapped to a function" )
	return file.unlockFuncs[unlockFuncString]( player )
}


bool function ItemFlavor_PassesExclusiveFunc( ItemFlavor flavor, entity player )
{
	if ( IsEverythingUnlocked() )
		return true

	string exclusiveFuncString = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "exclusiveFunc" )
	Assert( exclusiveFuncString in file.exclusiveFuncs, "exclusiveFuncKey from bakery isn't mapped to a function" )
	return file.exclusiveFuncs[exclusiveFuncString]( player, flavor )
}


bool function ItemFlavor_HasEntitlement( ItemFlavor flavor )
{
	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.character_skin:
		case eItemType.weapon_skin:
		case eItemType.gladiator_card_frame:
			return GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "unlockEntitlement" ) != ""
			break
	}

	return false
}


string function ItemFlavor_GetEntitlement( ItemFlavor flavor )
{
	string unlockEntitlement = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "unlockEntitlement" )
	return unlockEntitlement
}


bool function ItemFlavor_HasFeatures( ItemFlavor flavor )
{
	switch ( ItemFlavor_GetType( flavor ) )
	{
		case eItemType.character_skin:
			return CharacterSkin_HasCustomCharSelectAnims( flavor )
			break
	}

	return false
}

ItemFlavorCustomControlPointData function ItemFlavor_GetCustomControlPointData( ItemFlavor source )
{
	asset sourceAsset = ItemFlavor_GetAsset( source )

	ItemFlavorCustomControlPointData data
	foreach ( var controlPointBlock in IterateSettingsAssetArray( sourceAsset, "customControlPoints" ) )
	{
		int index = GetSettingsBlockInt( controlPointBlock, "index" )
		vector vec = GetSettingsBlockVector( controlPointBlock, "value" )
		string comment = GetSettingsBlockString( controlPointBlock, "comment" )

		Assert( !(index in data), format( "Duplicate control point index %d in asset %s - see comment in Bakery: \"%s\"", index, sourceAsset, comment ) )
		data[index] <- vec
	}
	return data
}

vector function ItemFlavor_GetCustomControlPointValueByIndex( ItemFlavor source, int index )
{
	ItemFlavorCustomControlPointData data = ItemFlavor_GetCustomControlPointData( source )
	if ( !(index in data) )
	{
		Assert( false, format( "Control point \"%d\" not found in asset %s", index, ItemFlavor_GetAssetString( source ) ) )
		return <0, 0, 0>
	}

	return data[index]
}

vector function CustomControlPoint_GetValueByIndex( ItemFlavorCustomControlPointData data, int index )
{
	if ( !(index in data) )
	{
		Assert( false, format( "Control point \"%d\" not found in custom control point data", index ) )
		return <0, 0, 0>
	}

	return data[index]
}

