int function ItemFlavor_SortByTier( ItemFlavor a, ItemFlavor b )
{
	int aTier = ItemFlavor_GetQuality( a, 0 )
	int bTier = ItemFlavor_GetQuality( b, 0 )

	if ( aTier > bTier )
		return -1

	if ( aTier < bTier )
		return 1

	return 0
}

array<ItemFlavor> function FilterItemFlavorsByType( array<ItemFlavor> list, int typeFilter )
{
	array<ItemFlavor> results

	foreach ( item in list )
	{
		if ( ItemFlavor_GetType( item ) == typeFilter )
			results.append( item )
	}

	return results
}








bool function ItemFlavor_IsEquippableCosmeticType( int typeFilter )
{
	
	return typeFilter > eItemType.__cosmetic_start && typeFilter < eItemType.__cosmetic_end && typeFilter in itemTypeUICategoryMap && COSMETIC_UI_CATEGORIES.contains( itemTypeUICategoryMap[ typeFilter ] )
}

table<string, string> function GetChallengeMetaDataFromAsset( asset settingsAsset )
{
	table<string, string> metaData = {}

	var settingsBlock = GetSettingsBlockForAsset( settingsAsset )
	var tierDataArray = GetSettingsBlockArray( settingsBlock, "tiers" )
	int tierCount     = GetSettingsArraySize( tierDataArray )

	metaData[ CHALLENGE_TIER_COUNT ] <- string(tierCount)
	for ( int i = 0; i < tierCount; i++ )
	{
		var tierBlock       	= GetSettingsArrayElem( tierDataArray, i )

		string specifiedStatRef = GetSettingsBlockString( tierBlock, "statRef" )

		string specifiedStatRefAlt = GetSettingsBlockString( tierBlock, "statRefAlt" )
		
		int statCount = 0
		string tempKey = ""

		if ( specifiedStatRef.find( "%char%" ) > -1 )
		{
			var charactersArray = GetSettingsBlockArray( tierBlock, "characters" )
			foreach ( var characterBlock in IterateSettingsArray( charactersArray ) )
			{
				asset characterAsset = GetSettingsBlockAsset( characterBlock, "flavor" )
				string tempStat = replace( specifiedStatRef, "%char%", ConvertAssetIDToGUIDString( GetUniqueIdForSettingsAsset( characterAsset ) ) )
				string tempStatAlt = replace( specifiedStatRefAlt, "%char%", ConvertAssetIDToGUIDString( GetUniqueIdForSettingsAsset( characterAsset ) ) )
				
				tempKey = format( CHALLENGE_TIER_STAT_REF, i, statCount )
				metaData[tempKey] <- tempStat
				tempKey = format( CHALLENGE_TIER_STAT_ALT_REF, i, statCount )
				metaData[tempKey] <- tempStatAlt
				statCount++
			}
			tempKey = format( CHALLENGE_TIER_STAT_COUNT, i )
			metaData[tempKey] <- string(statCount)
		}
		else if ( specifiedStatRef.find( "%class%" ) > -1 )
		{
			var characterClassArray = GetSettingsBlockArray( tierBlock, "classes" )
			foreach ( var classBlock in IterateSettingsArray( characterClassArray ) )
			{
				asset classAsset   = GetSettingsBlockAsset( classBlock, "flavor" )
				string tempStat    = replace( specifiedStatRef, "%class%", ConvertAssetIDToGUIDString( GetUniqueIdForSettingsAsset( classAsset ) ) )
				string tempStatAlt = replace( specifiedStatRefAlt, "%class%", ConvertAssetIDToGUIDString( GetUniqueIdForSettingsAsset( classAsset ) ) )

				tempKey = format( CHALLENGE_TIER_STAT_REF, i, statCount )
				metaData[tempKey] <- tempStat
				tempKey = format( CHALLENGE_TIER_STAT_ALT_REF, i, statCount )
				metaData[tempKey] <- tempStatAlt
				statCount++
			}
			tempKey = format( CHALLENGE_TIER_STAT_COUNT, i )
			metaData[tempKey] <- string(statCount)
		}
		else
		{
			
			tempKey = format( CHALLENGE_TIER_STAT_REF, i, statCount )
			metaData[tempKey] <- specifiedStatRef
			tempKey = format( CHALLENGE_TIER_STAT_ALT_REF, i, statCount )
			metaData[tempKey] <- specifiedStatRefAlt
			statCount++
			tempKey = format( CHALLENGE_TIER_STAT_COUNT, i )
			metaData[tempKey] <- string(statCount)
		}
	}

	string mode = GetGlobalSettingsString( settingsAsset, "mode" )
	Assert( mode in eChallengeGameMode || mode in AccoladeCompoundChallengeModeToBitfieldMap, format( "Challenge %s has invalid mode kind: %s", string( settingsAsset ), mode ) )

	if ( mode in AccoladeCompoundChallengeModeToBitfieldMap )
	{
		metaData[ CHALLENGE_GAME_MODE_REF ] <- string( AccoladeCompoundChallengeModeToBitfieldMap[ mode ] )
	}
	else
	{
		metaData[ CHALLENGE_GAME_MODE_REF ] <- string( eChallengeGameMode[ mode ] )
	}

	string altMode = GetGlobalSettingsString( settingsAsset, "modeAlt" )
	Assert( altMode in eChallengeGameMode || altMode in AccoladeCompoundChallengeModeToBitfieldMap, format( "Challenge %s has invalid alt mode kind: %s", string( settingsAsset ), altMode ) )

	if ( altMode in AccoladeCompoundChallengeModeToBitfieldMap )
	{
		metaData[ CHALLENGE_GAME_MODE_ALT_REF ] <- string( AccoladeCompoundChallengeModeToBitfieldMap[ altMode ] )
	}
	else
	{
		metaData[ CHALLENGE_GAME_MODE_ALT_REF ] <- string( eChallengeGameMode[ altMode ] )
	}

	float accoladeWeight = GetGlobalSettingsFloat( settingsAsset, "accoladeWeight" )
	metaData[ CHALLENGE_ACCOLADE_WEIGHT_REF ] <- string( accoladeWeight )

	return metaData
}








table<string, string> function GetTimestampMetaDataFromAsset( asset settingsAsset, int itemType, bool showWarning )
{
	MetaDataFieldMapping fieldMapping = itemType in ITEMTYPE_TO_DATETIME_METADATA_FIELD_MAPPINGS ? ITEMTYPE_TO_DATETIME_METADATA_FIELD_MAPPINGS[ itemType ] : DEFAULT_METADATA_FIELD_MAPPING
	table<string, string> metaData = {}

	
	if ( itemType == eItemType.battlepass && GetGlobalSettingsAsset( settingsAsset, "rewardScheduleDatatableV2" ) == $"" )
	{
		
		return metaData
	}

	
	int tempTimeStamp
	int defaultUnixTime = UNIX_TIME_FALLBACK_2038
	string tempKey = fieldMapping[ eDateTimeFieldType.START ]
	string str = GetGlobalSettingsString( settingsAsset, tempKey )
	if ( str != "" )
	{
		int ornull t = DateTimeStringToUnixTimestamp( str )
		if ( t != null )
		{
			tempTimeStamp = expect int(t)
		}
		else
		{
			tempTimeStamp = defaultUnixTime
			if ( showWarning )
				Warning( "Calendar event '%s' default '%s' time is not a valid datetime or Unix timestamp: \"%s\"", string(settingsAsset), tempKey, str )
		}

		metaData[ tempKey ] <- string(tempTimeStamp)
	}
	else if ( showWarning && IsCalEvent( itemType ) )
	{
		Warning( "CalEvent %s '%s' time is unset. Using %d (%s).", string(settingsAsset), tempKey, defaultUnixTime, GetDateTimeString( defaultUnixTime ) )
	}

	defaultUnixTime = UNIX_TIME_FALLBACK_1970
	tempKey = fieldMapping[ eDateTimeFieldType.FINISH ]
	str = GetGlobalSettingsString( settingsAsset, tempKey )
	if ( str != "" )
	{
		int ornull t = DateTimeStringToUnixTimestamp( str )
		if ( t != null )
		{
			tempTimeStamp = expect int(t)
		}
		else
		{
			tempTimeStamp = defaultUnixTime
			if ( showWarning )
				Warning( "Calendar event '%s' default '%s' time is not a valid datetime or Unix timestamp: \"%s\"", string(settingsAsset), tempKey, str )
		}

		metaData[ tempKey ] <- string(tempTimeStamp)
	}
	else if ( showWarning && IsCalEvent( itemType ) )
	{
		Warning( "CalEvent %s '%s' time is unset. Using %d (%s).", string(settingsAsset), tempKey, defaultUnixTime, GetDateTimeString( defaultUnixTime ) )
	}

	return metaData
}

table< string, string > ornull function ItemFlavor_GetMetaData( ItemFlavor flavor )
{
	Assert( flavor.metaData != null )
	return flavor.metaData
}

bool function IsCalEvent( int itemType )
{
	if ( itemType > eItemType._CALEVENT_RANGE_START && itemType < eItemType._CALEVENT_RANGE_END )
		return true

	return false
}
















































void function ItemFlavor_ForEachVfxAlias( asset vfxAliasTable, bool functionref( string, asset ) callback )
{
	var vfxAliasGroupsArray = GetSettingsBlockArray( GetSettingsBlockForAsset( vfxAliasTable ), "vfxaliasgroups" )
	foreach ( var vfxAliasGroupBlock in IterateSettingsArray( vfxAliasGroupsArray ) )
	{
		var vfxAliasesArray = GetSettingsBlockArray( vfxAliasGroupBlock, "vfxAliases" )
		foreach ( var vfxAliasBlock in IterateSettingsArray( vfxAliasesArray ) )
		{
			string vfxAlias = GetSettingsBlockString( vfxAliasBlock, "vfxAlias" )
			asset vfxReal = GetSettingsBlockStringAsAsset( vfxAliasBlock, "vfxReal" )
			bool shouldContinue = callback( vfxAlias, vfxReal )
			if ( !shouldContinue )
				return
		}
	}
}


void function ItemFlavor_ForEachVfxAliasOfTableOwner( ItemFlavor aliasTableOwner, bool functionref( string, asset ) callback )
{
	var settingsBlock = ItemFlavor_GetSettingsBlock( aliasTableOwner )
	var vfxTablesArray = GetSettingsBlockArray( settingsBlock, "alias_vfxTables" )
	foreach ( var vfxTableBlock in IterateSettingsArray( vfxTablesArray ) )
	{
		asset vfxAliasAsset = GetSettingsBlockAsset( vfxTableBlock, "alias_vfxTable" )
		if ( vfxAliasAsset != $"" )
		{
			ItemFlavor_ForEachVfxAlias( vfxAliasAsset, callback )
		}
	}
}

asset ornull function ItemFlavor_FindVfxAssetByAliasName( asset vfxAliasTable, string aliasName )
{
	PassByReferenceAsset vfxAsset
	ItemFlavor_ForEachVfxAlias( vfxAliasTable, bool function ( string currentAliasName, asset currentVfxAsset ) : ( aliasName, vfxAsset )
	{
		if ( currentAliasName == aliasName )
		{
			vfxAsset.value = currentVfxAsset
			return false 
		}
		return true 
	} )
	return vfxAsset.value
}

asset ornull function ItemFlavor_FindVfxAssetOfTableOwnerByAliasName( ItemFlavor aliasTableOwner, string aliasName )
{
	PassByReferenceAsset vfxAsset
	ItemFlavor_ForEachVfxAliasOfTableOwner( aliasTableOwner, bool function ( string currentAliasName, asset currentVfxAsset ) : ( aliasName, vfxAsset )
	{
		if ( currentAliasName == aliasName )
		{
			vfxAsset.value = currentVfxAsset
			return false 
		}
		return true 
	} )
	return vfxAsset.value
}
