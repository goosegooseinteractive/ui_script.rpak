int function ItemFlavorBag_GetRewardQuantityFromRewards( ItemFlavorBag rewards )
{
	if ( rewards.flavors.len() > 0 )
	{
		ItemFlavor rewardFlav = rewards.flavors[0] 
		if ( ItemFlavor_GetType( rewardFlav ) == eItemType.voucher )
		{
			int bpStars = Voucher_GetEffectBattlepassStars( rewardFlav )
			if ( bpStars > 0 )
			{
				
				return bpStars * rewards.quantities[0]
			}
			else if ( Voucher_GetEffectStatRef( rewardFlav ) != null )
			{
				
				return maxint( Voucher_GetEffectStatAmount( rewardFlav ), rewards.quantities[0] )
			}
		}

		return rewards.quantities[0]
	}

	return 0
}



asset function ItemFlavor_GetRewardSummaryFilterIcon( ItemFlavor ornull flavor )
{
	if ( flavor == null )
		return $"rui/menu/buttons/miscellaneous_button_icon"

	expect ItemFlavor( flavor )

	if ( !IsItemFlavorStructValid( flavor.guid, eValidation.DONT_ASSERT  ) )
		return $"rui/menu/buttons/miscellaneous_button_icon"

	var type = ItemFlavor_GetType( flavor )

	asset iconAsset = $""

	switch ( type )
	{
		case eItemType.battlepass:
			iconAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "xSmallLogo" )
			break
		case eItemType.calevent_event_shop:
			iconAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "eventMainIcon" )
			break
		case eItemType.calevent_milestone:
			iconAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "titleMainIcon" )
			break
		case eItemType.calevent_buffet:
			iconAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "titleMainIcon" )
			break
		case eItemType.gladiator_card_badge:
			iconAsset = $"rui/menu/buttons/battlepass/badge"
			break
		default:
			iconAsset = $"rui/menu/buttons/miscellaneous_button_icon"
			break
	}

	return iconAsset
}




string function ItemFlavor_GetTypeName( ItemFlavor flavor )
{
	Assert( IsItemFlavorStructValid( flavor.guid, eValidation.ASSERT ) )

	
	if ( !(flavor.typeIndex in itemTypeNameMap) )
		return format( "%s !UNLOCALIZED!", DEV_GetEnumStringSafe( "eItemType", flavor.typeIndex ) )

	if ( ItemFlavor_GetType( flavor ) == eItemType.gladiator_card_stat_tracker )
	{
		if ( GladiatorCardStatTracker_GetTrackerType( flavor ) == eTrackerType.ART )
			return Localize( "#REWARD_TRACKER_ART" )

		if ( GladiatorCardStatTracker_GetTrackerType( flavor ) == eTrackerType.BOTH )
			return Localize( "#REWARD_TRACKER_STAT_AND_ART" )
	}

	return itemTypeNameMap[flavor.typeIndex]
}




