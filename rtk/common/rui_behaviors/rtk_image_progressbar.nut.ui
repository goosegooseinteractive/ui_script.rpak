global function RTKImageProgressBar_OnInitialize
global function RTKImageProgressBar_OnDrawBegin

global struct RTKImageProgressBar_Properties
{
	asset rui = $""

	float current = 0
	float max = 0

	vector progressBarColor
	vector progressBgColor

	float progressBarAlpha
	float progressBgAlpha

	asset bgImage = $"ui_image/white.rpak"
	asset fillImage = $"ui_image/white.rpak"
}

void function RTKImageProgressBar_OnInitialize( rtk_behavior self )
{
	self.AddPropertyCallback( "rui", UpdateRuiAsset )

	UpdateRuiAsset( self )
}

void function UpdateRuiAsset( rtk_behavior self )
{
	asset ruiAsset = $"ui/rtk_image_progressbar.rpak"

	if ( ruiAsset != "" )
		self.CreateRui( ruiAsset )
	else if ( self.HasRui() )
		self.DestroyRui()
}

void function RTKImageProgressBar_OnDrawBegin( rtk_behavior self )
{
	if ( self.HasRui() )
	{
		rtk_panel panel = self.GetPanel()

		self.SetRuiArgFloat( "width", panel.GetWidth() )
		self.SetRuiArgFloat( "height", panel.GetHeight() )
		self.SetRuiArgFloat( "current", self.PropGetFloat( "current" ) )
		self.SetRuiArgFloat( "max", self.PropGetFloat( "max" ) )

		self.SetRuiArgColorRGB( "progressBarColor", self.PropGetFloat3( "progressBarColor" ) )
		self.SetRuiArgColorRGB( "progressBgColor", self.PropGetFloat3( "progressBgColor" ) )
		self.SetRuiArgFloat( "progressBarAlpha", self.PropGetFloat( "progressBarAlpha" ) )
		self.SetRuiArgFloat( "progressBgAlpha", self.PropGetFloat( "progressBgAlpha" ) )

		asset ornull bgImage = self.PropGetAssetPath( "bgImage" )
		asset ornull fillImage = self.PropGetAssetPath( "fillImage" )

		self.SetRuiArgImage( "progressBarBgImage", expect string( bgImage ) )
		self.SetRuiArgImage( "progressBarFillImage", expect string( fillImage ) )
	}
}