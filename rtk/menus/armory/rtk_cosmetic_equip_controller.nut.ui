void function RTKCosmeticEquipScreen_OnPrimaryButtonPressed( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	if ( p.currentSelectGUID == -1 )
		return

	RTKCosmeticEquipScreen_SetCurrentEquipGUID( self, p.currentSelectGUID )
}

void function RTKCosmeticEquipScreen_GenericInitItemList( rtk_behavior self, CosmeticEquipScreenInitSettings initSettings )
{
	ScreenPrivateData p
	self.Private( p )

	if ( p.favoriteSlotChangedCallback != null && p.loadoutEntries.len() > 0 )
	{
		RemoveCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( LocalClientEHI(), p.loadoutEntries[ 0 ], p.favoriteSlotChangedCallback )
		p.favoriteSlotChangedCallback = null
	}

	p.loadoutEntries                      = initSettings.loadoutEntries
	p.sortFuncNames                       = initSettings.sortFuncNames
	p.sortOrdinalFunc                     = initSettings.sortOrdinalFunc
	p.filterFunc                          = initSettings.filterFunc
	p.isEmptyFunc                         = initSettings.isEmptyFunc
	p.getItemFlavListFuncOverride         = initSettings.getItemFlavListFuncOverride
	p.getCurrentEquipGUIDOverride         = initSettings.getCurrentEquipGUIDOverride
	p.ignoreDefaultItemForOwnedCount      = initSettings.ignoreDefaultItemForOwnedCount
	p.shouldIgnoreOtherSlotsForOwnedCount = initSettings.shouldIgnoreOtherSlotsForOwnedCount

	table<string, int functionref( ItemFlavor, ItemFlavor, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) = null )> sortFuncNameMap = RTKCosmeticEquip_GetSortFuncNameToRefMap()

	p.sortFuncs.clear()
	foreach ( sortFuncName in p.sortFuncNames )
	{
		if ( sortFuncName in sortFuncNameMap )
		{
			p.sortFuncs.append( sortFuncNameMap[ sortFuncName ] )
		}
	}

	RTKCosmeticEquipScreen_GenericRefreshItemList( self, true )
}

void function RTKCosmeticEquipScreen_GenericRefreshItemList( rtk_behavior self, bool resetPreviewItem = false )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return

	ScreenPrivateData p
	self.Private( p )
	array<ItemFlavor> itemFlavs

	if ( p.getItemFlavListFuncOverride != null )
	{
		itemFlavs = p.getItemFlavListFuncOverride()

		itemFlavs.sort( int function( ItemFlavor a, ItemFlavor b ) : ( p ) {
			return p.sortFuncs[ p.sortFuncIndex ]( a, b, p.loadoutEntries[ 0 ], p.sortOrdinalFunc ) } )
	}
	else
	{
		itemFlavs = RTKCosmeticEquip_GetSortedFilteredItemFlavList( p.loadoutEntries, p.sortFuncs[ p.sortFuncIndex ], p.sortOrdinalFunc, p.filterFunc, p.isEmptyFunc )
	}

	string modelPath = self.PropGetString( "modelPath" )
	int currentEquippedItemGUID

	if ( p.getCurrentEquipGUIDOverride != null )
	{
		currentEquippedItemGUID = p.getCurrentEquipGUIDOverride()
	}
	else
	{
		currentEquippedItemGUID = ItemFlavor_GetGUID( LoadoutSlot_GetItemFlavor( LocalClientEHI(), p.loadoutEntries[ 0 ], true ) )
	}

	p.cosmeticList      = RTKCosmeticEquip_GetItemModelsFromFlavs( self, itemFlavs, p.loadoutEntries, modelPath, currentEquippedItemGUID )

	ItemFlavor previewItemFlav

	if ( p.currentSelectGUID == -1 || resetPreviewItem )
	{
		previewItemFlav = GetItemFlavorByGUID( currentEquippedItemGUID )
		p.currentSelectGUID = currentEquippedItemGUID
	}
	else
	{
		previewItemFlav = GetItemFlavorByGUID( p.currentSelectGUID )
	}

	p.currentEquipGUID  = currentEquippedItemGUID

	self.PropSetInt( "currentPreviewGUID", ItemFlavor_GetGUID( previewItemFlav ) )

	if ( ItemFlavor_IsTheFavoriteSentinel( previewItemFlav ) && p.loadoutEntries.len() == 1 )
	{
		previewItemFlav = LoadoutSlot_GetItemFlavor( LocalClientEHI(), p.loadoutEntries[ 0 ] )
	}

	RTKCosmeticEquipScreen_ShowGenericPreview( self, previewItemFlav )
	RTKCosmeticEquipScreen_RegisterFavoriteSlotChangedCallback( self )

	RTKCosmeticEquipScreen_SetItemListModel( self, p.cosmeticList )
	RTKCosmeticEquipScreen_SetItemsOwnedText( self, RTKCosmeticEquip_GetOwnedString( p.loadoutEntries[ 0 ], itemFlavs, p.ignoreDefaultItemForOwnedCount, p.shouldIgnoreOtherSlotsForOwnedCount ) )
}

void function RTKCosmeticEquipScreen_RegisterFavoriteSlotChangedCallback( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	if ( p.favoriteSlotChangedCallback != null && p.loadoutEntries.len() > 0 )
	{
		RemoveCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( LocalClientEHI(), p.loadoutEntries[ 0 ], p.favoriteSlotChangedCallback )
		p.favoriteSlotChangedCallback = null
	}

	
	if ( p.loadoutEntries.len() == 1 && p.loadoutEntries[ 0 ].maxFavoriteCount > 0 )
	{
		p.favoriteSlotChangedCallback = void function( EHI playerEHI, ItemFlavor contents ) : ( self )
		{
			ScreenPrivateData sp
			self.Private( sp )
			if ( sp.currentSelectGUID != -1 && ItemFlavor_IsTheFavoriteSentinel( GetItemFlavorByGUID( sp.currentSelectGUID ) ) )
				RTKCosmeticEquipScreen_GenericOnItemPreview( self, sp.currentSelectGUID )
		}
		AddCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( LocalClientEHI(), p.loadoutEntries[ 0 ], p.favoriteSlotChangedCallback )
	}
}

void function RTKCosmeticEquipScreen_GenericCategoryToggle( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	int index = -1
	RTKCosmeticListItemModel category

	foreach ( int itemIndex, listItem in p.cosmeticList )
	{
		if ( listItem.flavGUID == flavGUID )
		{
			index    = itemIndex
			category = listItem
			break
		}
	}

	if ( index == -1 || !category.isCategory )
		return

	if ( !category.isCategoryOpen ) 
	{
		int currentEquippedItemGUID = ItemFlavor_GetGUID( LoadoutSlot_GetItemFlavor( LocalClientEHI(), p.loadoutEntries[ 0 ], true ) )
		string modelPath = self.PropGetString( "modelPath" )
		int insertIndex = 1
		int playerGRXEdition = GRX_GetPlayerEdition()

		foreach ( guid in category.categoryContentGUIDs )
		{
			RTKCosmeticListItemModel itemModel = RTKCosmeticEquip_GetItemModelFromItemFlav( GetItemFlavorByGUID( guid ), p.loadoutEntries, modelPath, playerGRXEdition, p.currentSelectGUID, currentEquippedItemGUID, false, flavGUID )
			if ( itemModel.flavGUID == p.currentSelectGUID )
			{
				itemModel.state = RTKCosmeticEquip_GetSelectItemState( itemModel.state )
			}
			else if ( itemModel.flavGUID == p.currentEquipGUID )
			{
				itemModel.state = eUICosmeticItemState.EQUIPPED
			}

			p.cosmeticList.insert( index + insertIndex, itemModel )
			RTKCosmeticEquipScreen_InsertListItem( self, index + insertIndex, itemModel )
			insertIndex++
		}
	}
	else 
	{
		for ( int i = 0; i < p.cosmeticList.len(); i++ )
		{
			if ( category.categoryContentGUIDs.contains( p.cosmeticList[i].flavGUID ) && !p.cosmeticList[i].isCategory )
			{
				p.cosmeticList.remove( i )
				RTKCosmeticEquipScreen_RemoveListItem( self, i )
				i--
			}
		}
	}

	category.isCategoryOpen = !category.isCategoryOpen
	RTKCosmeticEquipScreen_SetListItemIsCategoryOpen( self, index, category.isCategoryOpen )
}

void function RTKCosmeticEquipScreen_GenericOnItemPreview( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	foreach ( int index, listItem in p.cosmeticList )
	{
		if ( listItem.flavGUID == flavGUID || listItem.categoryContentGUIDs.contains( flavGUID ) )
		{
			
			listItem.state = RTKCosmeticEquip_GetSelectItemState( listItem.state )
			RTKCosmeticEquipScreen_SetListItemState( self, index, listItem.state )
		}
		else if ( listItem.flavGUID == p.currentSelectGUID || listItem.categoryContentGUIDs.contains( p.currentSelectGUID ) )
		{
			
			listItem.state = RTKCosmeticEquip_GetDeSelectItemState( listItem.state )
			RTKCosmeticEquipScreen_SetListItemState( self, index, listItem.state )
		}
	}

	ItemFlavor previewItemFlav = GetItemFlavorByGUID( flavGUID )
	if ( ItemFlavor_IsTheFavoriteSentinel( previewItemFlav ) && p.loadoutEntries.len() == 1 )
	{
		previewItemFlav = LoadoutSlot_GetItemFlavor( LocalClientEHI(), p.loadoutEntries[0] )
	}

	p.currentSelectGUID = flavGUID
	self.PropSetInt( "currentPreviewGUID", ItemFlavor_GetGUID( previewItemFlav ) )
	RTKCosmeticEquipScreen_ShowGenericPreview( self, previewItemFlav )
}

void function RTKCosmeticEquipScreen_GenericOnItemEquip( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	if ( p.currentEquipGUID == flavGUID )
		return

	ItemFlavor itemFlav = GetItemFlavorByGUID( flavGUID )

	if ( RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav ) )
	{
		RTKCosmeticEquipScreen_GenericOnItemTryUnlock( self, flavGUID )
		return
	}

	foreach ( int index, listItem in p.cosmeticList )
	{
		if ( listItem.flavGUID == flavGUID || listItem.categoryContentGUIDs.contains( flavGUID ) )
		{
			
			listItem.state = RTKCosmeticEquip_GetEquipItemState( listItem.state )
			RTKCosmeticEquipScreen_SetListItemState( self, index, listItem.state )
		}
		else if ( listItem.flavGUID == p.currentEquipGUID || listItem.categoryContentGUIDs.contains( p.currentEquipGUID ) )
		{
			
			listItem.state = RTKCosmeticEquip_GetDeEquipItemState( listItem.state )
			RTKCosmeticEquipScreen_SetListItemState( self, index, listItem.state )
		}
	}

	if ( p.currentEquipGUID != flavGUID )
		EmitUISound( "UI_Menu_Equip_Generic" )

	p.currentEquipGUID = flavGUID

	RequestSetItemFlavorLoadoutSlot_WithDuplicatePrevention( LocalClientEHI(), p.loadoutEntries, itemFlav, 0 )

	
	RTKCosmeticEquip_Telemetry_SendItemEquipEvent( itemFlav )

	
	bool itemIsUnlocked = IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), p.loadoutEntries[ 0 ], itemFlav, false, true )
	RTKCosmeticEquipScreen_SetPrimaryButtonVisible( self, itemIsUnlocked && p.currentSelectGUID != p.currentEquipGUID ) 
	UpdateFooterOptions()
}

void function RTKCosmeticEquipScreen_GenericOnItemHighlight( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	p.currentHighlightGUID = flavGUID
	UpdateFooterOptions()
}


void function RTKCosmeticEquipScreen_GenericOnItemFavorite( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	LoadoutEntry entry = p.loadoutEntries[ 0 ]
	ItemFlavor itemFlav = GetItemFlavorByGUID( flavGUID )

	if ( RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav ) )
	{
		RTKCosmeticEquipScreen_GenericOnItemTryUnlock( self, flavGUID )
		return
	}

	if ( entry.maxFavoriteCount == 0 )
		return

	if ( itemFlav == entry.favoriteItemFlavor )
	{
		EmitUISound( "UI_Menu_Deny" )
		return
	}

	array<ItemFlavor> favouriteFlavs = LoadoutSlot_GetFavorites( LocalClientEHI(), entry )

	if ( favouriteFlavs.contains( itemFlav ) )
	{
		RequestClearItemFlavorFavoritesSlot( LocalClientEHI(), entry, favouriteFlavs.find( itemFlav ), itemFlav )
		EmitUISound( "ui_menu_cosmetic_unlock" )

		
		RTKCosmeticEquip_Telemetry_SendToggleFavoriteEvent( itemFlav, false )

		foreach ( int index, listItem in p.cosmeticList )
		{
			if ( listItem.flavGUID == flavGUID && !listItem.isCategory )
			{
				
				listItem.isFavorite = false
				RTKCosmeticEquipScreen_SetListItemIsFavorite( self, index, false )
			}
			else if ( listItem.categoryContentGUIDs.contains( flavGUID ) )
			{
				
				bool isFavorite = false
				array<int> otherGUIDsInCategory = clone listItem.categoryContentGUIDs
				otherGUIDsInCategory.removebyvalue( flavGUID )

				foreach ( guid in otherGUIDsInCategory )
				{
					if ( favouriteFlavs.contains( GetItemFlavorByGUID( guid ) ) )
					{
						isFavorite = true
						break
					}
				}
				listItem.isFavorite = isFavorite
				RTKCosmeticEquipScreen_SetListItemIsFavorite( self, index, isFavorite )
			}
		}
	}
	else
	{
		if ( favouriteFlavs.len() < entry.maxFavoriteCount )
		{
			RequestSetItemFlavorFavoritesSlot( LocalClientEHI(), entry, itemFlav, favouriteFlavs.len() )
			PlayEquipSound( itemFlav )

			
			RTKCosmeticEquip_Telemetry_SendToggleFavoriteEvent( itemFlav, true )

			foreach ( int index, listItem in p.cosmeticList )
			{
				if ( listItem.flavGUID == flavGUID || listItem.categoryContentGUIDs.contains( flavGUID ) )
				{
					
					listItem.isFavorite = true
					RTKCosmeticEquipScreen_SetListItemIsFavorite( self, index, true )
				}
			}
		}
		else
		{
			EmitUISound( "UI_Menu_Deny" )
			ConfirmDialogData dialogData
			dialogData.headerText = "#FAVORITES_FULL_TITLE"
			dialogData.messageText = Localize( "#FAVORITES_FULL_HINT", entry.maxFavoriteCount )

			OpenOKDialogFromData( dialogData )
		}
	}

	UpdateFooterOptions()
}

void function RTKCosmeticEquipScreen_GenericOnItemTryUnlock( rtk_behavior self, int flavGUID )
{
	ItemFlavor itemFlav = GetItemFlavorByGUID( flavGUID )
	bool doesItemNeedCharacterUnlockedFirst = RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav )
	bool isItemUnlockable = RTKCosmeticEquip_IsItemUnlockable( flavGUID )

	if ( !doesItemNeedCharacterUnlockedFirst && !isItemUnlockable )
		return

	PurchaseDialogConfig pdc

	
	if ( doesItemNeedCharacterUnlockedFirst )
	{
		ItemFlavor characterFlav = GetTopLevelCustomizeContext()
		if ( Character_IsUnlockableInNewPlayerPass( characterFlav ) )
		{
			OpenPromoLink( "newplayerpass", "" )
			return
		}

		pdc.flav = characterFlav 
	}
	else
	{
		pdc.flav = itemFlav
		pdc.hideStoreOffers = true
	}

	ItemFlavorPurchasabilityInfo ifpi = GRX_GetItemPurchasabilityInfo( itemFlav )
	pdc.quantity = 1
	pdc.markAsNew = true
	pdc.onDialogOpenCallback = void function() {
		
		CustomizeWeaponMenu_SetCanNavigateBack( false )
	}
	pdc.onDialogCloseCallback = void function() {
		thread void function() {
			
			WaitFrame()
			CustomizeWeaponMenu_SetCanNavigateBack( true )
		}()
	}
	pdc.onPurchaseResultCallback = void function( bool wasPurchaseSuccessful ) : ( self, pdc, ifpi ) {
		RTKCosmeticEquipScreen_GenericRefreshItemList( self )

		
		ItemFlavor itemFlav = expect ItemFlavor( pdc.flav )
		string topLevelContext = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
		string modelPath = self.PropGetString( "modelPath" )
		string categoryName = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
		string itemName = ItemFlavor_GetLongName( itemFlav )
		string qualityName = ItemQuality_GetQualityName( ItemFlavor_GetQuality( itemFlav ) )

		int price
		string currency
		bool offersWidgetActive

		if ( ifpi.craftingOfferOrNull != null )
		{
			GRXScriptCraftingOffer craftingOffer = expect GRXScriptCraftingOffer( ifpi.craftingOfferOrNull )
			price = craftingOffer.craftingPrice
			currency = "crafting_metals"
		}
		else if ( "leg" in ifpi.locationToDedicatedStoreOffersMap )
		{
			price = ifpi.locationToDedicatedStoreOffersMap[ "leg" ][ 0 ].prices[ 0 ].quantities[ 0 ]
			currency = "apex_coins"
		}

		if ( ifpi.isPurchasableAtAll && ifpi.locationToDedicatedStoreOffersMap.len() > 0 )
		{
			foreach ( string location, offers in ifpi.locationToDedicatedStoreOffersMap )
			{
				if ( location != "leg" ) 
				{
					offersWidgetActive = true
				}
			}
		}
		RTKCosmeticEquip_Telemetry_SendUnlockEvent( modelPath, categoryName, itemName, qualityName, price, currency, offersWidgetActive, topLevelContext )
	}

	PurchaseDialog( pdc )
}

bool function RTKCosmeticEquipScreen_GenericIsItemFocused( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	return p.currentHighlightGUID != -1
}

bool function RTKCosmeticEquipScreen_GenericIsItemEquippable( rtk_behavior self )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return false

	ScreenPrivateData p
	self.Private( p )

	if ( p.currentHighlightGUID == -1 )
		return false

	EHI playerEHI       = LocalClientEHI()
	ItemFlavor itemFlav = GetItemFlavorByGUID( p.currentHighlightGUID )

	if ( RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav ) )
		return false

	if ( itemFlav == p.loadoutEntries[ 0 ].favoriteItemFlavor )
		return true

	bool isUnlocked = IsItemFlavorUnlockedForLoadoutSlot( playerEHI, p.loadoutEntries[ 0 ], itemFlav )
	bool isEquipped = LoadoutSlot_GetItemFlavor( playerEHI, p.loadoutEntries[ 0 ], true ) == itemFlav

	return !isEquipped && isUnlocked
}

bool function RTKCosmeticEquipScreen_GenericIsItemUnlockable( rtk_behavior self )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return false

	ScreenPrivateData p
	self.Private( p )

	if ( p.currentHighlightGUID == -1 )
		return false

	return RTKCosmeticEquip_IsItemUnlockable( p.currentHighlightGUID )
}

bool function RTKCosmeticEquipScreen_GenericIsItemFavoritable( rtk_behavior self )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return false

	ScreenPrivateData p
	self.Private( p )

	if ( p.currentHighlightGUID == -1 )
		return false

	EHI playerEHI       = LocalClientEHI()
	ItemFlavor itemFlav = GetItemFlavorByGUID( p.currentHighlightGUID )

	if ( RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav ) )
		return false

	if ( itemFlav == p.loadoutEntries[ 0 ].favoriteItemFlavor )
		return false

	bool isUnlocked = IsItemFlavorUnlockedForLoadoutSlot( playerEHI, p.loadoutEntries[ 0 ], itemFlav )
	bool isFavorite = IsBitFlagSet( itemFlav.loadoutSortPriority, eLoadoutSortPriority.FAVORITE )

	return isUnlocked && !isFavorite
}

bool function RTKCosmeticEquipScreen_GenericIsItemFavorite( rtk_behavior self )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return false

	ScreenPrivateData p
	self.Private( p )

	if ( p.currentHighlightGUID == -1 )
		return false

	EHI playerEHI       = LocalClientEHI()
	ItemFlavor itemFlav = GetItemFlavorByGUID( p.currentHighlightGUID )

	if ( itemFlav == p.loadoutEntries[ 0 ].favoriteItemFlavor )
		return false

	return IsBitFlagSet( itemFlav.loadoutSortPriority, eLoadoutSortPriority.FAVORITE )
}

void function RTKCosmeticEquipScreen_CycleSortFunc( rtk_behavior self )
{
	if ( self == null )
		return

	ScreenPrivateData p
	self.Private( p )

	p.sortFuncIndex = ( p.sortFuncIndex + 1 ) % p.sortFuncs.len()
	RTKCosmeticEquipScreen_GenericRefreshItemList( self )

	p.sortFooterDefController.gamepadLabel = Localize( "#LEGEND_LOCKER_FOOTER_SORT_CONTROLLER", Localize( p.sortFuncNames[ p.sortFuncIndex ] ), p.sortFuncIndex + 1, p.sortFuncNames.len()  )
	p.sortFooterDefMKB.mouseLabel = Localize( "#LEGEND_LOCKER_FOOTER_SORT_MKB", Localize( p.sortFuncNames[ p.sortFuncIndex ] ), p.sortFuncIndex + 1, p.sortFuncNames.len() )
	EmitUISound( "UI_Menu_Accept" )

	UpdateFooterOptions()

	
	string modelPath = self.PropGetString( "modelPath" )
	string topLevelContext = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
	RTKCosmeticEquip_Telemetry_SendSortEvent( modelPath, p.sortFuncNames[ p.sortFuncIndex ], topLevelContext )
}

void function RTKCosmeticEquipScreen_ToggleShowHideUI( rtk_behavior self )
{
	if ( self == null )
		return

	ScreenPrivateData p
	self.Private( p )

	rtk_behavior animator = self.PropGetBehavior( "animatorBehavior" )
	if ( animator == null || RTKAnimator_IsPlaying( animator ) )
		return

	if ( p.isHidingUI && RTKAnimator_HasAnimation( animator, "onShow" ) )
	{
		RTKAnimator_PlayAnimation( animator, "onShow" )
		p.isHidingUI = false
	}
	else if ( !p.isHidingUI && RTKAnimator_HasAnimation( animator,"onHide" ) )
	{
		RTKAnimator_PlayAnimation( animator, "onHide" )
		p.isHidingUI = true
	}

	EmitUISound( "UI_Menu_Accept" )
}











