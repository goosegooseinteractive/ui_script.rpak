void function RTKCosmeticListItemButton_OnInitialize( rtk_behavior self )
{
	ItemPrivateData p
	self.Private( p )

	p.modelPathListenerID = RTKStruct_AddPropertyListener( self.GetProperties(), "screenModelPath", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self )
	{
		RTKCosmeticListItemButton_SetupButton( self )
	} )
}

void function RTKCosmeticListItemButton_SetupButton( rtk_behavior self )
{
	rtk_behavior button = self.PropGetBehavior( "buttonBehavior" )
	if ( button == null )
		return

	string screenModelPath = self.PropGetString( "screenModelPath" )
	if ( screenModelPath == "" )
		return

	rtk_struct screenStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, screenModelPath, "RTKCosmeticEquipScreenModel" )

	self.AutoSubscribe( button, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self, screenStruct )
	{
		if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		{
			EmitUISound( "UI_Menu_Deny" )
			return
		}

		bool isCategory = self.PropGetBool( "isCategory" )

		if ( isCategory )
		{
			RTKCosmeticListItemButton_ToggleCategory( self, screenStruct )
		}
		else
		{
			switch ( keycode )
			{
				case MOUSE_RIGHT:
				case BUTTON_X:
					RTKCosmeticListItemButton_EquipItem( self, screenStruct )
					break

				case MOUSE_LEFT:
				case BUTTON_A:
					RTKCosmeticListItemButton_PreviewItem( self, screenStruct )
					break

				case MOUSE_MIDDLE:
				case BUTTON_Y:
					RTKCosmeticListItemButton_FavoriteItem( self, screenStruct )
					break
			}
		}
	} )

	self.AutoSubscribe( button, "onDoublePressed", function( rtk_behavior button, int keycode ) : ( self, screenStruct )
	{
		bool isCategory = self.PropGetBool( "isCategory" )

		if ( isCategory )
		{
			RTKCosmeticListItemButton_ToggleCategory( self, screenStruct )
		}
		else
		{
			switch ( keycode )
			{
				case MOUSE_LEFT:
				case BUTTON_A:
					RTKCosmeticListItemButton_EquipItem( self, screenStruct )
					break
			}
		}
	} )

	self.AutoSubscribe( button, "onHighlighted", function( rtk_behavior button, int prevState ) : ( self, screenStruct )
	{
		RTKCosmeticListItemButton_HighlightItem( self, screenStruct )
	} )

	self.AutoSubscribe( button, "onIdle", function( rtk_behavior button, int prevState ) : ( self, screenStruct )
	{
		if ( prevState == RTKBUTTONSTATE_HIGHLIGHTED )
		{
			RTKCosmeticListItemButton_UnHighlightItem( self, screenStruct )
		}
	} )

	ItemPrivateData p
	self.Private( p )
	RTKStruct_RemovePropertyListener( self.GetProperties(), "screenModelPath", p.modelPathListenerID )



}

void function RTKCosmeticListItemButton_ToggleCategory( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null )
		return

	int flavGUID = self.PropGetInt( "flavGUID" )
	RTKStruct_SetInt( screenStruct, "categoryToggleGUID", flavGUID )
	EmitUISound( "ui_menu_accept" )
}

void function RTKCosmeticListItemButton_PreviewItem( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null )
		return

	int flavGUID = self.PropGetInt( "flavGUID" )
	RTKStruct_SetInt( screenStruct, "currentPreviewGUID", flavGUID )
	EmitUISound( "UI_Menu_Banner_Preview" )

	
	string screenModelPath = self.PropGetString( "screenModelPath" )
	string topLevelContext = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
	RTKCosmeticEquip_Telemetry_SendItemViewEvent( screenModelPath, topLevelContext )
}

void function RTKCosmeticListItemButton_EquipItem( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null )
		return

	int flavGUID = self.PropGetInt( "flavGUID" )

	int state = self.PropGetInt( "state" )
	bool cannotEquip = !RTKCosmeticEquip_CanItemBeEquipped( state )
	if ( cannotEquip )
	{
		RTKStruct_SetInt( screenStruct, "tryUnlockGUID", flavGUID )
		EmitUISound( "ui_menu_accept" )
		return
	}

	RTKStruct_SetInt( screenStruct, "currentPreviewGUID", flavGUID )
	RTKStruct_SetInt( screenStruct, "currentEquipGUID", flavGUID )
}

void function RTKCosmeticListItemButton_HighlightItem( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null || !RTKStruct_HasProperty( screenStruct, "currentHighlightGUID" ) )
		return

	int flavGUID = self.PropGetInt( "flavGUID" )
	RTKStruct_SetInt( screenStruct, "currentHighlightGUID", flavGUID )
}

void function RTKCosmeticListItemButton_UnHighlightItem( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null || !RTKStruct_HasProperty( screenStruct, "currentHighlightGUID" ) )
		return

	int flavGUID              = self.PropGetInt( "flavGUID" )
	int currentHighlightGUID = RTKStruct_GetInt( screenStruct, "currentHighlightGUID" )
	if ( flavGUID == currentHighlightGUID )
	{
		RTKStruct_SetInt( screenStruct, "currentHighlightGUID", -1 )
	}
}

void function RTKCosmeticListItemButton_FavoriteItem( rtk_behavior self, rtk_struct screenStruct )
{
	if ( screenStruct == null )
		return

	int state           = self.PropGetInt( "state" )
	bool cannotFavorite = !RTKCosmeticEquip_CanItemBeEquipped( state )
	if ( cannotFavorite )
		return

	int flavGUID = self.PropGetInt( "flavGUID" )
	RTKStruct_SetInt( screenStruct, "favoriteGUID", flavGUID )
	
}




table<string, int functionref( ItemFlavor, ItemFlavor, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) = null )> function RTKCosmeticEquip_GetSortFuncNameToRefMap()
{
	table<string, int functionref( ItemFlavor, ItemFlavor, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) = null )> map = {
		["#LEGEND_LOCKER_SORT_DEFAULT"] = RTKCosmeticEquip_DefaultSortFunc,
		["#LEGEND_LOCKER_SORT_RARITY"] = RTKCosmeticEquip_RaritySortFunc,
		["#LEGEND_LOCKER_SORT_UNOWNED"] = RTKCosmeticEquip_UnownedSortFunc,
		["#LEGEND_LOCKER_SORT_ALPHABETICAL"] = RTKCosmeticEquip_AlphabeticalSortFunc,
	}

	return map
}

array<ItemFlavor> function RTKCosmeticEquip_GetSortedFilteredItemFlavList(
		array<LoadoutEntry> loadoutEntries,
		int functionref( ItemFlavor, ItemFlavor, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) = null ) sortFunc,
		int functionref( ItemFlavor ) sortOrdinalFunc = null,
		bool functionref( ItemFlavor, array<LoadoutEntry> ) filterFunc = null,
		bool functionref( ItemFlavor ) isEmptyFunc = null )
{
	
	array<ItemFlavor> itemFlavs = clone GetValidItemFlavorsForLoadoutSlot( loadoutEntries[ 0 ] )

	EHI playerEHI = LocalClientEHI()

	
	itemFlavs = FilterItemsForVisibility( playerEHI, itemFlavs )
	if ( GetCurrentPlaylistVarBool( "filter_uncraftable_items", true ) )
		itemFlavs = FilterItemsForGRX( playerEHI, itemFlavs )

	
	for ( int i = 0; i < itemFlavs.len(); i++ )
	{
		if ( RTKCosmeticEquip_IsLockedAndHidden( itemFlavs[i], loadoutEntries ) || ( filterFunc != null && filterFunc( itemFlavs[i], loadoutEntries ) ) )
		{
			itemFlavs.remove( i )
			i--
		}
		else
		{
			
			itemFlavs[ i ].loadoutSortPriority = itemFlavs[ i ].loadoutSortPriority & ~eLoadoutSortPriority.EQUIPPED
			itemFlavs[ i ].loadoutSortPriority = itemFlavs[ i ].loadoutSortPriority & ~eLoadoutSortPriority.FAVORITE
		}
	}

	
	array<ItemFlavor> favoritedItemFlavs = LoadoutSlot_GetFavorites( LocalClientEHI(), loadoutEntries[ 0 ] )
	foreach ( item in favoritedItemFlavs )
		item.loadoutSortPriority = item.loadoutSortPriority | eLoadoutSortPriority.FAVORITE

	
	array<ItemFlavor> equippedItemFlavs
	foreach ( loadoutEntry in loadoutEntries )
	{
		if ( LoadoutSlot_IsReady( playerEHI, loadoutEntry ) )
			equippedItemFlavs.append( LoadoutSlot_GetItemFlavor( playerEHI, loadoutEntry, true ) )
	}
	foreach ( item in equippedItemFlavs )
	{
		item.loadoutSortPriority = item.loadoutSortPriority | eLoadoutSortPriority.EQUIPPED
	}

	itemFlavs.sort( int function( ItemFlavor a, ItemFlavor b ) : ( sortFunc, loadoutEntries, sortOrdinalFunc ) {
			return sortFunc( a, b, loadoutEntries[ 0 ], sortOrdinalFunc ) } )

	

	return itemFlavs
}

array<string> function RTKCosmeticEquip_GetDefaultSortFuncNames()
{
	return [
		"#LEGEND_LOCKER_SORT_DEFAULT",
		"#LEGEND_LOCKER_SORT_RARITY",
		"#LEGEND_LOCKER_SORT_UNOWNED",
		"#LEGEND_LOCKER_SORT_ALPHABETICAL",
	]
}

int function RTKCosmeticEquip_DefaultSortFunc( ItemFlavor a, ItemFlavor b, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) getSortOrdinalFunc = null )
{
	if ( a.loadoutSortPriority > b.loadoutSortPriority )
		return -1
	else if ( a.loadoutSortPriority < b.loadoutSortPriority )
		return 1

	if ( getSortOrdinalFunc != null )
	{
		return getSortOrdinalFunc( a ) - getSortOrdinalFunc( b )
	}

	return 0
}

int function RTKCosmeticEquip_RaritySortFunc( ItemFlavor a, ItemFlavor b, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) getSortOrdinalFunc = null )
{
	if ( ItemFlavor_GetQuality( a ) >  ItemFlavor_GetQuality( b ) )
		return -1
	else if ( ItemFlavor_GetQuality( a  ) <  ItemFlavor_GetQuality( b  ) )
		return 1

	if ( a.loadoutSortPriority > b.loadoutSortPriority )
		return -1
	else if ( a.loadoutSortPriority < b.loadoutSortPriority )
		return 1

	if ( getSortOrdinalFunc != null )
	{
		return getSortOrdinalFunc( a ) - getSortOrdinalFunc( b )
	}

	return 0
}

int function RTKCosmeticEquip_UnownedSortFunc( ItemFlavor a, ItemFlavor b, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) getSortOrdinalFunc = null )
{
	bool aIsUnlocked = IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), loadoutEntry, a )
	bool bIsUnlocked = IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), loadoutEntry, b )

	if ( aIsUnlocked && !bIsUnlocked )
		return -1
	else if ( !aIsUnlocked && bIsUnlocked )
		return 1

	if ( a.loadoutSortPriority > b.loadoutSortPriority )
		return -1
	else if ( a.loadoutSortPriority < b.loadoutSortPriority )
		return 1

	if ( getSortOrdinalFunc != null )
	{
		return getSortOrdinalFunc( a ) - getSortOrdinalFunc( b )
	}

	return 0
}

int function RTKCosmeticEquip_AlphabeticalSortFunc( ItemFlavor a, ItemFlavor b, LoadoutEntry loadoutEntry, int functionref( ItemFlavor ) getSortOrdinalFunc = null )
{
	if ( Localize( ItemFlavor_GetLongName( a ) ) < Localize( ItemFlavor_GetLongName( b ) ) )
		return -1
	else if ( Localize( ItemFlavor_GetLongName( a ) ) > Localize( ItemFlavor_GetLongName( b ) ) )
		return 1

	return 0
}

bool function RTKCosmeticEquip_IsLockedAndHidden( ItemFlavor item, array<LoadoutEntry> loadoutEntries )
{
	return !IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), loadoutEntries[ 0 ], item ) && GetGlobalSettingsBool( ItemFlavor_GetAsset( item ), "shouldHideIfLocked" )
}

array<RTKCosmeticListItemModel> function RTKCosmeticEquip_GetItemModelsFromFlavs( rtk_behavior self, array<ItemFlavor> itemFlavs, array<LoadoutEntry> loadoutEntries, string modelPath, int currentEquippedItemGUID )
{
	ScreenPrivateData p
	self.Private( p )

	array<RTKCosmeticListItemModel> listItems
	bool itemTypeSupportSets = itemFlavs.len() > 0 && CosmeticSet_DoesItemTypeSupportCosmeticSets( ItemFlavor_GetType( itemFlavs[0] ) )
	int playerGRXEdition = GRX_GetPlayerEdition()

	if ( itemTypeSupportSets )
	{
		array<ItemFlavor> categoryFlavs 
		foreach ( itemFlav in itemFlavs )
		{
			if ( CosmeticSet_DoesItemHaveDropdownCategory( itemFlav ) )
			{
				ItemFlavor baseItem = CosmeticSet_GetBaseItems( itemFlav )[ 0 ]
				if ( !categoryFlavs.contains( baseItem ) )
				{
					categoryFlavs.append( baseItem )
					RTKCosmeticListItemModel categoryModel = RTKCosmeticEquip_GetItemModelFromItemFlav( baseItem, loadoutEntries, modelPath, playerGRXEdition, p.currentSelectGUID, currentEquippedItemGUID, true )

					array< ItemFlavor > setItems = CosmeticSet_GetItemsOfType( itemFlav, ItemFlavor_GetType( itemFlav ) )
					if ( p.getItemFlavListFuncOverride == null )
					{
						setItems = FilterItemsForVisibility( LocalClientEHI(), setItems )
						if ( GetCurrentPlaylistVarBool( "filter_uncraftable_items", true ) )
						{
							setItems = FilterItemsForGRX( LocalClientEHI(), setItems )
						}
					}

					foreach ( setItem in setItems )
					{
						categoryModel.categoryContentGUIDs.append( ItemFlavor_GetGUID( setItem ) )
						if ( ItemFlavor_GetGUID( setItem ) == currentEquippedItemGUID )
							categoryModel.state = eUICosmeticItemState.SELECTED_AND_EQUIPPED
						if ( IsBitFlagSet( setItem.loadoutSortPriority, eLoadoutSortPriority.FAVORITE ) )
						{
							categoryModel.isFavorite = true
						}
					}

					listItems.append( categoryModel )
				}
			}
			else
			{
				listItems.append( RTKCosmeticEquip_GetItemModelFromItemFlav( itemFlav, loadoutEntries, modelPath, playerGRXEdition, p.currentSelectGUID, currentEquippedItemGUID ) )
			}
		}
	}
	else
	{
		foreach ( itemFlav in itemFlavs )
		{
			listItems.append( RTKCosmeticEquip_GetItemModelFromItemFlav( itemFlav, loadoutEntries, modelPath, playerGRXEdition, p.currentSelectGUID, currentEquippedItemGUID ) )
		}
	}

	return listItems
}
































































RTKCosmeticListItemModel function RTKCosmeticEquip_GetItemModelFromItemFlav( ItemFlavor itemFlav, array<LoadoutEntry> loadoutEntries, string modelPath, int playerGRXEdition, int currentSelectGUID = -1, int currentEquippedItemGUID = -1, bool isCategory = false, int parentCategoryGUID = -1 )
{
	RTKCosmeticListItemModel model

	model.flavGUID           = ItemFlavor_GetGUID( itemFlav )
	model.isCategory         = isCategory
	model.parentCategoryGUID = parentCategoryGUID
	model.name               = Localize( ItemFlavor_GetLongName( itemFlav ) )
	model.quality            = ItemFlavor_HasQuality( itemFlav ) ? ItemFlavor_GetQuality( itemFlav ) : 0
	model.eventIcon          = ItemFlavor_GetSourceIcon( itemFlav )

	if ( !isCategory )
	{
		model.isFavorite         = IsBitFlagSet( itemFlav.loadoutSortPriority, eLoadoutSortPriority.FAVORITE )

		if ( RTKCosmeticEquip_DoesItemHaveSubQuality( itemFlav ) )
		{
			model.subQuality = Mythics_GetSkinTierIntForSkin( itemFlav )
		}

		if ( ItemFlavor_GetType( itemFlav ) == eItemType.weapon_skin && WeaponSkin_DoesReactToKills( itemFlav ) && model.quality != eRarityTier.MYTHIC ) 
		{
			model.hasVisualFlair = true
		}
	}

	int state = eUICosmeticItemState.AVAILABLE
	bool itemIsUnlocked = IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), loadoutEntries[ 0 ], itemFlav, false, true )
	bool itemIsEquipped = model.flavGUID == currentEquippedItemGUID
	bool itemIsSelected = model.flavGUID == currentSelectGUID

	if ( !itemIsUnlocked )
	{
		if ( itemIsSelected )
			state = eUICosmeticItemState.SELECTED_AND_LOCKED
		else
			state = eUICosmeticItemState.LOCKED
	}
	else if ( itemIsEquipped )
	{
		if ( currentSelectGUID == -1 || itemIsSelected )
			state = eUICosmeticItemState.SELECTED_AND_EQUIPPED
		else
			state = eUICosmeticItemState.EQUIPPED
	}
	else if ( Newness_IsItemFlavorNew( itemFlav ) )
	{
		state = eUICosmeticItemState.NEW
	}
	else if ( itemIsSelected )
	{
		state = eUICosmeticItemState.SELECTED_AND_AVAILABLE
	}
	model.state = state

	ItemFlavorPurchasabilityInfo ifpi = GRX_GetItemPurchasabilityInfo( itemFlav )
	foreach ( string location, offers in ifpi.locationToDedicatedStoreOffersMap )
	{
		foreach ( offer in offers )
		{
			if ( RTKCosmeticStoreOffers_ShouldOfferBeShown( itemFlav, location, offer ) )
			{
				model.hasOffer = true
			}

			if ( !GRX_IsItemOwnedByPlayer( itemFlav ) && location == "leg" && "edition" in offer.attributes && ConvertStringToInt( offer.attributes[ "edition" ] ) == playerGRXEdition )
			{
				model.isNewlyAdded = true
			}
		}
	}

	if ( model.isNewlyAdded )
	{
		model.toolTipText += Localize( "#COSMETIC_ITEM_IS_NEWLY_ADDED" )
	}

	if ( model.hasOffer )
	{
		if ( model.toolTipText.len() > 0 )
			model.toolTipText+= "\n"
		model.toolTipText += Localize( "#COSMETIC_ITEM_HAS_OFFER" )
	}

	model.modelPath = modelPath

	return model
}

RTKCosmeticListItemModel ornull function RTKCosmeticEquip_GetItemModelByFlavGUID( rtk_behavior self, int flavGUID )
{
	ScreenPrivateData p
	self.Private( p )

	foreach ( int index, listItem in p.cosmeticList )
	{
		if ( listItem.flavGUID == flavGUID || listItem.categoryContentGUIDs.contains( flavGUID ) )
		{
			return listItem
		}
	}

	return null
}

RTKCosmeticListItemModel ornull function RTKCosmeticEquip_GetCurrentItemModel( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	return RTKCosmeticEquip_GetItemModelByFlavGUID( self, p.currentHighlightGUID )
}

bool function RTKCosmeticEquip_IsSharedFavoriteFlav( ItemFlavor item )
{
	return ItemFlavor_GetAssetShortName( item ) == "_shared_favorites"
}

bool function RTKCosmeticEquip_DoesItemHaveSubQuality( ItemFlavor itemFlav )
{
	return ItemFlavor_GetType( itemFlav ) == eItemType.character_skin && ItemFlavor_GetQuality( itemFlav ) == eRarityTier.MYTHIC
}

bool function RTKCosmeticEquip_IsItemUnlockable( int flavGUID )
{
	if ( !GRX_IsInventoryReady() || !GRX_AreOffersReady() )
		return false

	ItemFlavor ornull itemFlav = GetItemFlavorOrNullByGUID( flavGUID )
	if ( itemFlav == null )
		return false

	expect ItemFlavor( itemFlav )
	
	if ( ItemFlavor_GetType( itemFlav ) == eItemType.melee_skin && Artifacts_Loadouts_IsConfigPointerItemFlavor( itemFlav ) )
	{
		return !IsItemFlavorUnlockedForLoadoutSlot( ToEHI( GetLocalClientPlayer() ), Loadout_MeleeSkin( GetTopLevelCustomizeContext() ), itemFlav )
	}

	if ( GRX_IsItemOwnedByPlayer( itemFlav ) )
		return false

	return RTKCosmeticEquip_DoesItemHaveCraftingOrLLOffer( itemFlav )
}

bool function RTKCosmeticEquip_DoesItemHaveCraftingOrLLOffer( ItemFlavor itemFlav )
{
	const array<string> offerLocations = [ "leg", "universal_set_shop", "heirloom_set_shop" ]

	ItemFlavorPurchasabilityInfo ifpi = GRX_GetItemPurchasabilityInfo( itemFlav )

	if ( !ifpi.isPurchasableAtAll )
		return false

	if ( ifpi.craftingOfferOrNull != null )
		return true

	foreach ( s in offerLocations )
	{
		if ( s in ifpi.locationToDedicatedStoreOffersMap )
			return true
	}

	return false
}

bool function RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( ItemFlavor itemFlav )
{
	int itemType = ItemFlavor_GetType( itemFlav )
	if ( !FLAV_TYPES_NEED_CHARACTER_UNLOCKED.contains( itemType ) )
		return false

	return RTKCosmeticEquip_DoesScreenNeedCharacterUnlockedFirst()
}

bool function RTKCosmeticEquip_DoesScreenNeedCharacterUnlockedFirst()
{
	ItemFlavor characterFlav = GetTopLevelCustomizeContext()
	if ( ItemFlavor_GetType( characterFlav ) != eItemType.character )
		return false

	return !Character_IsCharacterOwnedByPlayer( characterFlav )
}

string function RTKCosmeticEquip_GetOwnedString( LoadoutEntry entry, array<ItemFlavor> itemList, bool ignoreDefaultItemForOwnedCount, bool shouldIgnoreOtherSlotsForOwnedCount )
{
	EHI playerEHI = LocalClientEHI()
	int owned = 0
	int total = itemList.len()

	foreach ( ItemFlavor itemFlav in itemList )
	{
		if ( IsItemFlavorUnlockedForLoadoutSlot( playerEHI, entry, itemFlav, false, shouldIgnoreOtherSlotsForOwnedCount ) )
		{
			owned++
		}
	}

	if ( ignoreDefaultItemForOwnedCount )
	{
		owned--
		total--
	}

	if ( itemList.contains( entry.favoriteItemFlavor ) )
	{
		owned--
		total--
	}

	return Localize( "#X/Y", owned, total )
}

int function RTKCosmeticEquip_GetSelectItemState( int previousState )
{
	switch ( previousState )
	{
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.NEW:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
			return eUICosmeticItemState.SELECTED_AND_AVAILABLE
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			return eUICosmeticItemState.SELECTED_AND_EQUIPPED
		case eUICosmeticItemState.LOCKED:
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
			return eUICosmeticItemState.SELECTED_AND_LOCKED
		case eUICosmeticItemState.RESTRICTED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			return eUICosmeticItemState.SELECTED_AND_RESTRICTED
	}

	unreachable
}

int function RTKCosmeticEquip_GetDeSelectItemState( int previousState )
{
	switch ( previousState )
	{
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.NEW:
			return eUICosmeticItemState.AVAILABLE
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
		case eUICosmeticItemState.EQUIPPED:
			return eUICosmeticItemState.EQUIPPED
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
		case eUICosmeticItemState.LOCKED:
			return eUICosmeticItemState.LOCKED
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
		case eUICosmeticItemState.RESTRICTED:
			return eUICosmeticItemState.RESTRICTED
	}

	unreachable
}

int function RTKCosmeticEquip_GetEquipItemState( int previousState )
{
	switch ( previousState )
	{
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.NEW:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			return eUICosmeticItemState.SELECTED_AND_EQUIPPED
		case eUICosmeticItemState.LOCKED:
			return eUICosmeticItemState.LOCKED
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
			return eUICosmeticItemState.SELECTED_AND_LOCKED
		case eUICosmeticItemState.RESTRICTED:
			return eUICosmeticItemState.RESTRICTED
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			return eUICosmeticItemState.SELECTED_AND_RESTRICTED
	}

	unreachable
}

int function RTKCosmeticEquip_GetDeEquipItemState( int previousState )
{
	switch ( previousState )
	{
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			return eUICosmeticItemState.AVAILABLE
		case eUICosmeticItemState.LOCKED: 
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.NEW:
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
			return eUICosmeticItemState.AVAILABLE
		case eUICosmeticItemState.RESTRICTED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			return eUICosmeticItemState.RESTRICTED
	}

	unreachable
}

bool function RTKCosmeticEquip_CanItemBeEquipped( int state )
{
	switch ( state )
	{
		case eUICosmeticItemState.NEW:
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			return true
	}

	return false
}

asset function RTKMutator_GetRightIconAssetFromState( int state )
{
	asset icon = $""

	switch ( state )
	{
		case eUICosmeticItemState.LOCKED:
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
			icon = $"ui_image/rui/menu/buttons/lock.rpak"
			break
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			icon = $"ui_image/rui/menu/buttons/equipped.rpak"
			break
		case eUICosmeticItemState.RESTRICTED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			icon = $"ui_image/rui/menu/common/icon_unable_equip.rpak"
			break
		case eUICosmeticItemState.NEW:
			icon = $"ui_image/rui/menu/buttons/new.rpak"
			break

		
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
			break
	}

	return icon
}

vector function RTKMutator_GetRightIconColorFromState( int state )
{
	vector color = <1.0, 1.0, 1.0>

	switch ( state )
	{
		case eUICosmeticItemState.LOCKED:
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
		case eUICosmeticItemState.RESTRICTED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			color = <143, 143, 143> / 255
			break
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			color = <246, 134, 40> / 255
			break

		
		case eUICosmeticItemState.AVAILABLE:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
		case eUICosmeticItemState.NEW:
			break
	}

	return color
}

bool function RTKMutator_IsCosmeticStateLockedOrRestricted( int state )
{
	switch ( state )
	{
		case eUICosmeticItemState.LOCKED:
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
		case eUICosmeticItemState.RESTRICTED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			return true
		default:
			return false
	}

	unreachable
}

bool function RTKMutator_IsCosmeticStateSelected( int state )
{
	switch ( state )
	{
		case eUICosmeticItemState.SELECTED_AND_LOCKED:
		case eUICosmeticItemState.SELECTED_AND_AVAILABLE:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_RESTRICTED:
			return true
		default:
			return false
	}

	unreachable
}

bool function RTKMutator_IsCosmeticStateEquipped( int state )
{
	switch ( state )
	{
		case eUICosmeticItemState.EQUIPPED:
		case eUICosmeticItemState.SELECTED_AND_EQUIPPED:
			return true
		default:
			return false
	}

	unreachable
}




void function RTKCosmeticEquip_Telemetry_SendPageViewEvent( string modelPath, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry = RTKCosmeticEquip_Telemetry_GetTelemetryStruct( modelPath, topLevelContext )
	telemetry.pageViewCount++
	telemetry.numItemsClicked = 0

	PIN_PageView_LegendLocker( telemetry.pageName, telemetry.pageViewCount )
}

void function RTKCosmeticEquip_Telemetry_SendItemViewEvent( string modelPath, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry = RTKCosmeticEquip_Telemetry_GetTelemetryStruct( modelPath, topLevelContext )
	telemetry.numItemsClicked++

	PIN_PageView_LegendLocker_OnItemView( telemetry.pageName, telemetry.numItemsClicked )
}

void function RTKCosmeticEquip_Telemetry_SendUnlockEvent( string modelPath, string categoryName, string itemName, string qualityName, int price, string currency, bool offersWidgetActive, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry = RTKCosmeticEquip_Telemetry_GetTelemetryStruct( modelPath, topLevelContext )

	PIN_Currency_LegendLocker_OnUnlock( telemetry.pageName, categoryName, itemName, qualityName, price, currency, offersWidgetActive )
}

void function RTKCosmeticEquip_Telemetry_SendSortEvent( string modelPath, string sortType, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry = RTKCosmeticEquip_Telemetry_GetTelemetryStruct( modelPath, topLevelContext )
	PIN_UIInteraction_LegendLocker_OnSort( telemetry.pageName, sortType )
}

void function RTKCosmeticEquip_Telemetry_SendExitEvent( string modelPath, string lastSortType, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry = RTKCosmeticEquip_Telemetry_GetTelemetryStruct( modelPath, topLevelContext )
	PIN_UIInteraction_LegendLocker_OnExit( telemetry.pageName, lastSortType )
}

LegendLockerTelemetry function RTKCosmeticEquip_Telemetry_GetTelemetryStruct( string modelPath, string topLevelContext = "" )
{
	LegendLockerTelemetry telemetry
	string key = topLevelContext + "_" + modelPath
	if ( !( key in fileTelemetry.telemetryTable ) )
	{
		telemetry.pageName = "legend_locker_" + key
		fileTelemetry.telemetryTable[ key ] <- telemetry
	}
	telemetry = fileTelemetry.telemetryTable[ key ]

	return telemetry
}

void function RTKCosmeticEquip_Telemetry_SendItemEquipEvent( ItemFlavor itemFlav )
{
	ItemFlavor ornull context = IsTopLevelCustomizeContextValid() ? GetTopLevelCustomizeContext() : null
	int ornull tier = null
	if ( DigitalGarments_IsEnabled() && ItemFlavor_GetType( itemFlav ) == eItemType.digital_garment )
	{
		tier = DigitalGarments_GetGarmentTier( LocalClientEHI(), itemFlav )
	}

	PIN_Customization( context, itemFlav, "equip", 0, tier )
}

void function RTKCosmeticEquip_Telemetry_SendToggleFavoriteEvent( ItemFlavor itemFlav, bool addFavourite )
{
	ItemFlavor ornull context = IsTopLevelCustomizeContextValid() ? GetTopLevelCustomizeContext() : null
	string customizeAction = addFavourite ? "add_favorite" : "clear_favorite"

	PIN_Customization( context, itemFlav, customizeAction, 0, null )
}
