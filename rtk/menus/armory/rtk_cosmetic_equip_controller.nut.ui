void function RTKCosmeticEquipScreen_ClearItemPreview( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	string modelPath = self.PropGetString( "modelPath" )
	rtk_struct screenStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, modelPath, "RTKCosmeticEquipScreenModel" )

	switch ( p.lastPreviewType )
	{
		case eCosmeticPreviewType.IMAGE:
			RTKStruct_SetAssetPath( screenStruct, "imagePreview", $"" )
			break
		case eCosmeticPreviewType.BINK:
			RTKStruct_SetAssetPath( screenStruct, "videoPreview", $"" )
			break
		case eCosmeticPreviewType.WEAPON_MODEL:
			break
		case eCosmeticPreviewType.MELEE_MODEL:
			RunClientScript( "UIToClient_ClearMeleeSkinPreview" )
			break
		}
}

void function RTKCosmeticEquipScreen_ShowGenericPreview( rtk_behavior self, ItemFlavor itemFlav )
{
	ScreenPrivateData p
	self.Private( p )

	switch ( ItemFlavor_GetType( itemFlav ) )
	{
		case eItemType.weapon_skin:
			RTKCosmeticEquipScreen_ShowWeaponModelPreview( self, itemFlav )
			break
		case eItemType.character_skin:
			RTKCosmeticEquipScreen_ShowCharacterModelPreview( self, itemFlav )
			break
		case eItemType.weapon_addon:
			if ( WeaponAddOn_IsTheEmpty( itemFlav ) )
			{
				RTKCosmeticEquipScreen_ShowImagePreview( self, $"ui_image/rui/menu/common/emptyKnockFX.rpak" )
			}
			else
			{
				asset videoPreview = WeaponAddOn_GetKnockFXVideo( itemFlav )
				RTKCosmeticEquipScreen_ShowVideoPreview( self, videoPreview )
			}
			break
		case eItemType.character_execution:
			RTKCosmeticEquipScreen_ShowVideoPreview( self, CharacterExecution_GetExecutionVideo( itemFlav ) )
			break
		case eItemType.character_select:

			asset previewVideo = $""
			asset previewImage = $""
			ItemFlavor character    = GetTopLevelCustomizeContext()
			ItemFlavor skinEquipped = LoadoutSlot_GetItemFlavor( LocalClientEHI(), Loadout_CharacterSkin( character ) )

			
			if ( itemFlav == Loadout_CharacterSelect( character ).defaultItemFlavor )
			{
				previewImage = CharacterClass_GetDefaultCharacterSelectPreviewAsset ( character )
				RTKCosmeticEquipScreen_ShowImagePreview( self, previewImage )
			}
			else
			{
				if ( CharacterSelect_IsLockedToOPSkin( itemFlav ) )
				{
					previewVideo = CharacterSelect_GetOPSkinVideo( itemFlav, skinEquipped )
				}

				if ( previewVideo == $"" )
				{
					previewVideo = CharacterSelect_GetPreviewVideo( itemFlav )
					if ( previewVideo == $"" )
					{
						previewImage = CharacterSelect_GetPreviewImage( itemFlav )
					}
				}

				if ( previewVideo != $"" )
				{
					RTKCosmeticEquipScreen_ShowVideoPreview( self, previewVideo )
				}
				else if ( previewImage != $"" )
				{
					RTKCosmeticEquipScreen_ShowImagePreview( self, previewImage )
				}
				else
				{
					Warning( "No Video or Image for character select ", ItemFlavor_GetLongName( itemFlav ) )
					RTKCosmeticEquipScreen_ShowImagePreview( self, previewImage )
				}
			}

			break
		case eItemType.digital_garment:
			RTKCosmeticEquipScreen_ShowCharacterGarmentPreview( self, itemFlav )
			break
		case eItemType.melee_skin:
			ItemFlavor character = GetTopLevelCustomizeContext()
			if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( itemFlav ) )
			{
				Artifacts_Loadouts_CheckAndFixMisconfigurations( LocalClientEHI(), character )
				RunClientScript( "Artifacts_StoreLoadoutDataOnPlayerEntityStruct", null, null, false )

				array<ItemFlavor> equippedItems = Artifacts_GetEquippedSet( itemFlav )
				foreach ( ItemFlavor item in equippedItems )
				{
					RunClientScript( "Artifacts_Loadouts_StorePreviewDataOnPlayerEntityStruct", ItemFlavor_GetGUID( item ) )
				}
			}

			if ( itemFlav == GetDefaultItemFlavorForLoadoutSlot( Loadout_MeleeSkin( character ) ) )
				RTKCosmeticEquipScreen_ShowImagePreview( self, $"ui_image/rui/menu/common/fists.rpak" )
			else
				RTKCosmeticEquipScreen_ShowMeleeSkinPreview( self, itemFlav )
			break
	}

	Newness_IfNecessaryMarkItemFlavorAsNoLongerNewAndInformServer( itemFlav )
	bool doesItemNeedCharacterUnlockedFirst = RTKCosmeticEquip_DoesItemNeedCharacterUnlockedFirst( itemFlav )

	
	bool itemIsUnlocked = !doesItemNeedCharacterUnlockedFirst && IsItemFlavorUnlockedForLoadoutSlot( LocalClientEHI(), p.loadoutEntries[ 0 ], itemFlav, false, true )
	RTKCosmeticEquipScreen_SetPrimaryButtonVisible( self, itemIsUnlocked && p.currentSelectGUID != p.currentEquipGUID )

	
	if ( self.PropGetBool( "enableSecondaryButton" ) )
	{
		if ( doesItemNeedCharacterUnlockedFirst )
		{
			ItemFlavor characterFlav = GetTopLevelCustomizeContext()
			string unlockButtonText = Character_IsUnlockableInNewPlayerPass( characterFlav ) ? "#BP_UNLOCK_NPP_LEGENDS" : "#UNLOCK_LEGEND"
			RTKCosmeticEquipScreen_SetSecondaryButtonVisible( self, true, unlockButtonText )
		}
		else
		{
			bool itemIsUnlockable      = RTKCosmeticEquip_IsItemUnlockable( ItemFlavor_GetGUID( itemFlav ) )
			string secondaryButtonText = "#UNLOCK"

			ItemFlavorPurchasabilityInfo ifpi = GRX_GetItemPurchasabilityInfo( itemFlav )
			if ( itemIsUnlockable && ifpi.isPurchasableAtAll )
			{
				if ( ifpi.craftingOfferOrNull != null )
				{
					secondaryButtonText = "#LEGEND_LOCKER_UNLOCK_CM"
				}
				else if ( "leg" in ifpi.locationToDedicatedStoreOffersMap )
				{
					secondaryButtonText = "#LEGEND_LOCKER_UNLOCK_AC"
				}
			}

			RTKCosmeticEquipScreen_SetSecondaryButtonVisible( self, itemIsUnlockable && p.currentSelectGUID != p.currentEquipGUID, secondaryButtonText )
		}
	}

	UpdateFooterOptions()
}

void function RTKCosmeticEquipScreen_ShowImagePreview( rtk_behavior self, asset imagePreview )
{
	ScreenPrivateData p
	self.Private( p )

	if ( p.lastPreviewType != eCosmeticPreviewType.IMAGE )
	{
		RTKCosmeticEquipScreen_ClearItemPreview( self )
	}

	string modelPath = self.PropGetString( "modelPath" )
	rtk_struct screenStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, modelPath, "RTKCosmeticEquipScreenModel" )

	if ( RTKStruct_GetAssetPath( screenStruct, "imagePreview" ) != imagePreview )
		RTKStruct_SetAssetPath( screenStruct, "imagePreview", imagePreview )

	p.lastPreviewType = eCosmeticPreviewType.IMAGE
}

void function RTKCosmeticEquipScreen_ShowVideoPreview( rtk_behavior self, asset videoPreview )
{
	ScreenPrivateData p
