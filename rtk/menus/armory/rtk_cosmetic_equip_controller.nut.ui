const array<int> FLAV_TYPES_NEED_CHARACTER_UNLOCKED = 
[
	eItemType.character_skin,
	eItemType.character_execution,
	eItemType.character_select,
	eItemType.digital_garment,
	eItemType.melee_skin
]


void function RTKCosmeticEquipScreen_OnInitialize( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	string modelPath = self.PropGetString( "modelPath" )
	rtk_struct screenStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, modelPath, "RTKCosmeticEquipScreenModel" )

	
	p.onPreviewListenerID = RTKStruct_AddPropertyListener( screenStruct, "currentPreviewGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		self.InvokeEvent( "onCosmeticPreview", expect int( propValue ) )
	} )

	
	p.onEquipListenerID = RTKStruct_AddPropertyListener( screenStruct, "currentEquipGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		self.InvokeEvent( "onCosmeticEquip", expect int( propValue ) )
	} )

	
	p.onHighlightListenerID = RTKStruct_AddPropertyListener( screenStruct, "currentHighlightGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		self.InvokeEvent( "onCosmeticHighlight", expect int( propValue ) )
	} )

	
	p.onFavoriteListenerID = RTKStruct_AddPropertyListener( screenStruct, "favoriteGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		self.InvokeEvent( "onCosmeticFavorite", expect int( propValue ) )
	} )

	
	p.onTryUnlockListenerID = RTKStruct_AddPropertyListener( screenStruct, "tryUnlockGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		self.InvokeEvent( "onCosmeticTryUnlock", expect int( propValue ) )
	} )

	p.onCategoryToggleListenerID = RTKStruct_AddPropertyListener( screenStruct, "categoryToggleGUID", void function ( rtk_struct properties, string propName, int propType, var propValue ) : ( self ) {
		RTKCosmeticEquipScreen_GenericCategoryToggle( self, expect int( propValue ) )
	} )

	
	RTKCosmeticEquipScreen_OverridePrimaryButtonFunction( self, void function( rtk_behavior button, int keycode, int prevState ) : ( self ) {
		RTKCosmeticEquipScreen_OnPrimaryButtonPressed( self )
	} )

	self.GetPanel().SetBindingRootPath( RTKDataModelType_GetDataPath( RTK_MODELTYPE_MENUS, modelPath, true ) )

	
	string topLevelContext = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
	RTKCosmeticEquip_Telemetry_SendPageViewEvent( modelPath, topLevelContext )
}

void function RTKCosmeticEquipScreen_OnDestroy( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	string modelPath = self.PropGetString( "modelPath" )
	rtk_struct screenStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, modelPath, "RTKCosmeticEquipScreenModel" )

	RTKStruct_RemovePropertyListener( screenStruct, "currentPreviewGUID", p.onPreviewListenerID )
	RTKStruct_RemovePropertyListener( screenStruct, "currentEquipGUID", p.onEquipListenerID )
	RTKStruct_RemovePropertyListener( screenStruct, "currentHighlightGUID", p.onHighlightListenerID )
	RTKStruct_RemovePropertyListener( screenStruct, "favoriteGUID", p.onFavoriteListenerID )
	RTKStruct_RemovePropertyListener( screenStruct, "tryUnlockGUID", p.onTryUnlockListenerID )
	RTKStruct_RemovePropertyListener( screenStruct, "categoryToggleGUID", p.onCategoryToggleListenerID )

	rtk_behavior primaryButton = self.PropGetBehavior( "primaryButton" )
	primaryButton.RemoveEventListener( "onPressed", p.onPrimaryClickedListenerID )

	rtk_behavior secondaryButton = self.PropGetBehavior( "secondaryButton" )
	secondaryButton.RemoveEventListener( "onPressed", p.onSecondaryClickedListenerID )

	rtk_behavior tertiaryButton = self.PropGetBehavior( "tertiaryButton" )
	tertiaryButton.RemoveEventListener( "onPressed", p.onTertiaryClickedListenerID )

	if ( p.setScreenDataModelFunction != null )
	{
		RemoveCallback_OnGRXInventoryStateChanged( p.setScreenDataModelFunction )
		RemoveCallback_OnGRXOffersRefreshed( p.setScreenDataModelFunction )
	}

	if ( p.favoriteSlotChangedCallback != null && p.loadoutEntries.len() > 0 )
	{
		RemoveCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( LocalClientEHI(), p.loadoutEntries[ 0 ], p.favoriteSlotChangedCallback )
		p.favoriteSlotChangedCallback = null
	}

	RTKDataModelType_DestroyStruct( RTK_MODELTYPE_MENUS, modelPath )

	RTKCosmeticEquipScreen_ClearItemPreview( self )




	
	string topLevelContext = ItemFlavor_GetLongName( GetTopLevelCustomizeContext() )
	RTKCosmeticEquip_Telemetry_SendExitEvent( modelPath, p.sortFuncNames[ p.sortFuncIndex ], topLevelContext )
}

int function RTKCosmeticEquipScreen_GetPreviewGUID( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	return p.currentSelectGUID
}

int function RTKCosmeticEquipScreen_GetEquipGUID( rtk_behavior self )
{
	ScreenPrivateData p
	self.Private( p )

	return p.currentEquipGUID
}

void function RTKCosmeticEquipScreen_SetAutoSubscribeCallbacks(
		rtk_behavior self,
		void functionref( int ) previewHandler = null,
		void functionref( int ) equipHandler = null,
		void functionref( int ) highlightHandler = null,
		void functionref( int ) favoriteHandler = null,
		void functionref( int ) tryUnlockHandler = null )
{
	if ( previewHandler != null )
		RTKCosmeticEquipScreen_AutoSubscribeOnItemPreview( self, previewHandler )

	if ( equipHandler != null )
		RTKCosmeticEquipScreen_AutoSubscribeOnItemEquip( self, equipHandler )

	if ( highlightHandler != null )
		RTKCosmeticEquipScreen_AutoSubscribeOnItemHighlight( self, highlightHandler )

	if ( favoriteHandler != null )
		RTKCosmeticEquipScreen_AutoSubscribeOnItemFavorite( self, favoriteHandler )

	if ( tryUnlockHandler != null )
		RTKCosmeticEquipScreen_AutoSubscribeOnItemTryUnlock( self, tryUnlockHandler )
}

void function RTKCosmeticEquipScreen_AutoSubscribeOnItemPreview( rtk_behavior self, void functionref( int ) handler )
{
	self.AutoSubscribe( self, "onCosmeticPreview", handler )
}

void function RTKCosmeticEquipScreen_AutoSubscribeOnItemEquip( rtk_behavior self, void functionref( int ) handler )
{
	self.AutoSubscribe( self, "onCosmeticEquip", handler )
}

void function RTKCosmeticEquipScreen_AutoSubscribeOnItemHighlight( rtk_behavior self, void functionref( int ) handler )
{
	self.AutoSubscribe( self, "onCosmeticHighlight", handler )
}

void function RTKCosmeticEquipScreen_AutoSubscribeOnItemFavorite( rtk_behavior self, void functionref( int ) handler )
{
	self.AutoSubscribe( self, "onCosmeticFavorite", handler )
}

void function RTKCosmeticEquipScreen_AutoSubscribeOnItemTryUnlock( rtk_behavior self, void functionref( int ) handler )
{
	self.AutoSubscribe( self, "onCosmeticTryUnlock", handler )
}

void function RTKCosmeticEquipScreen_OverrideGRXCallbacks( rtk_behavior self, void functionref() handler = null )
{
	ScreenPrivateData p
	self.Private( p )

	if ( handler != null )
	{
		p.setScreenDataModelFunction = handler
		AddCallback_OnGRXInventoryStateChanged( p.setScreenDataModelFunction )
		AddCallback_OnGRXOffersRefreshed( p.setScreenDataModelFunction )
	}
}

void function RTKCosmeticEquipScreen_OverridePrimaryButtonFunction( rtk_behavior self, void functionref( rtk_behavior, int, int ) handler )
{
	ScreenPrivateData p
	self.Private( p )

	
	rtk_behavior button = self.PropGetBehavior( "primaryButton" )
	button.RemoveEventListener( "onPressed", p.onPrimaryClickedListenerID )

	
	p.onPrimaryClickedListenerID = button.AddEventListener( "onPressed", handler )
}

void function RTKCosmeticEquipScreen_OverrideSecondaryButtonFunction( rtk_behavior self, void functionref( rtk_behavior, int, int ) handler )
{
	ScreenPrivateData p
	self.Private( p )

	
	rtk_behavior button = self.PropGetBehavior( "secondaryButton" )
	button.RemoveEventListener( "onPressed", p.onSecondaryClickedListenerID )

	
	p.onSecondaryClickedListenerID = button.AddEventListener( "onPressed", handler )
}

void function RTKCosmeticEquipScreen_OverrideTertiaryButtonFunction( rtk_behavior self, void functionref( rtk_behavior, int, int ) handler )
