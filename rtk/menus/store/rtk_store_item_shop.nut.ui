RTKStoreSectionModel function GetLegendPassSection( array<GRXScriptOffer> offers )
{
	RTKStoreSectionModel section

	if ( GRX_IsOfferRestricted() )
		return section

	RTKStoreGridItemModel infoButton
	infoButton.gridItemType  = eStoreGridItemType.INFO_SML
	infoButton.mainImage     = $"ui_image/rui/menu/store/common/store_offer_pass_bg.rpak"
	infoButton.mainText      = "#FOOTER_MORE_INFO_MOUSE"
	infoButton.subText       = "#LEGENDPASS_MORE_INFO_BUTTON_DESC"
	infoButton.priceColor    = <1.0, 1.0, 1.0>
	infoButton.newPriceColor = <0.6, 0.6, 0.6>
	infoButton.miscText1     = "legendpassinfo"
	infoButton.miscBool      = true 
	section.itemsArray.insert( 0, infoButton )

	foreach ( int index, offer in offers )
	{
		RTKStoreGridItemModel itemModel = GetItemModelFromOffer( offer, index, eStoreGridItemType.OFFER_1_2 )
		section.itemsArray.append( itemModel )
	}

	section.endTime = 0

	return section
}

string function GetCurrencyBalanceString( int currency )
{
	ItemFlavor currencyFlav = GRX_CURRENCIES[currency]
	asset currencyIcon = ItemFlavor_GetIcon( currencyFlav )
	int currencyAmount = GRXCurrency_GetPlayerBalance( GetLocalClientPlayer(), currencyFlav )
	return "%$" + currencyIcon + "% " + FormatAndLocalizeNumber( "1", float( currencyAmount ), true )
}

RTKStoreSectionModel function GetApexPacksOfferSection()
{
	RTKStoreSectionModel section

	if ( GetLootTickPurchaseOffers() != null )
	{
		array<GRXScriptOffer> offers = expect array<GRXScriptOffer>( GetLootTickPurchaseOffers() )

		RTKStoreGridItemModel gridItem
		gridItem.gridItemType = eStoreGridItemType.BONUS_METER
		gridItem.bindingPath  = "" 
		section.itemsArray.insert( 0, gridItem )
		bool offerContainsWishlistRelatedPack = false
		foreach ( int index, offer in offers )
		{
			int gridItemType = eStoreGridItemType.OFFER_1_2
			switch ( index )
			{
				case 0:
				case 1:
					gridItemType = eStoreGridItemType.OFFER_1_1
					break
			}

			RTKStoreGridItemModel itemModel = GetItemModelFromOffer( offer, index, gridItemType )
			section.itemsArray.append( itemModel )

			if ( GRXOffer_ContainsWishlistRelatedPack( offer ) )
				offerContainsWishlistRelatedPack = true
		}

		section.endTime = 0
		section.sectionName = "#APEX_PACKS"
		section.totalOffers = offers.len()
		if ( !Wishlist_IsCompleted() )
		{
			section.sectionCount = Localize( "#WISHLIST_STORE_UPGRADABLE" )
			section.showWishlistButton = offerContainsWishlistRelatedPack
		}
	}

	return section
}

RTKStoreSectionModel function GetLimitedTimeApexPacksOfferSection()
{
	RTKStoreSectionModel section

	if ( GetLimitedTimeApexPacksOffers() != null )
	{
		array<GRXScriptOffer> offers = expect array<GRXScriptOffer>( GetLimitedTimeApexPacksOffers() )
		int weeklyOfferIndex = offers.len() - 1
		int sectionExpireTime = INT_MAX

		bool offerContainsWishlistRelatedPack = false

		foreach ( int index, offer in offers )
		{
			RTKStoreGridItemModel itemModel = GetItemModelFromOffer( offer, index, eStoreGridItemType.OFFER_1_2 )
			section.itemsArray.append( itemModel )

			if ( offer.expireTime < sectionExpireTime && offer.expireTime != 0 )
			{
				sectionExpireTime = offer.expireTime
			}
			if ( GRXOffer_ContainsWishlistRelatedPack( offer ) )
				offerContainsWishlistRelatedPack = true
		}

		section.endTime = sectionExpireTime
		section.endTimeFormat = "#STORE_V2_TIME_REMAINING"
		section.sectionName = "#LIMITED_TIME"
		section.totalOffers = offers.len()

		section.showWishlistButton = offerContainsWishlistRelatedPack
	}

	return section
}

