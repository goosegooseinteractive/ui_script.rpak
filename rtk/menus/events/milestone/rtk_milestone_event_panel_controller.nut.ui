	rtk_struct trackingPanelModel
	rtk_struct ornull itemViewerModel

	array<rtk_behavior> hoveredItemButtons
	bool hasEnteredItem

	RTKMilestoneDrawerModel milestoneDrawerInfo
	array<RTKMilestoneProgressTrackerTierInfo> milestoneTierInfo
	array<MilestoneEventGrantReward> milestones

	bool isWishlistEnabled = false

	float itemPanelAnimationTime = 0.0
	float eventPanelAnimationTime = 0.0
	float itemPanelAlpha = 0.0
	float eventPanelAlpha = 0.0
	float panelAnimationDelay = 0.0

	
	void functionref() OnGRXStateChanged
}


struct
{
	table<int, int> eventGUIDTolastGridPage
} file

void function RTKMilestoneEventPanelController_InitMetaData( string behaviorType, string structType )
{
	RegisterSignal( "EndPrestigeSkinCarousel" )
}

void function RTKMilestoneEventPanelController_OnInitialize( rtk_behavior self )
{
	PrivateData p
	self.Private( p )


	SetupCallbacks( self )
	self.GetPanel().SetBindingRootPath( RTKDataModelType_GetDataPath( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME + string(self.GetInternalId()), true ) )
}

void function RTKMilestoneEventPanelController_OnDestroy( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	RemoveCallback_OnGRXOffersRefreshed( p.OnGRXStateChanged )
	RemoveCallback_OnGRXInventoryStateChanged( p.OnGRXStateChanged )
	RunClientScript( "ClearBattlePassItem" )
	Signal( uiGlobal.signalDummy, "EndPrestigeSkinCarousel" )

	rtk_behavior ornull gridPagination = self.PropGetBehavior( "gridPagination" )
	if ( gridPagination != null )
	{
		expect rtk_behavior( gridPagination )

		if ( p.activeEvent == null )
			return
		ItemFlavor event = expect ItemFlavor( p.activeEvent )

		file.eventGUIDTolastGridPage[ ItemFlavor_GetGUID( event ) ] = RTKPagination_GetCurrentPage( gridPagination )
	}
	RTKDataModelType_DestroyStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME + string(self.GetInternalId()) )
}

void function RTKMilestoneEventPanelController_OnDisable( rtk_behavior self )
{
	ResetPanelAnimations( self )
}

void function RTKMilestoneEventPanelController_OnUpdate( rtk_behavior self, float dt )
{
	PrivateData p
	self.Private( p )

	if ( p.itemViewerModel == null )
		return

	rtk_struct itemViewerModel = expect rtk_struct( p.itemViewerModel )
	if ( p.hasEnteredItem )
	{
		
		if ( p.hoveredItemButtons.len() > 0 || p.panelAnimationDelay > 0.0)
		{
			if ( p.itemPanelAlpha < 1.0 )
			{
				p.itemPanelAnimationTime = p.itemPanelAnimationTime + dt
				p.itemPanelAlpha = ( p.itemPanelAnimationTime >= PANEL_FADE_IN_DURATION ) ? 1.0 : LerpFloat( PANEL_FADE_IN_ALPHA_FROM, 1.0, p.itemPanelAnimationTime / PANEL_FADE_IN_DURATION )
				RTKStruct_SetFloat( itemViewerModel, "itemViewerPanelAlpha", p.itemPanelAlpha )
			}

			if ( p.eventPanelAlpha > 0.0 )
			{
				p.eventPanelAnimationTime = p.eventPanelAnimationTime + dt
				p.eventPanelAlpha = ( p.eventPanelAnimationTime >= PANEL_FADE_OUT_DURATION ) ? 0.0 : LerpFloat( PANEL_FADE_OUT_ALPHA_FROM, 0.0, p.eventPanelAnimationTime / PANEL_FADE_OUT_DURATION )
				RTKStruct_SetFloat( itemViewerModel, "eventOverviewPanelAlpha", p.eventPanelAlpha )
			}

			p.panelAnimationDelay = p.panelAnimationDelay - dt
			if ( p.hoveredItemButtons.len() == 0 && p.panelAnimationDelay <= 0.0 )
			{
				p.itemPanelAnimationTime = 0.0
				p.eventPanelAnimationTime = 0.0
			}
		}
		else
		{
			if ( p.eventPanelAlpha < 1.0 )
			{
				p.eventPanelAnimationTime = p.eventPanelAnimationTime + dt
				p.eventPanelAlpha = ( p.eventPanelAnimationTime >= PANEL_FADE_IN_DURATION ) ? 1.0 : LerpFloat( PANEL_FADE_IN_ALPHA_FROM, 1.0, p.eventPanelAnimationTime / PANEL_FADE_IN_DURATION )
				RTKStruct_SetFloat( itemViewerModel, "eventOverviewPanelAlpha", p.eventPanelAlpha )
			}

			if ( p.itemPanelAlpha > 0.0 )
			{
				p.itemPanelAnimationTime = p.itemPanelAnimationTime + dt
				if ( p.itemPanelAnimationTime >= PANEL_FADE_OUT_DURATION )
				{
					p.itemPanelAlpha = 0.0
					RunClientScript( "ClearBattlePassItem" )
				}
				else
				{
					p.itemPanelAlpha = LerpFloat( PANEL_FADE_OUT_ALPHA_FROM, 0.0, p.itemPanelAnimationTime / PANEL_FADE_OUT_DURATION )
				}
				RTKStruct_SetFloat( itemViewerModel, "itemViewerPanelAlpha", p.itemPanelAlpha )
			}
		}
	}
	else
	{
		
		if ( p.panelAnimationDelay > 0.0 )
		{
			p.panelAnimationDelay = p.panelAnimationDelay - dt
			if ( p.panelAnimationDelay <= 0.0 )
			{
				p.itemPanelAnimationTime = 0.0
				p.eventPanelAnimationTime = 0.0
			}
		}
		else
		{
			if ( p.eventPanelAlpha < 1.0 )
			{
				p.eventPanelAnimationTime = p.eventPanelAnimationTime + dt
				p.eventPanelAlpha = ( p.eventPanelAnimationTime >= PANEL_FADE_IN_DURATION ) ? 1.0 : LerpFloat( PANEL_FADE_IN_ALPHA_FROM, 1.0, p.eventPanelAnimationTime / PANEL_FADE_IN_DURATION )
				RTKStruct_SetFloat( itemViewerModel, "eventOverviewPanelAlpha", p.eventPanelAlpha )
			}
		}
	}
}


void function SetupButtons( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
		return

	ItemFlavor event = expect ItemFlavor( p.activeEvent )

	rtk_behavior ornull informationButton = self.PropGetBehavior( "informationButton" )
	self.AutoSubscribe( informationButton, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( p, event ) {
		if ( IsMilestoneEventStoreOnly( event ) )
		{
			StoreMilestoneEvents_SendPageViewInfoPage( "packInfoDialog" )
		}
		else
		{
			RTKEventsPanelController_SendPageViewInfoPage( "packInfoDialog" )
		}

		OpenMilestonePackInfoDialog( event )
	} )

	SetUpGridButtons( self )
	SetupMilestoneButtons( self )
	SetupMilestoneDrawerButtons( self )
	SetUpPurchaseButtons( self )
}

void function SetUpGridButtons( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
		return

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)

	rtk_panel ornull offersGrid = self.PropGetPanel( "offersGrid" )
	if ( offersGrid != null )
	{
		expect rtk_panel( offersGrid )

		self.AutoSubscribe( offersGrid, "onChildAdded", function ( rtk_panel newChild, int newChildIndex ) : ( self, event, p ) {
			array< rtk_behavior > gridItems = newChild.FindBehaviorsByTypeName( "Button" )

			foreach( button in gridItems )
			{
				self.AutoSubscribe( button, "onHighlighted", function( rtk_behavior button, int prevState ) : ( self, newChildIndex, event, p ) {
					ItemFlavor item = p.items[newChildIndex]

				
				if ( IsItemWishlistTracker( self, item ) )
					return

					if ( Mythics_IsItemFlavorMythicSkin( item ) )
					{
						thread RTKMilestoneEventPanelController_CarouselPrestigeSkin_Thread( self, item )
					}
					else
					{
						BuildMilestoneItemViewerModel( self, item )
					}

					OnItemButtonEnter( self, button )
					UpdateMilestoneDrawerInfo( self, false, -1, 0 )
				} )

				self.AutoSubscribe( button, "onIdle", function( rtk_behavior button, int prevState ) : ( self, newChildIndex ) {
					Signal( uiGlobal.signalDummy, "EndPrestigeSkinCarousel" )
					OnItemButtonExit( self, button )
				} )

				self.AutoSubscribe( button, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self, newChildIndex, event, p ) {
					if ( !GRX_AreOffersReady() )
						return


					ItemFlavor currentItem = p.items[newChildIndex]
					array<GRXScriptOffer> offers = GRX_GetItemDedicatedStoreOffers( currentItem, MilestoneEvent_GetFrontPageGRXOfferLocation( event, GRX_IsOfferRestricted() ) )

					if ( IsItemWishlistTracker( self, currentItem ) )
					{
						OpenWishlistMenu()
						return
					}

					if ( offers.len() > 0 )
					{
						GRXScriptOffer offer = offers[0]

						bool isStoreOnly = IsMilestoneEventStoreOnly( event )

						if ( isStoreOnly )
						{
							StoreMilestoneEvents_SendPageViewMilestoneOffer( newChildIndex, ItemFlavor_GetLongName( currentItem ) )
						}
						else
						{
							RTKEventsPanelController_SendPageViewEventOffer( self, newChildIndex, ItemFlavor_GetLongName( currentItem ) )
						}

						StoreInspectMenu_AttemptOpenWithOffer( offer )
					}
					else if ( Mythics_IsItemFlavorMythicSkin( currentItem ) )
					{
						OpenMythicSkinFakeOfferPreview( event, currentItem )
					}
					else
					{
						bool isStoreOnly = IsMilestoneEventStoreOnly( event )

						string title = GRX_IsOfferRestricted() ? "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_TITLE" : ( isStoreOnly ? "#MILESTONE_STORE_PURCHASE_PRESENTATION_BUTTON_TITLE" : "#MILESTONE_EVENT_PURCHASE_PRESENTATION_BUTTON_TITLE" )
						string desc = isStoreOnly ? "#MILESTONE_STORE_PURCHASE_PRESENTATION_BUTTON_DESC" : "#MILESTONE_EVENT_PURCHASE_PRESENTATION_BUTTON_DESC"
						if ( GRX_IsOfferRestricted() )
							desc = isStoreOnly ? "#MILESTONE_STORE_LOCKED_PRESENTATION_BUTTON_DESC" : "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_DESC"

						if ( isStoreOnly )
						{
							StoreMilestoneEvents_SendPageViewMilestoneOffer( newChildIndex, ItemFlavor_GetLongName( currentItem ) )
						}
						else
						{
							RTKEventsPanelController_SendPageViewEventOffer( self, newChildIndex, ItemFlavor_GetLongName( currentItem ) )
						}

						int displayQuantity = 0
						if ( ItemFlavor_GetType( currentItem ) == eItemType.reward_set_tracker )
						{
							if ( RewardSetTracker_IsStackable( currentItem ) )
							{
								displayQuantity = RewardSetTracker_GetDisplayQuantity( currentItem )
							}
						}
						if ( displayQuantity > 0 )
						{
							SetGenericItemPresentationModeActiveWithNavBack( p.items[newChildIndex], title, desc, void function() : () {}, displayQuantity )
						}
						else
						{
							SetGenericItemPresentationModeActiveWithNavBack( p.items[newChildIndex], title, desc, void function() : () {} )
						}
					}
				} )
			}
		} )
	}
}

void function SetupMilestoneButtons( rtk_behavior self )
{
	PrivateData p
	self.Private( p )
	if ( p.activeEvent == null )
		return

	ItemFlavor event = expect ItemFlavor( p.activeEvent )

	rtk_panel ornull milestonesList = self.PropGetPanel( "progressTrackerMilestones" )
	if ( milestonesList != null )
	{
		expect rtk_panel( milestonesList )

		self.AutoSubscribe( milestonesList, "onChildAdded", function ( rtk_panel newChild, int tierIndex ) : ( self, event, p ) {

			rtk_behavior prefabInstantiator = newChild.FindBehaviorByTypeName( "PrefabInstantiator" )
			self.AutoSubscribe( prefabInstantiator, "onPrefabInstantiated", function ( int index, rtk_panel newInstance ) : ( self, tierIndex, event, p ) {
				if ( p.milestoneTierInfo[tierIndex].prefabIndex == eMilestoneItemType.ITEM )
				{
					
					rtk_panel ornull itemsPanel = newInstance.FindDescendantByName( "Items" )
					if ( itemsPanel == null )
						return
					expect rtk_panel( itemsPanel )
					
					
					self.AutoSubscribe( itemsPanel, "onChildAdded", function ( rtk_panel newChild, int rewardIndex ) : ( self, tierIndex, event, p ) {

						array< rtk_behavior > rewardButtons = newChild.FindBehaviorsByTypeName( "Button" )
						foreach ( button in rewardButtons )
						{
							SettingsAssetGUID itemGuid = p.milestoneTierInfo[tierIndex].items[rewardIndex].itemGuid
							int itemQuantity           = p.milestoneTierInfo[tierIndex].items[rewardIndex].quantity
							ItemFlavor item            = GetItemFlavorByGUID( itemGuid )

							self.AutoSubscribe( button, "onHighlighted", function( rtk_behavior button, int prevState ) : ( self, item ) {
								BuildMilestoneItemViewerModel( self, item )
								OnItemButtonEnter( self, button )
								UpdateMilestoneDrawerInfo( self, false, -1, 0 )
							} )

							self.AutoSubscribe( button, "onIdle", function( rtk_behavior button, int prevState ) : ( self ) {
								OnItemButtonExit( self, button )
							} )

							self.AutoSubscribe( button, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self, rewardIndex, item, event, itemQuantity, p ) {
								bool isStoreOnly = IsMilestoneEventStoreOnly( event )
								string desc      = isStoreOnly ? "#MILESTONE_STORE_LOCKED_PRESENTATION_BUTTON_DESC" : "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_DESC"
								string itemName  = "milestoneReward_" + ItemFlavor_GetLongName( item )

								if ( isStoreOnly )
								{
									StoreMilestoneEvents_SendPageViewMilestoneOffer( rewardIndex, itemName, true )
								}
								else
								{
									RTKEventsPanelController_SendPageViewEventOffer( self, rewardIndex, itemName, true )
								}

								SetGenericItemPresentationModeActiveWithNavBack( item, "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_TITLE", desc, void function() : () {}, itemQuantity )
							} )
						}
					} )
				}
				else if ( p.milestoneTierInfo[tierIndex].prefabIndex == eMilestoneItemType.STACK )
				{
					foreach ( int rewardIndex, reward in p.milestoneTierInfo[tierIndex].items )
					{
						if ( rewardIndex > 2 )
							break

						rtk_behavior button = newInstance.FindDescendantByName( "Items" ).FindDescendantByName( "Reward_" + rewardIndex ).FindBehaviorByTypeName( "Button" )

						SettingsAssetGUID itemGuid = p.milestoneTierInfo[tierIndex].items[rewardIndex].itemGuid
						int itemQuantity           = p.milestoneTierInfo[tierIndex].items[rewardIndex].quantity
						ItemFlavor item            = GetItemFlavorByGUID( itemGuid )

						self.AutoSubscribe( button, "onHighlighted", function( rtk_behavior button, int prevState ) : ( self, item, tierIndex ) {
							BuildMilestoneItemViewerModel( self, item )
							OnItemButtonEnter( self, button )
							rtk_panel ornull milestonesList = self.PropGetPanel( "progressTrackerMilestones" )
							if ( milestonesList )
							{
								expect rtk_panel( milestonesList )
								UISize vguiscreenSize = GetScreenSize()
								vector rtkScreenSize = RTK_GetVirtualScreenSize()
								UpdateMilestoneDrawerInfo( self, true, tierIndex, ( button.GetPanel().GetAbsolutePositionX() - milestonesList.GetAbsolutePositionX() ) * rtkScreenSize.x / vguiscreenSize.width )
							}
						} )

						self.AutoSubscribe( button, "onIdle", function( rtk_behavior button, int prevState ) : ( self, rewardIndex ) {
							OnItemButtonExit( self, button )
						} )

						self.AutoSubscribe( button, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self, rewardIndex, item, event, itemQuantity, p ) {
							bool isStoreOnly = IsMilestoneEventStoreOnly( event )
							string desc      = isStoreOnly ? "#MILESTONE_STORE_LOCKED_PRESENTATION_BUTTON_DESC" : "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_DESC"
							string itemName  = "milestoneReward_" + ItemFlavor_GetLongName( item )

							if ( isStoreOnly )
							{
								StoreMilestoneEvents_SendPageViewMilestoneOffer( rewardIndex, itemName, true )
							}
							else
							{
								RTKEventsPanelController_SendPageViewEventOffer( self, rewardIndex, itemName, true )
							}

							SetGenericItemPresentationModeActiveWithNavBack( item, "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_TITLE", desc, void function() : () {}, itemQuantity )
						} )
					}
				}
			} )
		} )
	}
}

void function SetUpPurchaseButtons( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
		return

	ItemFlavor event = expect ItemFlavor( p.activeEvent )

	if ( !GRX_IsInventoryReady() )
		return

	rtk_behavior ornull giftButton = self.PropGetBehavior( "giftButton" )
	rtk_behavior ornull purchaseButton = self.PropGetBehavior( "purchaseButton" )
	array<GRXScriptOffer> singlePurchaseOffers = MilestoneEvent_GetSinglePackOffers( event )

	self.ClearAutoSubscribe( giftButton, "onPressed" )
	self.AutoSubscribe( giftButton, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( singlePurchaseOffers, event, p ) {
		int state = GetEventGiftButtonState( singlePurchaseOffers )
		switch ( state )
		{
			case eEventGiftingButtonState.AVAILABLE:
				if ( IsMilestoneEventStoreOnly( event ) )
				{
					StoreMilestoneEvents_SendPageViewPurchaseDialog( true )
				}
				else
				{
					RTKEventsPanelController_SendPageViewPurchaseDialog( true )
				}

				OpenPurchasePackSelectionDialog( true, event )
				break
			case eEventGiftingButtonState.TWO_FACTOR_DISABLED:
				OpenTwoFactorInfoDialog( null )
				break
			case eEventGiftingButtonState.GIFTING_EXCEEDED:
			case eEventGiftingButtonState.NOT_ENOUGH_LEVEL:
			case eEventGiftingButtonState.UNAVAILABLE:
				return
		}
	} )

	self.ClearAutoSubscribe( purchaseButton, "onPressed" )
	self.AutoSubscribe( purchaseButton, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( singlePurchaseOffers, event, p ) {
		int state = GetEventPurchaseButtonState( singlePurchaseOffers )
		switch ( state )
		{
			case eEventPackPurchaseButtonState.AVAILABLE:
				if ( IsMilestoneEventStoreOnly( event ) )
					StoreMilestoneEvents_SendPageViewPurchaseDialog( false )
				else
					RTKEventsPanelController_SendPageViewPurchaseDialog( false )

				OpenPurchasePackSelectionDialog( false, event )
				break
			default:
				EmitUISound( "menu_deny" )
				return
		}
	} )

	BuildPurchaseButtonDataModel( self )
}

void function SetupMilestoneDrawerButtons( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
		return

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)

	rtk_panel ornull milestonesDrawerList = self.PropGetPanel( "progressTrackerMilestonesDrawer" )
	if ( milestonesDrawerList != null )
	{
		expect rtk_panel( milestonesDrawerList )

		
		rtk_panel ornull itemsPanel = milestonesDrawerList.FindDescendantByName( "Items" )
		if ( itemsPanel == null )
			return
		expect rtk_panel( itemsPanel )

		
		self.AutoSubscribe( itemsPanel, "onChildAdded", function ( rtk_panel newChild, int rewardIndex ) : ( self, event, p ) {

			array< rtk_behavior > rewardButtons = newChild.FindBehaviorsByTypeName( "Button" )
			foreach( button in rewardButtons )
			{
				self.AutoSubscribe( button, "onHighlighted", function( rtk_behavior button, int prevState ) : ( self, rewardIndex, p ) {
					ItemFlavor item = GetItemFlavorByGUID( p.milestoneDrawerInfo.milestoneInfo.items[rewardIndex].itemGuid )
					BuildMilestoneItemViewerModel( self, item )
					OnItemButtonEnter( self, button )
				} )

				self.AutoSubscribe( button, "onIdle", function( rtk_behavior button, int prevState ) : ( self, rewardIndex ) {
					OnItemButtonExit( self, button )
				} )

				self.AutoSubscribe( button, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self, event, rewardIndex, p ) {
					ItemFlavor item = GetItemFlavorByGUID( p.milestoneDrawerInfo.milestoneInfo.items[rewardIndex].itemGuid )
					int itemQuantity = p.milestoneDrawerInfo.milestoneInfo.items[rewardIndex].quantity

					bool isStoreOnly = IsMilestoneEventStoreOnly( event )
					string desc = isStoreOnly ? "#MILESTONE_STORE_LOCKED_PRESENTATION_BUTTON_DESC" : "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_DESC"
					string itemName = "milestoneReward_" + ItemFlavor_GetLongName( item )

					if ( isStoreOnly )
						StoreMilestoneEvents_SendPageViewMilestoneOffer( rewardIndex, itemName, true )
					else
						RTKEventsPanelController_SendPageViewEventOffer( self, rewardIndex, itemName, true )

					SetGenericItemPresentationModeActiveWithNavBack( item, "#MILESTONE_EVENT_LOCKED_PRESENTATION_BUTTON_TITLE", desc, void function() : () {}, itemQuantity )
				} )
			}
		} )

		rtk_behavior cursorArea = milestonesDrawerList.FindBehaviorByTypeName( "Button" )

		self.AutoSubscribe( cursorArea, "onIdle", function( rtk_behavior button, int prevState ) : ( self ) {
			UpdateMilestoneDrawerInfo( self, false, -1, 0 )
		} )

	}
}

void function OnItemButtonEnter( rtk_behavior self, rtk_behavior button )
{
	PrivateData p
	self.Private( p )

	p.hasEnteredItem = true
	p.hoveredItemButtons.append( button )
}

void function OnItemButtonExit( rtk_behavior self, rtk_behavior button )
{
	PrivateData p
	self.Private( p )

	p.hoveredItemButtons.fastremovebyvalue( button )
	p.panelAnimationDelay = p.itemPanelAlpha > 0.0 ? PANEL_FADE_OUT_DELAY : 0.0
}


void function BuildDataModels( rtk_behavior self )
{
	BuildMilestonePanelDataModel( self )
	BuildProgressTrackerDataModel( self )
}

void function BuildProgressTrackerDataModel( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	rtk_struct trackingPanel = RTKStruct_GetOrCreateScriptStruct( p.milestoneEventModel, "trackingPage", "RTKMilestoneEventPanelModel" )
	p.trackingPanelModel = trackingPanel

	BuildMilestoneTrackingPanelInfo( self )
	BuildMilestoneRewardsItemsInfo( self )
	UpdateMilestoneDrawerInfo( self, false, -1, 0 )
	BuildPackPricingDataModel( self )
}

void function BuildPackPricingDataModel( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
		return

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)
	array<GRXScriptOffer> singlePurchaseOffers = MilestoneEvent_GetSinglePackOffers( event )
	array<GRXScriptOffer> multiplePurchaseOffers = MilestoneEvent_GetMultiPackOffers( event )

	array<RTKMilestonePackPricingModel> pricingDataModel
	RTKMilestonePackPricingModel singlePurchaseDataModel = GetMilestonePricingDataModelFromOffers( singlePurchaseOffers, SINGLE_BUTTON_PACK_QUANTITY )
	RTKMilestonePackPricingModel multiplePurchaseDataModel = GetMilestonePricingDataModelFromOffers( multiplePurchaseOffers, MULTIPLE_BUTTON_PACK_QUANTITY )

	pricingDataModel.append( singlePurchaseDataModel )
	pricingDataModel.append( multiplePurchaseDataModel )

	rtk_array pricingDataData = RTKStruct_GetOrCreateScriptArrayOfStructs( p.trackingPanelModel, "packPricingData", "RTKMilestonePackPricingModel" )
	RTKArray_SetValue( pricingDataData, pricingDataModel )
}

void function BuildMilestonePanelDataModel( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	rtk_struct milestoneEvent = RTKDataModelType_CreateStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME + string(self.GetInternalId()), "RTKMilestoneEventCollectionPanelModel" )
	p.milestoneEventModel = milestoneEvent

	BuildMilestoneGeneralPanelInfo( self )

	BuildMilestoneTitleDataModel( self )
	BuildMilestoneCollectedCategoryInfo( self )
	BuildMilestoneCollectedItemsInfo( self )
	BuildPackProbabilitiesDataModel( self )
	BuildMilestoneItemViewerModel( self, null )
}

void function BuildMilestoneRewardsItemsInfo( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	array<RTKMilestoneCollectedItemInfo> rewardsItemsModel = []

	if ( p.activeEvent == null )
		return

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)

	array<MilestoneEventGrantReward> milestones = MilestoneEvent_GetMilestoneGrantRewards( event, GRX_IsOfferRestricted() )
	p.milestones = milestones

	string eventName = Localize( ItemFlavor_GetLongName( event ) )
	table< int, array< RTKMilestoneCollectedItemInfo > > itemsTiers
	foreach ( milestone in milestones )
	{
		
		int milestoneLevel = milestone.grantingLevel
		if ( !( milestoneLevel in itemsTiers ) )
			itemsTiers[milestoneLevel] <- []

		
		RTKMilestoneCollectedItemInfo infoData
		ItemFlavor item = milestone.rewardFlav
		infoData.quality = GRX_GetRarityOverrideFromQuantity( item, ItemFlavor_GetQuality( item ), milestone.quantity )
		infoData.icon = milestone.customImage == "" ? CustomizeMenu_GetRewardButtonImage( item ) : milestone.customImage
		infoData.isStackable = milestone.isStackable
		infoData.isOwned = milestone.isStackable ? false : GRX_IsItemOwnedByPlayer( item )
		infoData.state = infoData.isOwned ? eShopItemState.OWNED : eShopItemState.AVAILABLE
		infoData.isPurchasable = false
		infoData.price = -1
		infoData.quantity = milestone.quantity
		infoData.tooltipInfo.titleText = milestone.customName == "" ? ItemFlavor_GetLongName( item ) : milestone.customName

		
		if ( ItemFlavor_GetType( item ) == eItemType.account_pack && ItemFlavor_GetAccountPackType( item ) == eAccountPackType.RETRO_PACK )
		{
			array<ItemFlavor> packContent = GRXPack_GetPackContents( item )
			foreach ( itemFlav in packContent )
			{
				if ( ItemFlavor_GetType( itemFlav ) == eItemType.weapon_skin && WeaponSkin_DoesReactToKills( itemFlav ) )
				{
					infoData.hasShimmer = true
					break
				}
			}
		}

		if ( milestoneLevel == 1 ) 
		{
			infoData.tooltipInfo.descText = GRX_IsOfferRestricted() ? Localize( "#MILESTONE_ITEM_TOOLTIP_DESC_RESTRICTED_SINGULAR", milestoneLevel, eventName ) : Localize( "#MILESTONE_ITEM_TOOLTIP_DESC_SINGULAR", milestoneLevel, eventName )
		}
		else
		{
			infoData.tooltipInfo.descText = GRX_IsOfferRestricted() ? Localize( "#MILESTONE_ITEM_TOOLTIP_DESC_RESTRICTED", milestoneLevel, eventName ) : Localize( "#MILESTONE_ITEM_TOOLTIP_DESC", milestoneLevel, eventName )
		}

		infoData.itemGuid = item.guid
		itemsTiers[milestoneLevel].append( infoData )
	}

	int totalCollectedItems = MilestoneEvent_GetProgressBasedOnRewardSetTracker( GetLocalClientPlayer(), event, GRX_IsOfferRestricted() )

	
	p.milestoneTierInfo.clear()

	int index = 0
	int currentTierStartLevel = 0
	foreach ( grantLevel, rewardsArray in itemsTiers )
	{
		
		RTKMilestoneProgressTrackerTierInfo tier
		tier.grantLevel = grantLevel
		tier.tierStartLevel = currentTierStartLevel
		foreach ( RTKMilestoneCollectedItemInfo reward in rewardsArray )
		{
			reward.isOwned = reward.isOwned || ( reward.isStackable && totalCollectedItems >= grantLevel )
			if ( reward.isStackable )
				reward.state = reward.isOwned ? eShopItemState.OWNED : eShopItemState.AVAILABLE
		}
		tier.items = rewardsArray
		tier.currentLevel = minint( grantLevel, totalCollectedItems )
		tier.prefabIndex = rewardsArray.len() == 1 ? eMilestoneItemType.ITEM : eMilestoneItemType.STACK
		tier.amountOfRewards = rewardsArray.len()

		p.milestoneTierInfo.append( tier )

		
		if ( index != itemsTiers.len() - 1 )
		{
			RTKMilestoneProgressTrackerTierInfo dividerTier
			dividerTier.grantLevel = grantLevel
			dividerTier.currentLevel = minint( grantLevel, totalCollectedItems )
			dividerTier.prefabIndex = eMilestoneItemType.DIVIDER
			p.milestoneTierInfo.append( dividerTier )
		}

		currentTierStartLevel = grantLevel
		index++
	}

	rtk_array rewardTiers = RTKStruct_GetOrCreateScriptArrayOfStructs( p.trackingPanelModel, "rewardTiersModel", "RTKMilestoneProgressTrackerTierInfo" )
	RTKArray_SetValue( rewardTiers, p.milestoneTierInfo )
}

void function UpdateMilestoneDrawerInfo( rtk_behavior self, bool visible = false, int tierIndex = -1, float posX = 0 )
{
	PrivateData p
	self.Private( p )

	p.milestoneDrawerInfo.visible = visible
	p.milestoneDrawerInfo.posX = posX

	if ( tierIndex != -1 )
		p.milestoneDrawerInfo.milestoneInfo = p.milestoneTierInfo[tierIndex]

	rtk_struct drawerInfo = RTKStruct_GetOrCreateScriptStruct( p.trackingPanelModel, "rewardTierDrawerModel", "RTKMilestoneDrawerModel" )
	RTKStruct_SetValue( drawerInfo, p.milestoneDrawerInfo )
}

void function BuildMilestoneGeneralPanelInfo( rtk_behavior self )
{
	bool isRestricted = GRX_IsOfferRestricted()
	PrivateData p
	self.Private( p )

	if ( p.activeEvent != null )
	{
		RTKMilestoneEventCollectionPanelModel generalModel
		ItemFlavor ornull event = p.activeEvent
		expect ItemFlavor(event)

		generalModel.color = MilestoneEvent_GetTitleCol( event )
		generalModel.titleBgColor = MilestoneEvent_GetTitleBGColor( event )
		generalModel.fullscreenBgDarkeningOpacity = MilestoneEvent_GetFullscreenBGDarkening( event )
		p.items = MilestoneEvent_GetEventItems( event, isRestricted )
		p.items.reverse() 
		p.chaseItems = MilestoneEvent_GetMythicEventItems( event, isRestricted )
		generalModel.totalItems = MilestoneEvent_GetTotalItemsInPoolIncludingTrackerTiers( event, isRestricted )
		generalModel.collectedItems = MilestoneEvent_GetProgressBasedOnRewardSetTracker( GetLocalClientPlayer(), event, isRestricted )
		generalModel.collectionBoxBGImage = MilestoneEvent_GetCollectionBoxBGImage( event )
		generalModel.collectionBoxBlur = MilestoneEvent_GetCollectionBoxBlur( event )
		generalModel.collectionBoxBlurImage = MilestoneEvent_GetCollectionBoxBlurImage( event )
		generalModel.infoBoxBGImage = MilestoneEvent_GetInfoBoxBGImage( event )
		generalModel.infoBoxBlur = MilestoneEvent_GetInfoBoxBlur( event )
		generalModel.infoBoxBlurImage = MilestoneEvent_GetInfoBoxBlurImage( event )
		generalModel.guaranteedInfo = MilestoneEvent_GetGuaranteedPackText( event )
		generalModel.eventKeyArt = MilestoneEvent_GetEventKeyArt( event )
		generalModel.isRestricted = isRestricted

		RTKStruct_SetValue( p.milestoneEventModel, generalModel )
	}
}

void function BuildMilestoneCollectedCategoryInfo( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	array<RTKMilestoneCollectedCategoryInfo> collectedInfoModel = []

	if ( p.activeEvent == null )
		return

	if ( !GRX_IsInventoryReady() )
		return

	bool isRestricted = GRX_IsOfferRestricted()

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)

	array<CollectionEventRewardGroup> rewardGroups = MilestoneEvent_GetRewardGroups( event, isRestricted )
	foreach ( rewardGroup in rewardGroups )
	{
		
		int nonItemPoolItemCount = 0
		int ownedItemsNotInPool = 0
		foreach ( rewardItem in rewardGroup.rewards )
		{
			if ( !MilestoneEvent_IsItemInPool( event, rewardItem.grxIndex, isRestricted ) )
			{
				nonItemPoolItemCount++

				if ( GRX_IsItemOwnedByPlayer( rewardItem ) )
					ownedItemsNotInPool++
			}
		}

		RTKMilestoneCollectedCategoryInfo tierData
		tierData.quantity = GetNumberOfOwnedRewardsPerCategory( self, rewardGroup ) - ownedItemsNotInPool

		if ( MilestoneEvent_HasRewardSetTracker( event, rewardGroup.quality, isRestricted  ) )
		{
			tierData.maxQuantity = MilestoneEvent_GetRewardTrackerQuantityForTier( event, rewardGroup.quality, isRestricted )
		}
		else
		{
			tierData.maxQuantity = rewardGroup.rewards.len()
		}
		tierData.maxQuantity -= nonItemPoolItemCount
		tierData.quality = rewardGroup.quality
		collectedInfoModel.append( tierData )
	}

	
	collectedInfoModel.reverse()

	rtk_array collectedInfo = RTKStruct_GetOrCreateScriptArrayOfStructs( p.milestoneEventModel, "collectedInfo", "RTKMilestoneCollectedCategoryInfo" )
	RTKArray_SetValue( collectedInfo, collectedInfoModel )
}

void function BuildMilestoneCollectedItemsInfo( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	array<RTKMilestoneCollectedItemInfo> collectedItemsModel = []

	if ( p.activeEvent == null )
		return

	ItemFlavor ornull event = p.activeEvent
	expect ItemFlavor(event)
	foreach ( item in p.items )
	{
		bool isChaseItem = MilestoneEvent_IsChaseItem( event, item.grxIndex, GRX_IsOfferRestricted() )
		asset customImage = MilestoneEvent_GetCustomIconForItemIdx( event, item.grxIndex, GRX_IsOfferRestricted() )
		vector gridSizeOverride = MilestoneEvent_GetGridSizeOverride( event, item.grxIndex, GRX_IsOfferRestricted() )
		array<GRXScriptOffer> offers = GRX_GetItemDedicatedStoreOffers( item, MilestoneEvent_GetFrontPageGRXOfferLocation( event, GRX_IsOfferRestricted() ) )

		RTKMilestoneCollectedItemInfo infoData
		infoData.quality = ItemFlavor_GetQuality( item )
		infoData.icon = customImage != "" ? customImage : CustomizeMenu_GetRewardButtonImage( item )
		infoData.isOwned = ItemFlavorIsStackable( item ) ? false : GRX_IsItemOwnedByPlayer( item )
		infoData.state = infoData.isOwned ? eShopItemState.OWNED : eShopItemState.AVAILABLE
		infoData.isPurchasable = offers.len() > 0
		infoData.isChaseItem = isChaseItem
		infoData.gridColSpan = int(gridSizeOverride.x) != 0 ? int(gridSizeOverride.x) : ( isChaseItem ? 2 : 1 )
		infoData.gridRowSpan = int(gridSizeOverride.y) != 0 ? int(gridSizeOverride.y) : 1
		infoData.price = infoData.isPurchasable ? GRXOffer_GetPremiumPriceQuantity( offers[0] ) : -1
		infoData.tooltipInfo.titleText = ItemFlavor_GetLongName( item )
		if ( IsItemWishlistTracker( self, item ) )
			infoData.tooltipInfo.descText = "#WISHLIST_MILESTONE_EVENT_TRACKER_TOOLTIP_DESC"

		collectedItemsModel.append( infoData )
	}

	rtk_array collectedInfo = RTKStruct_GetOrCreateScriptArrayOfStructs( p.milestoneEventModel, "collectedItemsModel", "RTKMilestoneCollectedItemInfo" )
	RTKArray_SetValue( collectedInfo, collectedItemsModel )
}

void function BuildMilestoneTrackingPanelInfo( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent != null )
	{
		RTKMilestoneEventPanelModel generalModel
		ItemFlavor ornull event = p.activeEvent
		expect ItemFlavor(event)
		int remainingItemsForMile =  MilestoneEvent_GetRemainingCompletionItemsForCurrentMilestone( event )

		generalModel.titleColor = MilestoneEvent_GetTitleCol( event )
		generalModel.titleBgColor = MilestoneEvent_GetTitleBGColor( event )
		generalModel.subtitleColor = MilestoneEvent_GetMilestoneBoxTitleColor( event )
		generalModel.disclaimerBoxColor = MilestoneEvent_GetDisclaimerBoxColor( event )
		generalModel.endtime =  CalEvent_GetFinishUnixTime( event )
		generalModel.totalItems = MilestoneEvent_GetTotalItemsInPoolIncludingTrackerTiers( event, GRX_IsOfferRestricted() )
		generalModel.currentCollectedItems = MilestoneEvent_GetProgressBasedOnRewardSetTracker( GetLocalClientPlayer(), event, GRX_IsOfferRestricted() )
		if ( remainingItemsForMile == 0  )
			generalModel.nextMilestoneText = Localize( "#MILESTONE_EVENT_TRACKING_BOX_COMPLETED_MILES" )
		else
			generalModel.nextMilestoneText = Localize( GRX_IsOfferRestricted() ? "#MILESTONE_EVENT_TRACKING_BOX_NEXT_MILE_RESTRICT" : "#MILESTONE_EVENT_TRACKING_BOX_NEXT_MILE", remainingItemsForMile )

		
		if ( generalModel.totalItems > 0 )
		{
			float percent = float( generalModel.currentCollectedItems ) / float( generalModel.totalItems )
			generalModel.completionPercentage = Localize( "#MILESTONE_TRACKER_PERCENT_COMPLETE", FormatNumber( "1", percent * 100 ) )
		}
		else
		{
			generalModel.completionPercentage = ""
		}

		p.isWishlistEnabled = MilestoneEvent_IsWishlistEnabled( event )
		generalModel.isWishlistEnabled = p.isWishlistEnabled
		generalModel.isRestricted = GRX_IsOfferRestricted()
		generalModel.trackerBoxBGImage = MilestoneEvent_GetTrackerBoxBGImage( event )
		generalModel.trackerBoxBlurBg = MilestoneEvent_GetTrackerBoxBlur( event )
		generalModel.trackerBoxBlurImage = MilestoneEvent_GetTrackerBoxBlurImage( event )
		generalModel.trackerProgressBarColor = MilestoneEvent_GetMilestoneTrackerProgressBarColor( event )
		generalModel.trackerProgressBarBGColor = MilestoneEvent_GetMilestoneTrackerProgressBarBGColor( event )
		generalModel.eventShopHasMilestonePack = IsMilestoneEventStoreOnly( event ) ? false : EventShop_HasMilestoneEventPack()
		generalModel.hasGuaranteedPack = MilestoneEvent_GetGuaranteedMultiPackOffers( event ).len() > 0
		generalModel.guaranteedInfo = MilestoneEvent_GetGuaranteedPackText( event )
		
		RTKStruct_SetValue( p.trackingPanelModel, generalModel )
	}
}

void function BuildPackProbabilitiesDataModel( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent == null )
