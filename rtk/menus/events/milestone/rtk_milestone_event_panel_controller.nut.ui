global function RTKMilestoneEventPanelController_InitMetaData
global function RTKMilestoneEventPanelController_OnInitialize
global function RTKMilestoneEventPanelController_OnDestroy
global function RTKMilestoneEventPanelController_OnDisable
global function RTKMilestoneEventPanelController_OnUpdate
global function RTKMilestoneEventPanelController_SetMilestoneEvent

const int SINGLE_BUTTON_PACK_QUANTITY = 1
const int MULTIPLE_BUTTON_PACK_QUANTITY = 4
const float ITEM_RESELECT_DELAY_TIME = 0.6

const float PANEL_FIRST_DELAY = 0.05
const float PANEL_FADE_IN_DURATION = 0.2
const float PANEL_FADE_IN_ALPHA_FROM = 0.0
const float PANEL_FADE_OUT_DURATION = 0.1
const float PANEL_FADE_OUT_ALPHA_FROM = 0.7
const float PANEL_FADE_OUT_DELAY = 0.15

const float PRESTIGE_SKIN_CAROUSEL_DELAY = 3

const string MODEL_PATH_NAME = "milestoneEvent"

enum eMilestoneItemType
{
	ITEM    = 0
	STACK   = 1
	DIVIDER = 2
}

