void function BuildMilestoneItemViewerModel( rtk_behavior self, ItemFlavor ornull itemToDisplay )
{
	PrivateData p
	self.Private( p )

	if ( p.activeEvent != null )
	{
		if ( !GRX_IsInventoryReady() )
			return

		
		rtk_struct itemViewerModel = RTKStruct_GetOrCreateScriptStruct( p.milestoneEventModel, "carouselInfo", "RTKMilestoneCarouselPanelInfo" )
		p.itemViewerModel = itemViewerModel

		
		ItemFlavor ornull event = p.activeEvent
		expect ItemFlavor( event )

		if ( itemToDisplay == null )
			return

		ItemFlavor ornull item = itemToDisplay
		expect ItemFlavor( item )

		RTKMilestoneCarouselPanelInfo itemInfo

		itemInfo.eventOverviewPanelAlpha = p.eventPanelAlpha
		itemInfo.itemViewerPanelAlpha = p.itemPanelAlpha

		if ( IsItemFlavorRewardItem( self, item ) )
		{
			itemInfo.isOwned = true
		}
		else
		{
			if ( ItemFlavorIsStackable( item ) )
				itemInfo.isOwned = false
			else
				itemInfo.isOwned = GRX_IsItemOwnedByPlayer( item )
		}

		itemInfo.quality = ItemFlavor_GetQuality( item )
		itemInfo.name = ItemFlavor_GetLongName( item )
		itemInfo.itemTypeDescription = MilestoneEvent_GetCarouselItemDescriptionText(item )
		itemInfo.packIcon = MilestoneEvent_GetMainPackImage( event )
		itemInfo.packName = Localize( MilestoneEvent_GetMainPackShortPluralName( event ) )
		ItemFlavor currencyFlav = GRX_CURRENCIES[GRX_CURRENCY_PREMIUM]
		itemInfo.coinIcon = ItemFlavor_GetIcon( currencyFlav )
		itemInfo.isRestricted = GRX_IsOfferRestricted()
		array<GRXScriptOffer> offers = GRX_GetItemDedicatedStoreOffers( item, MilestoneEvent_GetFrontPageGRXOfferLocation( event, GRX_IsOfferRestricted() ) )
		if ( !GRX_IsOfferRestricted() )
		{
			ItemFlavor ornull activeThemedShopEvent = GetActiveThemedShopEvent( GetUnixTimestamp() )
			if ( activeThemedShopEvent != null )
			{
				expect ItemFlavor( activeThemedShopEvent )
				offers.extend( GRX_GetItemDedicatedStoreOffers( item, ThemedShopEvent_GetGRXOfferLocation( activeThemedShopEvent ) ) )
			}
		}
		itemInfo.price = offers.len() > 0 ? GRXOffer_GetPremiumPriceQuantity( offers[0] ) : -1

		RTKStruct_SetValue( itemViewerModel, itemInfo )
		if ( IsValidItemFlavorGUID( ItemFlavor_GetGUID( item ) ) )
		{
			bool isCompactUI = false
#if SUPPORTS_COMPACT_UI
				isCompactUI = IsUsingCompactUILayout()
#endif
			RunClientScript( "UIToClient_ItemPresentation", ItemFlavor_GetGUID( item ) , -1, 1.19, Battlepass_ShouldShowLow( item ), null, true, "collection_event_ref", isCompactUI, true, false, false )
		}
	}
}

void function RTKMilestoneEventPanelController_CarouselPrestigeSkin_Thread( rtk_behavior self, ItemFlavor item )
{
	Signal( uiGlobal.signalDummy, "EndPrestigeSkinCarousel" )
	EndSignal( uiGlobal.signalDummy, "EndPrestigeSkinCarousel" )

	if ( !Mythics_IsItemFlavorMythicSkin( item ) )
		return

	int displayTier = 0
	while( true )
	{
		if ( displayTier > 2 ) 
			displayTier = 0

		ItemFlavor ornull displayItem = Mythics_GetItemTierForSkin( item, displayTier )
		displayTier++
		BuildMilestoneItemViewerModel( self, displayItem )

		wait PRESTIGE_SKIN_CAROUSEL_DELAY
	}
}

void function RTKMilestoneEventPanelController_SetMilestoneEvent( rtk_behavior self, ItemFlavor event )
{
	PrivateData p
	self.Private( p )

	p.activeEvent = event

	
	SetCollectionEventAboutPageEvent( p.activeEvent )

	int eventGUID = ItemFlavor_GetGUID( event )
	if ( !(eventGUID in file.eventGUIDTolastGridPage) )
	{
		file.eventGUIDTolastGridPage[ eventGUID ] <- 0
	}

	
	BuildDataModels( self )
	SetupButtons( self )
	ResetPanelAnimations( self )
	SetInitialGridPaginationPage( self )
}


void function SetupCallbacks( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	p.OnGRXStateChanged = ( void function() : ( self ) {
		OnGRXStateChanged( self )
	} )

	AddCallback_OnGRXOffersRefreshed( p.OnGRXStateChanged )
	AddCallback_OnGRXInventoryStateChanged( p.OnGRXStateChanged )
}

void function OnGRXStateChanged( rtk_behavior self )
{
	bool ready = GRX_IsInventoryReady() && GRX_AreOffersReady() && IsPersistenceAvailable()

	if ( !ready )
		return

	BuildMilestoneTrackingPanelInfo( self )
	BuildMilestoneCollectedCategoryInfo( self )
	BuildMilestoneCollectedItemsInfo( self )
	BuildPackPricingDataModel( self )
	BuildPurchaseButtonDataModel( self )
	SetUpPurchaseButtons( self )
}


int function GetNumberOfOwnedRewardsPerCategory( rtk_behavior self, CollectionEventRewardGroup rewardGroup )
{
	int counter = 0
	foreach	( flav in rewardGroup.rewards )
	{
		if ( !ItemFlavorIsStackable( flav ) )
		{
			if ( GRX_IsItemOwnedByPlayer( flav ) )
				counter++
		}
		else if ( IsItemWishlistTracker( self, flav ) )
		{
			return GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( flav ) )
		}

	}
	return counter
}

RTKMilestonePackPricingModel function GetMilestonePricingDataModelFromOffers( array<GRXScriptOffer> offers, int defaultQuantity )
{
	RTKMilestonePackPricingModel offerModel
	if ( offers.len() > 0 )
	{
		GRXScriptOffer offer = offers[0]
		if ( offer.prices.len() == 2 )
		{
			string firstPrice = "%$" + ItemFlavor_GetIcon( GRX_CURRENCIES[GRX_CURRENCY_PREMIUM] ) + "% " + FormatAndLocalizeNumber( "1", float( GRXOffer_GetPremiumPriceQuantity( offer ) ), true )
			string secondPrice = "%$" + ItemFlavor_GetIcon( GRX_CURRENCIES[GRX_CURRENCY_CRAFTING] ) + "% " + FormatAndLocalizeNumber( "1", float( GRXOffer_GetCraftingPriceQuantity( offer ) ), true )
			offerModel.price = Localize( "#STORE_PRICE_N_N", firstPrice, secondPrice )
		}
		else
		{
			offerModel.price = GRX_GetFormattedPrice( offer.prices[0], 1 )
		}
		offerModel.isPaidPack = GRXOffer_GetPremiumPriceQuantity( offer ) > 1 
		offerModel.doesOfferExist = true
		int originalPrice = GRXOffer_GetOriginalPremiumPriceQuantity( offer )
		int price = GRXOffer_GetPremiumPriceQuantity( offer )
		if ( originalPrice > 0 )
		{
			offerModel.discount = int( (float((originalPrice - price )) / float(originalPrice)) * 100 )
			offerModel.originalPrice = "%$" + ItemFlavor_GetIcon( GRX_CURRENCIES[GRX_CURRENCY_PREMIUM] ) + "% " + FormatAndLocalizeNumber( "1", float(originalPrice), true )
		}
	}
	else
	{
		offerModel.price = ""
		offerModel.discount = 0
		offerModel.originalPrice = ""
		offerModel.doesOfferExist = false
	}
	offerModel.quantity = defaultQuantity
	return offerModel
}

bool function IsItemFlavorRewardItem( rtk_behavior self, ItemFlavor item )
{
	PrivateData p
	self.Private( p )

	foreach ( milestone in p.milestones )
	{
		if ( milestone.rewardFlav.guid == item.guid )
			return true
	}
	return false
}

void function ResetPanelAnimations( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( p.itemViewerModel == null )
		return

	rtk_struct itemViewerModel = expect rtk_struct(p.itemViewerModel)

	p.hasEnteredItem = false
	p.itemPanelAnimationTime = 0.0
	p.eventPanelAnimationTime = 0.0
	p.panelAnimationDelay = PANEL_FIRST_DELAY
	p.itemPanelAlpha = 0.0
	p.eventPanelAlpha = 0.0
	RTKStruct_SetFloat( itemViewerModel, "itemViewerPanelAlpha", p.itemPanelAlpha )
	RTKStruct_SetFloat( itemViewerModel, "eventOverviewPanelAlpha", p.eventPanelAlpha )
}

void function SetInitialGridPaginationPage( rtk_behavior self )
{
	rtk_behavior ornull gridPagination = self.PropGetBehavior( "gridPagination" )
	if ( gridPagination != null )
	{
		expect rtk_behavior( gridPagination )
		PrivateData p
		self.Private( p )
		if ( p.activeEvent == null )
			return
		ItemFlavor event = expect ItemFlavor( p.activeEvent )

		gridPagination.PropSetInt( "startPageIndex", file.eventGUIDTolastGridPage[ ItemFlavor_GetGUID( event ) ] )
	}
}

void function OpenMythicSkinFakeOfferPreview( ItemFlavor event, ItemFlavor skin )
{
	array<ItemFlavor> contents = Mythics_GetAllSkinsFromBase( skin )
	GRXScriptOffer fakeOffer
	fakeOffer.titleText = ItemFlavor_GetLongName( skin )
	fakeOffer.descText = ""
	fakeOffer.prereq = event

	ItemFlavorBag priceBag
	priceBag.flavors.append( GRX_CURRENCIES[GRX_CURRENCY_HEIRLOOM] )
	priceBag.quantities.append( 999999999 )
	fakeOffer.prices.append( priceBag )

	foreach ( item in contents )
	{
		AddItemToFakeOffer( fakeOffer, item )
	}

	StoreMythicInspectMenu_AttemptOpenWithOffer( fakeOffer )
}

bool function IsItemWishlistTracker( rtk_behavior self, ItemFlavor item )
{
	PrivateData p
	self.Private( p )

	ItemFlavor ornull event = p.activeEvent
	if ( event == null )
		return false
	expect ItemFlavor( event )

	if ( p.isWishlistEnabled )
	{
		if ( MilestoneEvent_HasRewardSetTracker( event, ItemFlavor_GetQuality( item ), GRX_IsOfferRestricted() ) )
		{
			return true
		}
	}

	return false
}
