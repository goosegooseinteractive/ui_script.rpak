		training_2 								= ["3", "5", "", "", "0", "#GAME_MODE_SELECTOR_TRAINING_TITLE", "0", "0"],  
		training_3 								= ["3", "6", "", "", "0", "#GAME_MODE_SELECTOR_TRAINING_TITLE", "0", "0"],  
		training_4 								= ["3", "7", "", "", "0", "#GAME_MODE_SELECTOR_TRAINING_TITLE", "0", "0"],  
		training_5 								= ["3", "8", "", "", "0", "#GAME_MODE_SELECTOR_TRAINING_TITLE", "0", "0"],  
	}
	return scheduleNameToTileDefaults
}

array< string > function GameModeSelect_ScheduleNameToTileDefaults( string scheduleName )
{
	table< string, array< string > > scheduleNameToTileDefaultsMap = GameModeSelect_ScheduleNameToTileDefaultsMap()
	if ( scheduleName in scheduleNameToTileDefaultsMap )
	{
		return scheduleNameToTileDefaultsMap[ scheduleName ]
	}
	return []
}

void function GameModeSelect_ApplyTileDefaults( RTKGameModeSelectPlaylistButton_Struct playlistButton, array< string > scheduleNameToTileDefaults )
{
	rtk_struct modelRootStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_NAME, "RTKGameModeSelectControllerPanel_ModelStruct" )
	bool hasLocalPlayerCompletedTraining = RTKStruct_GetBool( modelRootStruct, "hasCompletedTraining" )
	bool hasLocalPlayerCompletedNewPlayerOrientation = RTKStruct_GetBool( modelRootStruct, "hasCompletedPlayerOrientation" )

	if ( playlistButton.ui_mode_select_tab_index == "" )
		playlistButton.ui_mode_select_tab_index 			= scheduleNameToTileDefaults.len() >= 1 ? scheduleNameToTileDefaults[0] : ""

	if ( playlistButton.ui_mode_select_tab_slot_index == "" )
		playlistButton.ui_mode_select_tab_slot_index 		= scheduleNameToTileDefaults.len() >= 2 ? scheduleNameToTileDefaults[1] : ""

	if ( playlistButton.ui_mode_select_grid_height_min == "" )
		playlistButton.ui_mode_select_grid_height_min 		= scheduleNameToTileDefaults.len() >= 3 ? scheduleNameToTileDefaults[2] : ""

	if ( playlistButton.ui_mode_select_featured == "" )
		playlistButton.ui_mode_select_featured 				= scheduleNameToTileDefaults.len() >= 4 ? scheduleNameToTileDefaults[3] : ""

	if ( playlistButton.ui_mode_select_show_upcoming == "" )
		playlistButton.ui_mode_select_show_upcoming 		= scheduleNameToTileDefaults.len() >= 5 ? scheduleNameToTileDefaults[4] : ""

	if ( playlistButton.ui_mode_select_tab_index_name == "" )
		playlistButton.ui_mode_select_tab_index_name 		= scheduleNameToTileDefaults.len() >= 6 ? scheduleNameToTileDefaults[5] : ""

	if ( playlistButton.ui_mode_select_req_training == "" )
		playlistButton.ui_mode_select_req_training 			= scheduleNameToTileDefaults.len() >= 7 ? scheduleNameToTileDefaults[6] : ""

	if ( playlistButton.ui_mode_select_req_orientation == "" )
		playlistButton.ui_mode_select_req_orientation 		= scheduleNameToTileDefaults.len() >= 8 ? scheduleNameToTileDefaults[7] : ""

#if DEV
		if ( DEBUG_PRINTS )
			printt("GMS: ", playlistButton.scheduleName, " into ", playlistButton.ui_mode_select_tab_index, playlistButton.ui_mode_select_tab_slot_index)
#endif
	
	if ( !hasLocalPlayerCompletedTraining && playlistButton.ui_mode_select_req_training == "1" )
	{
		playlistButton.locked = true
		playlistButton.showSelectMode = false
		
	}
	else if ( !hasLocalPlayerCompletedNewPlayerOrientation && playlistButton.ui_mode_select_req_orientation == "1" )
	{
		playlistButton.locked = true
		playlistButton.showSelectMode = false
		
	}

	if ( playlistButton.ui_mode_select_tab_index != "" && int ( playlistButton.ui_mode_select_tab_index ) >= 0 )
		playlistButton.frameColor = GameMode_GetPillarColor( int ( playlistButton.ui_mode_select_tab_index ) )

	if ( playlistButton.ui_mode_select_tab_index != "" && int ( playlistButton.ui_mode_select_tab_index ) >= 0 )
		playlistButton.frameColorLightness = GameMode_GetPillarColorLightness( int ( playlistButton.ui_mode_select_tab_index ) )

	
	if ( GameModeVariant_IsActiveForPlaylist( playlistButton.name, eGameModeVariants.SURVIVAL_RANKED ) && Ranked_HasSoloQueueRankScoreThreshold( playlistButton.name ) )
		playlistButton.squadSizeDefaultLightness = -0.75
}

vector function GameModeSelect_ScheduleNameToDefaultPillarColor( string scheduleName )
{
	array< string > tileDefaults = GameModeSelect_ScheduleNameToTileDefaults( scheduleName )
	RTKGameModeSelectPlaylistButton_Struct playlistButton
	GameModeSelect_ApplyTileDefaults( playlistButton, tileDefaults )
	return playlistButton.frameColor
}

float function GameModeSelect_ScheduleNameToDefaultPillarColorLightness( string scheduleName )
{
	array< string > tileDefaults = GameModeSelect_ScheduleNameToTileDefaults( scheduleName )
	RTKGameModeSelectPlaylistButton_Struct playlistButton
	GameModeSelect_ApplyTileDefaults( playlistButton, tileDefaults )
	return playlistButton.frameColorLightness
}

array< RTKGameModeSelectPlaylistButton_Struct > function ApplyDefaultsToButtonScriptArray( array< RTKGameModeSelectPlaylistButton_Struct > playlistButtonsScriptArray )
{
	table< string, array< string > > scheduleNameToTileDefaultsMap = GameModeSelect_ScheduleNameToTileDefaultsMap()
	for ( int i = 0; i < playlistButtonsScriptArray.len(); i++ )
	{
		RTKGameModeSelectPlaylistButton_Struct playlistButton = playlistButtonsScriptArray[i]
		array< string > tileDefaults = GameModeSelect_ScheduleNameToTileDefaults( playlistButton.scheduleName )
		GameModeSelect_ApplyTileDefaults( playlistButton, tileDefaults )
	}
	return playlistButtonsScriptArray
}


RTKGameModeSelectPlaylistButton_Struct function RTKGameModeSelect_GetCachedPlaylistStruct( rtk_behavior self, RTKGameModeSelectPlaylistButton_Struct playlistIn )
{
	string playlistName = playlistIn.name
	string scheduleName = playlistIn.scheduleName
	return GetMergedPlaylistStruct( playlistIn, fileVMPersistence.playlistButtonsScriptArray )
}











RTKGameModeSelectPlaylistButton_Struct function GetMergedPlaylistStruct( RTKGameModeSelectPlaylistButton_Struct playlistIn, array< RTKGameModeSelectPlaylistButton_Struct > playlistButtonsScriptArray )
{
	string playlistName = playlistIn.name
	string scheduleName = playlistIn.scheduleName

	if ( playlistIn.ui_mode_select_combine_key in fileVMPersistence.mergedPlaylistSelection )
	{
		playlistName = fileVMPersistence.mergedPlaylistSelection[ playlistIn.ui_mode_select_combine_key ]
	}

	for ( int i = 0; i < playlistButtonsScriptArray.len(); i++ )
	{
		RTKGameModeSelectPlaylistButton_Struct playlist = playlistButtonsScriptArray[i]
		if ( playlist.name == playlistName )
		{
			for  ( int j = 0; j < playlist.playlistSquadSizes.len(); j++ )
			{
				if ( playlist.playlistSquadSizes[j].state != eRTKGameModeSelectPlaylistSquadSizeState.UNSELECTED )
					return playlist
			}
		}
	}

	for ( int i = 0; i < playlistButtonsScriptArray.len(); i++ )
	{
		RTKGameModeSelectPlaylistButton_Struct playlist = playlistButtonsScriptArray[i]
		if ( playlist.scheduleName == scheduleName )
		{
			return playlist
		}
	}

	RTKGameModeSelectPlaylistButton_Struct empty
	return empty
}

void function RTKGameModeSelect_TileOnPressed( rtk_behavior self, rtk_behavior button, RTKGameModeSelectPlaylistButton_Struct playlistIn, int keycode )
{
	RTKGameModeSelectPlaylistButton_Struct playlist = RTKGameModeSelect_GetCachedPlaylistStruct( self, playlistIn )
	if ( playlist.name == "" )
		return

	if ( fileVMPersistence.userFocusedPlaylist != playlist.name ) 
		return

	if ( keycode == BUTTON_Y )
	{
		RTKGameModeSelect_ToggleSquadSize( self, button, playlist )
	}
	else if ( keycode == BUTTON_X || keycode == MOUSE_RIGHT )
	{
		if ( playlist.gameModeSelectTileAction == eGameModeSelectTileActions.ROAD_TO_RANKED )
		{
			UI_OpenFeatureTutorialDialog( ROAD_TO_RANKED_TUTORIAL )
		}
		else if ( playlist.gameModeSelectTileAction == eGameModeSelectTileActions.RANKED )
		{
			OpenRankedInfoPage( null )
			int rankedRumbleState = RankedEvent_GetRumbleRankedState()
			if ( rankedRumbleState == eRankedRumbleState.COMING_SOON )
			{
				RankedInfo_SetInitialTab( "OverviewPanel" )
			}
			else if ( rankedRumbleState == eRankedRumbleState.ACTIVE || rankedRumbleState == eRankedRumbleState.FINISH )
			{
				RankedInfo_SetInitialTab( "LeaderboardPanel" )
			}
			else
			{
				RankedInfo_SetInitialTab( "RankedInfoPanel" )
			}
		}
		else
		{
			OpenPlaylistTutorialDialog( playlist.name )
		}
	}
	else if ( keycode == BUTTON_A || keycode == MOUSE_LEFT )
	{
		if ( playlist.gameModeSelectTileAction == eGameModeSelectTileActions.ROAD_TO_RANKED )
		{
			JumpToChallenges( "road_to_ranked" )
		}
		else if ( playlist.locked )
		{
			EmitUISound( "menu_deny" )
		}
		else
		{
			if ( IsPrivateMatchLobby() )
				PrivateMatch_SetSelectedPlaylist( playlist.name )
			else
				LobbyPlaylist_SetSelectedPlaylist( playlist.name )

			DismissGamemodeSelectorAndRefresh()
			CloseAllDialogs()
		}
	}
}

void function RTKGameModeSelect_PreviewAndMaybeCommitPlaylistSelection( rtk_behavior self, rtk_behavior button, RTKGameModeSelectPlaylistSquadSize_Struct playlistSquadSize )
{
	RTKGameModeSelect_PreviewPlaylistSelection( playlistSquadSize )

	if ( RTKGameModeSelect_CanCommitPlaylistSelection( playlistSquadSize ) )
		RTKGameModeSelect_CommitPlaylistSelection( playlistSquadSize.playlistName )

	thread RTKGameModeSelect_RebuildContentThread( self, button )
}

void function RTKGameModeSelect_PreviewPlaylistSelection( RTKGameModeSelectPlaylistSquadSize_Struct playlistSquadSize )
{
	if ( !(playlistSquadSize.key in fileVMPersistence.mergedPlaylistSelection) )
	{
		fileVMPersistence.mergedPlaylistSelection[playlistSquadSize.key] <- playlistSquadSize.playlistName
	}
	else
	{
		fileVMPersistence.mergedPlaylistSelection[playlistSquadSize.key] = playlistSquadSize.playlistName
	}
}

bool function RTKGameModeSelect_CanCommitPlaylistSelection( RTKGameModeSelectPlaylistSquadSize_Struct playlistSquadSize )
{
	if ( playlistSquadSize.playlistName == "" )
		return false

	if ( !IsPartyLeader() )
		return false

	if ( !playlistSquadSize.available )
		return false

	if ( playlistSquadSize.partySize > playlistSquadSize.queueSize )
		return false

	if ( IsPrivateMatchLobby() )
		return true

	return Lobby_IsPlaylistAvailable( playlistSquadSize.playlistName )
}

void function RTKGameModeSelect_CommitPlaylistSelection( string playlistName )
{
	if ( IsPrivateMatchLobby() )
		PrivateMatch_SetSelectedPlaylist( playlistName )
	else
		LobbyPlaylist_SetSelectedPlaylist( playlistName )
}

void function RTKGameModeSelect_ToggleSquadSize( rtk_behavior self, rtk_behavior button, RTKGameModeSelectPlaylistButton_Struct playlist )
{
	int currentIndex = -1
	for ( int j = 0; j < playlist.playlistSquadSizes.len(); j++ )
	{
		if ( playlist.playlistSquadSizes[j].state == eRTKGameModeSelectPlaylistSquadSizeState.SELECTED )
		{
			currentIndex = j
		}
	}

	if ( currentIndex >= 0 )
	{
		currentIndex++
		if ( currentIndex >= playlist.playlistSquadSizes.len() )
			currentIndex = 0

		RTKGameModeSelect_PreviewAndMaybeCommitPlaylistSelection( self, button, playlist.playlistSquadSizes[currentIndex] )
	}
}


void function DelaySetUpcomingContentDataModelVisible()
{
	EndSignal( uiGlobal.signalDummy, "RTKGameModeSelectOnPreDestroy" )
	WaitFrame()
	rtk_struct modelRootStruct = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_NAME, "RTKGameModeSelectControllerPanel_ModelStruct" )
	RTKStruct_SetBool( modelRootStruct, "visible", true )
}

string function GetModeName( string playlistName, int index, string defaultName = "", string currentPlaylistRef = "" )
{
	return GetPlaylistMapVarString( playlistName, index, "name", defaultName )
	
	
	
	
	
}

asset function RTKMutator_GMS_SwapImageByHeight( float height, asset tile1h, asset tile2h, asset tile3h )
{
	if ( height >= 500 )
		return tile3h

	if ( height >= 300 )
		return tile2h

	return tile1h
}

asset function RTKMutator_GMS_SquadSizeIcon( int state, int squadSize, int partySize, int queueSize, int slot )
{
	
	
	
	

	if ( partySize > squadSize )
		return $"ui_image/rui/menu/gametype_select/mode_squad_icon_fade.rpak"

	if ( slot > queueSize )
		return $"ui_image/rui/menu/gametype_select/mode_squad_icon_fade.rpak"

	if ( partySize >= slot )
		return $"ui_image/rui/menu/gametype_select/mode_squad_icon_fill.rpak"

	return $"ui_image/rui/menu/gametype_select/mode_squad_icon_empty.rpak"
}

vector function RTKMutator_GMS_SquadSizeColor( int state, int endTime, int partySize, int queueSize, int slot )
{
	vector colorOut = < 1.0, 1.0, 1.0 >

	if ( state == eRTKGameModeSelectPlaylistSquadSizeState.ONLY_OPTION )
		colorOut = < 1.0, 1.0, 1.0 >

	if ( slot > queueSize )
		colorOut =  < 0.40, 0.40, 0.40 >

	if ( partySize > queueSize )
		colorOut =  < 1.0, 0.0, 0.0 >

	if ( endTime > 0 )
		colorOut =  < 1.0, 0.6667, 0.0 >

	if ( state == eRTKGameModeSelectPlaylistSquadSizeState.UNSELECTED )
	{
		if ( endTime > 0 )
			colorOut *= 0.66
		else
			colorOut *= 0.40
	}

	return colorOut
}