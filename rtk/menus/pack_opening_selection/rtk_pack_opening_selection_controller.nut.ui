array<featureTutorialTab> function RTKViewPacksInventoryButton_PopulateOpenPacksTutorialAboutText()
{
	array<featureTutorialTab> tabs
	featureTutorialTab tab1
	array<featureTutorialData> tab1Rules

	tab1.tabName = 	"#PACKS_INVENTORY_BUTTON_TUTORIAL_NAME"
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#PACKS_INVENTORY_BUTTON_TUTORIAL_TITLE_1", "#PACKS_INVENTORY_BUTTON_TUTORIAL_DESC_1", $"rui/hud/gametype_icons/bonus_meter/bonus_about_01" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#PACKS_INVENTORY_BUTTON_TUTORIAL_TITLE_2", "#PACKS_INVENTORY_BUTTON_TUTORIAL_DESC_2", $"rui/hud/gametype_icons/bonus_meter/bonus_about_02" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#PACKS_INVENTORY_BUTTON_TUTORIAL_TITLE_3", "#PACKS_INVENTORY_BUTTON_TUTORIAL_DESC_3", $"rui/hud/gametype_icons/bonus_meter/bonus_about_03" ) )
	tab1.rules = tab1Rules

	featureTutorialFooterData footerButton1
	footerButton1.title = "#PACKS_INVENTORY_BUTTON_VIEW_PACK_OPENING"
	footerButton1.titleGamepad = "#PACKS_INVENTORY_BUTTON_VIEW_PACK_OPENING"
	footerButton1.callbackFunc = void function ( var button ) {
		while ( GetActiveMenu() != GetMenu( "LobbyMenu" ) )
			CloseActiveMenu()
		OpenPackOpeningSelectionMenu()
		Remote_ServerCallFunction( "ClientCallback_MarkOpenPacksInfoDialogAsSeen" )
	}
	tab1.footerData.append( footerButton1 )
	tabs.append( tab1 )
	return tabs
}

