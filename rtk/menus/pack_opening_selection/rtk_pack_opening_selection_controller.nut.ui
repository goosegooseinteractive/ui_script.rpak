void function RTKPackOpeningSelectionController_SetBonusMeterDisclaimer( rtk_behavior self )
{
	PrivateData p
	self.Private( p )

	if ( BonusMeter_IsActive() )
	{
		rtk_struct panelStruct  = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME, "RTKPackOpeningSelectionModel" )
		if ( ShouldPackProgressBonusMeter( p.selectedPack ) )
		{
			int excessPacks = (p.selectedQuantity + BonusMeter_GetMeterProgress()) - BonusMeter_GetMeterGoal()
			if ( excessPacks > 0 && !BonusMeter_IsCompleted() )
			{
				string locString = excessPacks == 1 ? "#PACKS_INVENTORY_BONUS_METER_EXCESS_N" : "#PACKS_INVENTORY_BONUS_METER_EXCESS_N_PLURAL"
				RTKStruct_SetString( panelStruct, "bonusMeterDisclaimer", Localize( locString, excessPacks ) )
			}
			else
				RTKStruct_SetString( panelStruct, "bonusMeterDisclaimer", "" )
		}
		else
		{
			RTKStruct_SetString( panelStruct, "bonusMeterDisclaimer", "#PACKS_INVENTORY_BONUS_METER_NOT_ELEGIBLE" )
		}
	}
	else
	{
		rtk_struct panelStruct  = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME, "RTKPackOpeningSelectionModel" )
		RTKStruct_SetString( panelStruct, "bonusMeterDisclaimer", "" )
	}
}

void function RTKPackOpeningSelectionController_SetWishlistDisclaimer( rtk_behavior self )
{
	if ( !Wishlist_IsEnabled() )
		return

	PrivateData p
	self.Private( p )

	rtk_struct panelStruct  = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME, "RTKPackOpeningSelectionModel" )

	int wishlistState = Wishlist_GetSelectionUIState( p.selectedQuantity, ItemFlavor_GetQuality( p.selectedPack ), "RTKPackOpeningSelectionController_SetWishlistDisclaimer" )
	if ( p.selectedQuantity > 0 && ItemFlavor_IsWishlistPack( p.selectedPack ) && wishlistState == eWishlistFrontState.MAYBE_INVALID )
	{
		RTKStruct_SetString( panelStruct, "wishlistDisclaimer", "#WISHLIST_INVENTORY_OPENING_MAY_INVALID" )
	}
	else if ( Wishlist_IsPackUpgradable( p.selectedPack ) && wishlistState == eWishlistFrontState.ACTIVE )
	{
		RTKStruct_SetString( panelStruct, "wishlistDisclaimer", "#WISHLIST_INVENTORY_OPENING_NOT_AFFECTED" )
	}
	else
	{
		RTKStruct_SetString( panelStruct, "wishlistDisclaimer", "" )
	}
}

void function RTKPackOpeningSelectionController_SetUpgradeButton( rtk_behavior self )
{
	if ( !Wishlist_IsEnabled() )
		return

	rtk_behavior upgradeButton = self.PropGetBehavior( "upgradeButton" )
	if ( !Wishlist_IsUpgradingEnabled() )
	{
		upgradeButton.GetPanel().SetVisible( false )
		return
	}

	self.AutoSubscribe( upgradeButton, "onPressed", function( rtk_behavior button, int keycode, int prevState ) : ( self ) {
		PrivateData p
		self.Private( p )

		if ( p.upgradeOffer == null )
			return

		GRXScriptOffer offer = expect GRXScriptOffer( p.upgradeOffer )

		PurchaseDialogConfig pdc
		pdc.offer = offer
		pdc.quantity = p.selectedQuantity
		pdc.messageOverride = p.selectedQuantity > 1 ? Localize( "#UPGRADE_TO_WISHLIST_PACK_N", p.selectedQuantity ) : Localize( "#UPGRADE_TO_WISHLIST_PACK" )
		pdc.messageQualityOverride = ItemFlavor_GetQuality( p.selectedPack )
		pdc.buttonTextOverride = "#UPGRADE"
		PurchaseDialog( pdc )
	})

	
	RTKPackOpeningSelectionController_UpdateUpgradeButton( self )
}

void function RTKPackOpeningSelectionController_UpdateUpgradeButton( rtk_behavior self )
{
	if ( !Wishlist_IsEnabled() || !Wishlist_IsUpgradingEnabled() )
		return

	PrivateData p
	self.Private( p )

	rtk_behavior upgradeButton = self.PropGetBehavior( "upgradeButton" )

	if ( Wishlist_IsCompleted() )
	{
		p.upgradeOffer = null
		upgradeButton.GetPanel().SetVisible( false )
		return
	}


	rtk_struct panelStruct  = RTKDataModelType_GetOrCreateStruct( RTK_MODELTYPE_MENUS, MODEL_PATH_NAME, "RTKPackOpeningSelectionModel" )
	rtk_struct upgradeDataStruct = RTKStruct_GetStruct( panelStruct, "packUpgradeData" )

	RTKPackUpgradeData packUpgradeData

	
	bool isSelectedPackUpgradable = GRX_GetPackCount( ItemFlavor_GetGRXIndex( p.selectedPack ) ) > 0 && Wishlist_IsPackUpgradable( p.selectedPack )
	packUpgradeData.isSelectedPackUpgradable = isSelectedPackUpgradable

	
	p.upgradeOffer = Wishlist_GetUpgradePackOffer( p.selectedPack )

	bool canAfford
	if ( p.upgradeOffer != null )
	{
		GRXScriptOffer offer = expect GRXScriptOffer( p.upgradeOffer )

		ItemFlavorBag price = offer.prices[0]
		canAfford = GRX_CanAfford( price, p.selectedQuantity, false )
		int priceDelta = GRX_CanAffordDelta( price, p.selectedQuantity )
		int creditsBalance = GRXCurrency_GetPlayerBalance( GetLocalClientPlayer(), GRX_CURRENCIES[GRX_CURRENCY_CREDITS ] )

		string creditsBalanceText = FormatAndLocalizeNumber( "1", float( creditsBalance ), true )
		string priceDeltaText = FormatAndLocalizeNumber( "1", float( priceDelta ), true )

		packUpgradeData.price = GRX_GetFormattedPrice( offer.prices[0], p.selectedQuantity )
		packUpgradeData.tooltipData.active = !canAfford
		packUpgradeData.tooltipData.bodyText = Localize( "#CANNOT_AFFORD_CREDITS_DESC", priceDeltaText ) + Localize( "#CANNOT_AFFORD_CREDITS" )
		packUpgradeData.tooltipData.subtitleText = Localize( "#AVAILABLE_N", Localize( "#CREDITS_CURRENCY_ICON_N", creditsBalanceText ) )
	}

	upgradeButton.PropSetBool( "interactive", canAfford )

	RTKStruct_SetValue( upgradeDataStruct, packUpgradeData )
}

int function SortByQuality( RTKPackOpeningSelectionPackData a, RTKPackOpeningSelectionPackData b )
{
	if ( a.quality < b.quality )
	{
		return 1
	}
	else if ( a.quality > b.quality )
	{
		return -1
	}
	return 0
}

void function RTKPackOpeningSelectionController_SendBonusProgressPIN( rtk_behavior self )
{
	if ( !BonusMeter_IsActive() || BonusMeter_IsCompleted() )
		return

	PrivateData p
	self.Private( p )

	if ( !ShouldPackProgressBonusMeter( p.selectedPack ) )
		return

	string reward = ""
	string meterID = ""
	int meterGoal = BonusMeter_GetMeterGoal()
	int meterProgress = BonusMeter_GetMeterProgress()
	bool willCompleteMeter = p.selectedQuantity + meterProgress >= meterGoal

	GRXScriptOffer ornull offer = BonusMeter_GetEligibleRewardOffer()
	if ( offer != null )
	{
		expect GRXScriptOffer( offer )
		meterID = offer.offerAlias
	}

	if ( willCompleteMeter )
	{
		SettingsAssetGUID guid = BonusMeter_GetEligibleRewardFlavGUID()
		if( IsValidItemFlavorGUID( guid ) )
		{
			ItemFlavor item = GetItemFlavorByGUID( guid )
			reward = ItemFlavor_GetHumanReadableRefForPIN_Slow( item )
		}
	}
	
	PIN_BonusMeterPlayerProgressedMeter( GetLocalClientPlayer(), meterProgress, p.selectedQuantity, meterGoal, meterID, reward )
}































int function RTKPackOpeningSelectionController_GetMaxPackOpen( ItemFlavor pack )
{
	if ( ItemFlavor_IsWishlistPack( pack ) )
		return MAX_WISHLIST_PACKS_QUANTITY

	return MAX_PACKS_QUANTITY
}