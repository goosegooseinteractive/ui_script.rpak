bool function Cups_IsRevealed( CupBakeryAssetData cupData, int t )
{
	int revealUnixTime = Cups_GetRevealUnixTime( cupData )
	return (t >= revealUnixTime)
}

bool function Cups_IsVisible( CupBakeryAssetData cupData, int t )
{
	int hideUnixTime = Cups_GetHideUnixTime( cupData )
	return Cups_IsRevealed( cupData, t ) && (t < hideUnixTime)
}

bool function Cups_HasFinished( CupBakeryAssetData cupData, int t )
{
	int finishUnixTime = Cups_GetFinishUnixTime( cupData )
	return (t >= finishUnixTime)
}

bool function Cups_HasStarted( CupBakeryAssetData cupData, int t )
{
	int startUnixTime = Cups_GetStartUnixTime( cupData )
	return (t >= startUnixTime)
}

bool function Cups_IsActive( CupBakeryAssetData cupData, int t )
{
	int finishUnixTime = Cups_GetFinishUnixTime( cupData )

	bool hasStarted = Cups_HasStarted( cupData, t )
	bool hasNotFinished = ( t < finishUnixTime )

	return hasStarted && hasNotFinished
}

