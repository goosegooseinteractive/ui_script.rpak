CupBakeryAssetData ornull function Cups_SafeGetCupBakeryAssetDataFromGUID( SettingsAssetGUID guid )
{
	if ( !Cups_IsValidCupID( guid ) )
		return null
	return fileLevel.cups[ guid ]
}

CupBakeryAssetData function Cups_GetCupBakeryAssetDataFromGUID( SettingsAssetGUID guid )
{
	Assert( IsItemFlavorStructValid( guid, eValidation.ASSERT ) )
	Assert( guid in fileLevel.cups )
	return fileLevel.cups[ guid ]
}

void function Cups_InsertRewardToBag( entity player, table< ItemFlavor, int > bagContents, CupBakeryAssetData cupData, int rewardTier )
{
	if( rewardTier >= 0 && rewardTier < cupData.tiers.len() )
	{
		foreach( CupTierRewardData rewardData in cupData.tiers[rewardTier].rewardData )
		{
			ItemFlavor rewardFlavor = GetItemFlavorByAsset( rewardData.reward )
			if ( ItemFlavor_GetGRXMode( rewardFlavor ) == GRX_ITEMFLAVORMODE_REGULAR )
			{
				if ( GRX_IsItemOwnedByPlayer( rewardFlavor, player ) )
					continue
			}
			if( rewardFlavor in bagContents && ItemFlavorIsStackable( rewardFlavor ) )
				bagContents[ rewardFlavor ] += rewardData.quantity
			else
				bagContents[ rewardFlavor ] <- rewardData.quantity
		}
	}
	else
	{
		Warning( "[Cups] Invalid rewardTier! " + rewardTier )
	}
}

bool function Cups_IsMatchValidForCups()
{
	if( !GetConVarBool( "cups_enabled" ) )
		return false

	if ( IsLobby() )
		return false 

	if ( IsPrivateMatch() )
		return false

	if ( IsBotModeMatch() )
		return false

	return true
}

bool function Cups_IsCupGameMode( CupBakeryAssetData cupData, string playlist )
{
	if( !GetConVarBool( "cups_enabled" ) ) return false

	if ( RankedEvent_IsCupRankedEvent( cupData ) )
	{
		return GameModeVariant_IsActiveForPlaylist( playlist, eGameModeVariants.SURVIVAL_RANKED )
	}

	return GetPlaylistVarBool( playlist, cupData.gameMode, false )
}

bool function Cups_IsCupUseBestTen( CupBakeryAssetData cupData )
{
	if ( !fileLevel.cupsInitialised )
		return false
	return cupData.isUseBestTen
}

bool function Cups_IsCupIDUseBestTen( SettingsAssetGUID cupID )
{
	if ( !fileLevel.cupsInitialised || !( cupID in fileLevel.cups ) )
		return false
	return fileLevel.cups[cupID].isUseBestTen
}

bool function Cups_IsCupMatchPlayerPlatform( CupBakeryAssetData cupData, entity player )
{
	if ( !fileLevel.cupsInitialised )
		return false

	if ( cupData.platform == PLATFORM_VALUE_NO_PLATFORM )
		return true

	return cupData.platform == GetMergedPlatformIdForPlayer( player )
}

bool function Cups_IsCrossplay( entity player )
{








		
		
		

		return CrossplayUserOptIn()

}

CupBakeryAssetData ornull function Cups_GetRevealedCupForPlaylist( string playlist, entity player )
{
	if ( !GetConVarBool( "cups_enabled" ) || !Cups_IsInitialized() )
		return null







	if ( !IsValid( player ) || !IsPersistenceAvailable() || !IsFullyConnected() )
		return null


	int unixTime = GetUnixTimestamp()
	foreach ( SettingsAssetGUID cupID, CupBakeryAssetData cup in fileLevel.cups )
	{
		
		if ( !Cups_IsValidCupID( cupID ) )
			continue

		
		if ( !Cups_IsVisible( cup, unixTime ) )
			continue

		if ( !Cups_IsCupMatchPlayerPlatform( cup, player ) )
			continue

		if ( !GetConVarBool( RANKED_EVENT_CONVAR ) && RankedEvent_IsCupIDRankedEvent( cupID ) )
			continue

		if ( !GetConVarBool( MICRO_EVENT_CONVAR ) && !RankedEvent_IsCupIDRankedEvent( cupID ) )
			continue

		if ( !Cups_IsCupGameMode( cup, playlist ) )
			continue

		return cup
	}

	return null
}

array<UserCupEntryData> function Cups_GetPlayersFullPCupData ( entity player )
{
	array<UserCupEntryData> fullUserCupData = []
	if( !GetConVarBool( "cups_enabled" ) || !Cups_IsInitialized() ) return fullUserCupData
#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return fullUserCupData
#endif


		Assert ( player == GetLocalClientPlayer(), "Cups_GetPlayersFullPCupData only available for local player in CLIENT and UI" )


	for( int i = 0; i < MAX_REGISTERED_CUPS; ++i )
	{
		UserCupEntryData userCupData
		string persistentDataKey = format( "cups[%d]", i )
		bool cupIsActive = expect bool( player.GetPersistentVar( persistentDataKey+".active" ) )
		if( cupIsActive )
		{
			userCupData.cupID = player.GetPersistentVarAsInt( persistentDataKey+".cupID" )
			if ( !Cups_IsValidCupID( userCupData.cupID ) )
				continue
			userCupData.registered = true
			userCupData.cupIndex = i
			userCupData.numMatches = player.GetPersistentVarAsInt( persistentDataKey+".numMatches" )
			userCupData.score = player.GetPersistentVarAsInt( persistentDataKey+".score" )
			userCupData.squadID = expect string( player.GetPersistentVar( persistentDataKey+".squadID" ) )
			fullUserCupData.append(userCupData)
		}
	}
	return fullUserCupData
}

UserCupEntryData function Cups_GetPlayersPCupData ( entity player, SettingsAssetGUID cupID )
{
	UserCupEntryData userCupData
	if( !GetConVarBool( "cups_enabled" ) ) return userCupData


		Assert ( player == GetLocalClientPlayer() )


	for( int i = 0; i < MAX_REGISTERED_CUPS; ++i )
	{
		string persistentDataKey = format( "cups[%d]", i )
		if ( player.GetPersistentVarAsInt( persistentDataKey+".cupID" ) == cupID )
		{
			userCupData.registered = expect bool( player.GetPersistentVar( persistentDataKey+".active" ) )
			userCupData.cupIndex = i
			userCupData.cupID = player.GetPersistentVarAsInt( persistentDataKey+".cupID" )
			userCupData.numMatches = player.GetPersistentVarAsInt( persistentDataKey+".numMatches" )
			userCupData.score = player.GetPersistentVarAsInt( persistentDataKey+".score" )
			userCupData.squadID = expect string( player.GetPersistentVar( persistentDataKey+".squadID" ) )
			return userCupData
		}
	}
	return userCupData
}

LastCupMatchPlayedData ornull function Cups_GetLatestMatchSummaryData( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) ) return null


		Assert ( player == GetLocalClientPlayer() )


	string persistentDataKey = "cupsLastMatchPlayed"
	SettingsAssetGUID cupID  = player.GetPersistentVarAsInt( persistentDataKey + ".cupID" )

	if ( Cups_IsValidCupID( cupID ) )
	{
		LastCupMatchPlayedData summaryData

		summaryData.cupID    = cupID
		summaryData.matchNum = player.GetPersistentVarAsInt( persistentDataKey + ".matchNum" )

		return summaryData
	}
	return null
}

bool function Cups_IsCupForLatestMatchActive( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) ) return false

	LastCupMatchPlayedData ornull cupsLastMatchData = Cups_GetLatestMatchSummaryData( player )

	if ( cupsLastMatchData == null )
