bool function DeathboxBased_InventoryRestore_Enabled()
{
	bool isEnabled = GetCurrentPlaylistVarBool( "DeathboxBased_InventoryRestore_Enabled", false )
	isEnabled = isEnabled || GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_enabled", false )
	return isEnabled
}





















