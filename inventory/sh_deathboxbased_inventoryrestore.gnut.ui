struct
{
	bool checkVsBox_Mythics 					= true	
	bool giveDegradedKittedWeapon_IfNotInBox 	= true 	
	bool degradedKittedWeapon_IsBase			= true	

	bool checkVsBox_Attachments 			= true	
	bool giveDegradedIfNotInBox_Optic		= true  
	bool giveDegradedIfNotInBox_Attachments	= false	

	string equipmentSlots_ToCheck = "augment backpack gadgetslot helmet incapshield"
	string weaponMods_ToSkip = "dormant_hopup hopup_brand"

	bool weaponRestore_Values = false

	bool topOff_NonCrate_StockpileWeapons = false
	bool topOff_NonCrate_PoolWeapons = false
} tuning



















