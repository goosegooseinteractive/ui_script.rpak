void function DeathboxBased_InventoryRestore_Init()
{
	if( !DeathboxBased_InventoryRestore_Enabled() )
		return




















}

void function Tunings_Init()
{
	tuning.checkVsBox_Attachments 	= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_checkvsbox_attachments", tuning.checkVsBox_Attachments )
	tuning.checkVsBox_Mythics 		= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_checkvsbox_mythics", 	tuning.checkVsBox_Mythics )
	tuning.giveDegradedKittedWeapon_IfNotInBox = GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_givedegradedifnotinbox_kittedweapon", tuning.giveDegradedKittedWeapon_IfNotInBox )
	tuning.degradedKittedWeapon_IsBase 		= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_degradedkittedweapon_isbase", tuning.degradedKittedWeapon_IsBase )

	tuning.giveDegradedIfNotInBox_Optic 		= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_givedegradedifnotinbox_optic", tuning.giveDegradedIfNotInBox_Optic )
	tuning.giveDegradedIfNotInBox_Attachments 	= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_givedegradedifnotinbox_attachments", tuning.giveDegradedIfNotInBox_Attachments )

	tuning.equipmentSlots_ToCheck = GetCurrentPlaylistVarString( "deathboxbased_inventoryrestore_equipmentslots_tocheck", tuning.equipmentSlots_ToCheck )
	tuning.weaponMods_ToSkip = GetCurrentPlaylistVarString( "deathboxbased_inventoryrestore_weaponmods_toskip", tuning.weaponMods_ToSkip )

	tuning.weaponRestore_Values = GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_weaponrestore_values", tuning.weaponRestore_Values )

	tuning.topOff_NonCrate_StockpileWeapons 	= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_topoff_noncrate_stockpileweapons", tuning.topOff_NonCrate_StockpileWeapons )
	tuning.topOff_NonCrate_PoolWeapons			= GetCurrentPlaylistVarBool( "deathboxbased_inventoryrestore_topoff_noncrate_poolweapons", 		tuning.topOff_NonCrate_PoolWeapons )





}

