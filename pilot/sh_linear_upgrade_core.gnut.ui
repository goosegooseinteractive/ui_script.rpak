	table< ItemFlavor, array<SettingsAssetGUID> > characterToPassiveUpgradeOverrides
	table< ItemFlavor , UpgradeChoice > passiveFlavorToUpgradeData













} file

struct Tuning
{
	bool isEnabled = false
	bool shouldArmorTierMatchPlayerLevel = false 
	bool showHudUpgradeSelection = false 	
	bool showUpgradeTreeInventory = false 	
	bool showUpgradesUnitframe = false 		
	bool  armorTiedToUpgrades = false
	float upgradeSelectionReminderDelay = 60.0
	bool showUpgradeTreeLobbyMenu = false 			
	bool showUpgradeTreeSkillsMenu = false 			
	bool showUpgradeTreeCharacterSelect = false 	

	int maxLevel = 4
	int defaultXpPerLevel = 250
}
Tuning tuning


global const int LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES = 4
global const int LINEAR_UPGRADE_CORE_MAX_EXPECTED_LEVEL = 4
global const int LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES_PER_LEVEL = 2 

const int CAUSTIC_AMOUNT_SLOTS = 4


const string FUNCNAME_ClientToServer_LinearUpgradeCore_HandleUpgradeSelection = "Server_LinearUpgradeCore_HandleSelection"


const asset TROPHY_ELECTRICITY_FX = $"P_wpn_trophy_loop_2"


global const string LINEAR_UPGRADE_CORE_SELECTED_UPGRADES = SELECTED_UPGRADE_SHARED_NETVAR

const string LINEAR_UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER = "450 1350 2000"
const string LINEAR_UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER_DUOS = "400 1100 1700"





void function LinearUpgradeCore_Init()
{




	LinearUpgradeCore_InitTuningValues()

	if ( !LinearUpgradeCore_IsEnabled() )
		return






	LinearUpgradeCore_SetupEvoLevelSystem()





















	thread LinearUpgradeCore_DelayedParseUpgradeOverrides()





}

void function LinearUpgradeCore_DelayedParseUpgradeOverrides()
{
	WaitFrame()
	thread LinearUpgradeCore_ParseUpgradeOverrides()
}

void function LinearUpgradeCore_InitTuningValues()
{




	tuning.isEnabled							= GetCurrentPlaylistVarBool( "linear_upgrade_core_enabled", tuning.isEnabled )
	tuning.shouldArmorTierMatchPlayerLevel 	= GetCurrentPlaylistVarBool( "passive_upgrade_core_armor_match_player_level", tuning.shouldArmorTierMatchPlayerLevel )
	tuning.showHudUpgradeSelection 			= GetCurrentPlaylistVarBool( "passive_upgrade_show_hud_selection", tuning.showHudUpgradeSelection )
	tuning.showUpgradeTreeInventory 			= GetCurrentPlaylistVarBool( "passive_upgrade_show_upgrade_tree_inventory", tuning.showUpgradeTreeInventory )
	tuning.showUpgradesUnitframe 				= GetCurrentPlaylistVarBool( "passive_upgrade_show_upgrade_unitframe", tuning.showUpgradesUnitframe )
	tuning.armorTiedToUpgrades 				= GetCurrentPlaylistVarBool( "passive_upgrade_armor_tied_to_upgrades", tuning.armorTiedToUpgrades )
	tuning.upgradeSelectionReminderDelay 		= GetCurrentPlaylistVarFloat( "passive_upgrade_core_reminder_hint_delay", tuning.upgradeSelectionReminderDelay )
	tuning.showUpgradeTreeLobbyMenu 			= GetCurrentPlaylistVarBool( "lobby_characters_linear_tree_enabled", tuning.showUpgradeTreeLobbyMenu ) 
	tuning.showUpgradeTreeSkillsMenu 			= GetCurrentPlaylistVarBool( "skills_menu_upgrade_tree_enabled", tuning.showUpgradeTreeSkillsMenu )  
	tuning.showUpgradeTreeCharacterSelect 		= GetCurrentPlaylistVarBool( "character_select_upgrade_tree_enabled", tuning.showUpgradeTreeCharacterSelect )  
	tuning.maxLevel 							= GetCurrentPlaylistVarInt( "linear_upgrade_core_max_level", tuning.maxLevel )
}

