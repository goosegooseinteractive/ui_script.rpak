void function ShPassiveLinearUpgradeCore_LobbyInit()
{
	ShPassiveLinearUpgradeCore_NetvarsInit()

	if ( !file.performLobbyInit )
		return

	LinearUpgradeCore_InitTuningValues()

	thread ShPassiveLinearUpgradeCore_LobbyInit_DelayedUpgradeOverridesParse()
}

void function ShPassiveLinearUpgradeCore_LobbyInit_DelayedUpgradeOverridesParse()
{
	
	WaitFrame()
	LinearUpgradeCore_ParseUpgradeOverrides()



}

void function LinearUpgradeCore_RegisterUpgradesForCharacter( ItemFlavor character, array<ItemFlavor> upgrades )
{
	UpgradeHelper_RegisterUpgradesForCharacter( character, upgrades, file.characterToPassiveUpgrades, file.passiveFlavorToUpgradeData, file.characterToPassiveUpgradeOverrides )
}

void function LinearUpgradeCore_ParseUpgradeOverrides()
{
	int expectedLength = tuning.maxLevel + 1

	UpgradeHelper_ParseUpgradeOverrides( expectedLength, "passive_upgrade_core_overrides",
	file.characterToPassiveUpgrades, file.characterToPassiveUpgradeOverrides )
}



























































