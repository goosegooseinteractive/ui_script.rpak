bool function CanPlayerPurchaseBattlePass( entity player, ItemFlavor activeBattlePass )
{
	Assert( PlayerPass_IsPassOfType( activeBattlePass, ePassType.SEASONAL ), "Called CanPlayerPurchaseBattlePass on non-seasonal BP.")

	if ( DoesPlayerOwnBattlePass( player, activeBattlePass ) )
	{
		printt("CanPlayerPurchaseBattlePass - returning false because player already owns battlepass" + ItemFlavor_GetAsset( activeBattlePass ))
		return false
	}

	return true
}



bool function Battlepass_TryShowInstantGrants( void functionref( int ) resultCallback )
{
	if ( !GRX_IsInventoryReady() )
		return false

	ItemFlavor ornull activeBattlePass = GetActiveBattlePassV2()
	if ( activeBattlePass == null )
	{
		return false
	}
	expect ItemFlavor( activeBattlePass )

	entity localPlayer = GetLocalClientPlayer()
	if ( localPlayer == null )
		return false

	EHI playerEHI = LocalClientEHI()
	if ( playerEHI == EHI_null )
		return false

	 int currentTier = GetPlayerBattlePassTier( localPlayer, activeBattlePass )
	 int lastSeenTier = GetPlayerBattlePassLastSeenInstantGrantTier( playerEHI, activeBattlePass )

	if ( lastSeenTier < currentTier ) 
	{
		string stringOut = ""

		array<var> fromTiersArray = IterateSettingsAssetArray( ItemFlavor_GetAsset( activeBattlePass ), "instantGrantFromTier" )

		if ( lastSeenTier < fromTiersArray.len() )
		{
			var toTiersArray = GetSettingsBlockArray( fromTiersArray[lastSeenTier], "instantGrantToTier" )

			bool lengthValid = false
			foreach (int j, var toTierBlock in IterateSettingsArray( toTiersArray ) )
			{
				if ( j == currentTier )
				{
					stringOut = GetSettingsBlockString( toTierBlock, "instantGrantString" )
				}
				if ( j == 3 )
				{
					lengthValid = true
				}
			}

			if ( !lengthValid )
			{
				stringOut = ""
				Assert( false, "Battlepass_TryShowInstantGrants expects toTiersArray of size > 3"  )
			}
		}

		if ( CanRunClientScript() )
		{
			Remote_ServerCallFunction( "ClientCallback_UpdateBattlePassGrantLastSeen", ItemFlavor_GetGUID( activeBattlePass ) )
		}

		if ( stringOut != "" )
		{
			ConfirmDialogData dialogData
			dialogData.headerText = "#BP_INSTANT_GRANT_DIALOG_HEADER"
			dialogData.messageText = stringOut
			dialogData.resultCallback = resultCallback
			OpenOKDialogFromData( dialogData )

			return true
		}
	}

	return false
}



