bool function BattlePassHasWeeklyChallenge( ItemFlavor pass, ItemFlavor challenge, int week )
{
	return fileLevel.battlePassMap[ pass ].challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY ][ week ].contains( challenge )
}



void function ShBattlePass_RefreshCachedSeasonInfo()
{
	int unixTimeNow = GetUnixTimestamp()
	if ( fileLevel.expirationTimestampV2 >= unixTimeNow )
		return

	fileLevel.currentSeason = GetActiveSeason( unixTimeNow )
	fileLevel.expirationTimestamp = 0
	fileLevel.currentBattlePassV2 = null
	if ( fileLevel.currentSeason != null )
	{
		if ( Season_HasBattlePassV2( expect ItemFlavor( fileLevel.currentSeason ) ) )
		{
			array<BattlePassV2ConfigStruct> bpConfigs = Season_GetAllBattlePassesV2Config( expect ItemFlavor( fileLevel.currentSeason ) )
			foreach ( BattlePassV2ConfigStruct config in bpConfigs )
			{
				if ( unixTimeNow >= config.startTime && unixTimeNow <= config.finishTime )
				{
					fileLevel.currentBattlePassV2 = config.flav
					fileLevel.expirationTimestampV2 = config.finishTime
					break
				}
			}
		}
	}
}



asset function BattlePass_GetStoreBundleContentsImage ( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.battlepass )

	return GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "storeBundleContentsImage" )
