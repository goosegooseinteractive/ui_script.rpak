global const int BATTLEPASS_NUMBER_OF_FIXUP_SEASONS = 3

global const asset CHALLENGE_REWARD_MODEL = $"mdl/menu/challenge_reward_star/challenge_reward_star.rmdl"
global const asset BATTLEPASS_STAR_REWARD_MODEL = $"mdl/menu/reward_star.rmdl"
global const asset BATTLEPASS_MODEL_BOOST = $"mdl/menu/xp_badge.rmdl"
global const asset BATTLEPASS_MODEL_APEX_COINS = $"mdl/menu/coin.rmdl"
global const asset BATTLEPASS_MODEL_LEVEL_BADGE = $"mdl/menu/bp_badge.rmdl"
global const asset BATTLEPASS_MODEL_CRAFTING_METALS = $"mdl/currency/crafting/currency_crafting_epic.rmdl"
global const float BATTLEPASS_XP_BOOST_AMOUNT = 0.1

const string RECURRING_GRINDLORD_STAT = "stats.challenge_xp_earned"
const string GRINDLORD_CHALLENGE_BAKERY_KEY = "recurringGrindlordChallenge"

const int BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL = GRX_HTTPQUERYGOAL_GIVE_BATTLEPASS_SEQUENCE_REWARD






void function ShBattlePass_LevelInit()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	ShBattlePass_RefreshCachedSeasonInfo()

























	AddCallback_RegisterRootItemFlavors( void function() {
		foreach ( asset assetData in GetBaseItemFlavorsFromArray("accountPass") )
		{
			ItemFlavor ornull itemFlavorData = RegisterItemFlavorFromSettingsAsset( assetData )
			Assert ( itemFlavorData != null, "Account pass should not be null." )
			fileLevel.accountPass = expect ItemFlavor( itemFlavorData )
			break
		}
	} )

	AddCallback_OnItemFlavorRegistered( eItemType.battlepass, void function( ItemFlavor pass ) {
		if ( !PlayerPass_IsPassOfType( pass, ePassType.SEASONAL ) ) 
		{
			return
		}

		
		
		int sortOrdinal = 0

		fileLevel.battlePassList.append( pass )

		BattlePassData passData
		passData.pass = pass

		var passDataTable                 = BattlePass_GetScheduleDatatable( pass )
		int numRows                       = GetDataTableRowCount( passDataTable )
		int maxLevels                     = GetDataTableInt( passDataTable, numRows - 1, GetDataTableColumnByName( passDataTable, "levelIndex" ) ) + 1
		int cumulativeXP                  = 0
		bool shouldRegisterSubArrayAssets = true

		if ( GetCalEventBeingProcessed() != null )
			shouldRegisterSubArrayAssets = !CalEvent_IsExpired( expect ItemFlavor( GetCalEventBeingProcessed() ) )

		asset passAsset = ItemFlavor_GetAsset( pass )

		
		RegisterItemFlavorFromSettingsAsset( GetGlobalSettingsAsset( passAsset, "xpPurchaseFlav" ) )
		asset xpPurchaseLegendToken = GetGlobalSettingsAsset( passAsset, "bubblePurchaseFlav" )
		if ( xpPurchaseLegendToken != $"" )
			RegisterItemFlavorFromSettingsAsset( xpPurchaseLegendToken )

		if ( shouldRegisterSubArrayAssets )
		{
			RegisterItemFlavorFromSettingsAsset( GetGlobalSettingsAsset( passAsset, "xpBoostFlav" ) )

			asset reroll = GetGlobalSettingsAsset( passAsset, "challengeRerollFlav" )
			if ( reroll != $"" )
				RegisterItemFlavorFromSettingsAsset( reroll )
		}

		passData.maxPassLevel = maxLevels - 1 

		string typeStr = GetGlobalSettingsString( ItemFlavor_GetAsset( pass ), "progressionSystem" )
		Assert( typeStr in eBattlePassProgressionSystem )
		passData.progressionSystem = eBattlePassProgressionSystem[typeStr]
		int xpPerLevel = GetDataTableInt( passDataTable, 0, GetDataTableColumnByName( passDataTable, "xpPerLevel" ) )
		passData.xpPerLevel = GetCurrentPlaylistVarInt( format( "battlepass_%s_xp_per_level", ItemFlavor_GetGUIDString( pass ) ), xpPerLevel )












		passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING ] <- {}
		passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING ][-1] <- []
		if ( shouldRegisterSubArrayAssets && passData.progressionSystem == eBattlePassProgressionSystem.STARS )
		{
			asset chAsset = GetGlobalSettingsAsset( passAsset, GRINDLORD_CHALLENGE_BAKERY_KEY )
			Assert( chAsset != $"" )
			ItemFlavor challenge = expect ItemFlavor( RegisterItemFlavorFromSettingsAsset( chAsset ) )
			passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING ][-1].append( challenge )
			Assert( Challenge_GetStatRefs( null, challenge, 0 )[0] == RECURRING_GRINDLORD_STAT )
			passData.recurringGrindlordChallenge = challenge
		}

		array<asset> dupeCheck = []

		passData.challenges[ eChallengeTimeSpanKind.DAILY ] <- {}
		passData.challenges[ eChallengeTimeSpanKind.DAILY ][-1] <- []
		if ( shouldRegisterSubArrayAssets)
		{
			foreach ( var block in IterateSettingsAssetArray( passAsset, "dailyChallenges" ) )
			{
				asset chAsset = GetSettingsBlockAsset( block, "flavor" )

				Assert( !dupeCheck.contains( chAsset ) )
				dupeCheck.append( chAsset )

				ItemFlavor ornull challenge = RegisterItemFlavorFromSettingsAsset( chAsset )
				if ( challenge != null )
					passData.challenges[ eChallengeTimeSpanKind.DAILY ][-1].append( expect ItemFlavor( challenge ) )
			}
		}

		dupeCheck.clear()

		passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY ] <- {}
		if ( shouldRegisterSubArrayAssets )
		{
			foreach ( var block in IterateSettingsAssetArray( passAsset, "weeklyChallenges" ) )
			{
				int week = GetSettingsBlockInt( block, "weekNumber" )
				passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY ][week] <- []
				foreach ( var chBlock in IterateSettingsArray( GetSettingsBlockArray( block, "challenges" ) ) )
				{
					asset chAsset = GetSettingsBlockAsset( chBlock, "flavor" )

					Assert( !dupeCheck.contains( chAsset ) )
					dupeCheck.append( chAsset )

					ItemFlavor ornull challenge = RegisterItemFlavorFromSettingsAsset( chAsset )
					if ( challenge != null )
					{
						expect ItemFlavor( challenge )
						RegisterChallengeSource( challenge, pass, sortOrdinal++ )
						passData.challenges[ eChallengeTimeSpanKind.SEASON_WEEKLY ][week].append( challenge )
					}
				}
			}
		}

		dupeCheck.clear()

		if ( BattlePassV2_IsV2BattlePass( pass ) )
		{
			asset ultimateOwnershipAsset = BattlePassV2_GetUltimateOwnershipAsset( pass )
			if ( ultimateOwnershipAsset != $"" )
			{
				ItemFlavor ornull ultimateOwnershipFlav = RegisterItemFlavorFromSettingsAsset( ultimateOwnershipAsset )

				if ( ultimateOwnershipFlav != null )
				{
					expect ItemFlavor( ultimateOwnershipFlav )
					passData.ultimateOwnershipFlav = ultimateOwnershipFlav
				}
			}

			asset ultimatePlusOwnershipAsset = BattlePassV2_GetUltimatePlusOwnershipAsset( pass )
			if ( ultimatePlusOwnershipAsset != $"" )
			{
				ItemFlavor ornull ultimatePlusOwnershipFlav = RegisterItemFlavorFromSettingsAsset( ultimatePlusOwnershipAsset )

				if ( ultimatePlusOwnershipFlav != null )
				{
					expect ItemFlavor( ultimatePlusOwnershipFlav )
					passData.ultimatePlusOwnershipFlav = ultimatePlusOwnershipFlav
				}
			}
		}

		if ( shouldRegisterSubArrayAssets )
		{
			RegisterReferencedItemFlavorsFromArray( pass, "challengeTiles", "challengeTile" )
		}

		fileLevel.battlePassMap[pass] <- passData
	} )


	thread function() : () {
		EndSignal( uiGlobal.signalDummy, "LevelShutdown" )

		while ( fileLevel.currentBattlePassV2 == null )
		{
			wait 1.0
		}

		table<int, string> bpOfferIDs = GetCurrentBattlepassOfferIDs()
		Assert( bpOfferIDs.len() == BATTLEPASS_FIRST_PARTY_OFFER_COUNT )

		UpdateBattlepassEntitlements( [ BATTLEPASS_ULT, BATTLEPASS_ULT_PLUS, BATTLEPASS_UPGRADE ], [ bpOfferIDs[BATTLEPASS_ULT], bpOfferIDs[BATTLEPASS_ULT_PLUS], bpOfferIDs[BATTLEPASS_UPGRADE] ] )
		InitDLCStore()
		fileLevel.isBattlepassFirstPartyOffersReady = true
	}()

}

int function GetMaxBattlePassLevelIndex( var passDataTable )
{
	int numRows = GetDataTableRowCount( passDataTable )
	return GetDataTableInt( passDataTable, numRows - 1, GetDataTableColumnByName( passDataTable, "levelIndex" ) ) + 1
}

int function GetXPToCompleteBPLevel( ItemFlavor pass )
{
	BattlePassData passData = fileLevel.battlePassMap[pass]
	return passData.xpPerLevel
}


table<int, string> function GetCurrentBattlepassOfferIDs()
{
	if ( fileLevel.battlepassFirstPartyOfferIDs.len() == 0 )
	{
		return GetCurrentBattlepassFirstPartyOfferIDs()
	}

	return fileLevel.battlepassFirstPartyOfferIDs
}



table<int, string> function GetCurrentBattlepassFirstPartyOfferIDs()
{
	ItemFlavor ornull battlepassFlav = GetActiveBattlePassV2()
	if ( battlepassFlav == null )
	{
#if DEV
			GRX_Warning( "cannot find current active battlepass flav;" )
#endif
		return {}
	}

	if ( fileLevel.battlepassFirstPartyOfferIDs.len() == BATTLEPASS_FIRST_PARTY_OFFER_COUNT )
	{
		return fileLevel.battlepassFirstPartyOfferIDs
	}

	expect ItemFlavor( battlepassFlav )

	table<int, string> result

	asset battlepassAsset = ItemFlavor_GetAsset( battlepassFlav )

	string battlepassUltOfferId
	string battlepassUltPlusOfferId
	string battlepassUpgradeOfferId


	if ( PCPlat_IsSteam() )
	{
		battlepassUltOfferId = GetGlobalSettingsString( battlepassAsset, "BattlepassUltSteamOfferID" )
		battlepassUltPlusOfferId = GetGlobalSettingsString( battlepassAsset, "BattlepassUltPlusSteamOfferID" )
		battlepassUpgradeOfferId = GetGlobalSettingsString( battlepassAsset, "BattlepassUpgradeSteamOfferID" )
	}
	else
	{
		battlepassUltOfferId = GetGlobalSettingsString( battlepassAsset, "BattlepassUltOriginOfferID" )
		battlepassUltPlusOfferId =  GetGlobalSettingsString( battlepassAsset, "BattlepassUltPlusOriginOfferID" )
		battlepassUpgradeOfferId = GetGlobalSettingsString( battlepassAsset, "BattlepassUpgradeOriginOfferID" )
	}


























#if DEV
	if ( battlepassUltOfferId.len() == 0 || battlepassUltPlusOfferId.len() == 0 || battlepassUpgradeOfferId.len() == 0 )
	{
		GRX_Warning( "battlepass offer Id is empty; maybe bakery asset is not updated yet? ult:%s, ultplus:%s, upgrade:%s", battlepassUltOfferId, battlepassUltPlusOfferId, battlepassUpgradeOfferId )
	}
#endif

	result[BATTLEPASS_ULT] <- battlepassUltOfferId
	result[BATTLEPASS_ULT_PLUS] <- battlepassUltPlusOfferId
	result[BATTLEPASS_UPGRADE] <- battlepassUpgradeOfferId

	Assert( result.len() == BATTLEPASS_FIRST_PARTY_OFFER_COUNT )
	Assert( ( BATTLEPASS_ULT in result ) && ( BATTLEPASS_ULT_PLUS in result ) && ( BATTLEPASS_UPGRADE in result ) )











	fileLevel.battlepassFirstPartyOfferIDs = result

	return result
}



bool function IsBattlepassFirstPartyOfferReady()
{
	return fileLevel.isBattlepassFirstPartyOffersReady && IsDLCStoreReady()
}








bool function IsPurchasingBattlePassLevelsWithLegendTokensEnabled()
{
	return GetConVarBool( "mtx_purchaseBPLevelsWithLegendTokensEnabled" )
}



bool function IsPlayerLeveledToPurchaseBattlePassLevelsWithLegendTokens( entity player, ItemFlavor pass )
{
	if ( !IsPurchasingBattlePassLevelsWithLegendTokensEnabled() )
		return false

	
	return GetPlayerBattlePassLevel( player, pass, false ) >= GetConVarInt( "mtx_purchaseBPLevelsWithLegendTokensMinLevel" ) - 1
}



bool function IsCurrentlyWithinTimeframeToPurchaseBattlePassLevelsWithLegendTokens()
{
	if ( !IsPurchasingBattlePassLevelsWithLegendTokensEnabled() )
		return false

	ItemFlavor currentSeason = expect ItemFlavor( fileLevel.currentSeason )

	int currentTime          = GetUnixTimestamp()
	int startOffsetInSeconds = GetConVarInt( "mtx_purchaseBPLevelsWithLegendTokensStartDaysOffset" ) * (24 * 60 * 60)
	int endOffsetInSeconds   = GetConVarInt( "mtx_purchaseBPLevelsWithLegendTokensEndDaysOffset" ) * (24 * 60 * 60)
	int startTime            = CalEvent_GetStartUnixTime( currentSeason ) + startOffsetInSeconds
	int endTime              = CalEvent_GetFinishUnixTime( currentSeason ) - endOffsetInSeconds

	return currentTime >= startTime && currentTime <= endTime
}



int function GetMaxBattlePassLevelsWithLegendTokens()
{
	if ( !IsPurchasingBattlePassLevelsWithLegendTokensEnabled() )
		return 0
	return GetConVarInt( "mtx_purchaseBPLevelsWithLegendTokensLimit" )
}



ItemFlavor ornull function GetActiveBattlePass()
{
	return GetActiveBattlePassV2()
}



ItemFlavor ornull function GetActiveBattlePassV2()
{

	if ( !IsFullyConnected() )
		return null


	ShBattlePass_RefreshCachedSeasonInfo()

	return fileLevel.currentBattlePassV2
}



string function GetActiveBattlePassGUID()
{
	ItemFlavor ornull activeBattlePass = GetActiveBattlePass()
	if ( activeBattlePass == null )
	{
		Warning( "GetActiveBattlePassString: current active battle pass itemflavor was null." )
		return ""
	}

	expect ItemFlavor( activeBattlePass )

	string bpString = ItemFlavor_GetGUIDString( activeBattlePass )
	if ( bpString.len() == 0 )
	{
		Warning( "GetActiveBattlePassString: current active battle pass string guid was empty." )
		return ""
	}

	return bpString
}




ItemFlavor ornull function GetPlayerActiveBattlePass( EHI playerEHI )
{

		Assert( playerEHI == LocalClientEHI() )


	return GetActiveBattlePass()
}



ItemFlavor ornull function GetPlayerActiveBattlePassV2( EHI playerEHI )
{

		Assert( playerEHI == LocalClientEHI() )


	return GetActiveBattlePassV2()
}


enum eBattlepassEntitlementType
{
	Ultimate,
	UltimateUpgrade,
	UltimatePlus,
}


int function GetBattlepassEntitlement( int bpEntitlementType )
{
	ItemFlavor ornull currentPassFlav = GetActiveBattlePassV2()
	if ( currentPassFlav == null )
	{
		Assert( false, "Cannot retrieve entitlement because there's no current active Battlepass!" )
		return -1
	}
	expect ItemFlavor( currentPassFlav )
	Assert( BattlePassV2_IsV2BattlePass( currentPassFlav ) )

	int currentSplit = BattlePassV2_GetCurrentSplit( currentPassFlav )
	switch ( bpEntitlementType )
	{
		case eBattlepassEntitlementType.Ultimate:
		{
			return BATTLEPASS_ULT
		}
		case eBattlepassEntitlementType.UltimateUpgrade:
		{
			return BATTLEPASS_UPGRADE
		}
		case eBattlepassEntitlementType.UltimatePlus:
		{
			return BATTLEPASS_ULT_PLUS
		}
		default:
		{
			Assert( false, format( "Found a split number %d for Battlepass %s. Battlepass splits should either be 1 or 2.", currentSplit, ItemFlavor_GetGRXAlias( currentPassFlav ) ) )
			return -1
		}
	}
	unreachable
}

int function BattlepassGetEntitlementUltimate()
{
	return GetBattlepassEntitlement( eBattlepassEntitlementType.Ultimate )
}



int function BattlepassGetEntitlementUltimatePlus()
{
	return GetBattlepassEntitlement( eBattlepassEntitlementType.UltimatePlus )
}



int function BattlepassGetEntitlementUltToUltPlus()
{
	return GetBattlepassEntitlement( eBattlepassEntitlementType.UltimateUpgrade )
}



int function GetPlayerBattlePassTier( entity player, ItemFlavor pass )
{
	for ( int i = eBattlePassV2OwnershipTier._COUNT - 1; i >= 0; i-- )
	{
		if ( DoesPlayerOwnBattlePassTier( player, pass, i ) )
			return i
	}
	return eBattlePassV2OwnershipTier.INVALID
}



bool function DoesPlayerOwnBattlePassTier( entity player, ItemFlavor pass,  int ownershipTier = eBattlePassV2OwnershipTier.INVALID )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

	if ( !BattlePassV2_IsV2BattlePass( pass ) )
	{
		return false
	}

	int activePassType = BattlePass_GetType(  pass )

	if ( activePassType == ePassType.NEWPLAYER )
	{
		return ownershipTier <= eBattlePassV2OwnershipTier.FREE
	}

	if ( activePassType != ePassType.SEASONAL ) 
	{
		return false 
	}

	switch ( ownershipTier )
	{
		case eBattlePassV2OwnershipTier.FREE:
		{
			return true
		}
		case eBattlePassV2OwnershipTier.PREMIUM:
		{
			return DoesPlayerOwnBattlePass( player, pass ) || DoesPlayerOwnUltimateBattlePass(player, pass) || DoesPlayerOwnUltimatePlusBattlePass( player, pass )
		}
		case eBattlePassV2OwnershipTier.ULTIMATE:
		{
			return DoesPlayerOwnUltimateBattlePass(player, pass) || DoesPlayerOwnUltimatePlusBattlePass( player, pass )
		}
		case eBattlePassV2OwnershipTier.ULTIMATE_PLUS:
		{
			return DoesPlayerOwnUltimatePlusBattlePass( player, pass )
		}
	}

	return false
}



bool function DoesPlayerOwnBattlePass( entity player, ItemFlavor pass )
{

		if ( !IsLobby() && IsPersistenceAvailable() ) 
		{
			Assert( player == GetLocalClientPlayer() )
			return 	player.GetPersistentVarAsInt( format( BATTLE_PASS_OWNERSHIP_CACHE_PVAR, BATTLE_PASS_PREMIUM_INDEX ) ) == pass.guid
		}


	return GRX_IsItemOwnedByPlayer_AllowOutOfDateData( pass, player )
}




bool function DoesPlayerOwnUltimateBattlePass( entity player, ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	if ( !BattlePassV2_IsV2BattlePass( pass ) )
	{
		return false 
	}

	ItemFlavor ultimateOwnershipFlav = BattlePassV2_GetUltimateOwnershipFlavForBP( pass )


		if ( !IsLobby() && IsPersistenceAvailable() ) 
		{
			Assert( player == GetLocalClientPlayer() )
			return 	player.GetPersistentVarAsInt( format( BATTLE_PASS_OWNERSHIP_CACHE_PVAR, BATTLE_PASS_ULTIMATE_INDEX ) ) == ultimateOwnershipFlav.guid
		}


	return GRX_IsItemOwnedByPlayer_AllowOutOfDateData( ultimateOwnershipFlav, player )
}

bool function DoesPlayerOwnUltimatePlusBattlePass( entity player, ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	if ( !BattlePassV2_IsV2BattlePass( pass ) )
	{
		return false 
	}

	ItemFlavor ultimatePlusFlav = BattlePassV2_GetUltimatePlusOwnershipFlavForBP( pass )


		if ( !IsLobby() && IsPersistenceAvailable() ) 
		{
			Assert( player == GetLocalClientPlayer() )
			return player.GetPersistentVarAsInt( format( BATTLE_PASS_OWNERSHIP_CACHE_PVAR, BATTLE_PASS_ULTIMATE_PLUS_INDEX ) ) == ultimatePlusFlav.guid
		}


	return GRX_IsItemOwnedByPlayer_AllowOutOfDateData( ultimatePlusFlav, player )
}



int function GetPlayerBattlePassXPProgress( EHI playerEHI, ItemFlavor pass, bool getPreviousProgress = false )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

		Assert( playerEHI == LocalClientEHI() )


#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return 0
#endif

	if ( !( pass in fileLevel.battlePassMap ) )
	{
		Assert( false, format( "Requested BP is not in map: %s", string( ItemFlavor_GetAsset( pass ) ) ) )
		return 0
	}

	entity player = FromEHI( playerEHI )

	int earnedBattlePassXP    = player == null ? 0 : player.GetPersistentVarAsInt( format( getPreviousProgress ? "battlePasses[%s].previousEarnedXP" : "battlePasses[%s].earnedXP", ItemFlavor_GetGUIDString( pass ) ) )
	int purchasedBattlePassXP = GetPlayerBattlePassPurchasedXP( playerEHI, pass )

	BattlePassData passData = fileLevel.battlePassMap[pass]
	return minint( earnedBattlePassXP + purchasedBattlePassXP, passData.xpPerLevel * passData.maxPassLevel )
}




int function GetPlayerBattlePassLastSeenXP( EHI playerEHI, ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

		Assert( playerEHI == LocalClientEHI() )


#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return 0
#endif

	int earnedBattlePassXP    = GetPlayerBattlePassEarnedXP( playerEHI, pass, true )
	int purchasedBattlePassXP = GetPlayerBattlePassPurchasedXP( playerEHI, pass, true )

	return earnedBattlePassXP + purchasedBattlePassXP
}




int function GetPlayerBattlePassPurchasedXP( EHI playerEHI, ItemFlavor pass, bool getPreviousProgress = false )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

		Assert( playerEHI == LocalClientEHI() )


#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return 0
#endif

	if ( getPreviousProgress )
	{

		return expect int( GetDialogFlowTablesValueOrPersistence( format( "battlePasses[%s].lastSeenPurchasedXP", ItemFlavor_GetGUIDString( pass ) ), true ) )



	}
	else
	{

			if ( !IsLobby() && IsPersistenceAvailable() ) 
			{
				entity player = FromEHI( playerEHI )
				Assert( player == GetLocalClientPlayer() )
				return player.GetPersistentVarAsInt( format( "battlePasses[%s].cachedPurchasedXP", ItemFlavor_GetGUIDString( pass ) ))
			}


		return GetPlayerBattlePassPurchasedLevels( playerEHI, pass ) * GetXPToCompleteBPLevel( pass )
	}

	unreachable
}





int function GetPlayerBattlePassEarnedXP( EHI playerEHI, ItemFlavor pass, bool getPreviousProgress = false )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

		Assert( playerEHI == LocalClientEHI() )


#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return 0
#endif

	
	if ( getPreviousProgress )
	{
		return PlayerPass_GetLastSeenProgress( FromEHI( playerEHI ), pass, ePassLastSeenType.LOBBY )
	}


	if ( getPreviousProgress )
		 return expect int( GetDialogFlowTablesValueOrPersistence( format( "battlePasses[%s]." + PLAYER_PASSES_PDEF_LAST_SEEN_PVAR, ItemFlavor_GetGUIDString( pass ) ), true ) )

	return FromEHI( playerEHI ).GetPersistentVarAsInt( format( "battlePasses[%s].earnedXP", ItemFlavor_GetGUIDString( pass ) ) )



}




