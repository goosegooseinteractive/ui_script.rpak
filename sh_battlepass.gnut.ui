int function BattlePassV2_GetVisiblePassRewardsStartingPosition( entity player, ItemFlavor pass )
{
	int passType = BattlePass_GetType( pass )
	switch ( passType )
	{
		case ePassType.ACCOUNT:
			int currentAccountDisplayLevel	= GetPlayerAccountPassLevel( player ) + 1
			int maxVisibleLevels 	 		= BattlePassV2_GetMaxVisibleLevels( pass )
			int uncappedPageNum				= int( floor( float(currentAccountDisplayLevel) / float(maxVisibleLevels) ) )
			int maxPassLevel				= BattlePass_GetPassMaxLevelIndex( pass, passType )
			int maxPages					= int( floor( float(maxPassLevel) / float(maxVisibleLevels) ) )
			int page = minint( uncappedPageNum, maxPages )
			return page * maxVisibleLevels
		default:
			return 0
	}

	unreachable
}


int function BattlePassV2_GetCurrentSplit( ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	Assert( BattlePassV2_IsV2BattlePass( pass ) )
	string split = GetGlobalSettingsString( ItemFlavor_GetAsset( pass ), "currentSplit" )
	Assert( split.isnumeric(), format( "BP values for current split must be numeric; got a split value of '%s' for %s", split, ItemFlavor_GetHumanReadableRefForPIN_Slow( pass ) ) )
	return int( split )
}


