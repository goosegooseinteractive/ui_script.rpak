bool function CheckForBattlePassRewardPlaylistOverrides( BattlePassReward reward, ItemFlavor pass, int levelIndex )
{
	Assert( reward.bpRewardTier != eBattlePassV2RewardTier.UNSPECIFIED, "BattlePassReward was not fully initialized before checking for a playlist override" )

	bool didOverride = false

	

	
	
	int itemOverrideQty = GetCurrentPlaylistVarInt( format( "battlepass_%s_level_%d_tier_%d_itemguid_%s_override_qty", ItemFlavor_GetGUIDString( pass ), levelIndex, reward.bpRewardTier, ItemFlavor_GetGUIDString( reward.flav ) ), -1 )
	if ( itemOverrideQty != -1 )
	{
		reward.quantity = itemOverrideQty
		didOverride = true
	}

	
	
	string itemOverrideRefGUIDString = GetCurrentPlaylistVarString( format( "battlepass_%s_level_%d_tier_%d_itemguid_%s_override_ref", ItemFlavor_GetGUIDString( pass ), levelIndex, reward.bpRewardTier, ItemFlavor_GetGUIDString( reward.flav ) ), "" )
	if ( itemOverrideRefGUIDString != "" )
	{
		reward.flav = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( itemOverrideRefGUIDString ) )
		didOverride = true
	}

	return didOverride
}



array<BattlePassReward> function GetBattlePassV2Rewards( ItemFlavor pass, int levelIndex, int rewardTierTarget, entity player = null, bool allRewards = false, int allRewardsMinimumLevel = -1, int allRewardsMinimumTier = eBattlePassV2RewardTier.FREE, bool isAccountLevel = false )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	Assert( levelIndex >= 0, "Level must be >= 0" )

	bool isV2Pass = BattlePassV2_IsV2BattlePass( pass )
	if ( !isV2Pass )
	{
		Assert( rewardTierTarget == eBattlePassV2RewardTier.FREE || rewardTierTarget == eBattlePassV2RewardTier.PREMIUM, "Only FREE & PREMIUM tiers are supported on V1 assets." )
	}
	else
	{
		Assert( GetEnumString( "eBattlePassV2RewardTier", rewardTierTarget ) in eBattlePassV2RewardTier )
	}

	if ( ItemFlavor_GetType( pass ) != eItemType.battlepass || levelIndex < 0)
		return []

	var scheduleDT = isV2Pass ? BattlePassV2_GetScheduleDatatable( pass ) : BattlePass_GetScheduleDatatable( pass )

	array<BattlePassReward> rewardList = []

	int rowIndex = 0;
	int currentLevel = 0;

	int numRows = GetDataTableRowCount( scheduleDT )

	if ( isAccountLevel )
	{
		levelIndex++
		int lastRewardIndex = GetDataTableInt( scheduleDT, numRows - 1, GetDataTableColumnByName( scheduleDT, "levelIndex" ) )
		if ( levelIndex > lastRewardIndex )
			levelIndex = lastRewardIndex
	}

	while ( rowIndex < numRows )
	{
		
		asset rewardAsset 	= GetDataTableAsset( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "reward" ) )
		int rewardQty 		= GetDataTableInt( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "rewardQty" ) )
		currentLevel		= GetDataTableInt( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "levelIndex" ) )
		bool premium 	  	= GetDataTableBool( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "premium" ) )

		
		int rewardTier 		= isV2Pass ? GetDataTableInt( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "rewardTier" ) ) : eBattlePassV2RewardTier.UNSPECIFIED
		bool isChaseReward 	= isV2Pass ? GetDataTableBool( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "isChaseReward" ) ) : false

		
		if ( rewardTier == eBattlePassV2RewardTier.UNSPECIFIED )
		{
			
			
			rewardTier = premium ? eBattlePassV2RewardTier.PREMIUM : eBattlePassV2RewardTier.FREE
		}

		if ( currentLevel < levelIndex && !allRewards )
		{
			rowIndex += 1
			continue
		}

		if ( currentLevel < allRewardsMinimumLevel && allRewards  )
		{
			rowIndex += 1
			continue
		}

		if ( currentLevel > levelIndex )
			break

		if ( rewardTierTarget == rewardTier || ( allRewards && rewardTier <= rewardTierTarget && rewardTier >= allRewardsMinimumTier ) )
		{
			if ( rewardAsset != $"" )
			{
				if ( IsValidItemFlavorSettingsAsset( rewardAsset ) )
				{
					BattlePassReward reward

					reward.flav = GetItemFlavorByAsset( rewardAsset )
					reward.quantity = rewardQty
					reward.level = levelIndex
					reward.isPremium = premium
					reward.bpRewardTier = rewardTier
					reward.isChaseReward = isChaseReward
					CheckForBattlePassRewardPlaylistOverrides( reward, pass, levelIndex )

					SubstituteBattlePassRewardsForUserRestrictions( player, reward )

					rewardList.append( reward )
				}
			}
		}

		rowIndex++
	}

	return rewardList
}



array<BattlePassReward> function GetBattlePassPremiumRewards( ItemFlavor pass, int levelIndex, entity player = null )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	Assert( levelIndex >= 0, "Level must be >= 0" )

	if ( ItemFlavor_GetType( pass ) != eItemType.battlepass || levelIndex < 0)
		return []

	var scheduleDT = BattlePass_GetScheduleDatatable( pass )

	array<BattlePassReward> rewardList = []

	int rowIndex = 0;
	int currentLevel = 0;

	int numRows = GetDataTableRowCount( scheduleDT )

	while ( rowIndex < numRows )
	{
		asset rewardAsset = GetDataTableAsset( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "reward" ) )
		int rewardQty     = GetDataTableInt( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "rewardQty" ) )
		bool premium 	  = GetDataTableBool( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "premium" ) )
		currentLevel	  = GetDataTableInt( scheduleDT, rowIndex, GetDataTableColumnByName( scheduleDT, "levelIndex" ) )

		if ( currentLevel > levelIndex )
			break

		if ( premium )
		{
			if ( rewardAsset != $"" )
			{
				if ( IsValidItemFlavorSettingsAsset( rewardAsset ) )
				{
					BattlePassReward reward

					reward.flav = GetItemFlavorByAsset( rewardAsset )
					reward.quantity = rewardQty
					reward.bpRewardTier = eBattlePassV2RewardTier.PREMIUM
					reward.level = levelIndex
					reward.isPremium = premium
					CheckForBattlePassRewardPlaylistOverrides( reward, pass, levelIndex )

					SubstituteBattlePassRewardsForUserRestrictions( player, reward )

					rewardList.append( reward )
				}
			}
		}

		rowIndex++
	}

	return rewardList
}



BattlePassReward function ItemFlavorBagToBattlePassRewardByIndex( ItemFlavorBag bag, int index )
{
	BattlePassReward bpReward
	bpReward.flav = bag.flavors[ index ]
	bpReward.quantity = bag.quantities[ index ]
	return bpReward
}



void function SubstituteBattlePassRewardsForUserRestrictions( entity player, BattlePassReward reward )
{
	bool isFreeReward = ( !reward.isPremium && !reward.isUltimatePlus )
	Assert( reward.bpRewardTier != eBattlePassV2RewardTier.UNSPECIFIED )
	isFreeReward = isFreeReward && ( reward.bpRewardTier == eBattlePassV2RewardTier.FREE )

	if ( isFreeReward ) 
			return

	bool lootBoxesAllowed = !GRX_IsOfferRestricted( player )
	bool isRewardPackType = ( ItemFlavor_GetType( reward.flav ) == eItemType.account_pack )

	if ( !isRewardPackType )
	{
		return
	}

	if ( !lootBoxesAllowed )
	{
		switch ( ItemFlavor_GetAsset( reward.flav ) )
		{
			case $"settings/itemflav/pack/cosmetic_rare.rpak":
				reward.flav = GetItemFlavorByAsset( $"settings/itemflav/grx_currency/crafting.rpak" )
				reward.quantity = 30
				break

			case $"settings/itemflav/pack/cosmetic_epic.rpak":
				reward.flav = GetItemFlavorByAsset( $"settings/itemflav/grx_currency/crafting.rpak" )
				reward.quantity = 200
				break

			case $"settings/itemflav/pack/cosmetic_legendary.rpak":
				reward.flav = GetItemFlavorByAsset( $"settings/itemflav/grx_currency/crafting.rpak" )
				reward.quantity = 600
				break

			default:
				reward.flav = GetItemFlavorByAsset( $"settings/itemflav/grx_currency/crafting.rpak" )
				reward.quantity = 30
		}
	}
}




int function GetBattlePassXPEventValue( entity player, int xpType )
{
	ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( ToEHI( player ) )
	if ( activeBattlePass == null )
		return 0
	expect ItemFlavor(activeBattlePass)

#if DEV
		if ( DEV_ShouldIgnorePersistence() )
			return 0
#endif

	string pdefAmountKey = format( "battlePasses[%s].xp_match[%d]", ItemFlavor_GetGUIDString( activeBattlePass ), xpType )
	return player.GetPersistentVarAsInt( pdefAmountKey )
}




