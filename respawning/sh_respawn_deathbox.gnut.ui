bool function Respawn_FromDeathbox_Enabled()
{










	bool isEnabled = GetCurrentPlaylistVarBool( "Respawn_FromDeathbox_Enabled", false )
	return isEnabled
}









































































































































































































































































































































































































































































































































































































































































































































































































































































