void function DEV_DBRespawn_Lockout_Enabled( bool isOn )
{
	tuning.respawnLockout_Enabled = isOn
}

void function DEV_DBRespawn_RespawnedPresentation_Enabled( bool isOn )
{
	tuning.respawnedPresentation_Enabled = isOn
}

void function DEV_DBRespawn_RespawnedPresentation_Parms( float duration_Loop = 4.0,
															float duration_Spawn = 1.5,
															float fOVOffset_Start = 30.0,
															float fOVOffset_End = -30.0,
															float camOffset_Y = -50.0,
															float camOffset_Z = 75.0  )
{
	tuning.respawnedPresentation_Duration_Incoming 	= duration_Loop
	tuning.respawnedPresentation_Duration_Spawn 	= duration_Spawn
	tuning.respawnedPresentation_FOVOffset_Start	= fOVOffset_Start
	tuning.respawnedPresentation_FOVOffset_End	= fOVOffset_End
	tuning.respawnedPresentation_CamOffset_Y	= camOffset_Y
	tuning.respawnedPresentation_CamOffset_Z	= camOffset_Z
}

#endif

                              