void function DEV_Newness_DumpSparseList()
{
	entity player = GetLocalClientPlayer()
	int sparseListSize = PersistenceGetArrayCount( "newItemFlavorSparseList" )
	int numValidSpareListEntries = 0

	printt("--- DEBUG_NEW: BEGIN PRINTING NEWNESS SPARSE LIST --- ")

	for ( int sparseListSlotIndex = 0; sparseListSlotIndex < sparseListSize; sparseListSlotIndex++ )
	{
		SettingsAssetGUID storedGuid = player.GetPersistentVarAsInt( "newItemFlavorSparseList[" + sparseListSlotIndex + "]" )

		if ( storedGuid == 0 )
			continue 

		ItemFlavor ornull flavor = GetItemFlavorOrNullByGUID( storedGuid )

		if ( flavor != null )
		{
			++numValidSpareListEntries
			expect ItemFlavor( flavor )

			printt( "DEBUG_NEW: sparse list itemFlav = " +  ItemFlavor_GetAssetName( flavor ) )

			array<LoadoutEntry> slots = GetAppropriateLoadoutSlotsForItemFlavor( flavor )
			foreach( slot in slots )
			{
				printt( "\tDEBUG_NEW: IsItemFlavorUnlockedForLoadoutSlot = " + IsItemFlavorUnlockedForLoadoutSlot( ToEHI(player), slot, flavor ) + ", slot =  " + slot.id )
			}
		}
		else
		{
			printt( "DEBUG_NEW: sparse list itemFlav is null" )
		}
	}

	printt("\tDEBUG_NEW: Total number of valid sparse list entries = " + numValidSpareListEntries )

	printt("--- DEBUG_NEW: END PRINTING NEWNESS SPARSE LIST --- ")
}

void function DEV_Newness_PrintNewItemFlavorSet()
{
	printt("--- DEBUG_NEW: BEGIN PRINTING NEW ITEMFLAVOR SET --- ")

	foreach ( ItemFlavor itemFlav, bool isSet in fileLevel.newItemFlavorSet )
	{
		string assetName = ItemFlavor_GetAssetName( itemFlav )
		printt("\tDEBUG_NEW: new set itemflav = " + assetName )
	}

	printt("--- DEBUG_NEW: END PRINTING NEW ITEMLFAVOR SET --- ")
}

