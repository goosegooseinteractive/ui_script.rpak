const string PVAR_MATCH_MODIFIERS_DT_OVERRIDE = "_match_modifiers_dt_override_"

global const string MATCH_MODIFIERS_NO_MODIFIER = "matchmod_none"


global const string MATCHMOD_ACTIVE_STATE_NETVAR = "matchModActiveState"
global const int MATCHMOD_ACTIVE_STATE_NONE = 255
global const int MATCHMOD_ACTIVE_STATE_REMOVAL_ROUND_BIAS = 1
const string MATCHMOD_NETVAR_STAGE_MAP_0 = "matchModRoundMapping0"
const string MATCHMOD_NETVAR_STAGE_MAP_1 = "matchModRoundMapping1"
const string MATCHMOD_NETVAR_NESTED_STATE_0 = "matchModNestedState0"
const string MATCHMOD_NETVAR_NESTED_STATE_1 = "matchModNestedState1"
const int MATCHMOD_NESTED_STATE_BITS_PER_NETVAR = 32
const int MATCHMOD_NESTED_STATE_NETVAR_COUNT = 2


const asset MATCH_MODIFIERS_ASSET_DEFINITIONS = $"datatable/match_modifiers/match_modifiers.rpak"

global struct MatchModifierActionData
{
	int    modifier
	string params
}

global struct MatchModifierData
{
	string ref
	int    index

	MatchModifierActionData & action

	string name
	string description
	string author
	string flavor
	asset  image = $""
	asset  background = $""
	string activationSound
	string deactivationSound
}

global struct MatchModifierSettings
{
	
	void functionref (MatchModifierData) Init



















}

#if DEV
global function DEV_GetAllMatchModifierDefinitions
global function DEV_LoadMatchModifierDefinitions

global struct DEV_UI_MatchModifierDefinition
{
	string matchModRef = ""
	string displayName = "#NOT_SET_UP"
}
