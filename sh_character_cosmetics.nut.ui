void function RegisterCustomSelectsForCharacter( ItemFlavor characterClass )
{
	array<ItemFlavor> selectsList = RegisterReferencedItemFlavorsFromArray( characterClass, "characterSelects", "flavor" )

	MakeItemFlavorSet( selectsList, fileLevel.cosmeticFlavorSortOrdinalMap, true )

	LoadoutEntry entry = RegisterLoadoutSlot( eLoadoutEntryType.ITEM_FLAVOR, "character_select_for_" + ItemFlavor_GetGUIDString( characterClass ), eLoadoutEntryClass.CHARACTER )
	entry.category     = eLoadoutCategory.CHARACTER_SELECTS
#if DEV
		entry.pdefSectionKey = "character " + ItemFlavor_GetGUIDString( characterClass )
		entry.DEV_name       = ItemFlavor_GetCharacterRef( characterClass ) + " Select"
#endif
	entry.defaultItemFlavor         = selectsList[0]
	entry.validItemFlavorList       = selectsList
	entry.isSlotLocked              = bool function( EHI playerEHI ) {
		return !IsLobby()
	}
	entry.isItemFlavorUnlocked      = (bool function( EHI playerEHI, ItemFlavor characterSelect, bool shouldIgnoreGRX = false, bool shouldIgnoreOtherSlots = false ) {
		if( CharacterSelect_IsLockedToOPSkin( characterSelect ) )
			return false

		return IsItemFlavorGRXUnlockedForLoadoutSlot( playerEHI, characterSelect, shouldIgnoreGRX, shouldIgnoreOtherSlots )
	})
	entry.associatedCharacterOrNull = characterClass
	entry.networkTo                 = eLoadoutNetworking.PLAYER_GLOBAL
	entry.networkVarName            = "CharacterSelect"
	fileLevel.loadoutCharacterCustomSelectSlotMap[characterClass] <- entry
}


asset function CharacterSelect_GetOPSkinVideo( ItemFlavor characterSelect, ItemFlavor characterSkin )
{
	Assert( ItemFlavor_GetType( characterSelect ) == eItemType.character_select )
	Assert( ItemFlavor_GetType( characterSkin ) == eItemType.character_skin )
	Assert( CharacterSelect_IsLockedToOPSkin( characterSelect ) )

	foreach ( var skinBlock in IterateSettingsAssetArray( ItemFlavor_GetAsset( characterSelect ), "opSkins" ) )
	{
		asset skinAsset = GetSettingsBlockAsset( skinBlock, "flavor" )
		if ( IsValidItemFlavorSettingsAsset( skinAsset ) )
		{
			ItemFlavor skinFlavor = GetItemFlavorByAsset( skinAsset )
			if ( skinFlavor == characterSkin )
			{
				return GetSettingsBlockStringAsAsset( skinBlock, "video" )
			}
		}
	}

	return $""
}

