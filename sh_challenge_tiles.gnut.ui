	void function ChallengeTile_PrintTiles()
	{
		printf( "%s: %i tiles \n", FUNC_NAME(), file.activeTiles.len() )
		foreach( tile in file.activeTiles )
		{
			ChallengeTile_PrintTile( tile )
		}

	}
