float function CharSelect_GetOutroAllSquadsPresentDuration() {
	if( CharSelect_GetAllSquadIntroEnabled() )
		return GetCurrentPlaylistVarFloat( "charselect_outro_all_squads_present_duration", 0.0 )

	return 0
}


float function CharSelect_GetSquad3dPresentationDuration() {
	if( CharSelect_GetSquad3dPresentationEnabled() )
		return ( MAX_TEAM_PLAYERS ) * GetCurrentPlaylistVarFloat( "charselect_outro_squad_3d_present_duration", CHARACTER_SELECT_3D_SQUAD_TIME )

	return 0
}


bool function Survival_AbilitiesEnabled()
{
	return GetCurrentPlaylistVarBool( "survival_abilities_enabled", true )
}

float function CharSelect_GetOutroSquadPresentDuration() {
	if( CharSelect_GetSquadIntroEnabled() )
		return GetCurrentPlaylistVarFloat( "charselect_outro_squad_present_duration", 6.0  )

	return 0
}

float function CharSelect_GetOutroMVPPresentDuration() {
	if( CharSelect_GetMVPGladCardEnabled() )
		return GetCurrentPlaylistVarFloat( "charselect_outro_mvp_present_duration", 0.0 )

	return 0
}

float function CharSelect_GetOutroChampionPresentDuration()	{
	if( CharSelect_GetGladiatorCardsEnabled() )
		return GetCurrentPlaylistVarFloat( "charselect_outro_champion_present_duration", 8.0 )

	return 0
}

bool function Survival_HasInitialJumpmaster()
{
	
	

	bool planeEnabled = GetCurrentPlaylistVarBool( "jump_from_plane_enabled", true )
	planeEnabled = planeEnabled && !IsTestMap()


		bool forcedSpawnEnabled = GetCurrentPlaylistVarInt( "forced_spawn_mode", 0 ) != 0
		planeEnabled = planeEnabled && !forcedSpawnEnabled


	if ( planeEnabled )
		return true

	if ( GetCurrentPlaylistVarBool( "poiplayerspawning_exists", false ) )
		return false







		if ( forcedSpawnEnabled )
			return GetCurrentPlaylistVarBool( "forced_spawn_use_jumpmaster", false )


	return false
}




























































































































































