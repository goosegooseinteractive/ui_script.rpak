void function GameMode_AboutDialog_AppendMantleBoostTab( array<featureTutorialTab> tabs )
{
	if ( GetPlaylistVarBool( FeatureTutorialDialog_GetPlaylistName(), "mantleboost_modal_info", false ) )
	{
		featureTutorialTab tab
		array< featureTutorialData > tabRules

		tab.tabName = "#ABOUT_MANTLE_BOOST_TITLE"
		tabRules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#ABOUT_MANTLE_BOOST_1_HEADER", "#ABOUT_MANTLE_BOOST_1_BODY", $"rui/menu/mantle_boost/about_mantle_boost_at_the_ledge" ) )
		tabRules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#ABOUT_MANTLE_BOOST_2_HEADER", "#ABOUT_MANTLE_BOOST_2_BODY", $"rui/menu/mantle_boost/about_mantle_boost_hit_boost" ) )
		tabRules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#ABOUT_MANTLE_BOOST_3_HEADER", "#ABOUT_MANTLE_BOOST_3_BODY", $"rui/menu/mantle_boost/about_mantle_boost_ui_feedback" ) )

		tab.rules = tabRules
		tabs.append( tab )
	}
}


