global const string WEAPON_STAT_CATEGORY_CRATE_WEAPON = "crate_unique"
global const string WEAPON_STAT_CATEGORY_ORDNANCE = "ordnance"






struct FileStruct_LifetimeLevel
{
	table<string, ItemFlavor> weaponClassnameItemFlavorMap
}
FileStruct_LifetimeLevel& fileLevel







void function ShWeapons_LevelInit()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel









	AddCallback_RegisterRootItemFlavors( void function() {
		foreach ( asset weaponAsset in GetBaseItemFlavorsFromArray( "weapons" ) )
			RegisterItemFlavorFromSettingsAsset( weaponAsset )

		foreach ( asset categoryAsset in GetBaseItemFlavorsFromArray( "weaponCategories" ) )
			RegisterItemFlavorFromSettingsAsset( categoryAsset )
	} )
	AddCallback_OnItemFlavorRegistered( eItemType.loot_main_weapon, OnItemFlavorRegistered_WeaponItemFlavor )
}




void function OnItemFlavorRegistered_WeaponItemFlavor( ItemFlavor weaponFlavor )
{
	string classname = WeaponItemFlavor_GetClassname( weaponFlavor )
	fileLevel.weaponClassnameItemFlavorMap[classname] <- weaponFlavor

	RegisterWeaponForUse( classname )

	foreach ( string childClassname in WeaponItemFlavor_GetChildClassNames( weaponFlavor ) )
	{
		fileLevel.weaponClassnameItemFlavorMap[childClassname] <- weaponFlavor
		RegisterWeaponForUse( childClassname )
	}
}



void function RegisterWeaponForUse( string weaponClassname )
{




}







string function WeaponItemFlavor_GetClassname( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

	return GetGlobalSettingsString( ItemFlavor_GetAsset( weapon ), "entityClassname" )
}

string function WeaponItemFlavor_GetResolvedClassname( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )


		if ( WeaponItemFlavor_HasTakeover( weapon ) )
		{
			string takeoverClassname = WeaponItemFlavor_GetTakeoverClassname( weapon )
			if ( takeoverClassname != "" )
				return takeoverClassname
		}


	return GetGlobalSettingsString( ItemFlavor_GetAsset( weapon ), "entityClassname" )
}

array<string> function WeaponItemFlavor_GetChildClassNames( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

	array<string> childNames;
	var childSettingsArray = GetSettingsBlockArray( GetSettingsBlockForAsset( ItemFlavor_GetAsset( weapon ) ), "childClassnames" )

	foreach ( var childBlock in IterateSettingsArray( childSettingsArray ) )
	{
		string childClassname = GetSettingsBlockString( childBlock, "childClassname" )

		if ( childClassname != "" )
		{
			childNames.append( childClassname )
		}
	}

	return childNames
}

ItemFlavor ornull function GetWeaponItemFlavorByClass( string classname )
{
	if ( classname in fileLevel.weaponClassnameItemFlavorMap )
		return fileLevel.weaponClassnameItemFlavorMap[classname]

	return null
}


ItemFlavor function WeaponItemFlavor_GetCategory( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

	return GetItemFlavorByAsset( GetGlobalSettingsAsset( ItemFlavor_GetAsset( weapon ), "category" ) )
}


string function WeaponItemFlavor_GetLongName( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

		if ( WeaponItemFlavor_HasTakeover( weapon ) )
		{
			string weaponName = WeaponItemFlavor_GetTakeoverLongName( weapon )
			if ( weaponName != "" )
				return weaponName
		}


	return ItemFlavor_GetLongName( weapon )
}


string function WeaponItemFlavor_GetStatsCategory( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

	return GetGlobalSettingsString( ItemFlavor_GetAsset( weapon ), "statsCategory" )
}

array<int> function WeaponItemFlavor_GetAmmoTypes( ItemFlavor weapon )
{
	Assert( ItemFlavor_GetType( weapon ) == eItemType.loot_main_weapon )

	array<int> ammoTypes

	var ammoTypeSettingsArray = GetSettingsBlockArray( GetSettingsBlockForAsset( ItemFlavor_GetAsset( weapon ) ), "ammoTypes" )

	foreach ( var ammoTypeBlock in IterateSettingsArray( ammoTypeSettingsArray ) )
	{
		string ammoTypeName = GetSettingsBlockString( ammoTypeBlock, "ammoType" )

		if ( ammoTypeName != "" )
		{
			ammoTypes.append( eAmmoPoolType[ammoTypeName] )
		}
	}

	return ammoTypes
}

LightData function WeaponItemFlavor_GetMenuCustomLightData( ItemFlavor flavor )
{





	asset lightingAsset = GetGlobalSettingsAsset( ItemFlavor_GetAsset( flavor ), "customLightingDef" )

	LightData data
	if( lightingAsset == $"" )
		return data

	data.key_color =          GetGlobalSettingsVector( lightingAsset, "colorKey" )
	data.key_brightness =     GetGlobalSettingsFloat( lightingAsset, "brightnessKey" )
	data.key_cone =           GetGlobalSettingsFloat( lightingAsset, "coneKey" )
	data.key_innercone =      GetGlobalSettingsFloat( lightingAsset, "innerConeKey" )
	data.key_distance =       GetGlobalSettingsFloat( lightingAsset, "distanceKey" )
	data.key_halfbrightfrac = GetGlobalSettingsFloat( lightingAsset, "halfBrightFracKey" )
	data.key_specint =        GetGlobalSettingsFloat( lightingAsset, "specIntKey" )
	data.key_pbrfalloff =     GetGlobalSettingsBool( lightingAsset, "pbrFalloffKey" )
	data.key_castshadows =    GetGlobalSettingsBool( lightingAsset, "castShadowsKey" )
	data.fill_color =         GetGlobalSettingsVector( lightingAsset, "colorFill" )
	data.fill_brightness =    GetGlobalSettingsFloat( lightingAsset, "brightnessFill" )
	data.fill_cone =          GetGlobalSettingsFloat( lightingAsset, "coneFill" )
	data.fill_innercone =     GetGlobalSettingsFloat( lightingAsset, "innerConeFill" )
	data.fill_distance =      GetGlobalSettingsFloat( lightingAsset, "distanceFill" )
	data.fill_halfbrightfrac =GetGlobalSettingsFloat( lightingAsset, "halfBrightFracFill" )
	data.fill_specint =       GetGlobalSettingsFloat( lightingAsset, "specIntFill" )
	data.fill_pbrfalloff =    GetGlobalSettingsBool( lightingAsset, "pbrFalloffFill" )
	data.fill_castshadows =   GetGlobalSettingsBool( lightingAsset, "castShadowsFill" )
	data.rimL_color =         GetGlobalSettingsVector( lightingAsset, "colorRimL" )
	data.rimL_brightness =    GetGlobalSettingsFloat( lightingAsset, "brightnessRimL" )
	data.rimL_cone =          GetGlobalSettingsFloat( lightingAsset, "coneRimL" )
	data.rimL_innercone =     GetGlobalSettingsFloat( lightingAsset, "innerConeRimL" )
	data.rimL_distance =      GetGlobalSettingsFloat( lightingAsset, "distanceRimL" )
	data.rimL_halfbrightfrac =GetGlobalSettingsFloat( lightingAsset, "halfBrightFracRimL" )
	data.rimL_specint =       GetGlobalSettingsFloat( lightingAsset, "specIntRimL" )
	data.rimL_pbrfalloff =    GetGlobalSettingsBool( lightingAsset, "pbrFalloffRimL" )
	data.rimL_castshadows =   GetGlobalSettingsBool( lightingAsset, "castShadowsRimL" )
	data.rimR_color =         GetGlobalSettingsVector( lightingAsset, "colorRimR" )
	data.rimR_brightness =    GetGlobalSettingsFloat( lightingAsset, "brightnessRimR" )
	data.rimR_cone =          GetGlobalSettingsFloat( lightingAsset, "coneRimR" )
	data.rimR_innercone =     GetGlobalSettingsFloat( lightingAsset, "innerConeRimR" )
	data.rimR_distance =      GetGlobalSettingsFloat( lightingAsset, "distanceRimR" )
	data.rimR_halfbrightfrac =GetGlobalSettingsFloat( lightingAsset, "halfBrightFracRimR" )
	data.rimR_specint =       GetGlobalSettingsFloat( lightingAsset, "specIntRimR" )
	data.rimR_pbrfalloff =    GetGlobalSettingsBool( lightingAsset, "pbrFalloffRimR" )
	data.rimR_castshadows =   GetGlobalSettingsBool( lightingAsset, "castShadowsRimR" )
	data.animSeq =            GetGlobalSettingsAsset( lightingAsset, "animSeq" )
	data.initialized = 		  true

	return data
}


