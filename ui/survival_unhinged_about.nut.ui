

global function SurvivalUnhinged_PopulateAboutText
global function SurvivalUnhinged_AppendAboutText


array< featureTutorialTab > function SurvivalUnhinged_PopulateAboutText()
{
	array< featureTutorialTab > tabs

		SurvivalUnhinged_BatEvent_AppendAboutText( tabs )





		SurvivalUnhinged_FlatlineEvent_AppendAboutText( tabs )




	SurvivalUnhinged_HolidayEvent_AppendAboutText( tabs )




		SurvivalUnhinged_BeamstickEvent_AppendAboutText( tabs )





		SurvivalUnhinged_ClockupEvent_AppendAboutText( tabs )


		SurvivalUnhinged_MatchModfiersEvent_AppendAboutText( tabs )


		SurvivalUnhinged_WildHuntEvent_AppendAboutText( tabs )







	SurvivalUnhinged_AppendAboutText( tabs )
	return tabs
}

void function SurvivalUnhinged_AppendAboutText( array<featureTutorialTab> tabs )
{
	featureTutorialTab tab1
	array< featureTutorialData > tab1Rules

	
	tab1.tabName = "#PL_UNHINGED"

	if ( GetPlaylistVarBool( FeatureTutorialDialog_GetPlaylistName(), "endorsements_enable", false ) )
	{
		tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_WILDCARDS_HEADER_2", "#UNHINGED_ABOUT_WILDCARDS_DESC_2", $"rui/about_images/unhinged/about_unhinged_wild_cards" ) )

		tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_HEADER_2", "#UNHINGED_ABOUT_DESC_2", $"rui/about_images/unhinged/about_unhinged_1" ) )
	}

	int respawnsEndOnRound = GetPlaylistVarInt( FeatureTutorialDialog_GetPlaylistName(), "freespawns_endround_onclose", 4 ) + 1
	string aboutTextRespawning = Localize( "#UNHINGED_ABOUT_DESC_1", respawnsEndOnRound )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_HEADER_1", aboutTextRespawning, $"rui/about_images/unhinged/about_unhinged_3" ) )

	tab1.rules = tab1Rules
	tabs.append( tab1 )

	GameMode_AboutDialog_AppendDefaultGamemodeFeatureTabs( tabs )
}


void function SurvivalUnhinged_BatEvent_AppendAboutText( array<featureTutorialTab> tabs )
{
	if ( !GetPlaylistVarBool( FeatureTutorialDialog_GetPlaylistName(), "bat_event_about_text_enabled", false ) )
		return

	featureTutorialTab tab1
	array< featureTutorialData > tab1Rules

	
	tab1.tabName = "#UNHINGED_ABOUT_BAT_EVENT_TITLE"

		tab1Rules = SurvivalUnhinged_Endorsements_AppendAboutText( tab1Rules )

	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_BAT_HEADER_3", "#UNHINGED_ABOUT_BAT_DESC_3", $"rui/about_images/unhinged/about_unhinged_event_bat" ) )

	tab1.rules = tab1Rules
	tabs.append( tab1 )
}



array< featureTutorialData > function SurvivalUnhinged_Endorsements_AppendAboutText( array< featureTutorialData > eventTab )
{
	if ( !GetPlaylistVarBool( FeatureTutorialDialog_GetPlaylistName(), "endorsements_enable", false ) )
		return eventTab

	eventTab.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_WILDCARDS_HEADER_1", "#UNHINGED_ABOUT_WILDCARDS_DESC_1", $"rui/about_images/unhinged/about_unhinged_replicators" ) )
	eventTab.append( UI_FeatureTutorialDialog_BuildDetailsData( "#UNHINGED_ABOUT_WILDCARDS_HEADER_2", "#UNHINGED_ABOUT_WILDCARDS_DESC_2", $"rui/about_images/unhinged/about_unhinged_wild_cards" ) )

	return eventTab
}























