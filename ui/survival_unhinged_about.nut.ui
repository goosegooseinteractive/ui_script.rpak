void function SurvivalUnhinged_BeamstickEvent_AppendAboutText( array<featureTutorialTab> tabs )
{
	if ( !GetPlaylistVarBool( FeatureTutorialDialog_GetPlaylistName(), "beamstick_event_about_text_enabled", false ) )
		return

	featureTutorialTab tab1
	array< featureTutorialData > tab1Rules

	bool onController = IsControllerModeActive()
	string body02DisplayString = onController ? "#BEAMSTICK_ABOUT_BODY_02_CONTROLLER" : "#BEAMSTICK_ABOUT_BODY_02"
	string body03DisplayString = onController ? "#BEAMSTICK_ABOUT_BODY_03_CONTROLLER" : "#BEAMSTICK_ABOUT_BODY_03"

	
	tab1.tabName = "#BEAMSTICK_ABOUT_TAB_NAME"
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#BEAMSTICK_ABOUT_HEADER_01", "#BEAMSTICK_ABOUT_BODY_01", $"rui/about_images/unhinged/about_unhinged_beamstick_1" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#BEAMSTICK_ABOUT_HEADER_02", body02DisplayString, $"rui/about_images/unhinged/about_unhinged_beamstick_2" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#BEAMSTICK_ABOUT_HEADER_03", body03DisplayString, $"rui/about_images/unhinged/about_unhinged_beamstick_3" ) )

	tab1.rules = tab1Rules
	tabs.append( tab1 )
}

























