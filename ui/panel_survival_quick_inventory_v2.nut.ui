void function ClientCallback_StartEquipmentExtendedUse( var button, float duration, int actionType, bool shouldStartExtendedUse, bool hasSling, int reasonToNotStartExtendedUse )
{
	if ( shouldStartExtendedUse )
	{
		thread StartEquipmentExtendedUse( button, duration, actionType )
	}

	if( hasSling )
		thread EquipmentSlingDecorations( button, duration, actionType, shouldStartExtendedUse, reasonToNotStartExtendedUse )
}

void function StartEquipmentExtendedUse( var button, float duration, int actionType )
{
	Signal( uiGlobal.signalDummy, "StartEquipmentExtendedUse" )
	EndSignal( uiGlobal.signalDummy, "StartEquipmentExtendedUse" )

	var elem = file.holdToUseElem
	Hud_Show( elem )
	HideGameCursor()

	file.isSwappingWeapons = true

	var rui = Hud_GetRui( elem )
	RuiSetBool( rui, "isVisible", true )
	RuiSetGameTime( rui, "startTime", ClientTime() )
	RuiSetFloat( rui, "duration", duration )
	RuiSetString( rui, "holdButtonHint", SURVIVAL_GetButtonStringForLootActionType( actionType, true ) )
	float uiEndTime = UITime() + duration

	EmitUISound( "UI_Survival_PickupTicker" )

	OnThreadEnd(
		function() : ( rui, elem )
		{
			ShowGameCursor()
			Hud_Hide( elem )
			RuiSetBool( rui, "isVisible", false )
			StopUISound( "UI_Survival_PickupTicker" )
			file.isSwappingWeapons = false
		}
	)

	bool isButtonFocused = GetMouseFocus() == button || ( GetDpadNavigationActive() && Hud_IsFocused( button ) )
	while ( IsLootActionTypeButtonDown( actionType ) && UITime() < uiEndTime && isButtonFocused )
	{
		vector screenPos = ConvertCursorToScreenPos()
		Hud_SetPos( elem, screenPos.x - Hud_GetWidth( elem ) * 0.5, screenPos.y - Hud_GetHeight( elem ) * 0.5 )
		WaitFrame()
	}

	if ( UITime() < uiEndTime )
		return

	if ( IsLobby() )
		return

	EmitUISound( "ui_menu_store_purchase_success" )

	if ( IsFullyConnected() )
		RunClientScript( "UICallback_OnEquipmentButtonAction", button, actionType, true )
}

void function EquipmentSlingDecorations( var button, float duration, int actionType, bool shouldStartSlingAction, int reasonToNotStartExtendedUse )
{
	Signal( uiGlobal.signalDummy, "EquipmentSlingDecorations" )
	EndSignal( uiGlobal.signalDummy, "EquipmentSlingDecorations" )

	var slingDecorationsRui = Hud_GetRui( Hud_GetChild( file.mainInventoryPanel, "SlingDecorations" ) )
	if( slingDecorationsRui == null )
		return

	OnThreadEnd(
		function() : ( slingDecorationsRui )
		{
			if( CanRunClientScript() )
				RunClientScript( "EquipmentButton_SlingWarningMessage", false )

			RuiSetBool( slingDecorationsRui, "highlightLeftConnector", false )
			RuiSetBool( slingDecorationsRui, "highlightRightConnector", false )
			RuiSetBool( slingDecorationsRui, "isNonSwappableWeapon", false )
		}
	)

	float uiEndTime = UITime() + duration

	switch ( Hud_GetScriptID( button ) )
	{
		case "main_weapon0":
			if ( actionType == eLootActionType.CHARACTER_ACTION1 )
			{
				RuiSetBool( slingDecorationsRui, "highlightLeftConnector", true )
				RuiSetBool( slingDecorationsRui, "isNonSwappableWeapon", !shouldStartSlingAction )
				RunClientScript( "EquipmentButton_SlingWarningMessage", !shouldStartSlingAction, reasonToNotStartExtendedUse )
			}
			break
		case "main_weapon1":
			if ( actionType == eLootActionType.CHARACTER_ACTION1 )
			{
				RuiSetBool( slingDecorationsRui, "highlightRightConnector", true )
				RuiSetBool( slingDecorationsRui, "isNonSwappableWeapon", !shouldStartSlingAction )
				RunClientScript( "EquipmentButton_SlingWarningMessage", !shouldStartSlingAction, reasonToNotStartExtendedUse  )
			}
			break
		case "sling_weapon":
			if ( actionType == eLootActionType.CHARACTER_ACTION1 )
			{
				RuiSetBool( slingDecorationsRui, "highlightLeftConnector", true )
			}
			else if ( actionType == eLootActionType.CHARACTER_ACTION2 )
			{
				RuiSetBool( slingDecorationsRui, "highlightRightConnector", true )
			}

			RuiSetBool( slingDecorationsRui, "isNonSwappableWeapon", !shouldStartSlingAction )
			RunClientScript( "EquipmentButton_SlingWarningMessage", !shouldStartSlingAction, reasonToNotStartExtendedUse )
			break
	}

	bool isButtonFocused = GetMouseFocus() == button || ( GetDpadNavigationActive() && Hud_IsFocused( button ) )
	bool shouldHighlight = shouldStartSlingAction ? true : !file.isSwappingWeapons

	while ( IsLootActionTypeButtonDown( actionType ) && isButtonFocused && shouldHighlight )
	{
		WaitFrame()
	}

	if ( UITime() < uiEndTime )
		return
}

void function SurvivalInventoryMenu_SetEquipmentButtonFxState( string equipmentType, bool fxEnabled = false )
{
	if ( file.equipmentButtons.len() <= 0 )
		return

	var button = file.equipmentButtons[ equipmentType ]
	var buttonRui = Hud_GetRui( button )
	RuiSetBool( buttonRui, "showButtonFx", fxEnabled )
}

bool function IsLootActionTypeButtonDown( int actionType )
{
	switch( actionType )
	{
		case eLootActionType.ALT_ACTION:
			if( IsControllerModeActive() )
				return InputIsButtonDown( BUTTON_X )
			else
				return InputIsButtonDown( MOUSE_RIGHT )
			break

		case eLootActionType.PRIMARY_SWAP:
			int pcKeycode = GetKeyCodeForBinding( "+melee", 0 ) - 1
			if( IsControllerModeActive() )
				return InputIsButtonDown( BUTTON_SHOULDER_LEFT )
			else
				return InputIsButtonDown( pcKeycode )
			break

		case eLootActionType.CHARACTER_ACTION1:
			int pcKeycode = GetKeyCodeForBinding( "+offhand1", 0 ) - 1
			if( IsControllerModeActive() )
				return InputIsButtonDown( BUTTON_TRIGGER_LEFT )
			else
				return InputIsButtonDown( pcKeycode )
			break

		case eLootActionType.CHARACTER_ACTION2:
			int pcKeycode = GetKeyCodeForBinding( "+use", 0 ) - 1
			if( IsControllerModeActive() )
				return InputIsButtonDown( BUTTON_TRIGGER_RIGHT )
			else
				return InputIsButtonDown( pcKeycode )
			break
	}

	return false
}

void function UpdateArmorCoreEquipmentButtonPosition( string vguiButtonPanelLabel )
{
	bool setHudVisible = LegendUpgrades_IsEnabled()
	var rtkArmorCore = Hud_GetChild( file.mainInventoryPanel, "RTKArmorCore" )
	var backpackButton = Hud_GetChild( file.mainInventoryPanel, "Backpack" )
	var armorButton = Hud_GetChild( file.mainInventoryPanel, "Armor" )
	var buttonToSwapWith = Hud_GetChild( file.mainInventoryPanel, vguiButtonPanelLabel ) 
	var incapShieldButton = Hud_GetChild( file.mainInventoryPanel, "IncapShield" )
	var gadgetButton = Hud_GetChild( file.mainInventoryPanel, "GadgetSlot" )

	Hud_SetVisible( rtkArmorCore, setHudVisible )

	if ( !setHudVisible )
		return


	if ( Integrated_IncapShield_Enabled() )
	{
		Hud_SetPinSibling( buttonToSwapWith, "Backpack" )

		Hud_SetPinSibling( rtkArmorCore, "BackpackGrid" )
		Hud_SetPinCornerToSibling( rtkArmorCore, ePinCorners.TOP_LEFT )
		Hud_SetPinToSiblingCorner( rtkArmorCore, ePinCorners.BOTTOM_LEFT )

		Hud_SetPinSibling( armorButton, "RTKArmorCore" )
		Hud_SetPinCornerToSibling( armorButton, ePinCorners.RIGHT )
		Hud_SetPinToSiblingCorner( armorButton, ePinCorners.RIGHT )

		vector backpackPos = ScalePixelsForScreenSize( <0, 0, 0> )
		vector armorRTKPos = ScalePixelsForScreenSize( <60, 18, 0> )
		vector armorPos = ScalePixelsForScreenSize( <-28, 13, 0> )

#if SUPPORTS_COMPACT_UI
		if ( IsUsingCompactUILayout() )
		{
			armorPos = ScalePixelsForScreenSize( <-16, 17, 0> )
		}
#endif

		Hud_SetX( backpackButton, backpackPos.x )
		Hud_SetY( backpackButton, backpackPos.y )
		Hud_SetX( rtkArmorCore, armorRTKPos.x )
		Hud_SetY( rtkArmorCore, armorRTKPos.y )
		Hud_SetX( armorButton, armorPos.x )
		Hud_SetY( armorButton, armorPos.y )

		Hud_SetNavUp( armorButton, Hud_GetChild( file.inventoryGridStatic, "GridButton1x2" ) )
		Hud_SetNavDown( Hud_GetChild( file.inventoryGridStatic, "GridButton1x2" ), armorButton )
		Hud_SetNavRight( armorButton, buttonToSwapWith )

		Hud_SetNavDown( Hud_GetChild( file.inventoryGridStatic, "GridButton1x3" ), buttonToSwapWith )

		Hud_SetNavRight( buttonToSwapWith, backpackButton )
		Hud_SetNavUp( buttonToSwapWith, Hud_GetChild( file.inventoryGridStatic, "GridButton1x4" ) )
		Hud_SetNavDown( Hud_GetChild( file.inventoryGridStatic, "GridButton1x4" ), buttonToSwapWith )
		Hud_SetNavLeft( buttonToSwapWith, armorButton )

		Hud_SetNavUp( backpackButton, Hud_GetChild( file.inventoryGridStatic, "GridButton1x5" ) )
		Hud_SetNavDown( Hud_GetChild( file.inventoryGridStatic, "GridButton1x5" ), backpackButton )
		Hud_SetNavLeft( backpackButton, buttonToSwapWith )
	}
	else
	{
		Hud_SetPinSibling( buttonToSwapWith, "IncapShield" )
		Hud_SetPinSibling( armorButton, vguiButtonPanelLabel )

		Hud_SetX( armorButton, 86 )

		Hud_SetNavLeft( armorButton, null )
		Hud_SetNavRight( armorButton, buttonToSwapWith )
		Hud_SetNavUp( armorButton, Hud_GetChild( file.inventoryGridStatic, "GridButton1x1" ) )

		Hud_SetNavLeft( buttonToSwapWith, armorButton )
		Hud_SetNavRight( buttonToSwapWith, incapShieldButton )
		Hud_SetNavUp( buttonToSwapWith, Hud_GetChild( file.inventoryGridStatic, "GridButton1x2" ) )

		Hud_SetNavLeft( incapShieldButton, buttonToSwapWith )

		Hud_SetNavDown( Hud_GetChild( file.inventoryGridStatic, "GridButton1x2" ), buttonToSwapWith )
	}



















	setHudVisible = LegendUpgrades_ArmorTiedToUpgrades()
	Hud_SetVisible( rtkArmorCore, setHudVisible )
}


void function UpdateBackpackDpadNav()
{
	if ( !Hud_HasChild( file.inventoryGridStatic, "GridButton0x0" ) )
		return

	
	for ( int row = 0; row < GetInventoryRows(); row++ )
	{
		for ( int column = 0; column < GetInventoryColumns(); column++ )
		{
			var gridBtn = Hud_GetChild( file.inventoryGridStatic, GRID_BTN_PREFIX + row + "x" + column )

			GridButtonInfo btnUp = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.UP, true )
			Hud_SetNavUp( gridBtn, btnUp.button )

			GridButtonInfo btnDown = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.DOWN, true )
			Hud_SetNavDown( gridBtn, btnDown.button )

			if ( IsRTL() )
			{
				GridButtonInfo btnLeft = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.LEFT, true )
				Hud_SetNavRight( gridBtn, btnLeft.button )

				GridButtonInfo btnRight = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.RIGHT, true )
				Hud_SetNavLeft( gridBtn, btnRight.button )
			}
			else
			{
				GridButtonInfo btnLeft = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.LEFT, true )
				Hud_SetNavLeft( gridBtn, btnLeft.button )

				GridButtonInfo btnRight = GetNextValidGridButtonInDirection( file.inventoryGridStatic, row, column, eDirection.RIGHT, true )
				Hud_SetNavRight( gridBtn, btnRight.button )
			}
		}
	}

	var mainWeapon0Button = Hud_GetChild( file.mainInventoryPanel, "MainWeapon0" )
	var mainWeapon1Button = Hud_GetChild( file.mainInventoryPanel, "MainWeapon1" )

	
	var slingButton = Hud_GetChild( file.mainInventoryPanel, "SlingWeapon" )
	var slingOrMainWeapon0Button = Hud_IsVisible( slingButton ) ? slingButton : mainWeapon0Button
	for ( int column = 0; column < GetInventoryColumns(); column++ )
	{
		var gridBtn = Hud_GetChild( file.inventoryGridStatic, "GridButton0x" + column )
		Hud_SetNavUp( gridBtn, slingOrMainWeapon0Button )
	}

	
	
	var armorButton = Hud_GetChild( file.mainInventoryPanel, "Armor" )
	var helmetButton = Hud_GetChild( file.mainInventoryPanel, "Helmet" )
	var incapShieldButton = Hud_GetChild( file.mainInventoryPanel, "IncapShield" )
	var backpackButton = Hud_GetChild( file.mainInventoryPanel, "BackPack" )
	var gadgetSlot = Hud_GetChild( file.mainInventoryPanel, "GadgetSlot" )

	var gridButton1x0 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x0" )
	var gridButton1x1 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x1" )
	var gridButton1x2 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x2" )
	var gridButton1x3 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x3" )
	var gridButton1x4 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x4" )
	var gridButton1x5 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x5" )
	var gridButton1x6 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x6" )
	var gridButton1x7 = Hud_GetChild( file.inventoryGridStatic, "GridButton1x7" )

	
	if ( LegendUpgrades_IsEnabled() )
	{
		if ( IsButtonValidForNavigation( armorButton, null ) )
		{
			Hud_SetNavDown( gridButton1x0, armorButton )
			Hud_SetNavDown( gridButton1x1, armorButton )
		}

		if ( IsButtonValidForNavigation( helmetButton, null ) )
		{
			Hud_SetNavDown( gridButton1x2, helmetButton )
		}
	}
	else
	{
		if ( IsButtonValidForNavigation( helmetButton, null ) )
		{
			Hud_SetNavDown( gridButton1x0, helmetButton )
			Hud_SetNavDown( gridButton1x1, helmetButton )
		}

		if ( IsButtonValidForNavigation( armorButton, null ) )
		{
			Hud_SetNavDown( gridButton1x2, armorButton )
		}
	}

	
	if ( IsButtonValidForNavigation( incapShieldButton, null ) )
	{
		Hud_SetNavDown( gridButton1x3, incapShieldButton )
	}

	
	if ( IsButtonValidForNavigation( backpackButton, null ) )
	{
		Hud_SetNavDown( gridButton1x4, backpackButton )
		Hud_SetNavUp( backpackButton, IsButtonValidForNavigation( gridButton1x4, file.inventoryGridStatic ) ? gridButton1x4 : backpackButton )
	}

	bool dpadNavCompleteForButtonsNearEnd = false












	
	GridButtonInfo firstValidRow0ButtonInfo = GetNextValidGridButtonInDirection( file.inventoryGridStatic, 0, -1, eDirection.RIGHT, false ) 
	Hud_SetNavDown( slingButton, firstValidRow0ButtonInfo.button )


	
	Hud_SetNavDown( gridButton1x7, gadgetSlot )

	if ( !dpadNavCompleteForButtonsNearEnd && IsButtonValidForNavigation( gadgetSlot, null ) )
	{
		Hud_SetNavDown( gridButton1x5, gadgetSlot )
		Hud_SetNavDown( gridButton1x6, gadgetSlot )
		dpadNavCompleteForButtonsNearEnd = true
	}

	if ( IsButtonValidForNavigation( slingButton, null ) )
	{
		Hud_SetNavDown( mainWeapon0Button, slingButton )
		Hud_SetNavDown( mainWeapon1Button, slingButton )
	}
	else
	{
		Hud_SetNavDown( mainWeapon0Button, firstValidRow0ButtonInfo.button )
		Hud_SetNavDown( mainWeapon1Button, firstValidRow0ButtonInfo.button )
	}
}

void function UpdateInventoryDpadNav()
{
	UpdateBackpackDpadNav()


	UpdateGrenadeBackpackDpadNav()


	string swapButtonLabel = "Helmet"

		swapButtonLabel = "Augment_1"
		SurvivalQuickInventory_SetHudElementVisibility( "Helmet", false )



	if ( Integrated_IncapShield_Enabled () )
	{
		SurvivalQuickInventory_SetHudElementVisibility( "IncapShield", false )
	}


	UpdateArmorCoreEquipmentButtonPosition( swapButtonLabel )
}


GridButtonInfo function GetNextValidGridButtonInDirection( var grid, int startRow, int startCol, int direction, bool wrap )
{
	bool foundValidButton = false
	bool reachedEnd = false
	int currentRow = startRow
	int currentCol = startCol
	while ( !foundValidButton && !reachedEnd )
	{
		
		switch( direction )
		{
			case eDirection.LEFT:

				if ( currentCol <= 0 )
				{
					if ( wrap )
					{
						currentCol = GetInventoryColumns()
					}
					else
					{
						reachedEnd = true
					}
				}
				else
				{
					currentCol--
				}

				if ( currentCol == startCol )
				{
					reachedEnd = true
				}
				break

			case eDirection.RIGHT:
				if ( currentCol >= GetInventoryColumns() )
				{
					if ( wrap )
					{
						currentCol = 0
					}
					else
					{
						reachedEnd = true
					}
				}
				else
				{
					currentCol++
				}

				if ( currentCol == startCol )
				{
					reachedEnd = true
				}
				break

			case eDirection.UP:
				if ( currentRow <= 0 )
				{
					if ( wrap )
					{
						currentRow = GetInventoryRows()
					}
					else
					{
						reachedEnd = true
					}
				}
				else
				{
					currentRow--
				}

				if ( currentRow == startRow )
				{
					reachedEnd = true
				}
				break

			case eDirection.DOWN:
				if ( currentRow >= GetInventoryRows() )
				{
					if ( wrap )
					{
						currentRow = 0
					}
					else
					{
						reachedEnd = true
					}
				}
				else
				{
					currentRow++
				}

				if ( currentRow == startRow )
				{
					reachedEnd = true
				}
				break

			default:
				
				reachedEnd = true
				break
		}

		string buttonName = "GridButton" + currentRow + "x" + currentCol
		if ( Hud_HasChild( grid, buttonName ) )
		{
			var gridBtn = Hud_GetChild( grid, buttonName )
			bool isButtonVisible = GridPanel_GetButtonVisibility( grid, gridBtn )
			bool isButtonEnabled = Hud_IsEnabled( gridBtn )

			if ( isButtonVisible && isButtonEnabled )
			{
				foundValidButton = true
			}
		}
	}

	
	if ( !foundValidButton )
	{
		string originalButtonName = GRID_BTN_PREFIX + startRow + "x" + startCol
		if ( Hud_HasChild( grid, originalButtonName ) )
		{
			var originalButton = Hud_GetChild( grid, originalButtonName )
			bool isButtonVisible = GridPanel_GetButtonVisibility( grid, originalButton )
			bool isButtonEnabled = Hud_IsEnabled( originalButton )

			if ( isButtonVisible && isButtonEnabled )
			{
				GridButtonInfo originalButtonInfo
				originalButtonInfo.row = startRow
				originalButtonInfo.col = startCol
				originalButtonInfo.button = originalButton
				return originalButtonInfo
			}
		}

		GridButtonInfo invalidButtonInfo
		return invalidButtonInfo
	}

	GridButtonInfo validButtonInfo
	validButtonInfo.row = currentRow
	validButtonInfo.col = currentCol
	validButtonInfo.button = Hud_GetChild( grid, GRID_BTN_PREFIX + currentRow + "x" + currentCol )
	return validButtonInfo
}

bool function IsButtonValidForNavigation( var button, var grid )
{
	bool isButtonEnabled = Hud_IsEnabled( button )
	bool isButtonVisible = Hud_IsVisible( button )

	
	if ( grid != null && GridPanel_IsGridButton( grid, button ) )
	{
		if ( !GridPanel_GetButtonVisibility( grid, button ) )
		{
			isButtonVisible = false
		}
	}

	return ( isButtonVisible && isButtonEnabled )
}

void function SetInventoryDpadTooltipVisible( bool isVisible )
{
	var dpadToolTip    = Hud_GetChild( Hud_GetParent( file.mainPanel ), "TooltipDpad" )
	var dpadToolTipRui = Hud_GetRui( dpadToolTip )

	Hud_SetVisible( dpadToolTip, isVisible )
}

void function ClientToUI_UpdateInventoryDpadTooltip( string itemName, string mainUsePrompt = "", string altUsePrompt = "", string pingPrompt = "", string specialPrompt = "", string primarySwapPrompt = "", string character1UsePrompt = "", string character2UsePrompt = ""  )
{
	var dpadToolTip    = Hud_GetChild( Hud_GetParent( file.mainPanel ), "TooltipDpad" )
	var dpadToolTipRui = Hud_GetRui( dpadToolTip )

	string spacer     = "      "
	string footerText = specialPrompt

	footerText += mainUsePrompt != "" ? spacer + mainUsePrompt : ""
	footerText += altUsePrompt != "" ? spacer + altUsePrompt : ""
	footerText += primarySwapPrompt != "" ? spacer + primarySwapPrompt : ""
	footerText += character1UsePrompt != "" ? spacer + character1UsePrompt : ""
	footerText += character2UsePrompt != "" ? spacer + character2UsePrompt : ""
	footerText += pingPrompt != "" ? spacer + pingPrompt : ""
	RuiSetString( dpadToolTipRui, "itemNameText", Localize( itemName ) )
	RuiSetString( dpadToolTipRui, "footerText", footerText )
	Hud_SetVisible( dpadToolTip, itemName != "" )
}


void function Inventory_Shutdown()
{
	if ( IsFullyConnected() && CanRunClientScript() )
		RunClientScript( "UICallback_BackpackClosed" )
}


void function TryOpenSystemMenu( var panel )
{
	if ( InputIsButtonDown( BUTTON_START ) )
		return

	OpenSystemMenu()
}

void function OnLevelShutdown()
{
	if ( GetBugReproNum() == 53995 )
		return

	Hud_SetHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo0" ), Hud_GetBaseHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo0" ) ) )
	Hud_SetHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo1" ), Hud_GetBaseHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo1" ) ) )

	foreach ( button in file.equipmentButtons )
	{
#if SUPPORTS_COMPACT_UI
        if ( IsUsingCompactUILayout() )
            Hud_SetWidth( button, Hud_GetCompactLayoutWidth( button ) )
        else
#endif
            Hud_SetWidth( button, Hud_GetBaseWidth( button ) )
	}

}
