LootData function GetLootDataFromButton( var button, int index,  bool isOrdnanceSlots = false  )
{
	LootData data

	
	if ( CanRunClientScript() )
		RunClientScript( "UICallback_GetLootDataFromButton", button, index, isOrdnanceSlots )

	if ( SURVIVAL_Loot_IsRefValid( file.tempButtonRef ) )
	{
		data = SURVIVAL_Loot_GetLootDataByRef( file.tempButtonRef )
	}
	if ( index <= -1 && file.tempButtonIcon != $"" )
	{
		data.hudIcon = file.tempButtonIcon
		file.tempButtonIcon = $""
	}

	return data
}


