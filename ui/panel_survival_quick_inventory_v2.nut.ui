int function GetInventoryRows()
{
	return DEFAULT_INVENTORY_ROWS
}

int function GetInventoryColumns()
{
	return DEFAULT_INVENTORY_COLS
}

void function Survival_CommonButtonInit( var button )
{
	CommonButtonData bd
	file.useDataForButtons[button] <- bd
}


void function ClientToUI_SurvivalQuickInventory_MarkInventoryButtonPinged( var button )
{
	CommonButtonData bd = file.useDataForButtons[button]
	bd.pingCount += 1
	var rui = Hud_GetRui( button )
	RuiSetInt( rui, "pingCounter", bd.pingCount )
}


void function ClientToUI_SurvivalQuickInventory_MarkInventoryButtonUsed( var button )
{
	CommonButtonData bd = file.useDataForButtons[button]
	bd.useCount += 1
	var rui = Hud_GetRui( button )
	RuiSetInt( rui, "useCounter", bd.useCount )
}

bool function SurvivalInventory_AreDividersEnabled()
{
	if ( IsLobby() || !IsFullyConnected() )
		return false

	return GetCurrentPlaylistVarBool( "inventory_dividers_enabled", false )
}

void function InitSurvivalQuickInventoryPanel( var panel )
{
	file.mainPanel = panel

	RegisterSignal( "StopMouseDrag" )
	RegisterSignal( "StartEquipmentExtendedUse" )
	RegisterSignal( "EquipmentSlingDecorations" )

	AddPanelEventHandler( panel, eUIEvent.PANEL_SHOW, OnSurvivalQuickInventoryPanel_Show )
	AddPanelEventHandler( panel, eUIEvent.PANEL_HIDE, OnSurvivalQuickInventoryPanel_Hide )

	InitInventoryFooter( panel )

	file.mainInventoryPanel = Hud_GetChild( panel, "MainInventory" )
	InitMainInventoryPanel( file.mainInventoryPanel )

	array<var> dropSlots = GetElementsByClassname( GetParentMenu( panel ), "DropSlot" )

	foreach ( slot in dropSlots )
	{
		RegisterDropSlot( slot, null )
		if ( Hud_GetScriptID( slot ) == "ground" )
		{
			var rui = Hud_GetRui( slot )
			RuiSetBool( rui, "isAlwaysVisible", true )
			RuiSetString( rui, "optionalText", "#INVENTORY_SLOT_GROUND" )
		}
	}

	var reskin0 = Hud_GetChild( file.mainInventoryPanel, "MainWeaponReskin0" )
	Hud_AddEventHandler( reskin0, UIE_CLICK, OnReskinButtonClick )

	var reskin1 = Hud_GetChild( file.mainInventoryPanel, "MainWeaponReskin1" )
	Hud_AddEventHandler( reskin1, UIE_CLICK, OnReskinButtonClick )

	file.inventoryGridStatic = Hud_GetChild( file.mainInventoryPanel, "BackpackGrid" )

	GridPanel_Init( file.inventoryGridStatic, GetInventoryRows(), GetInventoryColumns(), OnBindBackpackItem, GetMaxInventoryItemCount, Survival_CommonButtonInit, false, false )

#if SUPPORTS_COMPACT_UI



    bool useCompactUILayout = IsUsingCompactUILayout()

#else
    bool useCompactUILayout = false
#endif

    if ( useCompactUILayout )
    {
        GridPanel_SetPadding( file.inventoryGridStatic, 10, 10, 10, 10 )
    }
    else
	{
        GridPanel_SetPadding( file.inventoryGridStatic, 13, 13, 13, 13 )
    }


	InitAssaultGrenadePanel()


	asset backgroundMaskAsset = $"rui/menu/inventory/backpack_container_mask"
	asset backgroundTextureAsset = $"rui/menu/inventory/backpack_container_texture"
	const float BACKGROUND_TEXTURE_ROTATION = 0.5

	GridPanel_RegisterGridBackgroundElement( file.inventoryGridStatic, Hud_GetChild( file.mainInventoryPanel, "BackerInventoryBG" ) ) 																											
	GridPanel_RegisterGridBackgroundElement( file.inventoryGridStatic, Hud_GetChild( file.mainInventoryPanel, "BackerInventory" ), eGridBackgroundScaleMode.ASPECT_Y, 0.0, GetImageSize( backgroundTextureAsset ) )								
	GridPanel_RegisterGridBackgroundElement( file.inventoryGridStatic, Hud_GetChild( file.mainInventoryPanel, "BackerInventory2" ), eGridBackgroundScaleMode.ASPECT_Y, BACKGROUND_TEXTURE_ROTATION, GetImageSize( backgroundTextureAsset ) )	

	GridBackgroundElement mouseDropInventoryBGE
	mouseDropInventoryBGE.paddingTop = 13
	mouseDropInventoryBGE.paddingBottom = 13

    if ( useCompactUILayout )
    {
        mouseDropInventoryBGE.paddingLeft = 40
        mouseDropInventoryBGE.paddingRight = 40
    }
    else
    {
        mouseDropInventoryBGE.paddingLeft = 20
        mouseDropInventoryBGE.paddingRight = 20
    }

	GridPanel_RegisterGridBackgroundElementWithStruct( file.inventoryGridStatic, Hud_GetChild( file.mainInventoryPanel, "MouseDropInventory" ), mouseDropInventoryBGE )		

	GridPanel_SetButtonHandler( file.inventoryGridStatic, UIE_CLICK, OnBackpackItemClick )
	GridPanel_SetButtonHandler( file.inventoryGridStatic, UIE_CLICKRIGHT, OnBackpackItemClickRight )
	GridPanel_SetButtonHandler( file.inventoryGridStatic, UIE_GET_FOCUS, OnBackpackItemGetFocus )
	GridPanel_SetButtonHandler( file.inventoryGridStatic, UIE_LOSE_FOCUS, OnBackpackItemLoseFocus )
	GridPanel_SetKeyPressHandler( file.inventoryGridStatic, OnBackpackItemKeyPress )
	GridPanel_SetCommandHandler( file.inventoryGridStatic, OnBackpackItemCommand )

	var elem = Hud_GetChild( panel, "MouseDragIcon" )
	Hud_Hide( elem )

	file.holdToUseElem = Hud_GetChild( Hud_GetParent( panel ), "HoldToUseElem" )

	AddUICallback_OnResolutionChanged( OnSurvivalQuickInventoryPanel_Refresh )
	AddUICallback_LevelShutdown( OnLevelShutdown )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "InventoryBracketR", "basicImage", $"rui/menu/inventory/backpack_container_side_bracket", eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "InventoryBracketL", "basicImage", $"rui/menu/inventory/backpack_container_side_bracket", eRuiArgType.IMAGE )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "InventoryBracketR", "imageRotation", 0.5, eRuiArgType.FLOAT )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "InventoryBracketL", "basicImageAlpha", 0.5, eRuiArgType.FLOAT )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "InventoryBracketR", "basicImageAlpha", 0.5, eRuiArgType.FLOAT )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "GearBracketR", "basicImage", $"rui/menu/inventory/gear_container_side_bracket", eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "GearBracketL", "basicImage", $"rui/menu/inventory/gear_container_side_bracket", eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "GearBracketR", "imageRotation", 0.5, eRuiArgType.FLOAT )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "GearBracketL", "basicImageAlpha", 0.5, eRuiArgType.FLOAT )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "GearBracketR", "basicImageAlpha", 0.5, eRuiArgType.FLOAT )

	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventoryBG", "basicImage", backgroundMaskAsset, eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventoryBG", "basicImageColor", <0.0, 0.0, 0.0>, eRuiArgType.VECTOR )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventoryBG", "basicImageAlpha", 0.65, eRuiArgType.FLOAT )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory", "maskImage", backgroundMaskAsset, eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory", "textureImage", backgroundTextureAsset, eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory", "basicImageAlpha", 0.25, eRuiArgType.FLOAT )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory2", "maskImage", backgroundMaskAsset, eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory2", "textureImage", backgroundTextureAsset, eRuiArgType.IMAGE )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory2", "basicImageAlpha", 0.25, eRuiArgType.FLOAT )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "BackerInventory2", "imageRotation", BACKGROUND_TEXTURE_ROTATION, eRuiArgType.FLOAT )


	if ( !(uiGlobal.uiShutdownCallbacks.contains( Inventory_Shutdown )) )
		AddUICallback_UIShutdown( Inventory_Shutdown )

	AddUICallback_InputModeChanged( Inventory_OnInputChanged )
}


void function InitAssaultGrenadePanel()
{
	file.grenadeGrid = Hud_GetChild( file.mainInventoryPanel, "GrenadeGrid" )
	GridPanel_Init( file.grenadeGrid, EXTRA_FIREPOWER_EXTRA_SLOTS, 1, OnBindGrenadeSlot, GetExtraFirepowerGrenadeSlots, Survival_CommonButtonInit )
	GridPanel_SetFillDirection( file.grenadeGrid, eGridPanelFillDirection.DOWN )
	GridPanel_SetButtonHandler( file.grenadeGrid, UIE_CLICKRIGHT, OnGrenadeBackpackItemClickRight )
	ClientToUi_SetGrenadeGridVisibility( false )
	HudElem_SetChildRuiArg( file.mainInventoryPanel, "AssaultClassIcon", "basicImage", $"rui/menu/character_select/utility/role_offense", eRuiArgType.IMAGE )
	RuiSetBool (Hud_GetRui( Hud_GetChild( file.grenadeGrid, "GridButton0x0" )), "isAssaultSlot", true)
	RuiSetBool (Hud_GetRui( Hud_GetChild( file.grenadeGrid, "GridButton1x0" )), "isAssaultSlot", true)


	GridPanel_SetButtonHandler( file.grenadeGrid, UIE_CLICK, OnGrenadeBackpackItemClick )
	GridPanel_SetButtonHandler( file.grenadeGrid, UIE_GET_FOCUS, OnGrenadeBackpackItemGetFocus )
	GridPanel_SetButtonHandler( file.grenadeGrid, UIE_LOSE_FOCUS, OnBackpackItemLoseFocus )
}

void function ClientToUi_SetGrenadeGridVisibility( bool visible )
{
	Hud_SetVisible( file.grenadeGrid, visible )
	Hud_SetVisible( Hud_GetChild( file.mainInventoryPanel, "AssaultClassIcon" ), visible )
}

void function UpdateGrenadeBackpackDpadNav()
{
	if ( !Hud_HasChild( file.grenadeGrid, "GridButton0x0" ) )
		return

	if ( !Hud_IsVisible( file.grenadeGrid ) )
		return

	var grenadeGridBtn0x0 = Hud_GetChild( file.grenadeGrid, "GridButton0x0" )
	var grenadeGridBtn1x0 = Hud_GetChild( file.grenadeGrid, "GridButton1x0" )

	if ( !IsButtonValidForNavigation( grenadeGridBtn0x0, file.grenadeGrid ) )
		return

	var slingButton = Hud_GetChild( file.mainInventoryPanel, "SlingWeapon" )
	var slingOrMainWeapon1Button = Hud_IsVisible( slingButton ) ? slingButton : Hud_GetChild( file.mainInventoryPanel, "MainWeapon1" )
	var backpackButton = Hud_GetChild( file.mainInventoryPanel, "BackPack" )

	Hud_SetNavUp( grenadeGridBtn0x0, slingOrMainWeapon1Button )

	if ( IsButtonValidForNavigation( backpackButton, null ) )
	{
		Hud_SetNavDown( grenadeGridBtn1x0, backpackButton )
	}
	else
	{
		Hud_SetNavDown( grenadeGridBtn1x0, grenadeGridBtn0x0 )
	}

	GridButtonInfo firstValidRow0ButtonInfo = GetNextValidGridButtonInDirection( file.inventoryGridStatic, 0, -1, eDirection.RIGHT, false ) 
	GridButtonInfo lastValidRow0ButtonInfo = GetNextValidGridButtonInDirection( file.inventoryGridStatic, 0, GetInventoryColumns() + 1, eDirection.LEFT, false ) 

	GridButtonInfo firstValidRow1ButtonInfo = GetNextValidGridButtonInDirection( file.inventoryGridStatic, 1, -1, eDirection.RIGHT, false )	
	GridButtonInfo lastValidRow1ButtonInfo = GetNextValidGridButtonInDirection( file.inventoryGridStatic, 1, GetInventoryColumns() + 1, eDirection.LEFT, false ) 

	if ( IsRTL() )
	{
		
		Hud_SetNavRight( firstValidRow0ButtonInfo.button, grenadeGridBtn0x0 )
		Hud_SetNavLeft( lastValidRow0ButtonInfo.button, grenadeGridBtn0x0 )
		Hud_SetNavRight( grenadeGridBtn0x0, lastValidRow0ButtonInfo.button )
		Hud_SetNavLeft( grenadeGridBtn0x0, firstValidRow0ButtonInfo.button )

		
		Hud_SetNavRight( firstValidRow1ButtonInfo.button, grenadeGridBtn1x0 )
		Hud_SetNavLeft( lastValidRow1ButtonInfo.button, grenadeGridBtn1x0 )
		Hud_SetNavRight( grenadeGridBtn1x0, lastValidRow1ButtonInfo.button )
		Hud_SetNavLeft( grenadeGridBtn1x0, firstValidRow1ButtonInfo.button )
	}
	else
	{
		
		Hud_SetNavLeft( firstValidRow0ButtonInfo.button, grenadeGridBtn0x0 )
		Hud_SetNavRight( lastValidRow0ButtonInfo.button, grenadeGridBtn0x0 )
		Hud_SetNavLeft( grenadeGridBtn0x0, lastValidRow0ButtonInfo.button )
		Hud_SetNavRight( grenadeGridBtn0x0, firstValidRow0ButtonInfo.button )

		
		Hud_SetNavLeft( firstValidRow1ButtonInfo.button, grenadeGridBtn1x0 )
		Hud_SetNavRight( lastValidRow1ButtonInfo.button, grenadeGridBtn1x0 )
		Hud_SetNavLeft( grenadeGridBtn1x0, lastValidRow1ButtonInfo.button )
		Hud_SetNavRight( grenadeGridBtn1x0, firstValidRow1ButtonInfo.button )
	}
}

void function OnGrenadeBackpackItemGetFocus( var panel, var button, int position )
{
	if ( GetMouseFocus() != button && !GetDpadNavigationActive() )
		return

	SetTabNavigationEnabled( Hud_GetParent( file.mainPanel ), false )

	if ( Hud_HasToolTipData( button ) && GetDpadNavigationActive() )
	{
		LootData ld          = GetLootDataFromButton( button, position, true )
		ToolTipData ttd      = Hud_GetToolTipData( button )
		string equipmentSlot = Hud_GetScriptID( button )
		RunClientScript( "UIToClient_UpdateInventoryDpadTooltipText", ld.ref, ttd.titleText, equipmentSlot )
	}
	else
	{
		SetInventoryDpadTooltipVisible( false )
	}
}


void function Inventory_OnInputChanged( bool isController )
{
	if( !IsPanelActive( file.mainPanel ) )
		return

	SurvivalQuickInventory_OnUpdate()
}

void function InitInventoryFooter( var panel )
{
	AddPanelFooterOption( panel, LEFT, BUTTON_Y, false, "", "", SurvivalMenuSwapWeapon, IsSurvivalMenuEnabled )

	AddPanelFooterOption( panel, LEFT, BUTTON_BACK, false, "", "", TryToggleMap )

	AddPanelFooterOption( panel, LEFT, KEY_M, false, "", "", TryToggleMap, PROTO_ShouldInventoryFooterHack )
	AddPanelFooterOption( panel, LEFT, KEY_TAB, false, "", "", TryCloseSurvivalInventory, PROTO_ShouldInventoryFooterHack )

	AddPanelFooterOption( panel, LEFT, BUTTON_B, true, "#B_BUTTON_BACK", "#B_BUTTON_BACK" )
	AddPanelFooterOption( panel, RIGHT, BUTTON_START, true, "#HINT_SYSTEM_MENU_GAMEPAD", "#HINT_SYSTEM_MENU_KB", TryOpenSystemMenu )

#if DEV
		AddPanelFooterOption( panel, LEFT, BUTTON_STICK_LEFT, true, "#LEFT_STICK_DEV_MENU", "#DEV_MENU", OpenDevMenu )
#endif
}

void function InitSquadFooter( var panel )
{
	var parentMenu = GetParentMenu( panel )

	if( parentMenu != GetMenu( "DeathScreenMenu" ) ) 
	{
		AddPanelFooterOption( panel, LEFT, BUTTON_BACK, false, "", "", TryToggleMap )

		AddPanelFooterOption( panel, LEFT, KEY_M, false, "", "", TryToggleMap, PROTO_ShouldInventoryFooterHack )
		AddPanelFooterOption( panel, LEFT, KEY_TAB, false, "", "", TryCloseSurvivalInventory, PROTO_ShouldInventoryFooterHack )

		AddPanelFooterOption( panel, LEFT, BUTTON_B, true, "#B_BUTTON_BACK", "#B_BUTTON_BACK" )
#if DEV
			AddPanelFooterOption( panel, LEFT, BUTTON_STICK_LEFT, true, "#LEFT_STICK_DEV_MENU", "#DEV_MENU", OpenDevMenu )
#endif
		AddPanelFooterOption( panel, RIGHT, BUTTON_START, true, "#HINT_SYSTEM_MENU_GAMEPAD", "#HINT_SYSTEM_MENU_KB", TryOpenSystemMenu )
	}
	else
	{
		InitDeathScreenPanelFooter( panel, eDeathScreenPanel.SQUAD)
	}
}


void function RegisterDropSlot( var button, void functionref( var, var, var, int ) dropFunc )
{
	file.allDropSlots.append( button )
	file.onMouseDropCallbacks[ button ] <- dropFunc
	Hud_SetAboveBlur( button, false )
}


void function InitCharacterDetailsPanel( var panel )
{
	file.characterDetailsPanel = panel
	file.characterDetailsRui = Hud_GetRui( file.characterDetailsPanel )

	AddPanelEventHandler( panel, eUIEvent.PANEL_SHOW, OnShowCharacterDetails )

	InitInventoryFooter( panel )
}


void function OnShowCharacterDetails( var panel )
{
	SurvivalInventory_SetBGVisible( true )
}


void function OnSurvivalQuickInventoryPanel_Show( var panel )
{
	var menu = GetParentMenu( panel )

	UISize screenSize = GetScreenSize()
	SetCursorPosition( <1920.0 * 0.5, 1080.0 * 0.5, 0> )

	file.compactModeEnabled = false

	SurvivalQuickInventory_OnUpdate()

	Hud_Show( file.mainInventoryPanel )
	SurvivalInventory_SetBGVisible( true )

	bool showTextChatHistory = IsAccessibilityChatToSpeech() && !bool( GetCommsRestrictionState() & COMMSRESTRICT_SENDRECV_TEXTANDVOICE )
#if SUPPORTS_COMPACT_UI
		showTextChatHistory = showTextChatHistory && !IsUsingCompactUILayout()
#endif

	var ingameTextChatHistory = Hud_GetChild( panel, "IngameTextChatHistory" )
	Hud_SetVisible( ingameTextChatHistory, showTextChatHistory )
	Hud_SetEnabled( ingameTextChatHistory, showTextChatHistory )

	if ( !IsFullyConnected() )
		return

	if ( IsLobby() )
		return

	RunClientScript( "UICallback_BackpackOpened" )

	int numUpgradeSlots = UPGRADE_CORE_NUM_EXPECTED_UPGRADES / UPGRADE_CORE_NUM_EXPECTED_UPGRADES_PER_LEVEL


		if ( LinearUpgradeCore_UseLegendUpgrades() )
		{
			numUpgradeSlots = LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES / LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES_PER_LEVEL
		}


	for ( int playerId = 0; playerId < 2; playerId++ )
	{
		for ( int upgradeId = 0; upgradeId < numUpgradeSlots; upgradeId++ )
		{
			RunClientScript( "UICallback_UpdateTeammateUpgrades", Hud_GetChild( file.mainInventoryPanel, "TeammateInfo" + playerId ), upgradeId )
		}
	}

	var smallPlayerInfo   = Hud_GetChild( file.mainInventoryPanel, "smallPlayerInfo" )
	var largePlayerInfo   = Hud_GetChild( file.mainInventoryPanel, "PlayerInfo" )
	var teammateInfo0     = Hud_GetChild( file.mainInventoryPanel, "TeammateInfo0" )
	var teammateInfo1     = Hud_GetChild( file.mainInventoryPanel, "TeammateInfo1" )
	var teammateInfo2     = Hud_GetChild( file.mainInventoryPanel, "TeammateInfo2" )
	float screenSizeYFrac =  GetScreenSize().height / 1080.0

	bool showPlayerInfo   = false

	int teammateInfo0YPos = 0
#if SUPPORTS_COMPACT_UI
	if ( IsUsingCompactUILayout() )
		teammateInfo0YPos = Hud_GetCompactLayoutY( teammateInfo0 )
	else
#endif
		teammateInfo0YPos = Hud_GetBaseY( teammateInfo0 )

	if( GetMaxTeamSizeForPlaylist( GetCurrentPlaylistName() ) > 3 )
	{
		RunClientScript( "UICallback_UpdateTeammateInfo", smallPlayerInfo, false )
		teammateInfo0YPos +=  int( -110 * screenSizeYFrac ) 
	}
	else
	{
		RunClientScript( "UICallback_UpdatePlayerInfo", largePlayerInfo )
		showPlayerInfo = true
	}


#if SUPPORTS_COMPACT_UI
			if ( IsUsingCompactUILayout() )
			{
				if ( Endorsements_IsActive() )
				{
					const int ENDORSEMENTS_UNITFRAME_OFFSET_COMPACT_UI = 40
					int scaledEndorsementsOffset = int( ENDORSEMENTS_UNITFRAME_OFFSET_COMPACT_UI * screenSizeYFrac )

					teammateInfo0YPos += scaledEndorsementsOffset
					int teammateInfo1YPos = Hud_GetCompactLayoutY( teammateInfo1 ) + scaledEndorsementsOffset
					int teammateInfo2YPos = Hud_GetCompactLayoutY( teammateInfo2 ) + scaledEndorsementsOffset

					Hud_SetY( teammateInfo1, teammateInfo1YPos )
					Hud_SetY( teammateInfo2, teammateInfo2YPos )
				}
				else
				{
					Hud_ReturnToBasePos( teammateInfo1 )
					Hud_ReturnToBasePos( teammateInfo2 )
				}
			}
#endif


	Hud_SetY( teammateInfo0, teammateInfo0YPos )

	Hud_SetVisible( smallPlayerInfo, !showPlayerInfo )
	Hud_SetVisible( largePlayerInfo, showPlayerInfo )

	RunClientScript( "UICallback_UpdateTeammateInfo", teammateInfo0, false )
	RunClientScript( "UICallback_UpdateTeammateInfo", teammateInfo1, false )
	RunClientScript( "UICallback_UpdateTeammateInfo", teammateInfo2, false )
	RunClientScript( "UICallback_UpdateUltimateInfo", Hud_GetChild( file.mainInventoryPanel, "PlayerUltimate" ) )

	AddUnitframeEventHandlers()


	if ( Endorsements_IsActive() )
	{
		SetupEndorsements()
	}
	else
	{
		
		CleanupEndorsements()
	}


	UpdateMouseDropGroundSizes()
}

void function AddUnitframeEventHandlers()
{
	for ( int idx = 0; idx < MAX_INVENTORY_UNITFRAMES; idx++ )
	{
		if ( !Hud_HasChild( file.mainInventoryPanel, "TeammateInfo" + idx ) )
			continue

		var teammateInfo = Hud_GetChild( file.mainInventoryPanel, "TeammateInfo" + idx )
		if ( !Hud_HasEventHandler( teammateInfo, UIE_GET_FOCUS, OnUnitframeButtonFocused ) )
		{
			Hud_AddEventHandler( teammateInfo, UIE_GET_FOCUS, OnUnitframeButtonFocused )
		}
	}
}

void function RemoveUnitframeEventHandlers()
{
	for ( int idx = 0; idx < MAX_INVENTORY_UNITFRAMES; idx++ )
	{
		if ( !Hud_HasChild( file.mainInventoryPanel, "TeammateInfo" + idx ) )
			continue

		var teammateInfo = Hud_GetChild( file.mainInventoryPanel, "TeammateInfo" + idx )
		if ( Hud_HasEventHandler( teammateInfo, UIE_GET_FOCUS, OnUnitframeButtonFocused ) )
		{
			Hud_RemoveEventHandler( teammateInfo, UIE_GET_FOCUS, OnUnitframeButtonFocused )
		}
	}
}

void function OnUnitframeButtonFocused( var button )
{
	RunClientScript( "UIToClient_UpdateTeammateRuiTooltip", button )
}


void function SetupEndorsements()
{
	CleanupEndorsements()

	if ( Hud_HasChild( file.mainInventoryPanel, "EndorsementsInventory" ) )
	{
		file.endorsementsInventoryPanel = Hud_GetChild( file.mainInventoryPanel, "EndorsementsInventory" )
		Hud_SetVisible( file.endorsementsInventoryPanel, true )
		Hud_SetEnabled( file.endorsementsInventoryPanel, true )

		int maxEndorsements = Endorsements_GetMaxEndorsementCount()

		for ( int idx = 0; idx < maxEndorsements; idx++ )
		{
			if ( Hud_HasChild( file.endorsementsInventoryPanel, "Endorsement" + idx ) )
			{
				var endorsementButton = Hud_GetChild( file.endorsementsInventoryPanel, "Endorsement" + idx )

				Hud_AddEventHandler( endorsementButton, UIE_GET_FOCUS, OnEndorsementButtonFocused )










				RunClientScript( "UIToClient_OnBindEndorsementButton", endorsementButton )

				file.endorsementButtons[idx] <- endorsementButton
			}
		}

		
		const int TOTAL_ENDORSEMENT_SLOTS = 3
		for ( int idx = maxEndorsements; idx < TOTAL_ENDORSEMENT_SLOTS; idx++ )
		{
			if ( Hud_HasChild( file.endorsementsInventoryPanel, "Endorsement" + idx ) )
			{
				var endorsementButton = Hud_GetChild( file.endorsementsInventoryPanel, "Endorsement" + idx )
				Hud_SetVisible( endorsementButton, false )
			}
		}


			
			bool isClockUpMode = GetCurrentPlaylistVarBool( "clockup_endorsements_is_enabled", false )
			UICallback_UpdateEndorsementFrameForClockUp( isClockUpMode )

	}
}

void function CleanupEndorsements()
{
	if ( file.endorsementsInventoryPanel != null )
	{
		Hud_SetVisible( file.endorsementsInventoryPanel, false )
		Hud_SetEnabled( file.endorsementsInventoryPanel, false )
	}

	
	if ( file.endorsementButtons.len() == 0 )
		return

	foreach ( int idx, var endorsementButton in file.endorsementButtons )
	{
		Hud_RemoveEventHandler( endorsementButton, UIE_GET_FOCUS, OnEndorsementButtonFocused )








	}

	file.endorsementButtons.clear()
}







































void function OnEndorsementButtonFocused( var button )
{
	if ( CanRunClientScript() )
	{
		RunClientScript( "UIToClient_UpdateEndorsementInventoryButtonTooltip", button )
	}
}


void function UICallback_UpdateEndorsementFrameForClockUp( bool hasClockUpEndorsement )
{
	if ( !IsValid( file.endorsementsInventoryPanel ) )
		return

	var framePanel = Hud_GetChild( file.endorsementsInventoryPanel, "EndorsementFrame" )

	if ( !framePanel )
		return

	var rui = Hud_GetRui( framePanel )

	RuiSetBoolIfExists( rui, "hasClockUpEndorsement", hasClockUpEndorsement )
}



void function UpdateMouseDropGroundSizes()
{
	var mouseDropGroundLeft = Hud_GetChild( file.mainInventoryPanel, "MouseDropGroundLeft" )
	var mouseDropGroundRight = Hud_GetChild( file.mainInventoryPanel, "MouseDropGroundRight" )

	int mouseDropGroundLeftWidth = Hud_GetBaseWidth( mouseDropGroundLeft )
	int mouseDropGroundRightWidth = Hud_GetBaseWidth( mouseDropGroundRight )

	int targetLeftWidth = mouseDropGroundLeftWidth
	int targetRightWidth = mouseDropGroundRightWidth
	if( LegendUpgrades_IsEnabled() )
	{
		UIScaleFactor scaleFactor = GetContentFixedScaleFactor( file.mainInventoryPanel )
		targetLeftWidth = int( 640.0 * scaleFactor.x )
		targetRightWidth = int( 180.0 * scaleFactor.x )
	}
	Hud_SetWidth( mouseDropGroundLeft, targetLeftWidth )
	Hud_SetWidth( mouseDropGroundRight, targetRightWidth )
}

void function Delayed_SetCursorToOffsetInventoryPosition( float offset )
{
	wait 0.01

	float width  = 1920
	float height = 1080

#if DEV
	if( !IsControllerModeActive() )
	{
		float screenSizeYFrac = GetScreenSize().height / 1080.0
		
		WarpMouseCursorDEV( <((width * 0.5) + offset) * screenSizeYFrac, (height * 0.5) * screenSizeYFrac, 0> )
	}
	else
#endif
	{
		SetCursorPosition( <(width * 0.5) + offset, height * 0.5, 0> )
	}
}

void function ClientToUI_UpdateInventoryUltimateTooltip( var button, string ultName )
{
	if ( ultName == "" )
	{
		Hud_ClearToolTipData( button )
		return
	}

	ToolTipData ttd
	ttd.titleText = ultName
	ttd.descText = "#INVENTORY_LABEL_ULTIMATE_READY"
	ttd.commsPromptDefault = IsControllerModeActive() ? "#PING_PROMPT_ULTIMATE_STATUS_GAMEPAD" : "#PING_PROMPT_ULTIMATE_STATUS"
	ttd.tooltipFlags = eToolTipFlag.SOLID
	ttd.tooltipStyle = eTooltipStyle.DEFAULT
	Hud_SetToolTipData( button, ttd )
}

void function OnSurvivalQuickInventoryPanel_Refresh()
{
	SurvivalQuickInventory_OnUpdate()
}


void function OnSurvivalQuickInventoryPanel_Hide( var panel )
{
	Hud_SetHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo0" ), Hud_GetBaseHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo0" ) ) )
	Hud_SetHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo1" ), Hud_GetBaseHeight( Hud_GetChild( file.mainInventoryPanel, "TeammateInfo1" ) ) )

	SurvivalMenu_AckAction()

	if ( !IsFullyConnected() )
		return

	if ( IsLobby() )
		return

	CloseCharacterDetails()
	RemoveUnitframeEventHandlers()


	if ( Endorsements_IsActive() )
	{
		CleanupEndorsements()
	}


	RunClientScript( "UICallback_BackpackClosed" )
}


void function SurvivalQuickInventory_OnUpdate()
{
	
	GridPanel_RefreshAndUpdateRowsAndColumns( file.inventoryGridStatic, GetInventoryRows(), GetInventoryColumns() )
	GridPanel_SetDividerVisibility( file.inventoryGridStatic, SurvivalInventory_AreDividersEnabled() )


	GridPanel_Refresh( file.grenadeGrid )


	if ( !IsFullyConnected() )
		return

	if ( GetActiveMenu() != GetParentMenu( file.mainPanel ) )
		return

	if ( IsLobby() )
		return

	entity localPlayer = GetLocalClientPlayer()
	if( LegendUpgrades_IsEnabled() && IsValid( localPlayer) )
	{
		UpdatePlayerUpgradeInfo()
	}

	foreach ( button in file.equipmentButtons )
	{
		Hud_ClearToolTipData( button )
		if ( IsFullyConnected() )
			RunClientScript( "UICallback_UpdateEquipmentButton", button )
	}

	foreach ( button in file.requestButtons )
	{
		Hud_ClearToolTipData( button )
		if ( IsFullyConnected() )
			RunClientScript( "UICallback_UpdateRequestButton", button )
	}

	if ( CanRunClientScript() )
	{
		RunClientScript( "UICallback_UpdateUltimateInfo", Hud_GetChild( file.mainInventoryPanel, "PlayerUltimate" ) )
	}

	var rtkUpgradeTree = Hud_GetChild( file.mainInventoryPanel, "RTKPlayerUpgradeInfo" )

	bool armorTiedToUpgrades = LegendUpgrades_ArmorTiedToUpgrades()
	bool showUpgradeTreeInventory = LegendUpgrades_ShowUpgradeTreeInventory()

	Hud_SetVisible( rtkUpgradeTree, armorTiedToUpgrades && showUpgradeTreeInventory )


	UpdateInventoryDpadNav()

	
	
	
	array<string> attachmentSuffix =
	[
		"Barrel",
		"Mag",
		"Sight",
		"Grip",




		"Hopup",
		"HopupMulti_a",
		"HopupMulti_b",
	]

	for ( int i = 0; i < 2; i++ )
	{
		string prefix       = "MainWeapon" + i
		bool didDpadMapping = false

		var prevButton = null
		foreach ( suffix in attachmentSuffix )
		{
			var button = Hud_GetChild( file.mainInventoryPanel, prefix + "_" + suffix )

			Hud_SetX( button, Hud_GetBaseX( button ) )

			if ( prevButton != null )
			{
				if ( Hud_GetWidth( prevButton ) == 0 )
				{
					Hud_SetX( button, 0 )
				}
				else if ( !didDpadMapping )
				{
					
					var mainWeapon = Hud_GetChild( file.mainInventoryPanel, prefix )
					Hud_SetNavUp( mainWeapon, prevButton )
					didDpadMapping = true
				}
			}

			prevButton = button
		}
	}
	
}


