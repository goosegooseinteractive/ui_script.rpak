void function SurvivalInventoryMenu_SetSpaceForSling( bool hasSling, bool useGenericSlingStyle = false )
{
	int weaponOffset = hasSling ? 50 : 0
	var weapon0 = Hud_GetChild( file.mainInventoryPanel, "MainWeapon0" )
	Hud_SetY( weapon0, Hud_GetBaseY(weapon0) + ContentScaledYAsInt( weaponOffset ) )
	var slingDecorations = Hud_GetChild( file.mainInventoryPanel, "SlingDecorations" )
	Hud_SetVisible( slingDecorations, hasSling )

	var slingDecorationsRui = Hud_GetRui( slingDecorations )
	if ( slingDecorationsRui != null )
		RuiSetBool( slingDecorationsRui, "useGenericSlingStyle", useGenericSlingStyle )
}


