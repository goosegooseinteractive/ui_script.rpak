global function InitCategoryWeaponPanel

global function CategoryWeaponPanel_SetWeapon
global function CategoryWeaponPanel_GetWeapon
global function CategoryWeaponPanel_GetActiveWeapon
global function CategoryWeaponPanel_GetActivePanel

struct PanelData
{
	var panel

	ItemFlavor ornull weaponOrNull
}


struct
{
	table<var, PanelData> panelDataMap

	table<var, TabDef> knockFXTabMap
	bool enableRTKWeaponSkinsTab = false

	var activePanel = null
	int lastTab = 0
	array< Newness_Query > newnessQueries
} file

void function InitCategoryWeaponPanel( var panel )
{
	Assert( !(panel in file.panelDataMap) )
	PanelData pd
	file.panelDataMap[ panel ] <- pd

	AddPanelEventHandler( panel, eUIEvent.PANEL_SHOW, CategoryWeaponPanel_OnShow )
	AddPanelEventHandler( panel, eUIEvent.PANEL_HIDE, CategoryWeaponPanel_OnHide )









	{
		var childPanel = Hud_GetChild( panel, "RTKWeaponSkinsPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#SKINS_BUTTON" )
		SetTabBaseWidth( tabdef, 160 )
		tabdef.useTapHoldLogic = true
	}
	{
		var childPanel = Hud_GetChild( panel, "WeaponSkinsPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#SKINS_BUTTON" )
		SetTabBaseWidth( tabdef, 160 )
		tabdef.useTapHoldLogic = true
	}

	{
		var childPanel = Hud_GetChild( panel, "WeaponPlaygroundPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#PLAYGROUND_BUTTON" )
		SetTabBaseWidth( tabdef, 200 )
		tabdef.useTapHoldLogic = true
	}

	{
		var childPanel = Hud_GetChild( panel, "WeaponCharmsPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#CHARMS_BUTTON" )
		SetTabBaseWidth( tabdef, 160 )
	}
	{
		
		var childPanel = Hud_GetChild( panel, "KnockFXPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#KNOCK_FX" )
		SetTabBaseWidth( tabdef, 200 )
		tabdef.useTapHoldLogic = true
		file.knockFXTabMap[ panel ] <- tabdef
	}









	{
		var childPanel = Hud_GetChild( panel, "WeaponMasteryPanel" )
		TabDef tabdef = AddTab( panel, childPanel, "#PROGRESSION_BUTTON" )
		SetTabBaseWidth( tabdef, 200 )
		tabdef.useTapHoldLogic = true
	}


	TabData tabData = GetTabDataForPanel( panel )
	tabData.centerTabs = true

	SetTabBackground( tabData, Hud_GetChild( panel, "TabsBackground" ), eTabBackground.STANDARD )
	SetTabDefsToSeasonal(tabData)
	AddCallback_OnTabChanged( WeaponCategory_OnTabChanged )
}

void function WeaponCategory_OnTabChanged()
{
	if( file.activePanel == null )
		return

	TabData tabData = GetTabDataForPanel( file.activePanel )
	file.lastTab = tabData.activeTabIdx
	bool showMasteryLevel = true

	TabDef weaponPlaygroundTab = Tab_GetTabDefByBodyName( tabData, "WeaponPlaygroundPanel" )
		showMasteryLevel = !weaponPlaygroundTab.isActive

	CustomizeWeaponMenu_SetMasteryLevelVisible( showMasteryLevel )
}

void function CategoryWeaponPanel_OnShow( var panel )
{
	file.activePanel = panel
	TabData tabData = GetTabDataForPanel( panel )

	bool enableWeaponMastery =  Mastery_IsEnabled()
	TabDef seasonTabDef = Tab_GetTabDefByBodyName( tabData, "WeaponMasteryPanel" )

	seasonTabDef.visible = enableWeaponMastery
	seasonTabDef.enabled = enableWeaponMastery

	file.enableRTKWeaponSkinsTab = GetCurrentPlaylistVarBool( "rtk_weapon_skins_enabled", true )

	TabDef rtkWeaponSkinsTab = Tab_GetTabDefByBodyName( tabData, "RTKWeaponSkinsPanel" )
	rtkWeaponSkinsTab.visible = file.enableRTKWeaponSkinsTab
	rtkWeaponSkinsTab.enabled = file.enableRTKWeaponSkinsTab

	TabDef vguiWeaponSkinsTab = Tab_GetTabDefByBodyName( tabData, "WeaponSkinsPanel" )
	vguiWeaponSkinsTab.visible = !file.enableRTKWeaponSkinsTab
	vguiWeaponSkinsTab.enabled = !file.enableRTKWeaponSkinsTab

	{
		var tabBodyPanel = file.enableRTKWeaponSkinsTab ? Hud_GetChild( panel, "RTKWeaponSkinsPanel" ) : Hud_GetChild( panel, "WeaponSkinsPanel" )
		ItemFlavor ornull weaponOrNull = CategoryWeaponPanel_GetWeapon(  panel  )

		if ( weaponOrNull != null )
		{
			expect ItemFlavor( weaponOrNull )

			{
				Newness_Query query
				query.itemFlavor    = weaponOrNull
				query.itemTypeList  = [eItemType.weapon_skin]
				query.uiCategory    = eItemTypeUICategory.WEAPON_LOADOUT
				query.panelOrButton = tabBodyPanel
				query.cb            = OnNewnessQueryChangedUpdatePanelTab
				Newness_AddCallbackAndCallNow_OnQueryUpdated( query )
				file.newnessQueries.append( query )
			}

			{
				Newness_Query query
				query.itemFlavor    = weaponOrNull
				query.itemTypeList  = [eItemType.weapon_addon]
				query.uiCategory    = eItemTypeUICategory.WEAPON_LOADOUT
				query.panelOrButton = Hud_GetChild( panel, "KnockFXPanel" )
				query.cb            = OnNewnessQueryChangedUpdatePanelTab
				Newness_AddCallbackAndCallNow_OnQueryUpdated( query )
				file.newnessQueries.append( query )
			}
		}
	}
	{
		var tabBodyPanel = Hud_GetChild( panel, "WeaponCharmsPanel" )

		Newness_Query query
		query.itemTypeList  = [eItemType.weapon_charm]
		query.uiCategory    = eItemTypeUICategory.WEAPON_LOADOUT
		query.panelOrButton = tabBodyPanel
		query.cb            = OnNewnessQueryChangedUpdatePanelTab
		Newness_AddCallbackAndCallNow_OnQueryUpdated( query )
		file.newnessQueries.append( query )
	}


	CustomizeWeaponMenu_SetMasteryLevelVisible( tabData.activeTabIdx != 0 )

	ActivateTab( tabData, file.lastTab )
}


void function CategoryWeaponPanel_OnHide( var panel )
{
	foreach ( Newness_Query nq in file.newnessQueries )
		Newness_RemoveCallback_OnQueryUpdated( nq )

	file.newnessQueries.clear()

	TabData tabData = GetTabDataForPanel( panel )
	HideVisibleTabBodies( tabData )
}











void function CategoryWeaponPanel_SetWeapon( var panel, ItemFlavor ornull weaponFlavOrNull )
{
	PanelData pd = file.panelDataMap[panel]
	pd.weaponOrNull = weaponFlavOrNull

	bool weaponHasKnockFX =  weaponFlavOrNull != null && WeaponAddOn_WeaponHasEquippableDoesKnockFXAddOn( expect ItemFlavor( weaponFlavOrNull ) )
	file.knockFXTabMap[panel].visible = weaponHasKnockFX
	file.knockFXTabMap[panel].enabled = weaponHasKnockFX
}

ItemFlavor ornull function CategoryWeaponPanel_GetWeapon( var panel )
{
	PanelData pd = file.panelDataMap[panel]
	return pd.weaponOrNull
}


ItemFlavor ornull function CategoryWeaponPanel_GetActiveWeapon()
{
	PanelData pd = file.panelDataMap[file.activePanel]
	return pd.weaponOrNull
}

var function CategoryWeaponPanel_GetActivePanel()
{
	return file.activePanel
}
