void function SoundPanelSetButtonVisible( var contentPanel, string buttonName, bool visible )
{
	int prevVisibleNavItem = -1

	for ( int i = 0; i < navItems.len() - 1; i++ )
	{
		var elem = Hud_GetChild( contentPanel, navItems[i] )

		if ( navItems[i] == buttonName )
		{
			if ( visible )
			{
				Hud_Show( elem )

				if ( i < navItems.len() - 1 )
					Hud_SetPinSibling( Hud_GetChild( contentPanel, navItems[i + 1] ), buttonName )

				if ( prevVisibleNavItem >= 0 )
					Hud_SetPinSibling( elem, navItems[prevVisibleNavItem] )
			}
			else
			{
				Hud_Hide( elem )

				if ( i < navItems.len() - 1 && prevVisibleNavItem >= 0 )
					Hud_SetPinSibling( Hud_GetChild( contentPanel, navItems[i + 1] ), navItems[prevVisibleNavItem] )
			}

			Hud_SetEnabled( elem, visible )
			return
		}

		if ( Hud_IsVisible( elem ) )
			prevVisibleNavItem = i
	}
}

void function OnShowAudioTweakPanel( var panel )
{

	const string aboveElem = "SwchSoundWithoutFocus"




	var vipButton = Hud_GetChild( file.tweakContentPanel, "SwchVipTelemetry" )
	if (GetConVarString( "XLOG_TLS_hostname" ).len() != 0 )
	{
		Hud_Show( vipButton )
		Hud_SetEnabled( vipButton, true )
		Hud_SetNavDown( Hud_GetChild( file.tweakContentPanel, aboveElem ), vipButton )
	}
	else
	{
		Hud_Hide( vipButton )
		Hud_SetEnabled( vipButton, false )
		Hud_SetNavDown( Hud_GetChild( file.tweakContentPanel, aboveElem ), null )
	}


		var weaponDialogueButton  = Hud_GetChild( file.tweakContentPanel, "SwchDialogueWeapons" )
		var announcerButton       = Hud_GetChild( file.tweakContentPanel, "SwchDialogueAnnouncer" )
		var standingEmotesButton  = Hud_GetChild( file.tweakContentPanel, "SwchSoundStandingEmotes" )
		bool showWeaponDialogue   = WeaponSkin_PlayerOwnsAnyWithVoice()
		if ( showWeaponDialogue )
		{
			Hud_Show( weaponDialogueButton )
			Hud_SetEnabled( weaponDialogueButton, true )
			Hud_SetPinSibling( weaponDialogueButton, "SwchDialogueAnnouncer" )
			Hud_SetPinSibling( standingEmotesButton, "SwchDialogueWeapons" )
			Hud_SetNavDown( announcerButton, weaponDialogueButton )
			Hud_SetNavUp( standingEmotesButton, weaponDialogueButton )
		}
		else
		{
			Hud_Hide( weaponDialogueButton )
			Hud_SetEnabled( weaponDialogueButton, false )
			Hud_SetPinSibling( standingEmotesButton, "SwchDialogueAnnouncer" )
			Hud_SetNavDown( announcerButton, standingEmotesButton )
			Hud_SetNavUp( standingEmotesButton, announcerButton )
		}


	ScrollPanel_SetActive( panel, true )
	SettingsPanel_SetContentPanelHeight( file.tweakContentPanel )
	ScrollPanel_Refresh( panel )
}

void function OnHideAudioTweakPanel( var panel )
{
	ScrollPanel_SetActive( panel, false )
	SavePlayerSettings()
}

void function OnOpenAudioTweakMenu()
{
	ShowPanel( Hud_GetChild( file.tweakMenu, "AudioTweakPanel" ) )
}

void function InitAudioTweakMenu( var menu )
{
	file.tweakMenu = menu
	AddMenuEventHandler( menu, eUIEvent.MENU_OPEN, OnOpenAudioTweakMenu )
}

void function SetupDialogueTweakButton( var btn, string name, string desc, string cvarType )
{
	SetupSettingsButton( btn, name, desc, $"rui/menu/settings/settings_audio" )

	Hud_DialogList_AddListItem( btn, "#SETTING_NONE", "" )
	Hud_DialogList_AddListItem( btn, "#SETTING_ONLY_IMPORTANT", "" )
	Hud_DialogList_AddListItem( btn, "#SETTING_ALL", "" )

	bool hasFlavor = GetConVarBool( "dialogue_cat_" + cvarType + "_flavor" )
	bool hasImportant = GetConVarBool( "dialogue_cat_" + cvarType + "_important" )

	if ( hasFlavor )
		Hud_SetDialogListSelectionIndex( btn, 2 )
	else if ( hasImportant )
		Hud_SetDialogListSelectionIndex( btn, 1 )

	AddButtonEventHandler( btn, UIE_CHANGE, void function( var btn ) : ( cvarType )
		{
			int selIdx = Hud_GetDialogListSelectionIndex( btn )

			switch ( selIdx )
			{
				case 2:
					SetConVarBool( "dialogue_cat_" + cvarType + "_flavor", true )
					SetConVarBool( "dialogue_cat_" + cvarType + "_important", true )
					break

				case 1:
					SetConVarBool( "dialogue_cat_" + cvarType + "_flavor", false )
					SetConVarBool( "dialogue_cat_" + cvarType + "_important", true )
					break

				case 0:
					SetConVarBool( "dialogue_cat_" + cvarType + "_flavor", false )
					SetConVarBool( "dialogue_cat_" + cvarType + "_important", false )
					break
			}
		} 
	)
}

