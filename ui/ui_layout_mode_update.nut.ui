#if SUPPORTS_COMPACT_UI


global function UICodeCallback_UiLayoutModeChanged
global function AddUICallback_UiLayoutModeChanged
global function RemoveUICallback_UiLayoutModeChanged








global function IsChangingUILayoutMode

bool isChangingUILayoutMode = false


void function UICodeCallback_UiLayoutModeChanged()
{
#if DEV
	if ( IsUsingCompactUILayout() )
		printt( "UIScript: Switching to Compact UI Layout" )
	else
		printt( "UIScript: Switching to Full UI Layout" )
#endif

	var activeMenu = GetActiveMenu()

	if ( activeMenu && GetActiveMenuName() == "CharacterSelectMenu" )
		RunClientScript( "UIToClient_OnUiLayoutModeChanged" )

	if ( activeMenu && GetActiveMenuName() == "CustomizeCharacterMenu" )
		RunClientScript( "ClearBattlePassItem" )

	if ( activeMenu && GetActiveMenuName() == "SurvivalInventoryMenu" )
		RunClientScript( "ResetInventoryMenu", GetLocalClientPlayer() )

	isChangingUILayoutMode = true

	if ( activeMenu != null )
	{
		if ( uiGlobal.menuData[ activeMenu ].hideFunc != null )
			uiGlobal.menuData[ activeMenu ].hideFunc()

		if ( uiGlobal.menuData[ activeMenu ].showFunc != null )
			uiGlobal.menuData[ activeMenu ].showFunc()

		UpdateMenuTabs()
	}

	if ( uiGlobal.activePanels.len() != 0 )
	{
		var activePanel = uiGlobal.activePanels.top()
		HidePanelInternal( activePanel )
		ShowPanelInternal( activePanel )
	}

	isChangingUILayoutMode = false

	
	if( activeMenu != null && ( uiGlobal.menuData[ activeMenu ].isPopup || uiGlobal.menuData[ activeMenu ].isDialog ) )
	{
		array<var> menuStack = MenuStack_GetCopy()
		foreach ( index, currMenu in menuStack )
		{
			if (Hud_IsVisible( currMenu ))
			{
				if ( uiGlobal.menuData[ currMenu ].hideFunc != null )
					uiGlobal.menuData[ currMenu ].hideFunc()

				if ( uiGlobal.menuData[ currMenu ].showFunc != null )
					uiGlobal.menuData[ currMenu ].showFunc()
			}
		}

		foreach ( var panel in uiGlobal.activePanels )
		{
			if ( uiGlobal.panelData[ panel ].isCurrentlyShown )
			{
				HidePanelInternal( panel )
				ShowPanelInternal( panel )
			}
		}
	}

	foreach ( func in uiGlobal.uiLayoutModeChangedCallbacks )
		func()

#if DEV
	printt( "UIScript: Switch Completed" )
#endif
}

void function AddUICallback_UiLayoutModeChanged( void functionref() callbackFunc )
{
	if ( !uiGlobal.uiLayoutModeChangedCallbacks.contains( callbackFunc ) )
		uiGlobal.uiLayoutModeChangedCallbacks.append( callbackFunc )
}

void function RemoveUICallback_UiLayoutModeChanged( void functionref() callbackFunc )
{
	if ( uiGlobal.uiLayoutModeChangedCallbacks.contains( callbackFunc ) )
		uiGlobal.uiLayoutModeChangedCallbacks.removebyvalue( callbackFunc )
}































bool function IsChangingUILayoutMode()
{
	return isChangingUILayoutMode
}


#endif
