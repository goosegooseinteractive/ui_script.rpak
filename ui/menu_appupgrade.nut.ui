global function InitAppUpgradeDialog
global function OpenAppUpgradeDialog

struct
{
	var menu
	var contentRui
} file


void function InitAppUpgradeDialog( var menu )
{
	file.menu = menu

	SetDialog( menu, true )
	SetGamepadCursorEnabled( menu, false )

	file.contentRui = Hud_GetRui( Hud_GetChild( file.menu, "ContentRui" ) )

	AddMenuFooterOption( menu, LEFT, BUTTON_A, true, "#APPUPGRADE_NEW_VERSION_BUTTON", "#APPUPGRADE_NEW_VERSION_BUTTON", OpenStoreLink )

	AddMenuEventHandler( menu, eUIEvent.MENU_OPEN, AppUpgradeDialog_OnOpen )
    AddMenuEventHandler( menu, eUIEvent.MENU_NAVIGATE_BACK, AppUpgradeDialog_OnBackButtonPressed )
}

void function OpenAppUpgradeDialog()
{
	AdvanceMenu( file.menu )
}

void function AppUpgradeDialog_OnBackButtonPressed()
{
    
}


void function AppUpgradeDialog_OnOpen()
{
	RuiSetAsset( file.contentRui, "contextImage", $"ui/menu/common/dialog_notice" )
	RuiSetString( file.contentRui, "headerText", Localize( "#APPUPGRADE_NEW_VERSION_HEADER" ).toupper() )
	RuiSetString( file.contentRui, "messageText", Localize( "#APPUPGRADE_NEW_VERSION_DESC" ) )
}


void function OpenStoreLink( var button )
{



}