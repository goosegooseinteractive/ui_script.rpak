void function UI_OnLoadoutButton_Enter( var button )
{
	

	TabData childTabData = DeathScreenGetDataForPanel( file.currentTabIndex )

	var panel   = _GetActiveTabPanel( file.menu )

	var chatbox
	if ( Hud_HasChild( panel, "LobbyChatBox" ) )
		chatbox = Hud_GetChild( panel, "LobbyChatBox" )

	if ( childTabData.activeTabIdx != INVALID_TAB_INDEX && childTabData.tabDefs.len() > childTabData.activeTabIdx && childTabData.tabDefs[ childTabData.activeTabIdx ].panel != null && Hud_HasChild( childTabData.tabDefs[ childTabData.activeTabIdx ].panel, "LobbyChatBox" ) )
	{
		chatbox = Hud_GetChild( childTabData.tabDefs[ childTabData.activeTabIdx ].panel, "LobbyChatBox" )
	}

	if ( chatbox == null )
	{
		var child = DeathScreenGetChild( "DeathScreenChatBox" )
		if ( child == null )
			return

		chatbox = Hud_GetChild( child, "LobbyChatBox" )
	}

	if ( chatbox == null )
		return

	if ( !HudChat_HasAnyMessageModeStoppedRecently() )
		Hud_StartMessageMode( chatbox )

	Hud_SetVisible( chatbox, true )
}

void function UI_OnLoadoutButton_Enter_RTKMenu( var button )
{
	

	var panel   = _GetActiveTabPanel( file.menu )
	var parentPanel = Hud_GetParent( panel )

	var chatbox
	if ( Hud_HasChild( parentPanel, "LobbyChatBox" ) )
		chatbox = Hud_GetChild( parentPanel, "LobbyChatBox" )

	if ( chatbox == null )
	{
		var child = DeathScreenGetChild( "DeathScreenChatBox" )
		if ( child == null )
			return

		chatbox = Hud_GetChild( child, "LobbyChatBox" )
	}

	if ( chatbox == null )
		return

	if ( !HudChat_HasAnyMessageModeStoppedRecently() )
		Hud_StartMessageMode( chatbox )

	Hud_SetVisible( chatbox, true )
}

