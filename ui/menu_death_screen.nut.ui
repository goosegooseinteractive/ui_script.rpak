	else if( !IsPrivateMatch() )
		UI_FullmapChallengeCategoryLeft( null )
}

void function DPadRBind( var button )
{
	if( Hud_IsVisible( DeathScreenGetChangeLoadoutButton() ) && DeathScreenIsOpen() )
		ChangeLoadout_OnActivate( null )
	else if( !IsPrivateMatch() )
		UI_FullmapChallengeCategoryRight( null )
}

void function ChangeLegend_OnActivate( var button )
{
	if( Hud_IsVisible( DeathScreenGetChangeLegendButton() ) && DeathScreenIsOpen() && CanRunClientScript() )
		RunClientScript( "UICallback_OpenCharacterSelectMenu" )
}

void function ChangeLoadout_OnActivate( var button )
{
	if( Hud_IsVisible( DeathScreenGetChangeLoadoutButton() ) && DeathScreenIsOpen() )
		LoadoutSelectionMenu_OpenLoadoutMenu( true )
}

void function InitiateRequeue( var button, bool isPartyRequeue = true )
{
	if ( !DeathScreenIsOpen() )
		return

	if ( LeaveMatch_WasInitiated() )
		return


	entity clientPlayer = GetLocalClientPlayer()
	if ( !IsMatchmakingFromMatchAllowed( clientPlayer ) )
		return

	bool isOptedInParty = Requeue_AmIOptedInParty()
	bool isOptedInSquad = Requeue_AmIOptedInSquad()

	if ( AmIPartyLeader() && !isOptedInParty && !isOptedInSquad )
	{
		if ( isPartyRequeue )
		{
			if ( Requeue_SquadOptInEnabled() )
				RunClientScript( "ClRequeue_OptIn", eRequeueOptInChoice.PARTY )
			else
			{
				bool isRanked = GameModeVariant_IsActiveForPlaylist( GetCurrentPlaylistName(), eGameModeVariants.SURVIVAL_RANKED )
				if ( !isRanked )
					StartMatchmakingFromMatch()
			}
		}
		else
		{
			RunClientScript( "ClRequeue_OptIn", eRequeueOptInChoice.SQUAD )
		}
	}
	else
	{
		bool partyRequeueWithNoSquadOptIn = isPartyRequeue && !isOptedInSquad
		bool squadRequeueWithNoPartyOptIn = !isPartyRequeue && !isOptedInParty

		if ( partyRequeueWithNoSquadOptIn || squadRequeueWithNoPartyOptIn )
		{
			AdvanceMenu( GetMenu( "RequeueDialog" ) )
		}
	}

}

void function RequeueWithParty( var button )
{
	InitiateRequeue( button, true )
}

void function RequeueWithSquad( var button )
{
	InitiateRequeue( button, false )
}

