#if UI_AUTOMATION
void function DeathScreenPanelFooterAutomationThink( var menu )
{
	if ( UIAutomation_AutomationDelay() && !UIAutomation_GetWaitForPostmatch() && DeathScreenShowLobbyButton() )
	{
		printf("[AutoUI] <Death Screen> Think")

		if ( UIAutomation_GetRequeue() )
		{
			printf("[AutoUI] Requeue")
			RequeueWithParty( null )
		}
		else{
			printf("[AutoUI] Stop Matchmaking")
			
			StopMatchmaking()
			ClientCommand( "disconnect" )
			Party_LeaveParty()
		}
	}
}
#endif
