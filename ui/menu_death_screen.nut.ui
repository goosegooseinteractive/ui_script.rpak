var function DeathScreen_GetVguiConnectingElement()
{
	return Hud_GetChild( file.menu, "DeathScreenConnecting" )
}

var function DeathScreen_GetOrCreateNestedConnectingRui()
{
	if ( file.connectingNestedElement != null && RuiIsAlive( file.connectingNestedElement ) )
		return file.connectingNestedElement

	var connectingVguiElement = DeathScreen_GetVguiConnectingElement()
	if ( connectingVguiElement == null )
		return null

	var connectingRui = Hud_GetRui( connectingVguiElement )
	if ( connectingRui == null )
		return null

	file.connectingNestedElement = RuiCreateNested( connectingRui, "innerElem", $"ui/matchmaking_status.rpak" )
	return file.connectingNestedElement
}

void function DeathScreen_DestroyNestedConnectingRui()
{
	var connectingVguiElement = DeathScreen_GetVguiConnectingElement()
	if ( connectingVguiElement == null )
		return null

	var connectingRui = Hud_GetRui( connectingVguiElement )

	if ( connectingRui == null )
		return

	RuiDestroyNestedIfAlive( connectingRui, "innerElem" )
	file.connectingNestedElement = null
}




bool function DeathScreen_UpdateConnectingUI( string statusText )
{
	var vguiElement = DeathScreen_GetVguiConnectingElement()

	if ( vguiElement == null )
		return false

	bool shouldShowConnecting = statusText.len() > 0
	Hud_SetVisible( vguiElement, shouldShowConnecting )

	
	if ( !shouldShowConnecting )
	{
		DeathScreen_DestroyNestedConnectingRui()
		DeathScreen_SetHideRespawnTimer( false )
		return false
	}

	var nestedRuiElement = DeathScreen_GetOrCreateNestedConnectingRui()
	if ( nestedRuiElement == null )
		return false

	RuiSetBoolIfExists( nestedRuiElement, "statusHasText", shouldShowConnecting )
	RuiSetBoolIfExists( nestedRuiElement, "statusVisible", shouldShowConnecting )
	RuiSetStringIfExists( nestedRuiElement, "statusText", shouldShowConnecting ? Localize( statusText ) : "" )
	RuiSetBoolIfExists( nestedRuiElement, "iconVisible", true )
	RuiSetBoolIfExists( nestedRuiElement, "hideBlur", true )
	RuiSetBoolIfExists( nestedRuiElement, "hideBackground", true )
	RuiSetBoolIfExists( nestedRuiElement, "centerTextVertically", true )

	
	
	DeathScreen_SetHideRespawnTimer( true )
	return true
}

void function DeathScreen_SetHideRespawnTimer( bool shouldHide )
{
	var headerElement = DeathScreenGetChild( "Header" )
	if ( headerElement != null )
	{
		var headerRui = Hud_GetRui( headerElement )
		RuiSetBool( headerRui, "hideRespawnTimer", shouldHide )
	}
}

