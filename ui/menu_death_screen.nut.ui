void function UI_SetDeathScreenTabTitle( int tabIndex, string title )
{
	
	if ( !MenuStack_Contains( file.menu ) )
	{
		
		return
	}

			string panelName = DeathScreenPanelEnumToPanelBodyName( tabIndex )
			if ( panelName == "" )
			{
				Assert( false, "UI_SetDeathScreenTabTitle failed to resolve panel body for index " + tabIndex )
				return
			}

			TabData tabData = DeathScreenPanelEnumIsLeafRoot( tabIndex ) ? GetTabDataForPanel( file.menu ) : DeathScreenGetDataForPanel( tabIndex )
	TabDef tabDef   = Tab_GetTabDefByBodyName( tabData, panelName )
	tabDef.title = title

	UpdateMenuTabs()
}


