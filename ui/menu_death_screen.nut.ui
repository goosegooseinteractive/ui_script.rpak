bool function UI_IsReadyForRequeue()
{
	bool gameIsOver = GetGlobalNonRewindNetBool( "roundBased" ) ? GetGlobalNonRewindNetBool("roundScoreLimitComplete") : GetGameState() >= eGameState.WinnerDetermined
	return ( file.isEliminated || gameIsOver ) &&
		IsMatchmakingFromMatchAllowed( GetLocalClientPlayer() ) &&
		!LeaveMatch_WasInitiated()
}

